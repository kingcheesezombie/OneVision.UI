@using OneVision.UI.Components

<OVAccessManagement @key="Scenario"
    Mode="@DemoMode"
    Features="@DemoFeatures"
    AssignAvailability="@DemoAssignAvailability"
    RevokeAvailability="@DemoRevokeAvailability"
    Roles="@DemoRoles"
    LoadPrincipals="@LoadPrincipalsAsync"
    SearchAvailablePrincipals="@SearchPrincipalsAsync"
    CheckGrantEligibility="@CheckEligibilityAsync"
    GrantRole="@GrantAsync"
    RevokeRole="@RevokeAsync"
    LoadEffectiveAccess="@LoadEffectiveAsync"
    LoadAudit="@LoadAuditAsync"
    AuditActions="@DemoAuditActions"
    Lifecycle="@DemoLifecycle"
    BootstrapAdministrator="@BootstrapAsync"
    RequestRecovery="@RecoveryAsync"
    DataChanged="@RefreshAfterChange" />

@code {
    [Parameter] public string Scenario { get; set; } = "assigned";
    [Parameter] public bool AllowAssignments { get; set; } = true;
    [Parameter] public bool AllowRevocation { get; set; } = true;
    [Parameter] public bool ShowEffective { get; set; } = true;
    [Parameter] public bool ShowAudit { get; set; } = false;
    [Parameter] public bool SupportGroups { get; set; } = true;

    private OVAccessMode DemoMode => Scenario.StartsWith("bootstrap", StringComparison.Ordinal)
        ? OVAccessMode.Bootstrap : Scenario.StartsWith("recovery", StringComparison.Ordinal)
        ? OVAccessMode.Recovery : Scenario == "read-only" ? OVAccessMode.InspectOnly : OVAccessMode.Manage;
    private OVAccessFeatures DemoFeatures => new(
        AllowRoleAssignment: AllowAssignments, AllowRoleRevocation: AllowRevocation,
        ShowEffectivePermissions: ShowEffective, ShowAuditHistory: ShowAudit || Scenario == "audit",
        SupportGroupPrincipals: SupportGroups, SupportBootstrap: true, SupportRecovery: true);
    private OVAccessAvailability DemoAssignAvailability => Scenario == "unauthorised"
        ? OVAccessAvailability.Deny("The current operator cannot grant roles.") : OVAccessAvailability.Permit;
    private OVAccessAvailability DemoRevokeAvailability => Scenario == "unauthorised"
        ? OVAccessAvailability.Deny("The current operator cannot revoke roles.") : OVAccessAvailability.Permit;

    private static readonly IReadOnlyList<OVOption<string>> DemoAuditActions =
    [
        new("Assign", "Assign"),
        new("Revoke", "Revoke"),
        new("Bootstrap", "Bootstrap"),
        new("Recover", "Recover")
    ];

    private static readonly IReadOnlyList<OVAccessRole> DemoRoles =
    [
        new("observer", "Reader", "Can inspect synthetic records.",
            [new("view", "View records", "Read-only catalogue access")]),
        new("editor", "Editor", "Can maintain synthetic records.",
            [new("view", "View records"), new("edit", "Edit records")]),
        new("administrator", "Administrator", "Can manage the synthetic application's access.",
            [new("access", "Administer access"), new("view", "View records")]),
        new("baseline", "Authenticated", "Implicit authenticated-user access.",
            [new("baseline-view", "View application welcome screen")], IsImplicit: true)
    ];
    private static readonly OVAccessPrincipal User = new("synthetic:user-001", "Avery Example",
        OVAccessPrincipalType.User, "person-001", "Sample directory", "Active",
        [new("assignment-001", "synthetic:user-001", "administrator", "Administrator",
            "r1", Revocability: OVAccessAvailability.Deny("Last effective administrator cannot be revoked."))]);
    private static readonly OVAccessPrincipal SecondUser = new("synthetic:user-002", "Jordan Sample",
        OVAccessPrincipalType.User, "person-002", "Sample directory", "Active",
        [new("assignment-002", "synthetic:user-002", "editor", "Editor", "r4")]);
    private static readonly OVAccessPrincipal Group = new("synthetic:group-001", "Reporting Readers",
        OVAccessPrincipalType.Group, "group-001", "Sample directory", "Active",
        [new("assignment-003", "synthetic:group-001", "observer", "Reader", "r2")]);

    private readonly List<OVAccessPrincipal> _records = [User, SecondUser, Group];
    private bool _bootstrapped;
    private bool _recovered;

    private OVAccessLifecycle DemoLifecycle
    {
        get
        {
            var state = Scenario switch
            {
                "bootstrap-eligible" => _bootstrapped ? OVAccessLifecycleState.Configured : OVAccessLifecycleState.BootstrapEligible,
                "bootstrap-ineligible" => OVAccessLifecycleState.BootstrapIneligible,
                "bootstrap-configured" => OVAccessLifecycleState.Configured,
                "recovery-eligible" => _recovered ? OVAccessLifecycleState.Configured : OVAccessLifecycleState.RecoveryEligible,
                "recovery-ineligible" => OVAccessLifecycleState.RecoveryIneligible,
                _ => OVAccessLifecycleState.NotConfigured
            };
            var allowed = state is OVAccessLifecycleState.BootstrapEligible or OVAccessLifecycleState.RecoveryEligible;
            return new(state, "synthetic:operator-001",
                allowed ? OVAccessAvailability.Permit : OVAccessAvailability.Deny("Not eligible for this operation."),
                "Eligibility in this demonstration is supplied by a synthetic application.",
                "Synthetic demonstration of operational recovery.");
        }
    }

    private async Task<OVAccessPage<OVAccessPrincipal>> LoadPrincipalsAsync(OVAccessQuery query, CancellationToken ct)
    {
        if (Scenario == "loading") await Task.Delay(1500, ct);
        if (Scenario == "error") throw new InvalidOperationException("Synthetic load failure");
        await Task.Delay(20, ct);
        var records = Scenario == "empty" ? [] : _records.ToList();
        if (Scenario == "protected") records = [User];
        var filtered = records.Where(p => string.IsNullOrEmpty(query.Search)
            || p.DisplayName.Contains(query.Search, StringComparison.OrdinalIgnoreCase)
            || (p.SecondaryLabel?.Contains(query.Search, StringComparison.OrdinalIgnoreCase) ?? false)).ToArray();
        return new(filtered.Skip((query.Page - 1) * query.PageSize).Take(query.PageSize).ToArray(),
            query.Page, query.PageSize, filtered.Length);
    }

    private Task<IReadOnlyList<OVAccessPrincipal>> SearchPrincipalsAsync(string term, CancellationToken ct)
    {
        ct.ThrowIfCancellationRequested();
        IReadOnlyList<OVAccessPrincipal> result =
            new[] { User, SecondUser, Group }.Where(p => p.DisplayName.Contains(term, StringComparison.OrdinalIgnoreCase)).ToArray();
        return Task.FromResult(result);
    }

    private Task<OVAccessAvailability> CheckEligibilityAsync(string principalId, string roleId, CancellationToken ct)
    {
        ct.ThrowIfCancellationRequested();
        var existing = _records.Any(p => p.PrincipalId == principalId
            && (p.Assignments ?? []).Any(a => a.RoleId == roleId));
        return Task.FromResult(existing
            ? OVAccessAvailability.Deny("That direct role assignment already exists.")
            : OVAccessAvailability.Permit);
    }

    private Task<OVAccessMutationResult> GrantAsync(OVAccessGrantRequest request)
    {
        if (Scenario == "save-error")
            return Task.FromResult(new OVAccessMutationResult(OVAccessMutationCode.Conflict, "The synthetic record changed."));
        var principal = _records.FirstOrDefault(p => p.PrincipalId == request.PrincipalId);
        if (principal is null)
            return Task.FromResult(new OVAccessMutationResult(OVAccessMutationCode.PrincipalUnavailable));
        if ((principal.Assignments ?? []).Any(a => a.RoleId == request.RoleId))
            return Task.FromResult(new OVAccessMutationResult(OVAccessMutationCode.AlreadyAssigned));
        var role = DemoRoles.First(r => r.RoleId == request.RoleId);
        _records[_records.IndexOf(principal)] = principal with {
            Assignments = (principal.Assignments ?? []).Append(new("synthetic-" + Guid.NewGuid().ToString("N"),
                request.PrincipalId, request.RoleId, role.Name)).ToArray()
        };
        return Task.FromResult(new OVAccessMutationResult(OVAccessMutationCode.Success, "Synthetic assignment confirmed."));
    }

    private Task<OVAccessMutationResult> RevokeAsync(OVAccessRevokeRequest request)
    {
        var principal = _records.FirstOrDefault(p => (p.Assignments ?? []).Any(a => a.AssignmentId == request.AssignmentId));
        if (principal is null) return Task.FromResult(new OVAccessMutationResult(OVAccessMutationCode.AlreadyRevoked));
        var assignment = principal.Assignments!.First(a => a.AssignmentId == request.AssignmentId);
        if (assignment.Revocability?.Allowed == false)
            return Task.FromResult(new OVAccessMutationResult(OVAccessMutationCode.LastAdministratorProtected));
        _records[_records.IndexOf(principal)] = principal with {
            Assignments = principal.Assignments.Where(a => a.AssignmentId != request.AssignmentId).ToArray()
        };
        return Task.FromResult(OVAccessMutationResult.Success);
    }

    private Task<OVAccessEvaluation> LoadEffectiveAsync(string principalId, CancellationToken ct)
    {
        ct.ThrowIfCancellationRequested();
        return Task.FromResult(new OVAccessEvaluation(
            Scenario == "partial-access" ? OVAccessEvaluationQuality.Partial : OVAccessEvaluationQuality.Complete,
            [
                new("view", "View records", OVAccessOutcome.Granted,
                    [new(OVAccessGrantOrigin.Direct, "Direct application role", "editor", "assignment-002"),
                     new(OVAccessGrantOrigin.Group, "Group-derived access via Reporting Readers", "observer", "assignment-003", "Reporting Readers")]),
                new("baseline-view", "Welcome screen", OVAccessOutcome.Granted,
                    [new(OVAccessGrantOrigin.Baseline, "Authenticated-user baseline")])
            ], DateTimeOffset.UtcNow, "Synthetic example; no live membership evaluation",
            Scenario == "partial-access" ? "Some external group lineage is unavailable." : null));
    }

    private Task<OVAccessAuditPage> LoadAuditAsync(OVAccessAuditQuery query, CancellationToken ct)
    {
        ct.ThrowIfCancellationRequested();
        IReadOnlyList<OVAccessAuditRecord> rows =
        [
            new("event-1", DateTimeOffset.UtcNow.AddDays(-1), "Synthetic operator",
                "Assign", "Jordan Sample", "Editor", "Success"),
            new("event-2", DateTimeOffset.UtcNow.AddDays(-4), "Synthetic operator",
                "Bootstrap", "Avery Example", "Administrator", "Success")
        ];
        var filtered = rows.Where(r => (string.IsNullOrWhiteSpace(query.PrincipalSearch) ||
            r.Principal.Contains(query.PrincipalSearch, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrWhiteSpace(query.Action) ||
            string.Equals(r.Action, query.Action, StringComparison.OrdinalIgnoreCase))).ToArray();
        return Task.FromResult(new OVAccessAuditPage(
            new(filtered.Skip((query.Page - 1) * query.PageSize).Take(query.PageSize).ToArray(),
                query.Page, query.PageSize, filtered.Length),
            "Synthetic demonstration only; not a complete security history."));
    }

    private Task<OVAccessMutationResult> BootstrapAsync()
    {
        if (_bootstrapped) return Task.FromResult(new OVAccessMutationResult(OVAccessMutationCode.StateChanged));
        _bootstrapped = true;
        return Task.FromResult(OVAccessMutationResult.Success);
    }
    private Task<OVAccessMutationResult> RecoveryAsync()
    {
        _recovered = true;
        return Task.FromResult(OVAccessMutationResult.Success);
    }
    private Task RefreshAfterChange() => InvokeAsync(StateHasChanged);
}
