<section class="ov-page ov-page--list">
    <header class="ov-page__header">
        <div class="ov-page__heading">
            <h1>@Title</h1>
            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <p>@Description</p>
            }
        </div>
        @if (Actions is not null)
        {
            <div class="ov-page__actions" role="toolbar" aria-label="@($"{Title} page actions")">@Actions</div>
        }
    </header>

    @if (Summary is not null)
    {
        <div class="ov-list-page__summary">@Summary</div>
    }

    @if (Toolbar is not null || ToolbarActions is not null)
    {
        <div class="ov-list-page__toolbar">
            <div class="ov-list-page__toolbar-content">@Toolbar</div>
            @if (ToolbarActions is not null)
            {
                <div class="ov-list-page__toolbar-actions" role="toolbar" aria-label="@($"{Title} list actions")">@ToolbarActions</div>
            }
        </div>
    }

    <div class="ov-list-page__results">@ChildContent</div>

    @if (Pagination is not null)
    {
        <div class="ov-list-page__pagination">@Pagination</div>
    }
</section>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? Summary { get; set; }
    [Parameter] public RenderFragment? Toolbar { get; set; }
    [Parameter] public RenderFragment? ToolbarActions { get; set; }
    [Parameter] public RenderFragment? Pagination { get; set; }
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;
}
