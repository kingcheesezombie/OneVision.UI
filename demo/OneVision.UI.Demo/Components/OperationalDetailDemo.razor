<OVOperationalDetail Title="Example operational resource"
                     Description="Managed resource with live status and overlay-based configuration editing"
                     PrimaryAction="@PrimaryActionContent"
                     EditAction="@EditActionContent"
                     OverflowActions="@OverflowActionsContent"
                     HealthSummary="@HealthSummaryContent"
                     LatestEvent="@LatestEventContent"
                     ProcessStages="@ProcessStagesContent"
                     RecentActivity="@RecentActivityContent">
    <Status>
        <OVPill Text="Healthy" Role="OVPillRole.Status" Tone="OVPillTone.Success" />
    </Status>
    <EnabledControl>
        <OVToggle Label="Enabled" Value="@_enabled" ValueChanged="OnEnabledChanged" />
    </EnabledControl>
    <Alerts>
        <OVAlert Tone="OVAlertTone.Information">Configuration editing belongs in an overlay; this surface remains predominantly read-only.</OVAlert>
    </Alerts>
    <Metadata>
        <div class="ov-demo-detail-grid">
            <OVKeyValue Label="Type" Value="Managed resource" />
            <OVKeyValue Label="Owner" Value="Application supplied" />
            <OVKeyValue Label="Created" Value="18/10/2026 09:30" />
            <OVKeyValue Label="Reference" Value="OPS-001" />
        </div>
    </Metadata>
</OVOperationalDetail>

@code {
    [Parameter] public string Scenario { get; set; } = "healthy";
    [Parameter] public bool ShowHealth { get; set; } = true;
    [Parameter] public bool ShowEvent { get; set; } = true;
    [Parameter] public bool ShowStages { get; set; } = true;
    [Parameter] public bool ShowActivity { get; set; } = true;
    [Parameter] public bool ShowActions { get; set; } = true;

    private RenderFragment? PrimaryActionContent => ShowActions ? @<OVButton Icon="OneVisionIcon.Run">Run</OVButton> : null;
    private RenderFragment? EditActionContent => ShowActions ? @<OVButton Appearance="OVButtonVariant.Secondary" Icon="OneVisionIcon.Edit">Edit</OVButton> : null;
    private RenderFragment? OverflowActionsContent => ShowActions ? @<OVIconButton Icon="OneVisionIcon.More" Label="More actions" /> : null;
    private RenderFragment? HealthSummaryContent => !ShowHealth ? null : @<text>
        <OVKeyValue Label="Current state" Value="Healthy" />
        <OVKeyValue Label="Last operation" Value="Completed" />
        <OVKeyValue Label="Items processed" Value="842" />
        <OVKeyValue Label="Next scheduled" Value="26/10/2026 06:00" />
    </text>;
    private RenderFragment? LatestEventContent => ShowEvent ? @<OVTimeline Items="@Events" /> : null;
    private RenderFragment? ProcessStagesContent => ShowStages ? @<OVProcessStages Stages="@Stages" /> : null;
    private RenderFragment? RecentActivityContent => ShowActivity ? @<OVList Items="@RecentActivity" /> : null;

    private bool _enabled = true;
    private string? _lastScenario;
    protected override void OnParametersSet()
    {
        if (Scenario != _lastScenario) { _lastScenario = Scenario; _enabled = Scenario != "disabled"; }
    }

    private static readonly DateTimeOffset Now = new(2026, 10, 25, 11, 0, 0, TimeSpan.Zero);

    private static readonly IReadOnlyList<OVTimelineItem> Events =
    [
        new("latest", Now.AddMinutes(-8), "Operation completed", "The latest operation completed successfully.", OVTimelineTone.Success, "842 items")
    ];

    private static readonly IReadOnlyList<OVProcessStage> Stages =
    [
        new("one", "Prepare", OVProcessStageState.Complete, "Prepare the operation", "842 items", TimeSpan.FromSeconds(3)),
        new("two", "Process", OVProcessStageState.Complete, "Apply the operation", "842 items", TimeSpan.FromSeconds(12)),
        new("three", "Publish", OVProcessStageState.Complete, "Publish the final state", Duration: TimeSpan.FromSeconds(2))
    ];

    private static readonly IReadOnlyList<OVListItem> RecentActivity =
    [
        new("a1", "Operation completed", "25/10/2026 10:52", "Success"),
        new("a2", "Configuration updated", "24/10/2026 15:14", "Complete"),
        new("a3", "Operation completed", "24/10/2026 06:02", "Success")
    ];

    private Task OnEnabledChanged(bool value) { _enabled = value; return Task.CompletedTask; }
}
