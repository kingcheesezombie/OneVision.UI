@page "/components/buttons"

<PageTitle>Buttons · OneVision.UI</PageTitle>

<h1 class="ov-gallery-page-title">Buttons</h1>
<MudText Typo="Typo.body1" Class="ov-gallery-page-intro">
    Standard action buttons exposed through <code>OVButton</code>. Applications should use these variants instead of styling MudButton directly.
</MudText>

<section class="ov-demo-section">
    <MudText Typo="Typo.h6" GutterBottom="true">Standard variants</MudText>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="ov-demo-wrap">
        <OVButton>Primary action</OVButton>
        <OVButton Variant="Variant.Outlined" Color="Color.Primary">Secondary action</OVButton>
        <OVButton Variant="Variant.Text" Color="Color.Primary">Text action</OVButton>
        <OVButton Variant="Variant.Text" Color="Color.Error">Delete</OVButton>
        <OVButton Disabled="true">Disabled</OVButton>
    </MudStack>
</section>

<section class="ov-demo-section">
    <MudText Typo="Typo.h6" GutterBottom="true">Usage</MudText>
    <pre class="ov-code"><code>&lt;OVButton&gt;Save&lt;/OVButton&gt;
&lt;OVButton Variant=&quot;Variant.Outlined&quot;&gt;Cancel&lt;/OVButton&gt;</code></pre>
</section>
