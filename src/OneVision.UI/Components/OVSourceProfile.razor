@using OneVision.UI.Iconography

<section class="@ProfileClass">
    <header class="ov-source-profile__header">
        <div>
            <h2>@Title</h2>
            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <p>@Description</p>
            }
        </div>
        @if (Status is not null)
        {
            <div class="ov-source-profile__status">@Status</div>
        }
    </header>

    <div class="ov-source-profile__definition">
        <div class="ov-source-profile__section-heading">
            <div>
                <strong>@DefinitionTitle</strong>
                @if (!string.IsNullOrWhiteSpace(ConnectionLabel))
                {
                    <span>Using @ConnectionLabel</span>
                }
            </div>
            @if (!ReadOnly)
            {
                @DefinitionActions
            }
        </div>
        <div class="ov-source-profile__definition-content">@Definition</div>
    </div>

    <div class="ov-source-profile__runbar">
        <div class="ov-source-profile__run-context">
            @if (!string.IsNullOrWhiteSpace(RunHint))
            {
                <span>@RunHint</span>
            }
        </div>
        @if (!ReadOnly)
        {
            <OVButton Icon="OneVisionIcon.Refresh"
                      Loading="@(Profiling || ProfileState == OVSourceProfileState.Running)"
                      Disabled="@Disabled"
                      OnClick="@RunRequested">@RunLabel</OVButton>
        }
    </div>

    @if (Profiling || ProfileState == OVSourceProfileState.Running)
    {
        <div class="ov-source-profile__progress">
            <OVProgress Mode="OVProgressMode.Indeterminate" Label="Profiling source…" />
        </div>
    }

    @if (ProfileState == OVSourceProfileState.Stale)
    {
        <div class="ov-source-profile__message">
            <OVAlert Tone="OVAlertTone.Warning">The source definition has changed. This profile result is retained for context only and must be refreshed before Mapping can use it.</OVAlert>
        </div>
    }
    else if (ProfileState == OVSourceProfileState.Failed && Message is null)
    {
        <div class="ov-source-profile__message">
            <OVAlert Tone="OVAlertTone.Error">Profiling did not complete successfully.</OVAlert>
        </div>
    }

    @if (Message is not null)
    {
        <div class="ov-source-profile__message">@Message</div>
    }

    <div class="ov-source-profile__result">
        <div class="ov-source-profile__section-heading">
            <div>
                <strong>@ResultTitle</strong>
                @if (!string.IsNullOrWhiteSpace(ResultSummary))
                {
                    <span>@ResultSummary</span>
                }
                @if (ProfileState == OVSourceProfileState.Stale)
                {
                    <span class="ov-source-profile__stale-label">Stale</span>
                }
            </div>
            @if (!ReadOnly)
            {
                @ResultActions
            }
        </div>
        <div class="ov-source-profile__result-content">@Profile</div>
    </div>
</section>

@code {
    [Parameter] public string Title { get; set; } = "Profile";
    [Parameter] public string? Description { get; set; } = "Define what to read from the source, run it, and inspect the discovered structure.";
    [Parameter] public string DefinitionTitle { get; set; } = "Source definition";
    [Parameter] public string ResultTitle { get; set; } = "Profiled output";
    [Parameter] public string RunLabel { get; set; } = "Run & Profile";
    [Parameter] public string? ConnectionLabel { get; set; }
    [Parameter] public string? RunHint { get; set; }
    [Parameter] public string? ResultSummary { get; set; }
    [Parameter] public bool Profiling { get; set; }
    [Parameter] public OVSourceProfileState ProfileState { get; set; } = OVSourceProfileState.Initial;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> RunRequested { get; set; }
    [Parameter] public RenderFragment? Status { get; set; }
    [Parameter] public RenderFragment? Definition { get; set; }
    [Parameter] public RenderFragment? DefinitionActions { get; set; }
    [Parameter] public RenderFragment? Message { get; set; }
    [Parameter] public RenderFragment? Profile { get; set; }
    [Parameter] public RenderFragment? ResultActions { get; set; }

    private string ProfileClass => ProfileState == OVSourceProfileState.Stale
        ? "ov-source-profile ov-source-profile--stale"
        : "ov-source-profile";
}
