@using OneVision.UI.Iconography

<div class="@RootClass">
    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <OVAlert Tone="OVAlertTone.Error">@ErrorMessage</OVAlert>
    }
    else if (Loading)
    {
        <OVProgress Mode="OVProgressMode.Indeterminate" Label="Loading rule options…" />
    }
    else
    {
        <OVTabs Items="@Tabs" ActiveKey="@EffectiveActiveTab" ActiveKeyChanged="@ChangeTab" />
    }
</div>

@code {
    [Parameter] public OVMappingRuleComposition Composition { get; set; } = OVMappingRuleComposition.AllocationContract;
    [Parameter] public string? AllocationRuleKey { get; set; }
    [Parameter] public EventCallback<string?> AllocationRuleKeyChanged { get; set; }
    [Parameter] public IReadOnlyList<OVOption<string>> AllocationRules { get; set; } = [];
    [Parameter] public OVMappingAllocationContract? AllocationContract { get; set; }
    [Parameter] public bool AllocationContractLoading { get; set; }
    [Parameter] public string? AllocationContractError { get; set; }
    [Parameter] public OVMappingRuleResolutionType ResolutionType { get; set; } = OVMappingRuleResolutionType.Direct;
    [Parameter] public EventCallback<OVMappingRuleResolutionType> ResolutionTypeChanged { get; set; }
    [Parameter] public bool ConditionsInvalid { get; set; }
    [Parameter] public string? ActiveTab { get; set; }
    [Parameter] public EventCallback<string?> ActiveTabChanged { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public EventCallback<string?> DescriptionChanged { get; set; }
    [Parameter] public int? Priority { get; set; }
    [Parameter] public EventCallback<int?> PriorityChanged { get; set; }
    [Parameter] public bool ShowPriority { get; set; }
    [Parameter] public bool ShowEnabled { get; set; } = true;
    [Parameter] public bool OverviewInvalid { get; set; }
    [Parameter] public bool RuleInvalid { get; set; }
    [Parameter] public bool TargetNamespaceInvalid { get; set; }
    [Parameter] public OVMappingRuleCapabilityState SourceState { get; set; } = OVMappingRuleCapabilityState.Enabled;
    [Parameter] public OVMappingRuleCapabilityState OutputsState { get; set; } = OVMappingRuleCapabilityState.Enabled;
    [Parameter] public OVMappingRuleCapabilityState TargetNamespaceState { get; set; } = OVMappingRuleCapabilityState.Unavailable;
    [Parameter] public RenderFragment? OutputsContent { get; set; }
    [Parameter] public RenderFragment? TargetNamespaceContent { get; set; }
    [Parameter] public IReadOnlyList<OVOption<string>> TargetProviderOptions { get; set; } = [];
    [Parameter] public IReadOnlyList<OVOption<string>> TargetSourceOptions { get; set; } = [];
    [Parameter] public IReadOnlyList<OVOption<string>> TargetTypeOptions { get; set; } = [];
    [Parameter] public IReadOnlyList<OVOption<string>> TargetIdentifierOptions { get; set; } = [];
    [Parameter] public string? TargetProvider { get; set; }
    [Parameter] public string? TargetSource { get; set; }
    [Parameter] public string? TargetType { get; set; }
    [Parameter] public string? TargetIdentifier { get; set; }
    [Parameter] public EventCallback<string?> TargetProviderChanged { get; set; }
    [Parameter] public EventCallback<string?> TargetSourceChanged { get; set; }
    [Parameter] public EventCallback<string?> TargetTypeChanged { get; set; }
    [Parameter] public EventCallback<string?> TargetIdentifierChanged { get; set; }
    [Parameter] public bool TargetNamespaceLoading { get; set; }
    [Parameter] public string? TargetNamespaceError { get; set; }
    [Parameter] public string? RuleName { get; set; }
    [Parameter] public EventCallback<string?> RuleNameChanged { get; set; }
    [Parameter] public bool Enabled { get; set; } = true;
    [Parameter] public EventCallback<bool> EnabledChanged { get; set; }
    [Parameter, EditorRequired] public OVMappingRuleGroup RootGroup { get; set; } = new("root", OVMappingRuleJoin.And, Array.Empty<OVMappingRuleCondition>());
    [Parameter] public IReadOnlyList<OVOption<string>> Operands { get; set; } = [];
    [Parameter] public IReadOnlyList<OVOption<string>> Operators { get; set; } = [];
    [Parameter] public IReadOnlyList<OVMappingRuleFieldDefinition> FieldDefinitions { get; set; } = [];
    [Parameter] public IReadOnlyList<OVMappingRuleOperatorDefinition>? OperatorDefinitions { get; set; }
    [Parameter] public IReadOnlyList<OVOption<string>> OutcomeOptions { get; set; } = [];
    [Parameter] public string? OutcomeKey { get; set; }
    [Parameter] public EventCallback<string?> OutcomeKeyChanged { get; set; }
    [Parameter] public RenderFragment? OutcomeContent { get; set; }
    [Parameter] public RenderFragment? SourceScopeContent { get; set; }
    [Parameter] public bool ShowClassification { get; set; } = true;
    [Parameter] public bool ShowTargetResolution { get; set; } = true;
    [Parameter] public RenderFragment? ClassificationContent { get; set; }
    [Parameter] public RenderFragment? TargetResolutionContent { get; set; }
    [Parameter] public bool AllowNestedGroups { get; set; }
    [Parameter] public bool AllowConditionDisabling { get; set; }
    [Parameter] public bool AllowReordering { get; set; }
    [Parameter] public bool AllowFieldComparison { get; set; }
    [Parameter] public IReadOnlyCollection<string> FieldComparisonOperatorKeys { get; set; } = [];
    [Parameter] public IReadOnlyList<OVOption<string>> ComparisonFields { get; set; } = [];
    [Parameter] public bool ShowCasePolicy { get; set; }
    [Parameter] public OVMappingRuleCasePolicy CasePolicy { get; set; } = OVMappingRuleCasePolicy.ApplicationDefault;
    [Parameter] public EventCallback<OVMappingRuleCasePolicy> CasePolicyChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public EventCallback<OVMappingRuleConditionChange> ConditionChanged { get; set; }
    [Parameter] public EventCallback<OVMappingRuleConditionMoveRequest> ConditionMoveRequested { get; set; }
    [Parameter] public EventCallback<OVMappingRuleConditionRequest> AddConditionRequested { get; set; }
    [Parameter] public EventCallback<OVMappingRuleConditionRequest> RemoveConditionRequested { get; set; }
    [Parameter] public EventCallback<OVMappingRuleGroupRequest> AddGroupRequested { get; set; }
    [Parameter] public EventCallback<OVMappingRuleGroupRequest> RemoveGroupRequested { get; set; }
    [Parameter] public EventCallback<OVMappingRuleGroupJoinChange> GroupJoinChanged { get; set; }
    [Parameter] public RenderFragment? TestInputContent { get; set; }
    [Parameter] public Func<Task<OVMappingRuleTestResult>>? TestRuleAsync { get; set; }
    [Parameter] public string? TestContextKey { get; set; }
    [Parameter] public string? Class { get; set; }

    private static readonly IReadOnlyList<OVOption<OVMappingRuleCasePolicy>> CaseOptions =
    [
        new(OVMappingRuleCasePolicy.ApplicationDefault, "Application default"),
        new(OVMappingRuleCasePolicy.CaseSensitive, "Case sensitive"),
        new(OVMappingRuleCasePolicy.CaseInsensitive, "Case insensitive")
    ];

    private string? _lastExternalTab;
    private OVMappingRuleGroup? _lastGroup;
    private string? _lastContext;
    private int _testGeneration;
    private bool _testRunning;
    private string? _testError;
    private OVMappingRuleTestResult? _testResult;

    protected override void OnParametersSet()
    {
        if (ActiveTab is not null && !string.Equals(_lastExternalTab, ActiveTab, StringComparison.Ordinal))
        {
            _internalTab = ActiveTab;
            _lastExternalTab = ActiveTab;
        }
        if (!ReferenceEquals(_lastGroup, RootGroup) || !string.Equals(_lastContext, TestContextKey, StringComparison.Ordinal))
        {
            _lastGroup = RootGroup;
            _lastContext = TestContextKey;
            _testGeneration++;
            _testResult = null;
            _testError = null;
            // An in-flight evaluation belongs to the previous rule/context.
            // Allow a new evaluation immediately; its generation guards stale results.
            _testRunning = false;
        }
    }

    private async Task RunTest(MouseEventArgs _)
    {
        if (TestRuleAsync is null || _testRunning)
            return;

        var generation = ++_testGeneration;
        _testError = null;
        _testResult = null;
        _testRunning = true;

        try
        {
            var result = await TestRuleAsync();
            if (generation == _testGeneration)
                _testResult = result;
        }
        catch
        {
            if (generation == _testGeneration)
                _testError = "Rule evaluation could not be completed.";
        }
        finally
        {
            if (generation == _testGeneration)
                _testRunning = false;
        }
    }


    private bool IsVisible(OVMappingRuleCapabilityState state) =>
        state is not OVMappingRuleCapabilityState.Unavailable and not OVMappingRuleCapabilityState.Hidden;
    private bool CanEdit(OVMappingRuleCapabilityState state) =>
        !ReadOnly && state == OVMappingRuleCapabilityState.Enabled;
    private bool HasOutputs => OutputsContent is not null
        || (ShowClassification && ClassificationContent is not null)
        || (ShowTargetResolution && TargetResolutionContent is not null)
        || OutcomeContent is not null;
    private bool ShowNamespace => IsVisible(TargetNamespaceState);
    private bool NamespaceEditable => CanEdit(TargetNamespaceState);
    private string _internalTab = "overview";
    private string SelectedTab => ActiveTabChanged.HasDelegate ? ActiveTab ?? _internalTab : _internalTab;
    private string EffectiveActiveTab => Composition == OVMappingRuleComposition.AllocationContract
        ? SelectedTab is "overview" or "rule" or "conditions" ? SelectedTab : "overview"
        : SelectedTab == "target-namespace" && !ShowNamespace ? "rule"
        : SelectedTab is "overview" or "rule" or "target-namespace" ? SelectedTab : "overview";

    private IReadOnlyList<OVTabItem> Tabs => Composition == OVMappingRuleComposition.AllocationContract
        ? [
            new("overview", OverviewInvalid ? "Overview •" : "Overview", AllocationOverviewTab),
            new("rule", RuleInvalid || AllocationContract is { IsValid: false } || !string.IsNullOrEmpty(AllocationContractError)
                ? "Rule •" : "Rule", AllocationRuleTab),
            new("conditions", ConditionsInvalid ? "Conditions •" : "Conditions", AllocationConditionsTab)
          ]
        : new List<OVTabItem>
          {
              new("overview", OverviewInvalid ? "Overview •" : "Overview", OverviewTab),
              new("rule", RuleInvalid ? "Rule •" : "Rule", RuleTab)
          }.Concat(ShowNamespace
              ? [new OVTabItem("target-namespace", (TargetNamespaceInvalid || !string.IsNullOrWhiteSpace(TargetNamespaceError)) ? "Target Namespace •" : "Target Namespace", NamespaceTab)]
              : Array.Empty<OVTabItem>()).ToArray();

    private Task ChangeTab(string? tab)
    {
        _internalTab = tab ?? "overview";
        return ActiveTabChanged.HasDelegate ? ActiveTabChanged.InvokeAsync(tab) : Task.CompletedTask;
    }


    private static readonly IReadOnlyList<OVOption<OVMappingRuleResolutionType>> ResolutionTypeOptions =
    [
        new(OVMappingRuleResolutionType.Direct, "Direct"),
        new(OVMappingRuleResolutionType.Associated, "Associated")
    ];

    private RenderFragment AllocationOverviewTab => @<div class="ov-mapping-rule__overview" aria-label="Rule overview">
        <OVTextField Label="Name" Value="@RuleName" ValueChanged="@RuleNameChanged" ReadOnly="@ReadOnly" Required="true" />
        <OVTextArea Label="Description" Value="@Description" ValueChanged="@DescriptionChanged" ReadOnly="@ReadOnly" Lines="3" />
        @if (ShowEnabled)
        {
            <OVToggle Label="Enabled" Value="@Enabled" ValueChanged="@EnabledChanged" Disabled="@ReadOnly" />
        }
    </div>;

    private RenderFragment AllocationRuleTab => @<div class="ov-mapping-rule__sections" aria-label="Allocation matching rule">
        <section class="ov-mapping-rule__section" aria-label="Allocation Rule">
            <header class="ov-mapping-rule__section-header"><div><h3>Allocation Rule</h3><p>Inherited allocation eligibility and source-to-target contract.</p></div></header>
            <div class="ov-mapping-rule__section-content">
                <OVSelect T="string" Label="Allocation Rule" Value="@AllocationRuleKey"
                          ValueChanged="@AllocationRuleKeyChanged" Options="@AllocationRules"
                          Disabled="@(ReadOnly || AllocationContractLoading)" />
                @if (AllocationContractLoading)
                {
                    <OVProgress Mode="OVProgressMode.Indeterminate" Label="Loading allocation contract…" />
                }
                @if (!string.IsNullOrWhiteSpace(AllocationContractError))
                {
                    <OVAlert Tone="OVAlertTone.Error">@AllocationContractError</OVAlert>
                }
                @if (AllocationContract is { } contract)
                {
                    @if (!contract.Enabled || !contract.IsValid)
                    {
                        <OVAlert Tone="OVAlertTone.Warning">@(contract.ValidationMessage ?? "The inherited allocation contract is unavailable or no longer eligible.")</OVAlert>
                    }
                    <div class="ov-mapping-rule__contract" aria-label="Inherited allocation contract">
                        <div class="ov-mapping-rule__contract-side">
                            <strong>Source Entity</strong>
                            <dl><dt>Class</dt><dd>@contract.SourceClass</dd><dt>Type</dt><dd>@contract.SourceType</dd><dt>Source</dt><dd>@contract.Source</dd></dl>
                        </div>
                        <div class="ov-mapping-rule__contract-side">
                            <strong>Target</strong>
                            <dl><dt>Provider</dt><dd>@contract.TargetProvider</dd><dt>Type</dt><dd>@contract.TargetType</dd></dl>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(contract.Revision))
                    {
                        <small>Contract revision: @contract.Revision</small>
                    }
                }
                else if (!AllocationContractLoading)
                {
                    <OVEmptyState Title="No allocation contract" Description="Select an available Allocation Rule. The application supplies its read-only source and target relationship." />
                }
            </div>
        </section>
        <section class="ov-mapping-rule__section" aria-label="Outcome">
            <header class="ov-mapping-rule__section-header"><div><h3>Outcome</h3><p>How an eligible matching result will be processed.</p></div></header>
            <div class="ov-mapping-rule__section-content">
                <OVSelect T="string" Label="Outcome" Value="@OutcomeKey" ValueChanged="@OutcomeKeyChanged"
                          Options="@EffectiveMatchingOutcomes" Disabled="@ReadOnly" />
            </div>
        </section>
        <section class="ov-mapping-rule__section" aria-label="Type">
            <header class="ov-mapping-rule__section-header"><div><h3>Type</h3><p>Choose how the target's comparison evidence is obtained.</p></div></header>
            <div class="ov-mapping-rule__section-content">
                <OVSelect T="OVMappingRuleResolutionType" Label="Type" Value="@ResolutionType" ValueChanged="@ResolutionTypeChanged"
                          Options="@ResolutionTypeOptions" Disabled="@ReadOnly" />
                <p class="ov-mapping-rule__resolution-guidance">@(ResolutionType == OVMappingRuleResolutionType.Direct
                    ? "Compare against values and Standard Details held directly by the target."
                    : "Compare against application-supplied Standard Details associated with the target through approved allocations.")</p>
            </div>
        </section>
    </div>;

    private static readonly IReadOnlyList<OVOption<string>> MatchingOutcomes =
    [
        new("AUTO", "Auto"),
        new("POTENTIAL", "Potential")
    ];
    private IReadOnlyList<OVOption<string>> EffectiveMatchingOutcomes =>
        OutcomeOptions.Count > 0 ? OutcomeOptions : MatchingOutcomes;

    private RenderFragment AllocationConditionsTab => @<div class="ov-mapping-rule__sections" aria-label="Matching conditions">
        <section class="ov-mapping-rule__section" aria-label="Conditions">
            <header class="ov-mapping-rule__section-header"><h3>Conditions</h3><p>Define when the rule qualifies, using grouped comparisons.</p></header>
            <div class="ov-mapping-rule__section-content">
                @if (ShowCasePolicy)
                {
                    <div class="ov-mapping-rule__case-policy">
                        <OVSelect T="OVMappingRuleCasePolicy" Label="Text comparison"
                                  Value="@CasePolicy" ValueChanged="@CasePolicyChanged"
                                  Options="@CaseOptions" Disabled="@ReadOnly" />
                    </div>
                }
                @if (RootGroup.Conditions.Count == 0 && RootGroup.Groups.Count == 0)
                {
                    <OVEmptyState Title="No conditions configured" Description="Add a condition to define when this rule applies.">
                        <Action>
                            @if (!ReadOnly)
                            {
                                <OVButton Icon="OneVisionIcon.Add" OnClick="@(_ => AddConditionRequested.InvokeAsync(new OVMappingRuleConditionRequest(RootGroup.Key)))">Add condition</OVButton>
                            }
                        </Action>
                    </OVEmptyState>
                }
                else
                {
                    <OVMappingRuleGroupEditor Group="@RootGroup"
                                              Operands="@Operands"
                                              Operators="@Operators"
                                              FieldDefinitions="@FieldDefinitions"
                                              OperatorDefinitions="@OperatorDefinitions"
                                              ReadOnly="@ReadOnly"
                                              AllowNestedGroups="@AllowNestedGroups"
                                              AllowConditionDisabling="@AllowConditionDisabling"
                                              AllowReordering="@AllowReordering"
                                              AllowFieldComparison="@AllowFieldComparison"
                                              FieldComparisonOperatorKeys="@FieldComparisonOperatorKeys"
                                              ComparisonFields="@ComparisonFields"
                                              ConditionChanged="@ConditionChanged"
                                              ConditionMoveRequested="@ConditionMoveRequested"
                                              AddConditionRequested="@AddConditionRequested"
                                              RemoveConditionRequested="@RemoveConditionRequested"
                                              AddGroupRequested="@AddGroupRequested"
                                              RemoveGroupRequested="@RemoveGroupRequested"
                                              GroupJoinChanged="@GroupJoinChanged" />
                }
            </div>
        </section>
        @if (TestRuleAsync is not null)
        {
            <section class="ov-mapping-rule__test" aria-label="Test rule">
                <div class="ov-mapping-rule__test-head">
                    <h3 class="ov-mapping-rule__section-title">Test rule</h3>
                    <OVButton Appearance="OVButtonVariant.Secondary" Icon="OneVisionIcon.Run"
                              Loading="@_testRunning" OnClick="RunTest">Test rule</OVButton>
                </div>
                @if (TestInputContent is not null)
                {
                    <div class="ov-mapping-rule__test-input">@TestInputContent</div>
                }
                @if (_testRunning)
                {
                    <OVProgress Mode="OVProgressMode.Indeterminate" Label="Evaluating rule…" />
                }
                @if (!string.IsNullOrEmpty(_testError))
                {
                    <OVAlert Tone="OVAlertTone.Error">@_testError</OVAlert>
                }
                @if (_testResult is { } result)
                {
                    <div class="ov-mapping-rule__test-result" role="status" aria-live="polite">
                        <OVAlert Tone="@(result.ErrorMessage is not null ? OVAlertTone.Error : result.Ambiguous ? OVAlertTone.Warning : result.Matched ? OVAlertTone.Success : OVAlertTone.Information)">
                            @(result.ErrorMessage ?? (result.Ambiguous ? "Ambiguous outcome — review required." : result.Matched ? "Rule matched." : "Rule did not match."))
                        </OVAlert>
                        <div class="ov-mapping-rule__test-context"><strong>Input:</strong> @result.Input</div>
                        @if (!string.IsNullOrWhiteSpace(result.Outcome))
                        {
                            <div class="ov-mapping-rule__test-context"><strong>Proposed outcome:</strong> @result.Outcome</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(result.Target))
                        {
                            <div class="ov-mapping-rule__test-context"><strong>Target:</strong> @result.Target</div>
                        }
                        @if (result.ResolutionType is { } resolvedType)
                        {
                            <div class="ov-mapping-rule__test-context"><strong>Resolution:</strong> @resolvedType</div>
                        }
                        @if (result.DistinctTargetCount is { } count)
                        {
                            <div class="ov-mapping-rule__test-context"><strong>Distinct targets:</strong> @count</div>
                        }
                        @if (result.Eligibility is { } eligibility)
                        {
                            <div class="ov-mapping-rule__test-context"><strong>Condition match:</strong> @(eligibility.ConditionMatched ? "Yes" : "No")</div>
                            <div class="ov-mapping-rule__test-context"><strong>Allocation eligible:</strong> @(eligibility.AllocationEligible ? "Yes" : "No")</div>
                            <div class="ov-mapping-rule__test-context"><strong>Automatic processing eligible:</strong> @(eligibility.AutomaticProcessingEligible ? "Yes" : "No")</div>
                            @if (!string.IsNullOrWhiteSpace(eligibility.Explanation))
                            {
                                <div class="ov-mapping-rule__test-context">@eligibility.Explanation</div>
                            }
                        }
                        @if (result.Evidence is { Count: > 0 } evidence)
                        {
                            <table class="ov-mapping-rule__evidence">
                                <caption>Matching evidence</caption>
                                <thead><tr><th>Field</th><th>Value</th><th>Origin entity</th><th>Approved allocation</th></tr></thead>
                                <tbody>
                                    @foreach (var item in evidence)
                                    {
                                        <tr><td>@item.Field</td><td>@item.Value</td><td>@item.OriginEntity</td><td>@item.AllocationReference</td></tr>
                                    }
                                </tbody>
                            </table>
                        }
                        @if (result.Conditions.Count > 0)
                        {
                            <ul class="ov-mapping-rule__test-conditions">
                                @foreach (var condition in result.Conditions)
                                {
                                    <li @key="condition.Key">
                                        <span>@(condition.Skipped ? "Skipped" : condition.Matched ? "Matched" : "Not matched")</span>
                                        <span>@condition.Description</span>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                }
            </section>
        }

    </div>;

    private RenderFragment OverviewTab => @<div class="ov-mapping-rule__overview" aria-label="Rule overview">
        <OVTextField Label="Name" Value="@RuleName" ValueChanged="@RuleNameChanged" ReadOnly="@ReadOnly" />
        <OVTextArea Label="Description" Value="@Description" ValueChanged="@DescriptionChanged" ReadOnly="@ReadOnly" Lines="3" />
        <div class="ov-mapping-rule__overview-options">
            @if (OutcomeOptions.Count > 0)
            {
                <OVSelect T="string" Label="Rule Outcome" Value="@OutcomeKey" ValueChanged="@OutcomeKeyChanged"
                          Options="@OutcomeOptions" Disabled="@ReadOnly" />
            }
            @if (ShowPriority)
            {
                <OVNumberField T="int?" Label="Priority" Value="@Priority" ValueChanged="@PriorityChanged" ReadOnly="@ReadOnly" />
            }
            @if (ShowEnabled)
            {
                <OVToggle Label="Enabled" Value="@Enabled" ValueChanged="@EnabledChanged" Disabled="@ReadOnly" />
            }
        </div>
    </div>;

    private RenderFragment RuleTab => @<div class="ov-mapping-rule__sections" aria-label="Rule definition">
        @if (SourceScopeContent is not null && IsVisible(SourceState))
        {
            <section class="ov-mapping-rule__section" aria-label="Source">
                <header class="ov-mapping-rule__section-header">
                    <div><h3>Source</h3><p>Choose the incoming records this rule evaluates.</p></div>
                    @if (SourceState is OVMappingRuleCapabilityState.ReadOnly or OVMappingRuleCapabilityState.Disabled)
                    {
                        <span class="ov-mapping-rule__capability-status" data-capability-state="@SourceState.ToString().ToLowerInvariant()">@SourceState</span>
                    }
                </header>
                <fieldset class="ov-mapping-rule__section-content ov-mapping-rule__capability-fields" disabled="@(!CanEdit(SourceState))" aria-readonly="@(SourceState == OVMappingRuleCapabilityState.ReadOnly)">
                    @SourceScopeContent
                </fieldset>
            </section>
        }
        @if (HasOutputs && IsVisible(OutputsState))
        {
            <section class="ov-mapping-rule__section" aria-label="Outputs">
                <header class="ov-mapping-rule__section-header">
                    <div><h3>Outputs</h3><p>Values produced when this rule matches.</p></div>
                    @if (OutputsState is OVMappingRuleCapabilityState.ReadOnly or OVMappingRuleCapabilityState.Disabled)
                    {
                        <span class="ov-mapping-rule__capability-status" data-capability-state="@OutputsState.ToString().ToLowerInvariant()">@OutputsState</span>
                    }
                </header>
                <fieldset class="ov-mapping-rule__section-content ov-mapping-rule__outputs ov-mapping-rule__capability-fields" disabled="@(!CanEdit(OutputsState))" aria-readonly="@(OutputsState == OVMappingRuleCapabilityState.ReadOnly)">
                    @if (ShowClassification && ClassificationContent is not null)
                    {
                        @ClassificationContent
                    }
                    @if (ShowTargetResolution && TargetResolutionContent is not null)
                    {
                        @TargetResolutionContent
                    }
                    @OutputsContent
                    @OutcomeContent
                </fieldset>
            </section>
        }
        <section class="ov-mapping-rule__section" aria-label="Conditions">
            <header class="ov-mapping-rule__section-header"><h3>Conditions</h3><p>Define when the rule qualifies, using grouped comparisons.</p></header>
            <div class="ov-mapping-rule__section-content">
                @if (ShowCasePolicy)
                {
                    <div class="ov-mapping-rule__case-policy">
                        <OVSelect T="OVMappingRuleCasePolicy" Label="Text comparison"
                                  Value="@CasePolicy" ValueChanged="@CasePolicyChanged"
                                  Options="@CaseOptions" Disabled="@ReadOnly" />
                    </div>
                }
                @if (RootGroup.Conditions.Count == 0 && RootGroup.Groups.Count == 0)
                {
                    <OVEmptyState Title="No conditions configured" Description="Add a condition to define when this rule applies.">
                        <Action>
                            @if (!ReadOnly)
                            {
                                <OVButton Icon="OneVisionIcon.Add" OnClick="@(_ => AddConditionRequested.InvokeAsync(new OVMappingRuleConditionRequest(RootGroup.Key)))">Add condition</OVButton>
                            }
                        </Action>
                    </OVEmptyState>
                }
                else
                {
                    <OVMappingRuleGroupEditor Group="@RootGroup"
                                              Operands="@Operands"
                                              Operators="@Operators"
                                              FieldDefinitions="@FieldDefinitions"
                                              OperatorDefinitions="@OperatorDefinitions"
                                              ReadOnly="@ReadOnly"
                                              AllowNestedGroups="@AllowNestedGroups"
                                              AllowConditionDisabling="@AllowConditionDisabling"
                                              AllowReordering="@AllowReordering"
                                              AllowFieldComparison="@AllowFieldComparison"
                                              FieldComparisonOperatorKeys="@FieldComparisonOperatorKeys"
                                              ComparisonFields="@ComparisonFields"
                                              ConditionChanged="@ConditionChanged"
                                              ConditionMoveRequested="@ConditionMoveRequested"
                                              AddConditionRequested="@AddConditionRequested"
                                              RemoveConditionRequested="@RemoveConditionRequested"
                                              AddGroupRequested="@AddGroupRequested"
                                              RemoveGroupRequested="@RemoveGroupRequested"
                                              GroupJoinChanged="@GroupJoinChanged" />
                }
            </div>
        </section>
        @if (TestRuleAsync is not null)
        {
            <section class="ov-mapping-rule__test" aria-label="Test rule">
                <div class="ov-mapping-rule__test-head">
                    <h3 class="ov-mapping-rule__section-title">Test rule</h3>
                    <OVButton Appearance="OVButtonVariant.Secondary" Icon="OneVisionIcon.Run"
                              Loading="@_testRunning" OnClick="RunTest">Test rule</OVButton>
                </div>
                @if (TestInputContent is not null)
                {
                    <div class="ov-mapping-rule__test-input">@TestInputContent</div>
                }
                @if (_testRunning)
                {
                    <OVProgress Mode="OVProgressMode.Indeterminate" Label="Evaluating rule…" />
                }
                @if (!string.IsNullOrEmpty(_testError))
                {
                    <OVAlert Tone="OVAlertTone.Error">@_testError</OVAlert>
                }
                @if (_testResult is { } result)
                {
                    <div class="ov-mapping-rule__test-result" role="status" aria-live="polite">
                        <OVAlert Tone="@(result.ErrorMessage is not null ? OVAlertTone.Error : result.Ambiguous ? OVAlertTone.Warning : result.Matched ? OVAlertTone.Success : OVAlertTone.Information)">
                            @(result.ErrorMessage ?? (result.Ambiguous ? "Ambiguous outcome — review required." : result.Matched ? "Rule matched." : "Rule did not match."))
                        </OVAlert>
                        <div class="ov-mapping-rule__test-context"><strong>Input:</strong> @result.Input</div>
                        @if (!string.IsNullOrWhiteSpace(result.Outcome))
                        {
                            <div class="ov-mapping-rule__test-context"><strong>Proposed outcome:</strong> @result.Outcome</div>
                        }
                        @if (result.Conditions.Count > 0)
                        {
                            <ul class="ov-mapping-rule__test-conditions">
                                @foreach (var condition in result.Conditions)
                                {
                                    <li @key="condition.Key">
                                        <span>@(condition.Skipped ? "Skipped" : condition.Matched ? "Matched" : "Not matched")</span>
                                        <span>@condition.Description</span>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                }
            </section>
        }
    </div>;

    private RenderFragment NamespaceTab => @<div class="ov-mapping-rule__sections" aria-label="Target namespace configuration">
        <section class="ov-mapping-rule__section" aria-label="Target Namespace">
            <header class="ov-mapping-rule__section-header">
                <div><h3>Target Namespace</h3><p>Configure the namespace for subsequent target identification. No resolution is performed here.</p></div>
                @if (TargetNamespaceState is OVMappingRuleCapabilityState.ReadOnly or OVMappingRuleCapabilityState.Disabled)
                {
                    <span class="ov-mapping-rule__capability-status" data-capability-state="@TargetNamespaceState.ToString().ToLowerInvariant()">@TargetNamespaceState</span>
                }
            </header>
            <div class="ov-mapping-rule__section-content">
                @if (TargetNamespaceLoading)
                {
                    <OVProgress Mode="OVProgressMode.Indeterminate" Label="Loading namespace options…" />
                }
                @if (!string.IsNullOrWhiteSpace(TargetNamespaceError))
                {
                    <OVAlert Tone="OVAlertTone.Error">@TargetNamespaceError</OVAlert>
                }
                <div class="ov-mapping-rule__namespace-fields">
                    @if (TargetProviderOptions.Count > 0)
                    {
                        <OVSelect T="string" Label="Target Provider" Value="@TargetProvider" ValueChanged="@TargetProviderChanged"
                                  Options="@TargetProviderOptions" Disabled="@(!NamespaceEditable || TargetNamespaceLoading)" />
                    }
                    @if (TargetSourceOptions.Count > 0)
                    {
                        <OVSelect T="string" Label="Target Source" Value="@TargetSource" ValueChanged="@TargetSourceChanged"
                                  Options="@TargetSourceOptions" Disabled="@(!NamespaceEditable || TargetNamespaceLoading)" />
                    }
                    @if (TargetTypeOptions.Count > 0)
                    {
                        <OVSelect T="string" Label="Target Type" Value="@TargetType" ValueChanged="@TargetTypeChanged"
                                  Options="@TargetTypeOptions" Disabled="@(!NamespaceEditable || TargetNamespaceLoading)" />
                    }
                    @if (TargetIdentifierOptions.Count > 0)
                    {
                        <OVSelect T="string" Label="Target Identifier Mapping" Value="@TargetIdentifier" ValueChanged="@TargetIdentifierChanged"
                                  Options="@TargetIdentifierOptions" Disabled="@(!NamespaceEditable || TargetNamespaceLoading)" />
                    }
                </div>
                @TargetNamespaceContent
                @if (TargetProviderOptions.Count == 0 && TargetSourceOptions.Count == 0 && TargetTypeOptions.Count == 0
                    && TargetIdentifierOptions.Count == 0 && TargetNamespaceContent is null && !TargetNamespaceLoading)
                {
                    <OVEmptyState Title="Namespace not configured" Description="No target namespace controls have been supplied." />
                }
            </div>
        </section>
    </div>;

    private string RootClass => string.IsNullOrWhiteSpace(Class) ? "ov-mapping-rule" : $"ov-mapping-rule {Class}";
}
