@using OneVision.UI.Demo

@switch (Definition.Reference)
{
    case "OVC-PILL":
        @PillPreview
        break;

    case "OVC-DATA-GRID":
        <div>
            <div class="ov-demo-table-wrap">
                <table class="ov-demo-table">
                    <thead><tr><th><input type="checkbox" disabled="@(State == "Read-only")" /></th><th>Name</th><th>Status</th><th>Updated</th><th></th></tr></thead>
                    <tbody>
                        @if (State == "Loading")
                        {
                            <tr><td colspan="5"><OVProgress Mode="OVProgressMode.Indeterminate" Label="Loading results…" /></td></tr>
                        }
                        else if (State == "Empty")
                        {
                            <tr><td colspan="5"><OVEmptyState Title="No records" Description="There are no records in this result set." /></td></tr>
                        }
                        else
                        {
                            <tr><td><input type="checkbox" disabled="@(State == "Read-only")" /></td><td>Example A</td><td><OVPill Text="Current" Role="OVPillRole.Status" Tone="OVPillTone.Success" /></td><td>24/10/2026</td><td><OVIconButton Icon="OneVisionIcon.More" Label="More actions" Disabled="@(State == "Read-only")" /></td></tr>
                            <tr><td><input type="checkbox" disabled="@(State == "Read-only")" /></td><td>Example B</td><td><OVPill Text="Scheduled" Role="OVPillRole.Status" Tone="OVPillTone.Info" /></td><td>23/10/2026</td><td><OVIconButton Icon="OneVisionIcon.More" Label="More actions" Disabled="@(State == "Read-only")" /></td></tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="ov-demo-pagination"><span>1–2 of 25</span><OVIconButton Icon="OneVisionIcon.ChevronLeft" Label="Previous page" Disabled="true" /><OVIconButton Icon="OneVisionIcon.ChevronRight" Label="Next page" /></div>
        </div>
        break;

    case "OVC-PAGINATION":
        <div class="ov-demo-pagination"><span>@PageRange</span><OVIconButton Icon="OneVisionIcon.ChevronLeft" Label="Previous page" Disabled="@(_page <= 1)" OnClick="@(_ => PreviousPage())" /><span class="ov-demo-page-active">@_page</span><OVIconButton Icon="OneVisionIcon.ChevronRight" Label="Next page" Disabled="@(State == "Single page")" OnClick="@(_ => NextPage())" /></div>
        break;

    case "OVC-SORTABLE-HEADER":
        <table class="ov-demo-table"><thead><tr><th><button class="ov-demo-sort-header" type="button" disabled="@(State == "Disabled")" @onclick="ToggleSort">Name <span>@SortGlyph</span></button></th><th>Status</th></tr></thead><tbody><tr><td>@(_sortAscending ? "Alpha" : "Zulu")</td><td>Current</td></tr><tr><td>@(_sortAscending ? "Zulu" : "Alpha")</td><td>Current</td></tr></tbody></table>
        break;

    case "OVC-EMPTY-STATE":
        <OVEmptyState Title="@EmptyTitle" Description="@EmptyDescription" Icon="@EmptyIcon">
            <Action>
                @if (State == "No results")
                {
                    <OVButton Appearance="OVButtonVariant.Secondary">Clear filters</OVButton>
                }
                else if (State == "First use")
                {
                    <OVButton>Create item</OVButton>
                }
            </Action>
        </OVEmptyState>
        break;

    case "OVC-TABS":
        <div class="ov-demo-tabs">@foreach (var tab in new[] { "Overview", "Configuration", "History" }) { <button type="button" disabled="@(State == "Disabled" && tab == "History")" class="@(tab == _activeTab ? "ov-demo-tab ov-demo-tab--active" : "ov-demo-tab")" @onclick="() => _activeTab = tab">@tab</button> }</div>
        @if (State == "Overflow") { <div class="ov-pattern-demo__muted mt-2">Additional peer views move into the governed overflow treatment rather than shrinking labels.</div> }
        break;

    case "OVC-BREADCRUMB":
        <nav class="ov-demo-breadcrumb" aria-label="Breadcrumb"><a href="#">Settings</a><span>›</span>@if (State == "Long path") { <button type="button" class="ov-demo-breadcrumb-overflow" aria-label="More ancestors">…</button><span>›</span> }<a href="#">Connections</a><span>›</span><span aria-current="page">SQL Warehouse</span></nav>
        break;

    case "OVC-SIDE-NAV":
        <nav class="ov-demo-side-nav" aria-label="Workspace navigation">
            <button type="button" class="@(SideClass("General"))" @onclick="() => _sideNav = "General"">General</button>
            <button type="button" class="@(SideClass("Integrations"))" @onclick="() => _sideNav = "Integrations"">Integrations</button>
            <button type="button" class="ov-demo-side-nav__group" @onclick="() => _settingsOpen = !_settingsOpen"><span>@(_settingsOpen ? "▾" : "▸")</span><span>Advanced</span></button>
            @if (_settingsOpen || State != "Collapsed group")
            {
                <div class="ov-demo-side-nav__children">
                    <button type="button" class="@(SideClass("API"))" @onclick="() => _sideNav = "API"">API</button>
                    <button type="button" class="@(SideClass("Security"))" disabled="@(State == "Disabled item")" @onclick="() => _sideNav = "Security"">Security</button>
                </div>
            }
        </nav>
        break;

    case "OVC-TREE":
        <OVTree Nodes="@TreeNodes"
                SelectionMode="@TreeMode"
                Searchable="true"
                ReadOnly="@(State == "Read-only")"
                SelectedKeys="@_treeSelectedKeys"
                SelectedKeysChanged="OnTreeSelectionChanged"
                FocusedKey="@_treeFocusedKey"
                FocusedKeyChanged="OnTreeFocusChanged" />
        <OVSelectionSummary Items="@TreeSelectionLabels" MaxVisibleItems="3" />
        break;

    default:
        <MudAlert Severity="Severity.Warning">No status/data/navigation demo is registered for @Definition.Reference.</MudAlert>
        break;
}

@code {
    [Parameter, EditorRequired] public ComponentDefinition Definition { get; set; } = default!;
    [Parameter] public string State { get; set; } = "Default";

    private int _page = 2;
    private bool _sortAscending = true;
    private string _activeTab = "Overview";
    private string _sideNav = "General";
    private bool _settingsOpen = true;
    private IReadOnlyCollection<string> _treeSelectedKeys = new[] { "team-north" };
    private string? _treeFocusedKey = "community-nursing";

    private static readonly IReadOnlyList<OVTreeNode> TreeNodes =
    [
        new("organisation", "Organisation",
        [
            new("clinical-services", "Clinical Services",
            [
                new("community-nursing", "Community Nursing"),
                new("therapies", "Therapies"),
                new("teams", "Teams",
                [
                    new("team-north", "Team North"),
                    new("team-south", "Team South"),
                    new("archived-service", "Archived Service", disabled: true)
                ])
            ])
        ])
    ];

    private RenderFragment PillPreview => builder =>
    {
        var seq = 0;
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "ov-component-demo-row ov-demo-wrap");
        switch (State)
        {
            case "Type":
                AddPill(builder, ref seq, "ASSET", OVPillRole.Type, OVPillTone.Neutral);
                AddPill(builder, ref seq, "ATTRIBUTE", OVPillRole.Type, OVPillTone.Neutral);
                break;
            case "Source":
                AddPill(builder, ref seq, "EAM", OVPillRole.Source, OVPillTone.Info);
                AddPill(builder, ref seq, "IDM", OVPillRole.Source, OVPillTone.Info);
                AddPill(builder, ref seq, "HDM", OVPillRole.Source, OVPillTone.Info);
                break;
            case "Filter":
                builder.OpenComponent<OVPill>(seq++); builder.AddAttribute(seq++, "Text", "Status: Current"); builder.AddAttribute(seq++, "Role", OVPillRole.Filter); builder.AddAttribute(seq++, "Removable", true); builder.CloseComponent();
                builder.OpenComponent<OVPill>(seq++); builder.AddAttribute(seq++, "Text", "Business Area: North"); builder.AddAttribute(seq++, "Role", OVPillRole.Filter); builder.AddAttribute(seq++, "Locked", true); builder.CloseComponent();
                break;
            case "Count":
                AddPill(builder, ref seq, "12", OVPillRole.Count, OVPillTone.Info);
                AddPill(builder, ref seq, "999+", OVPillRole.Count, OVPillTone.Info);
                break;
            default:
                AddPill(builder, ref seq, "Current", OVPillRole.Status, OVPillTone.Success);
                AddPill(builder, ref seq, "Scheduled", OVPillRole.Status, OVPillTone.Info);
                AddPill(builder, ref seq, "Warning", OVPillRole.Status, OVPillTone.Warning);
                AddPill(builder, ref seq, "Failed", OVPillRole.Status, OVPillTone.Danger);
                break;
        }
        builder.CloseElement();
    };

    private static void AddPill(RenderTreeBuilder builder, ref int seq, string text, OVPillRole role, OVPillTone tone)
    {
        builder.OpenComponent<OVPill>(seq++);
        builder.AddAttribute(seq++, "Text", text);
        builder.AddAttribute(seq++, "Role", role);
        builder.AddAttribute(seq++, "Tone", tone);
        builder.CloseComponent();
    }

    private string PageRange => State == "Single page" ? "1–8 of 8" : $"{((_page - 1) * 25) + 1}–{_page * 25} of 118";
    private string SortGlyph => State == "Unsorted" ? "↕" : _sortAscending ? "↑" : "↓";
    private void PreviousPage() { if (_page > 1) _page--; }
    private void NextPage() => _page++;
    private void ToggleSort() => _sortAscending = !_sortAscending;

    private string SideClass(string item) => item == _sideNav ? "ov-demo-side-nav__item ov-demo-side-nav__item--active" : "ov-demo-side-nav__item";

    private OVTreeSelectionMode TreeMode => State switch
    {
        "Single" => OVTreeSelectionMode.Single,
        "Multiple" => OVTreeSelectionMode.Multiple,
        "LeafOnly" => OVTreeSelectionMode.LeafOnly,
        _ => OVTreeSelectionMode.MultipleHierarchical
    };

    private IReadOnlyList<string> TreeSelectionLabels => Flatten(TreeNodes).Where(node => _treeSelectedKeys.Contains(node.Key)).Select(node => node.Label).ToArray();
    private Task OnTreeSelectionChanged(IReadOnlyCollection<string> keys) { _treeSelectedKeys = keys; return Task.CompletedTask; }
    private Task OnTreeFocusChanged(string? key) { _treeFocusedKey = key; return Task.CompletedTask; }

    private static IEnumerable<OVTreeNode> Flatten(IEnumerable<OVTreeNode> nodes)
    {
        foreach (var node in nodes)
        {
            yield return node;
            foreach (var child in Flatten(node.Children)) yield return child;
        }
    }

    private string EmptyTitle => State switch
    {
        "No results" => "No matching results",
        "No data" => "No data available",
        "Permission limited" => "Nothing available in your scope",
        _ => "Nothing here yet"
    };

    private string EmptyDescription => State switch
    {
        "No results" => "Try changing or clearing the current search and filters.",
        "No data" => "The current context contains no records.",
        "Permission limited" => "Your current permissions do not expose any items here.",
        _ => "Create the first item to get started."
    };

    private OneVisionIcon EmptyIcon => State == "No results" ? OneVisionIcon.Search : OneVisionIcon.Information;
}
