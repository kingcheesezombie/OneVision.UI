<section class="@RootClass" aria-label="Allocation">
    @if (Loading)
    {
        <OVProgress Mode="OVProgressMode.Indeterminate" Label="Loading allocation…" />
    }
    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <OVAlert Tone="OVAlertTone.Error">@ErrorMessage</OVAlert>
    }
    else
    {
        <header class="ov-allocation__page-header">
            <h1>@Title</h1>
            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <p>@Description</p>
            }
        </header>

        <section class="ov-allocation__section" aria-label="Target">
            <header class="ov-allocation__section-header">
                <h2>Target entity</h2>
            </header>

            @if (FindTarget && !TargetSelected)
            {
                <div class="ov-allocation__section-body">
                    @if (TargetPlatformChoices.Count > 1)
                    {
                        <div class="ov-allocation__field">
                            <div class="ov-allocation__field-label">Target platform</div>
                            <div class="ov-allocation__platforms" role="group" aria-label="Target platform">
                                @foreach (var platform in TargetPlatformChoices)
                                {
                                    <button type="button"
                                            class="@PlatformClass(platform)"
                                            aria-pressed="@(TargetPlatform == platform)"
                                            disabled="@ReadOnly"
                                            @onclick="() => OnTargetPlatformChanged(platform)">
                                        @PlatformLabel(platform)
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    @if (TargetPlatform == OVAllocationTargetPlatform.Eam && TargetType is not null)
                    {
                        <div class="ov-allocation__field">
                            <div class="ov-allocation__field-label">Target type</div>
                            @TargetType
                        </div>
                    }
                    @if (TargetSearch is not null)
                    {
                        <div class="ov-allocation__field ov-allocation__search">
                            <div class="ov-allocation__field-label">Find target</div>
                            @TargetSearch
                        </div>
                    }
                    @if (TargetResults is not null)
                    {
                        <div class="ov-allocation__results" aria-label="Target results">
                            @TargetResults
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="ov-allocation__identity-row">
                    <div class="ov-allocation__target-summary">
                        @(FindTarget ? SelectedTarget : Target)
                    </div>
                    @if (FindTarget && ChangeTargetRequested.HasDelegate && !ReadOnly)
                    {
                        <button type="button" class="ov-allocation__change" @onclick="RequestTargetChange">Change</button>
                    }
                </div>
            }
        </section>

        <section class="ov-allocation__section ov-allocation__source" aria-label="Source">
            <header class="ov-allocation__section-header">
                <h2>Source entity</h2>
            </header>
            <div class="ov-allocation__section-body">
                @if (SourceSystem is not null || !string.IsNullOrWhiteSpace(FixedSourceSystem)
                    || SourceType is not null || !string.IsNullOrWhiteSpace(FixedSourceType))
                {
                    <div class="ov-allocation__source-criteria">
                        @if (SourceSystem is not null || !string.IsNullOrWhiteSpace(FixedSourceSystem))
                        {
                            <div class="ov-allocation__field">
                                <div class="ov-allocation__field-label">Source system</div>
                                @if (!string.IsNullOrWhiteSpace(FixedSourceSystem))
                                {
                                    <span class="ov-allocation__fixed-value">@FixedSourceSystem</span>
                                }
                                else
                                {
                                    @SourceSystem
                                }
                            </div>
                        }
                        @if (SourceType is not null || !string.IsNullOrWhiteSpace(FixedSourceType))
                        {
                            <div class="ov-allocation__field">
                                <div class="ov-allocation__field-label">Source type</div>
                                @if (!string.IsNullOrWhiteSpace(FixedSourceType))
                                {
                                    <span class="ov-allocation__fixed-value">@FixedSourceType</span>
                                }
                                else
                                {
                                    @SourceType
                                }
                            </div>
                        }
                    </div>
                }

                <div class="ov-allocation__field ov-allocation__search">
                    <div class="ov-allocation__field-label">Find source</div>
                    @SourceSearch
                </div>

                @if (SourceSelected && SelectedSource is not null)
                {
                    <div class="ov-allocation__selected-source" aria-label="Selected source">
                        <div class="ov-allocation__selected-source-content">
                            <div class="ov-allocation__field-label">Selected source</div>
                            @SelectedSource
                        </div>
                        @if (ChangeSourceRequested.HasDelegate && !ReadOnly)
                        {
                            <button type="button" class="ov-allocation__change" @onclick="RequestSourceChange">Change</button>
                        }
                    </div>
                }
                else if (SourceResults is not null)
                {
                    <div class="ov-allocation__results" aria-label="Source results">
                        @SourceResults
                    </div>
                }
            </div>
        </section>

        <section class="ov-allocation__section ov-allocation__effective" aria-label="Effective dates">
            <header class="ov-allocation__section-header">
                <h2>Effective dates</h2>
            </header>
            <div class="ov-allocation__section-body">
                <div class="ov-allocation__always-row">
                    <div>
                        <div class="ov-allocation__always-label">Always belonged</div>
                        <p>No explicit start or end date required.</p>
                    </div>
                    <OVToggle Value="@AlwaysBelonged"
                              ValueChanged="@AlwaysBelongedChanged"
                              Label="Always belonged"
                              Disabled="@ReadOnly"
                              ReadOnly="@ReadOnly"
                              Class="ov-allocation__always-toggle" />
                </div>

                @if (!AlwaysBelonged)
                {
                    <div class="ov-allocation__dates">
                        <OVDatePicker Label="Effective from"
                                      Value="@FromDate"
                                      ValueChanged="@FromDateChanged"
                                      Disabled="@ReadOnly"
                                      ReadOnly="@ReadOnly"
                                      Required="true" />
                        <OVDatePicker Label="Effective to"
                                      Value="@ToDate"
                                      ValueChanged="@ToDateChanged"
                                      Disabled="@ReadOnly"
                                      ReadOnly="@ReadOnly" />
                    </div>
                    <p class="ov-allocation__date-help">A start date is required; an end date is optional.</p>
                }
            </div>
        </section>

        @if (ValidationSummary is not null)
        {
            <div class="ov-allocation__validation">@ValidationSummary</div>
        }
        @if (Actions is not null)
        {
            <footer class="ov-allocation__footer">@Actions</footer>
        }
    }
</section>

@code {
    [Parameter] public string Title { get; set; } = "Allocation";
    [Parameter] public string? Description { get; set; } = "Create an allocation from a selected source to this target.";

    [Parameter] public bool FindTarget { get; set; }
    [Parameter] public bool TargetSelected { get; set; }
    [Parameter] public OVAllocationTargetPlatform TargetPlatform { get; set; } = OVAllocationTargetPlatform.Eam;
    [Parameter] public IReadOnlyList<OVAllocationTargetPlatform>? AvailableTargetPlatforms { get; set; }
    [Parameter] public EventCallback<OVAllocationTargetPlatform> TargetPlatformChanged { get; set; }
    [Parameter] public EventCallback ChangeTargetRequested { get; set; }
    [Parameter] public RenderFragment? TargetType { get; set; }
    [Parameter] public RenderFragment? TargetSearch { get; set; }
    [Parameter] public RenderFragment? TargetResults { get; set; }
    [Parameter] public RenderFragment? SelectedTarget { get; set; }
    [Parameter] public RenderFragment? Target { get; set; }

    [Parameter] public RenderFragment? SourceSystem { get; set; }
    [Parameter] public string? FixedSourceSystem { get; set; }
    [Parameter] public RenderFragment? SourceType { get; set; }
    [Parameter] public string? FixedSourceType { get; set; }
    [Parameter, EditorRequired] public RenderFragment SourceSearch { get; set; } = default!;
    [Parameter, EditorRequired] public RenderFragment SourceResults { get; set; } = default!;
    [Parameter] public bool SourceSelected { get; set; }
    [Parameter] public RenderFragment? SelectedSource { get; set; }
    [Parameter] public EventCallback ChangeSourceRequested { get; set; }

    [Parameter] public bool AlwaysBelonged { get; set; } = true;
    [Parameter] public EventCallback<bool> AlwaysBelongedChanged { get; set; }
    [Parameter] public DateTime? FromDate { get; set; }
    [Parameter] public EventCallback<DateTime?> FromDateChanged { get; set; }
    [Parameter] public DateTime? ToDate { get; set; }
    [Parameter] public EventCallback<DateTime?> ToDateChanged { get; set; }

    [Parameter] public RenderFragment? ValidationSummary { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public string? Class { get; set; }

    private string RootClass => string.IsNullOrWhiteSpace(Class) ? "ov-allocation" : $"ov-allocation {Class}";
    private IReadOnlyList<OVAllocationTargetPlatform> TargetPlatformChoices
        => AvailableTargetPlatforms ?? Enum.GetValues<OVAllocationTargetPlatform>();

    private static string PlatformLabel(OVAllocationTargetPlatform platform) => platform switch
    {
        OVAllocationTargetPlatform.Eam => "EAM",
        OVAllocationTargetPlatform.Odm => "ODM",
        OVAllocationTargetPlatform.Idm => "IDM",
        _ => platform.ToString().ToUpperInvariant()
    };

    private string PlatformClass(OVAllocationTargetPlatform platform)
        => TargetPlatform == platform
            ? "ov-allocation__platform ov-allocation__platform--selected"
            : "ov-allocation__platform";

    private Task OnTargetPlatformChanged(OVAllocationTargetPlatform platform)
    {
        if (ReadOnly || TargetPlatform == platform || !TargetPlatformChoices.Contains(platform))
            return Task.CompletedTask;

        return TargetPlatformChanged.InvokeAsync(platform);
    }

    private Task RequestTargetChange()
        => ReadOnly ? Task.CompletedTask : ChangeTargetRequested.InvokeAsync();

    private Task RequestSourceChange()
        => ReadOnly ? Task.CompletedTask : ChangeSourceRequested.InvokeAsync();
}
