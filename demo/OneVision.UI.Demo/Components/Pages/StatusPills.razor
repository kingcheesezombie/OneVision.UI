@page "/components/status-pills"

<PageTitle>Status pills · OneVision.UI</PageTitle>

<h1 class="ov-gallery-page-title">Status pills</h1>
<MudText Typo="Typo.body1" Class="ov-gallery-page-intro">
    Compact status treatment exposed through <code>OVStatusPill</code>.
</MudText>

<section class="ov-demo-section">
    <MudText Typo="Typo.h6" GutterBottom="true">Tones</MudText>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="ov-demo-wrap">
        <OVStatusPill Text="Current" Tone="OVStatusPill.OVStatusTone.Success" />
        <OVStatusPill Text="Scheduled" Tone="OVStatusPill.OVStatusTone.Info" />
        <OVStatusPill Text="Pending" Tone="OVStatusPill.OVStatusTone.Warning" />
        <OVStatusPill Text="Ended" />
        <OVStatusPill Text="Failed" Tone="OVStatusPill.OVStatusTone.Danger" />
    </MudStack>
</section>

<section class="ov-demo-section">
    <MudText Typo="Typo.h6" GutterBottom="true">Usage</MudText>
    <pre class="ov-code"><code>&lt;OVStatusPill Text=&quot;Current&quot; Tone=&quot;OVStatusPill.OVStatusTone.Success&quot; /&gt;</code></pre>
</section>
