@using OneVision.UI.Iconography

<section class="ov-source-configuration" aria-busy="@(Saving ? "true" : null)">
    @if (!EmbeddedInOverlay)
    <header class="ov-source-configuration__header">
        <div class="ov-source-configuration__heading">
            <h1>@Title</h1>
            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <p>@Description</p>
            }
        </div>
        <div class="ov-source-configuration__header-actions">
            @if (Status is not null)
            {
                @Status
            }
            @HeaderActions
        </div>
    </header>

    @if (EmbeddedInOverlay && (Status is not null || HeaderActions is not null))
    {
        <div class="ov-source-configuration__header-actions ov-source-configuration__embedded-actions">
            @Status
            @HeaderActions
        </div>
    }

    <div class="ov-source-configuration__tabs">
        <OVTabs Items="@Tabs" ActiveKey="@EffectiveActiveSection" ActiveKeyChanged="@ActiveSectionChanged" />
    </div>

    @if (ValidationSummary is not null)
    {
        <div class="ov-source-configuration__validation">@ValidationSummary</div>
    }

    @if (!string.IsNullOrWhiteSpace(SaveErrorMessage))
    {
        <div class="ov-source-configuration__validation" role="alert">
            <OVAlert Tone="OVAlertTone.Error">@SaveErrorMessage</OVAlert>
        </div>
    }

    @if (EmbeddedInOverlay && Saving)
    {
        <div class="ov-source-configuration__saving" role="status"><OVProgress Mode="OVProgressMode.Indeterminate" Label="Saving source…" /></div>
    }

    @if (!EmbeddedInOverlay && FooterActions is not null)
    {
        <footer class="ov-source-configuration__footer">
            @if (Saving)
            {
                <OVProgress Mode="OVProgressMode.Indeterminate" Label="Saving…" />
            }
            <div class="ov-source-configuration__footer-actions">@FooterActions</div>
        </footer>
    }
</section>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? ActiveSection { get; set; } = "overview";
    [Parameter] public EventCallback<string?> ActiveSectionChanged { get; set; }
    [Parameter] public OVSourceConnectionMode ConnectionMode { get; set; } = OVSourceConnectionMode.ManagedConnection;
    [Parameter] public string NoConnectionTitle { get; set; } = "No managed connection required";
    [Parameter] public string NoConnectionDescription { get; set; } = "This source is configured directly in Profile.";
    [Parameter] public OVSourceProfileState ProfileState { get; set; } = OVSourceProfileState.Initial;
    [Parameter] public RenderFragment? Status { get; set; }
    [Parameter] public RenderFragment? HeaderActions { get; set; }
    [Parameter] public RenderFragment? Overview { get; set; }
    [Parameter] public RenderFragment? Connection { get; set; }
    [Parameter] public RenderFragment? Profile { get; set; }
    [Parameter] public RenderFragment? Mapping { get; set; }
    [Parameter] public bool DisplayValueBuilderEnabled { get; set; }
    [Parameter] public IReadOnlyList<OVDisplayValueTargetOption> DisplayValueTargets { get; set; } = Array.Empty<OVDisplayValueTargetOption>();
    [Parameter] public OVDisplayValueDefinition? DisplayValueDefinition { get; set; }
    [Parameter] public EventCallback<OVDisplayValueDefinition?> DisplayValueDefinitionChanged { get; set; }
    [Parameter] public bool DisplayValueReadOnly { get; set; }
    [Parameter] public bool DisplayValueAllowLiteralOnly { get; set; }
    [Parameter] public RenderFragment? ValidationSummary { get; set; }
    [Parameter] public RenderFragment? FooterActions { get; set; }
    [Parameter] public bool Saving { get; set; }
    [Parameter] public bool EmbeddedInOverlay { get; set; }
    [Parameter] public bool MappingRequiresCurrentProfile { get; set; }
    [Parameter] public string? SaveErrorMessage { get; set; }

    private string? EffectiveActiveSection => ActiveSection == "display-value" && !DisplayValueBuilderEnabled ? "mapping" : ActiveSection;

    private IReadOnlyList<OVTabItem> Tabs
    {
        get
        {
            var tabs = new List<OVTabItem>
            {
                new("overview", "Overview", Overview ?? EmptyFragment),
                new("connection", "Connection", ConnectionContent),
                new("profile", "Profile", Profile ?? EmptyFragment),
                new("mapping", "Mapping", MappingContent)
            };

            if (DisplayValueBuilderEnabled)
                tabs.Add(new("display-value", "Display Value", DisplayValueContent));

            return tabs;
        }
    }

    private RenderFragment ConnectionContent => ConnectionMode == OVSourceConnectionMode.NoConnectionRequired
        ? NoConnectionRequiredContent
        : Connection ?? EmptyFragment;

    private RenderFragment MappingContent => ProfileState == OVSourceProfileState.Stale
        ? StaleMappingContent
        : MappingRequiresCurrentProfile && ProfileState != OVSourceProfileState.Current
            ? UnavailableMappingContent
            : Mapping ?? EmptyFragment;

    private RenderFragment UnavailableMappingContent => @<OVEmptyState
        Title="Mapping requires a current profile"
        Description="Complete profiling before mapping source fields to target meanings." />;

    private RenderFragment DisplayValueContent => ProfileState switch
    {
        OVSourceProfileState.Current => ActiveDisplayValueContent,
        OVSourceProfileState.Stale => StaleDisplayValueContent,
        _ => UnavailableDisplayValueContent
    };

    private RenderFragment NoConnectionRequiredContent => @<div class="ov-source-configuration__no-connection" role="status">
        <div class="ov-source-configuration__no-connection-icon" aria-hidden="true">
            <OVIcon Name="OneVisionIcon.Success" />
        </div>
        <div>
            <strong>@NoConnectionTitle</strong>
            <p>@NoConnectionDescription</p>
        </div>
    </div>;

    private RenderFragment ActiveDisplayValueContent => @<OVDisplayValueBuilder Targets="@DisplayValueTargets"
        Value="@DisplayValueDefinition"
        ValueChanged="@DisplayValueDefinitionChanged"
        ReadOnly="@DisplayValueReadOnly"
        AllowLiteralOnly="@DisplayValueAllowLiteralOnly" />;

    private RenderFragment StaleDisplayValueContent => @<div class="ov-source-configuration__display-value-state">
        <OVAlert Tone="OVAlertTone.Warning">The source definition has changed since it was last profiled. Run &amp; Profile again, then confirm Mapping before editing Display Value.</OVAlert>
        @if (DisplayValueDefinition is not null)
        {
            <OVDisplayValueBuilder Targets="@DisplayValueTargets"
                                   Value="@DisplayValueDefinition"
                                   ValueChanged="@DisplayValueDefinitionChanged"
                                   ReadOnly="true"
                                   AllowLiteralOnly="@DisplayValueAllowLiteralOnly" />
        }
    </div>;

    private RenderFragment UnavailableDisplayValueContent => @<div class="ov-source-configuration__display-value-state">
        <OVEmptyState Title="Display Value is not available yet"
                      Description="Complete a current profile and Mapping first. Display Value only uses successfully mapped target fields." />
    </div>;

    private RenderFragment StaleMappingContent => @<div class="ov-source-configuration__stale-mapping" role="status">
        <OVAlert Tone="OVAlertTone.Warning">
            The source definition has changed since it was last profiled. Run &amp; Profile again before using the discovered structure for Mapping.
        </OVAlert>
    </div>;

    private static RenderFragment EmptyFragment => builder => { };
}
