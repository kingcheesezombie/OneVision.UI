@using OneVision.UI.Iconography

<div class="@EmptyClass" role="status">
    <OVIcon Name="@Icon" Class="ov-empty-state__icon" />
    <div class="ov-empty-state__copy">
        <h3>@Title</h3>
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <p>@Description</p>
        }
    </div>
    @if (Action is not null)
    {
        <div class="ov-empty-state__action">@Action</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public OneVisionIcon Icon { get; set; } = OneVisionIcon.Information;
    [Parameter] public RenderFragment? Action { get; set; }
    [Parameter] public string? Class { get; set; }

    private string EmptyClass => string.IsNullOrWhiteSpace(Class) ? "ov-empty-state" : $"ov-empty-state {Class}";
}
