@using OneVision.UI.Demo

@{
    var definition = PatternPreviewDefinitions.For(PatternKey);
}

<MudPaper Class="ov-pattern-demo" Elevation="0">
    <div class="ov-pattern-demo__header">
        <div>
            <MudText Typo="Typo.h6">@definition.Title</MudText>
            <MudText Typo="Typo.caption">@(string.IsNullOrWhiteSpace(ScopeName) ? "Full pattern" : ScopeName) · @Reference</MudText>
        </div>
        <OVStatusPill Text="Draft" Tone="OVStatusPill.OVStatusTone.Info" />
    </div>

    @switch (definition.Kind)
    {
        case PatternPreviewKind.List:
            @RenderList(definition)
            break;
        case PatternPreviewKind.Workspace:
            @RenderWorkspace(definition)
            break;
        case PatternPreviewKind.Wizard:
            @RenderWizard(definition)
            break;
        case PatternPreviewKind.Tree:
            @RenderTree(definition)
            break;
        case PatternPreviewKind.Overlay:
            @RenderOverlay(definition)
            break;
        case PatternPreviewKind.Builder:
            @RenderBuilder(definition)
            break;
        case PatternPreviewKind.Review:
            @RenderReview(definition)
            break;
        case PatternPreviewKind.Status:
            @RenderStatus(definition)
            break;
        case PatternPreviewKind.Detail:
            @RenderDetail(definition)
            break;
        case PatternPreviewKind.Picker:
            @RenderPicker(definition)
            break;
        case PatternPreviewKind.Api:
            @RenderApi(definition)
            break;
        case PatternPreviewKind.Empty:
            @RenderEmpty(definition)
            break;
        default:
            @RenderForm(definition)
            break;
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public string PatternKey { get; set; } = string.Empty;
    [Parameter] public string ScopeName { get; set; } = string.Empty;
    [Parameter] public string Reference { get; set; } = string.Empty;

    private string? _activeView;
    private string? _selectedItem;
    private string? _selectedBuilderItem;
    private int _selectedTreeIndex;
    private readonly HashSet<int> _pickerSelection = [0];
    private string _search = string.Empty;
    private string? _lastPatternKey;

    protected override void OnParametersSet()
    {
        if (string.Equals(_lastPatternKey, PatternKey, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        var definition = PatternPreviewDefinitions.For(PatternKey);
        _activeView = definition.Items.FirstOrDefault();
        _selectedItem = definition.Items.FirstOrDefault();
        _selectedBuilderItem = definition.Items.FirstOrDefault();
        _selectedTreeIndex = 0;
        _pickerSelection.Clear();
        if (definition.Items.Length > 0)
        {
            _pickerSelection.Add(0);
        }
        _search = string.Empty;
        _lastPatternKey = PatternKey;
    }

    private RenderFragment RenderForm(PatternPreviewDefinition d) => @<div class="ov-pattern-demo__body">
        <MudText Typo="Typo.body2" Class="ov-pattern-demo__summary">@d.Summary</MudText>
        @RenderTabs(d)
        @RenderActiveStateReference(d)
        <div class="ov-demo-form-grid">
            @foreach (var field in ActiveFields(d))
            {
                <MudTextField Value="@SampleValue(field)" Label="@field" Variant="Variant.Outlined" Margin="Margin.Dense" />
            }
        </div>
        @if (PatternKey == "schedule-editor" && _activeView == "Timing")
        {
            <div class="ov-demo-preview-box">Timing mode drives the One-off / Recurring conditional pane. Open the Timing scope to exercise those nested states independently.</div>
        }
        @RenderFooter(d)
    </div>;

    private RenderFragment RenderList(PatternPreviewDefinition d) => @<div class="ov-pattern-demo__body">
        <MudText Typo="Typo.body2" Class="ov-pattern-demo__summary">@d.Summary</MudText>
        <div class="ov-demo-toolbar">
            <MudTextField @bind-Value="_search" Immediate="true" Placeholder="Search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <OVButton Variant="Variant.Outlined">Filter</OVButton>
            <MudSpacer />
            <OVButton>@d.PrimaryAction</OVButton>
        </div>
        <div class="ov-demo-table-wrap">
            <table class="ov-demo-table">
                <thead><tr><th>Name</th><th>Status</th><th>Updated</th><th></th></tr></thead>
                <tbody>
                    @foreach (var item in FilteredItems(d))
                    {
                        <tr class="@(item == _selectedItem ? "ov-demo-table-row--selected" : null)" @onclick="() => _selectedItem = item">
                            <td>@item</td><td><OVStatusPill Text="Current" Tone="OVStatusPill.OVStatusTone.Success" /></td><td>24/10/2026</td><td>⋯</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="ov-demo-pagination"><span>@FilteredItems(d).Length result(s)</span><span>‹ 1 ›</span></div>
    </div>;

    private RenderFragment RenderWorkspace(PatternPreviewDefinition d) => @<div class="ov-pattern-demo__body">
        <MudText Typo="Typo.body2" Class="ov-pattern-demo__summary">@d.Summary</MudText>
        <div class="ov-demo-workspace">
            <div class="ov-demo-workspace__list">
                <MudTextField @bind-Value="_search" Immediate="true" Placeholder="Search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense" />
                @foreach (var item in FilteredItems(d))
                {
                    <button type="button" class="@(item == _selectedItem ? "ov-demo-list-row ov-demo-list-row--selected" : "ov-demo-list-row")" @onclick="() => _selectedItem = item">@item</button>
                }
            </div>
            <div class="ov-demo-workspace__detail">
                <MudText Typo="Typo.subtitle1">@d.AsideTitle · @(_selectedItem ?? "None selected")</MudText>
                <div class="ov-demo-form-grid">
                    @foreach (var field in d.Fields)
                    {
                        <MudTextField Value="@SampleValue(field)" Label="@field" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    }
                </div>
                @RenderFooter(d)
            </div>
        </div>
    </div>;

    private RenderFragment RenderWizard(PatternPreviewDefinition d) => @<div class="ov-pattern-demo__body">
        <MudText Typo="Typo.body2" Class="ov-pattern-demo__summary">@d.Summary</MudText>
        <div class="ov-demo-steps">
            @for (var i = 0; i < d.Items.Length; i++)
            {
                var step = d.Items[i];
                <button type="button" class="@(step == _activeView ? "ov-demo-step ov-demo-step--active" : "ov-demo-step")" @onclick="() => _activeView = step"><span>@(i + 1)</span>@step</button>
            }
        </div>
        @RenderActiveStateReference(d)
        <div class="ov-demo-form-grid">
            @foreach (var field in ActiveFields(d))
            {
                <MudTextField Value="@SampleValue(field)" Label="@field" Variant="Variant.Outlined" Margin="Margin.Dense" />
            }
        </div>
        <div class="ov-demo-preview-box">@(_activeView ?? "Current step") preview / validation output</div>
        @RenderFooter(d)
    </div>;

    private RenderFragment RenderTree(PatternPreviewDefinition d) => @<div class="ov-pattern-demo__body">
        <MudText Typo="Typo.body2" Class="ov-pattern-demo__summary">@d.Summary</MudText>
        <div class="ov-demo-toolbar">
            <MudTextField @bind-Value="_search" Immediate="true" Placeholder="Search tree" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudSpacer />
            <OVButton>@d.PrimaryAction</OVButton>
        </div>
        <div class="ov-demo-tree-layout">
            <div class="ov-demo-tree">
                @for (var i = 0; i < d.Items.Length; i++)
                {
                    var index = i;
                    var item = d.Items[i];
                    if (MatchesSearch(item))
                    {
                        <button type="button" class="@(index == _selectedTreeIndex ? "ov-demo-tree-node ov-demo-tree-node--selected" : "ov-demo-tree-node")" style="padding-left:@(index * 14)px" @onclick="() => _selectedTreeIndex = index"><span>▾</span><span>@item</span></button>
                    }
                }
            </div>
            <div class="ov-demo-inspector">
                <MudText Typo="Typo.subtitle1">@d.AsideTitle · @SelectedTreeItem(d)</MudText>
                @foreach (var field in d.Fields)
                {
                    <MudTextField Value="@SampleValue(field)" Label="@field" Variant="Variant.Outlined" Margin="Margin.Dense" />
                }
                <OVButton Variant="Variant.Outlined">@d.SecondaryAction</OVButton>
            </div>
        </div>
    </div>;

    private RenderFragment RenderOverlay(PatternPreviewDefinition d) => @<div class="ov-pattern-demo__body ov-pattern-demo__body--overlay">
        <MudText Typo="Typo.body2" Class="ov-pattern-demo__summary">@d.Summary</MudText>
        <div class="ov-demo-modal">
            <div class="ov-demo-modal__header"><strong>@d.Title</strong><span>×</span></div>
            @RenderTabs(d)
            <div class="ov-demo-modal__content">
                @RenderActiveStateReference(d)
                <div class="ov-demo-form-grid">
                    @foreach (var field in ActiveFields(d))
                    {
                        <MudTextField Value="@SampleValue(field)" Label="@field" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    }
                </div>
            </div>
            <div class="ov-demo-modal__footer"><OVButton Variant="Variant.Text">@d.SecondaryAction</OVButton><OVButton>@d.PrimaryAction</OVButton></div>
        </div>
    </div>;

    private RenderFragment RenderBuilder(PatternPreviewDefinition d) => @<div class="ov-pattern-demo__body">
        <MudText Typo="Typo.body2" Class="ov-pattern-demo__summary">@d.Summary</MudText>
        <div class="ov-demo-toolbar"><OVButton Variant="Variant.Outlined">Add</OVButton><OVButton Variant="Variant.Outlined">Validate</OVButton><MudSpacer /><OVButton>@d.PrimaryAction</OVButton></div>
        <div class="ov-demo-builder">
            <div class="ov-demo-builder__palette">
                <strong>Available</strong>
                @foreach (var item in d.Items)
                {
                    <button type="button" class="@(item == _selectedBuilderItem ? "ov-demo-palette-item ov-demo-palette-item--selected" : "ov-demo-palette-item")" @onclick="() => _selectedBuilderItem = item">@item</button>
                }
            </div>
            <div class="ov-demo-builder__canvas">
                <button type="button" class="ov-demo-canvas-node" @onclick="() => _selectedBuilderItem = "Source"">Source</button>
                <div class="ov-demo-canvas-arrow">→</div>
                <button type="button" class="ov-demo-canvas-node ov-demo-canvas-node--selected" @onclick="() => _selectedBuilderItem = "Transform"">Transform</button>
                <div class="ov-demo-canvas-arrow">→</div>
                <button type="button" class="ov-demo-canvas-node" @onclick="() => _selectedBuilderItem = "Output"">Output</button>
            </div>
            <div class="ov-demo-builder__inspector">
                <strong>@d.AsideTitle · @(_selectedBuilderItem ?? "Selection")</strong>
                @foreach (var field in d.Fields)
                {
                    <MudTextField Value="@SampleValue(field)" Label="@field" Variant="Variant.Outlined" Margin="Margin.Dense" />
                }
            </div>
        </div>
    </div>;

    private RenderFragment RenderReview(PatternPreviewDefinition d) => @<div class="ov-pattern-demo__body">
        <MudText Typo="Typo.body2" Class="ov-pattern-demo__summary">@d.Summary</MudText>
        <div class="ov-demo-metrics">
            @foreach (var item in d.Items)
            {
                <button type="button" class="@(item == _selectedItem ? "ov-demo-metric ov-demo-metric--selected" : "ov-demo-metric")" @onclick="() => _selectedItem = item"><span>@item</span><strong>@MetricValue(item)</strong></button>
            }
        </div>
        <div class="ov-demo-review-panel">
            <MudText Typo="Typo.subtitle1">Review details · @(_selectedItem ?? "Summary")</MudText>
            @foreach (var field in d.Fields) { <div class="ov-demo-keyvalue"><span>@field</span><strong>@SampleValue(field)</strong></div> }
        </div>
        @RenderFooter(d)
    </div>;

    private RenderFragment RenderStatus(PatternPreviewDefinition d) => @<div class="ov-pattern-demo__body">
        <MudText Typo="Typo.body2" Class="ov-pattern-demo__summary">@d.Summary</MudText>
        <div class="ov-demo-health">
            @for (var i = 0; i < d.Items.Length; i++)
            {
                <div class="ov-demo-health-row"><span class="ov-demo-health-dot"></span><span>@d.Items[i]</span><strong>@(i == d.Items.Length - 1 ? "Current" : "Passed")</strong></div>
            }
        </div>
        <div class="ov-demo-progress"><div style="width:78%"></div></div>
        @RenderFooter(d)
    </div>;

    private RenderFragment RenderDetail(PatternPreviewDefinition d) => @<div class="ov-pattern-demo__body">
        <MudText Typo="Typo.body2" Class="ov-pattern-demo__summary">@d.Summary</MudText>
        <div class="ov-demo-detail-header"><div><strong>Selected object</strong><div class="ov-pattern-demo__muted">Reference / context</div></div><OVStatusPill Text="Current" Tone="OVStatusPill.OVStatusTone.Success" /></div>
        @RenderTabs(d)
        @RenderActiveStateReference(d)
        <div class="ov-demo-detail-grid">
            @foreach (var field in ActiveFields(d)) { <div class="ov-demo-keyvalue"><span>@field</span><strong>@SampleValue(field)</strong></div> }
        </div>
        @RenderFooter(d)
    </div>;

    private RenderFragment RenderPicker(PatternPreviewDefinition d) => @<div class="ov-pattern-demo__body">
        <MudText Typo="Typo.body2" Class="ov-pattern-demo__summary">@d.Summary</MudText>
        <div class="ov-demo-toolbar"><MudTextField @bind-Value="_search" Immediate="true" Placeholder="Search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense" /><OVButton Variant="Variant.Outlined">Filters</OVButton></div>
        <div class="ov-demo-picker-results">
            @for (var i = 0; i < d.Items.Length; i++)
            {
                var index = i;
                if (MatchesSearch(d.Items[i]))
                {
                    <label class="ov-demo-picker-row"><input type="checkbox" checked="@_pickerSelection.Contains(index)" @onchange="e => TogglePicker(index, e.Value is bool value && value)" /><span><strong>@d.Items[i]</strong><small>Eligible target · Current</small></span></label>
                }
            }
        </div>
        <div class="ov-demo-selection-summary"><span>@_pickerSelection.Count selected</span><OVButton>@d.PrimaryAction</OVButton></div>
    </div>;

    private RenderFragment RenderApi(PatternPreviewDefinition d) => @<div class="ov-pattern-demo__body">
        <MudText Typo="Typo.body2" Class="ov-pattern-demo__summary">@d.Summary</MudText>
        <div class="ov-demo-api-line"><span class="ov-demo-method">GET</span><code>/api/v1/entities/{id}</code><OVButton Variant="Variant.Outlined">Copy</OVButton></div>
        <pre class="ov-code">{
  "entityId": 123,
  "code": "EXAMPLE",
  "status": "Current"
}</pre>
        @RenderFooter(d)
    </div>;

    private RenderFragment RenderEmpty(PatternPreviewDefinition d) => @<div class="ov-pattern-demo__body">
        <div class="ov-demo-empty"><MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Large" /><MudText Typo="Typo.h6">Nothing configured yet</MudText><MudText Typo="Typo.body2">@d.Summary</MudText><OVButton>@d.PrimaryAction</OVButton><OVButton Variant="Variant.Text">@d.SecondaryAction</OVButton></div>
    </div>;

    private RenderFragment RenderTabs(PatternPreviewDefinition d) => @<div>
        @if (d.Items.Length > 1)
        {
            <div class="ov-demo-tabs">
                @foreach (var item in d.Items)
                {
                    <button type="button" class="@(item == _activeView ? "ov-demo-tab ov-demo-tab--active" : "ov-demo-tab")" @onclick="() => _activeView = item">@item</button>
                }
            </div>
        }
    </div>;

    private RenderFragment RenderActiveStateReference(PatternPreviewDefinition d) => @<div>
        @if (!string.IsNullOrWhiteSpace(_activeView))
        {
            var node = ActiveCatalogNode();
            <div class="ov-demo-state-label"><span>Active state</span><strong>@_activeView</strong>@if (node is not null) { <code>@node.Reference</code> }</div>
        }
    </div>;

    private RenderFragment RenderFooter(PatternPreviewDefinition d) => @<div class="ov-pattern-demo__footer"><OVButton Variant="Variant.Text">@d.SecondaryAction</OVButton><OVButton>@d.PrimaryAction</OVButton></div>;

    private string[] ActiveFields(PatternPreviewDefinition d)
    {
        if (PatternKey == "schedule-editor")
        {
            return _activeView switch
            {
                "Overview" => ["Schedule name", "Enabled"],
                "Timing" => ["Timing mode", "Start date", "Time"],
                "Advanced" => ["Time zone", "Misfire policy", "Retry limit"],
                _ => d.Fields
            };
        }

        if (PatternKey == "tabbed-editor")
        {
            return _activeView switch
            {
                "Overview" => ["Name", "Description", "Enabled"],
                "Configuration" => ["Configuration mode", "Source", "Value"],
                "Advanced" => ["Read-only", "Validation mode", "Audit changes"],
                _ => d.Fields
            };
        }

        if (PatternKey == "run-overlay")
        {
            return _activeView switch
            {
                "Overview" => ["Run scope", "Target"],
                "Options" => ["Reprocess", "Notify on completion"],
                "Progress" => ["Started", "Processed", "Remaining"],
                "Result" => ["Outcome", "Accepted", "Rejected"],
                _ => d.Fields
            };
        }

        return d.Fields;
    }

    private PatternNode? ActiveCatalogNode()
    {
        var pattern = PatternCatalog.FindPattern(PatternKey);
        if (pattern is null || string.IsNullOrWhiteSpace(_activeView))
        {
            return null;
        }

        return pattern.Children.FirstOrDefault(child => string.Equals(child.Name, _activeView, StringComparison.OrdinalIgnoreCase));
    }

    private string[] FilteredItems(PatternPreviewDefinition d)
        => d.Items.Where(MatchesSearch).ToArray();

    private bool MatchesSearch(string item)
        => string.IsNullOrWhiteSpace(_search) || item.Contains(_search, StringComparison.OrdinalIgnoreCase);

    private string SelectedTreeItem(PatternPreviewDefinition d)
        => d.Items.Length == 0 ? "None" : d.Items[Math.Clamp(_selectedTreeIndex, 0, d.Items.Length - 1)];

    private void TogglePicker(int index, bool selected)
    {
        if (selected)
        {
            _pickerSelection.Add(index);
        }
        else
        {
            _pickerSelection.Remove(index);
        }
    }

    private static string SampleValue(string field)
    {
        var f = field.ToLowerInvariant();
        if (f.Contains("date")) return "24/10/2026";
        if (f.Contains("time")) return "09:00";
        if (f.Contains("status")) return "Current";
        if (f.Contains("type")) return "Standard";
        if (f.Contains("endpoint")) return "https://service.example";
        if (f.Contains("name")) return "Example configuration";
        if (f.Contains("search")) return string.Empty;
        if (f.Contains("enabled") || f.Contains("include") || f.Contains("reprocess") || f.Contains("read-only") || f.Contains("audit")) return "Yes";
        if (f.Contains("retry")) return "3";
        if (f.Contains("zone")) return "Europe/London";
        return "Example value";
    }

    private static string MetricValue(string item)
    {
        var digits = new string(item.Where(char.IsDigit).ToArray());
        return string.IsNullOrWhiteSpace(digits) ? "—" : digits;
    }
}