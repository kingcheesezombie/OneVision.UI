@using OneVision.UI.Iconography

<section class="ov-mapping-rule-group" aria-label="Rule group">
    <header class="ov-mapping-rule-group__header">
        @if (Group.Conditions.Count > 0 || Group.Groups.Count > 0)
        {
        <OVSelect T="OVMappingRuleJoin" Label="Join" Value="@Group.Join" ValueChanged="OnJoinChanged" Options="@JoinOptions" Disabled="@ReadOnly" />
        }
        @if (CanRemoveGroup && !ReadOnly)
        {
            <OVIconButton Icon="OneVisionIcon.Delete" Label="Remove group" OnClick="@(_ => RemoveGroupRequested.InvokeAsync(new OVMappingRuleGroupRequest(ParentGroupKey, Group.Key)))" />
        }
    </header>

    @if (Group.Conditions.Count == 0 && Group.Groups.Count == 0)
    {
        <p class="ov-mapping-rule-group__empty">No conditions in this group.</p>
    }
    <div class="ov-mapping-rule-group__conditions">
        @for (var index = 0; index < Group.Conditions.Count; index++)
        {
            var condition = Group.Conditions[index];
            var validation = ValidateCondition(condition);
            var field = GetField(condition);
            var operatorDefinition = GetOperator(field, condition.OperatorKey);
            var requiresValue = operatorDefinition?.RequiresValue ?? true;
            <div @key="condition.Key" class="@(validation.IsValid ? "ov-mapping-rule-condition" : "ov-mapping-rule-condition ov-mapping-rule-condition--invalid") @(SelectedConditionKey == condition.Key && SelectedGroupKey == Group.Key ? "ov-mapping-rule-condition--selected" : "")">
                @if (EnableConditionSelection)
                {
                    <button type="button" class="ov-mapping-rule-condition__select"
                            aria-pressed="@(SelectedConditionKey == condition.Key && SelectedGroupKey == Group.Key)"
                            @onclick="@(() => ConditionSelected.InvokeAsync(new OVMappingRuleConditionRequest(Group.Key, condition.Key)))">
                        @(SelectedConditionKey == condition.Key && SelectedGroupKey == Group.Key ? "Editing" : "Edit pair")
                    </button>
                }
                @if (AllowConditionDisabling)
                {
                    <div class="ov-mapping-rule-condition__enabled">
                        <OVCheckbox Label="Enabled" Value="@(!condition.Disabled)" ValueChanged="@(value => SetConditionEnabled(condition, value))" ReadOnly="@ReadOnly" />
                    </div>
                }
                <OVSelect T="string" Label="Field" Value="@condition.OperandKey"
                          ValueChanged="@(value => ChangeOperand(condition, value))"
                          Options="@AvailableFields" Disabled="@(ReadOnly || condition.Disabled)" />
                <OVSelect T="string" Label="Operator" Value="@condition.OperatorKey"
                          ValueChanged="@(value => ChangeOperator(condition, value))"
                          Options="@GetOperatorOptions(field)"
                          Disabled="@(ReadOnly || condition.Disabled || (HasTypedFields && field is null))" />
                @if (requiresValue)
                {
                    @if (AllowFieldComparison && FieldComparisonOperatorKeys.Contains(condition.OperatorKey ?? "", StringComparer.Ordinal))
                    {
                        <OVSelect T="string" Label="Compare with field" Value="@condition.Value"
                                  ValueChanged="@(value => ChangeValue(condition, value))"
                                  Options="@EffectiveComparisonFields" Disabled="@(ReadOnly || condition.Disabled)"
                                  Error="@(!validation.IsValid)" ErrorText="@validation.Message" />
                    }
                    else if (field?.ComparisonValues is { } comparisonValues)
                    {
                        <OVSelect T="string" Label="Value" Value="@condition.Value"
                                  ValueChanged="@(value => ChangeValue(condition, value))"
                                  Options="@comparisonValues" Disabled="@(ReadOnly || condition.Disabled)"
                                  Error="@(!validation.IsValid)" ErrorText="@validation.Message" />
                    }
                    else
                    {
                        <OVTextField Label="Value" Value="@condition.Value"
                                     ValueChanged="@(value => ChangeValue(condition, value))"
                                     ReadOnly="@(ReadOnly || condition.Disabled)"
                                     Error="@(!validation.IsValid)" ErrorText="@validation.Message" />
                    }
                }
                else
                {
                    <span class="ov-mapping-rule-condition__unary">No value required</span>
                }
                <div class="ov-mapping-rule-condition__actions">
                    @if (!ReadOnly && AllowReordering && Group.Conditions.Count > 1)
                    {
                        <OVButton Appearance="OVButtonVariant.Subtle" Disabled="@(index == 0)"
                                  OnClick="@(_ => MoveCondition(condition, -1))">Up</OVButton>
                        <OVButton Appearance="OVButtonVariant.Subtle" Disabled="@(index == Group.Conditions.Count - 1)"
                                  OnClick="@(_ => MoveCondition(condition, 1))">Down</OVButton>
                    }
                    @if (!ReadOnly)
                    {
                        <OVIconButton Icon="OneVisionIcon.Delete" Label="Remove condition"
                                      OnClick="@(_ => RemoveConditionRequested.InvokeAsync(new OVMappingRuleConditionRequest(Group.Key, condition.Key)))" />
                    }
                </div>
            </div>
        }
    </div>

    @if (Group.Groups.Count > 0)
    {
        <div class="ov-mapping-rule-group__children">
            @foreach (var child in Group.Groups)
            {
                <OVMappingRuleGroupEditor @key="child.Key" Group="@child"
                                          ParentGroupKey="@Group.Key"
                                          Operands="@Operands"
                                          Operators="@Operators"
                                          FieldDefinitions="@FieldDefinitions"
                                          OperatorDefinitions="@OperatorDefinitions"
                                          ReadOnly="@ReadOnly"
                                          AllowNestedGroups="@AllowNestedGroups"
                                          AllowConditionDisabling="@AllowConditionDisabling"
                                          AllowReordering="@AllowReordering"
                                          AllowFieldComparison="@AllowFieldComparison"
                                          FieldComparisonOperatorKeys="@FieldComparisonOperatorKeys"
                                          ComparisonFields="@ComparisonFields"
                                          ComparisonFieldDefinitions="@ComparisonFieldDefinitions"
                                          EnableConditionSelection="@EnableConditionSelection"
                                          SelectedGroupKey="@SelectedGroupKey"
                                          SelectedConditionKey="@SelectedConditionKey"
                                          ConditionSelected="@ConditionSelected"
                                          CanRemoveGroup="true"
                                          ConditionChanged="@ConditionChanged"
                                          ConditionMoveRequested="@ConditionMoveRequested"
                                          AddConditionRequested="@AddConditionRequested"
                                          RemoveConditionRequested="@RemoveConditionRequested"
                                          AddGroupRequested="@AddGroupRequested"
                                          RemoveGroupRequested="@RemoveGroupRequested"
                                          GroupJoinChanged="@GroupJoinChanged" />
            }
        </div>
    }

    @if (!ReadOnly)
    {
        <div class="ov-mapping-rule-group__actions">
            <OVButton Appearance="OVButtonVariant.Secondary" Icon="OneVisionIcon.Add" OnClick="@(_ => AddConditionRequested.InvokeAsync(new OVMappingRuleConditionRequest(Group.Key)))">Add condition</OVButton>
            @if (AllowNestedGroups)
            {
                <OVButton Appearance="OVButtonVariant.Subtle" Icon="OneVisionIcon.Add" OnClick="@(_ => AddGroupRequested.InvokeAsync(new OVMappingRuleGroupRequest(Group.Key)))">Add group</OVButton>
            }
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public OVMappingRuleGroup Group { get; set; } = default!;
    [Parameter] public string ParentGroupKey { get; set; } = string.Empty;
    [Parameter] public IReadOnlyList<OVOption<string>> Operands { get; set; } = [];
    [Parameter] public IReadOnlyList<OVOption<string>> Operators { get; set; } = [];
    [Parameter] public IReadOnlyList<OVMappingRuleFieldDefinition> FieldDefinitions { get; set; } = [];
    [Parameter] public IReadOnlyList<OVMappingRuleOperatorDefinition>? OperatorDefinitions { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool AllowNestedGroups { get; set; }
    [Parameter] public bool AllowConditionDisabling { get; set; }
    [Parameter] public bool AllowReordering { get; set; }
    [Parameter] public bool CanRemoveGroup { get; set; }
    [Parameter] public bool EnableConditionSelection { get; set; }
    [Parameter] public string? SelectedConditionKey { get; set; }
    [Parameter] public string? SelectedGroupKey { get; set; }
    [Parameter] public EventCallback<OVMappingRuleConditionRequest> ConditionSelected { get; set; }
    [Parameter] public IReadOnlyList<OVMappingComparisonField> ComparisonFieldDefinitions { get; set; } = [];
    [Parameter] public bool AllowFieldComparison { get; set; }
    [Parameter] public IReadOnlyCollection<string> FieldComparisonOperatorKeys { get; set; } = [];
    [Parameter] public IReadOnlyList<OVOption<string>> ComparisonFields { get; set; } = [];
    [Parameter] public EventCallback<OVMappingRuleConditionChange> ConditionChanged { get; set; }
    [Parameter] public EventCallback<OVMappingRuleConditionMoveRequest> ConditionMoveRequested { get; set; }
    [Parameter] public EventCallback<OVMappingRuleConditionRequest> AddConditionRequested { get; set; }
    [Parameter] public EventCallback<OVMappingRuleConditionRequest> RemoveConditionRequested { get; set; }
    [Parameter] public EventCallback<OVMappingRuleGroupRequest> AddGroupRequested { get; set; }
    [Parameter] public EventCallback<OVMappingRuleGroupRequest> RemoveGroupRequested { get; set; }
    [Parameter] public EventCallback<OVMappingRuleGroupJoinChange> GroupJoinChanged { get; set; }

    private static readonly IReadOnlyList<OVOption<OVMappingRuleJoin>> JoinOptions =
    [
        new(OVMappingRuleJoin.And, "All must match (AND)"),
        new(OVMappingRuleJoin.Or, "Any may match (OR)")
    ];

    private bool HasTypedFields => FieldDefinitions.Count > 0;
    private IReadOnlyList<OVOption<string>> EffectiveComparisonFields =>
        ComparisonFields.Count > 0 ? ComparisonFields : AvailableFields;

    private IReadOnlyList<OVOption<string>> AvailableFields =>
        HasTypedFields ? FieldDefinitions.Select(f => new OVOption<string>(f.Key, f.Label)).ToArray() : Operands;

    private OVMappingRuleFieldDefinition? GetField(OVMappingRuleCondition condition) =>
        HasTypedFields
            ? FieldDefinitions.FirstOrDefault(f => string.Equals(f.Key, condition.OperandKey, StringComparison.Ordinal))
            : null;

    private OVMappingRuleOperatorDefinition? GetOperator(OVMappingRuleFieldDefinition? field, string? key) =>
        field is null ? null : OVMappingRuleOperatorContract.ForField(field, OperatorDefinitions)
            .FirstOrDefault(op => string.Equals(op.Key, key, StringComparison.Ordinal));

    private IReadOnlyList<OVOption<string>> GetOperatorOptions(OVMappingRuleFieldDefinition? field) =>
        HasTypedFields
            ? field is null
                ? []
                : OVMappingRuleOperatorContract.ForField(field, OperatorDefinitions)
                    .Select(op => new OVOption<string>(op.Key, op.Label)).ToArray()
            : Operators;

    private OVMappingRuleConditionValidation ValidateCondition(OVMappingRuleCondition condition)
    {
        if (condition.Disabled)
            return OVMappingRuleConditionValidation.Valid;
        if (!condition.IsValid)
            return new(false, condition.ValidationMessage);
        if (AllowFieldComparison && FieldComparisonOperatorKeys.Contains(condition.OperatorKey ?? "", StringComparer.Ordinal))
        {
            if (!EffectiveComparisonFields.Any(option =>
                    !option.Disabled && string.Equals(option.Value, condition.Value, StringComparison.Ordinal)))
                return new(false, "Select an available comparison field.");
            var sourceField = GetField(condition);
            if (HasTypedFields && GetOperator(sourceField, condition.OperatorKey) is null)
                return new(false, "Select an operator supported by this field.");
            if (ComparisonFieldDefinitions.Count > 0)
            {
                var target = ComparisonFieldDefinitions.FirstOrDefault(f => string.Equals(f.Key, condition.Value, StringComparison.Ordinal));
                if (target is null || target.Disabled)
                    return new(false, "The selected comparison field is unavailable for this resolution method.");
                if (sourceField is not null && sourceField.Type != target.Type)
                    return new(false, "The selected field types are incompatible.");
                if (target.AllowedOperators is not null && !target.AllowedOperators.Contains(condition.OperatorKey ?? "", StringComparer.Ordinal))
                    return new(false, "The comparison operator is not permitted for this target field.");
            }
            return OVMappingRuleConditionValidation.Valid;
        }
        return HasTypedFields ? OVMappingRuleOperatorContract.Validate(condition, GetField(condition), OperatorDefinitions)
            : OVMappingRuleConditionValidation.Valid;
    }

    private Task OnJoinChanged(OVMappingRuleJoin value) =>
        GroupJoinChanged.InvokeAsync(new OVMappingRuleGroupJoinChange(Group.Key, value));

    private Task ChangeOperand(OVMappingRuleCondition condition, string? value)
    {
        if (!HasTypedFields)
            return Notify(condition with { OperandKey = value });

        var field = FieldDefinitions.FirstOrDefault(f => f.Key == value);
        var op = field is null ? null : GetOperator(field, condition.OperatorKey);
        return Notify(condition with
        {
            OperandKey = value,
            OperatorKey = op?.Key,
            // A new field may have a different datatype or allowed-values set;
            // do not carry its previous field's comparison literal across.
            Value = string.Equals(condition.OperandKey, value, StringComparison.Ordinal) && op is { RequiresValue: true }
                ? condition.Value : null,
            IsValid = true,
            ValidationMessage = null
        });
    }

    private Task ChangeOperator(OVMappingRuleCondition condition, string? value)
    {
        var field = GetField(condition);
        var op = GetOperator(field, value);
        return Notify(condition with
        {
            OperatorKey = value,
            Value = HasTypedFields && op?.RequiresValue == false ? null : condition.Value,
            IsValid = true,
            ValidationMessage = null
        });
    }

    private Task ChangeValue(OVMappingRuleCondition condition, string? value) =>
        Notify(condition with { Value = value, IsValid = true, ValidationMessage = null });

    private Task SetConditionEnabled(OVMappingRuleCondition condition, bool? enabled) =>
        Notify(condition with { Disabled = enabled != true });

    private Task MoveCondition(OVMappingRuleCondition condition, int offset) =>
        ConditionMoveRequested.InvokeAsync(new OVMappingRuleConditionMoveRequest(Group.Key, condition.Key, offset));

    private Task Notify(OVMappingRuleCondition condition) =>
        ConditionChanged.InvokeAsync(new OVMappingRuleConditionChange(Group.Key, condition));
}
