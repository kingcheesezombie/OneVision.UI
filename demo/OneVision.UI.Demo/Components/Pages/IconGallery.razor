@page "/icons"
@using OneVision.UI.Iconography

<PageTitle>Icons · OneVision.UI</PageTitle>

<div class="ov-index-heading">
    <div>
        <h1 class="ov-gallery-page-title">Icons</h1>
        <MudText Typo="Typo.body1" Class="ov-gallery-page-intro">Reference the governed OneVision semantic icon names from application code. Apps should use <code>OneVisionIcon.*</code> rather than selecting implementation-specific MudBlazor or Fluent icon strings.</MudText>
    </div>
    <div class="ov-index-count">@FilteredIcons.Count() icons</div>
</div>

<div class="ov-catalog-toolbar">
    <MudTextField @bind-Value="_search" Immediate="true" Placeholder="Search semantic icons" Adornment="Adornment.Start" AdornmentIcon="@MudBlazor.Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense" />
</div>

<div class="ov-catalog-grid">
    @foreach (var icon in FilteredIcons)
    {
        <div class="ov-catalog-card">
            <div class="ov-catalog-card__top">
                <div class="ov-component-demo-row"><OVIcon Name="@icon" /><strong>@icon</strong></div>
                <code>OneVisionIcon.@icon</code>
            </div>
            <span>@Description(icon)</span>
        </div>
    }
</div>

@code {
    private string _search = string.Empty;
    private static IReadOnlyList<OneVisionIcon> AllIcons { get; } = Enum.GetValues<OneVisionIcon>();

    private IEnumerable<OneVisionIcon> FilteredIcons
        => string.IsNullOrWhiteSpace(_search)
            ? AllIcons
            : AllIcons.Where(icon => icon.ToString().Contains(_search, StringComparison.OrdinalIgnoreCase)
                || Description(icon).Contains(_search, StringComparison.OrdinalIgnoreCase));

    private static string Description(OneVisionIcon icon) => icon switch
    {
        OneVisionIcon.Home => "Application or gallery home.",
        OneVisionIcon.Search => "Search or find content.",
        OneVisionIcon.Build => "Build, configure or compose.",
        OneVisionIcon.Components => "Reusable components or application modules.",
        OneVisionIcon.Patterns => "Governed patterns and structured flows.",
        OneVisionIcon.Add => "Create or add an item.",
        OneVisionIcon.Edit => "Edit an existing item.",
        OneVisionIcon.Delete => "Delete or remove an item.",
        OneVisionIcon.Save => "Save current changes.",
        OneVisionIcon.Cancel => "Close, dismiss or cancel.",
        OneVisionIcon.Copy => "Copy a value or reference.",
        OneVisionIcon.More => "More actions. Always rendered as a vertical ellipsis.",
        OneVisionIcon.Filter => "Filter the current result set.",
        OneVisionIcon.Refresh => "Refresh or reload data.",
        OneVisionIcon.Run => "Run or start an operation.",
        OneVisionIcon.Download => "Download or export output.",
        OneVisionIcon.Settings => "Settings or configuration.",
        OneVisionIcon.Person => "Person, user or staff context.",
        OneVisionIcon.Organisation => "Organisation or organisational-unit context.",
        OneVisionIcon.Success => "Successful or healthy state.",
        OneVisionIcon.Warning => "Warning or degraded state.",
        OneVisionIcon.Error => "Error or failed state.",
        OneVisionIcon.Information => "Informational context.",
        OneVisionIcon.ChevronLeft => "Previous, back or collapse toward the left.",
        OneVisionIcon.ChevronRight => "Next, forward or expand toward the right.",
        OneVisionIcon.ChevronDown => "Expand, disclose or open downward.",
        _ => icon.ToString()
    };
}
