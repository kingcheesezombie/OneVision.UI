@inherits LayoutComponentBase

<MudThemeProvider Theme="OneVisionTheme.Default" />
<MudPopoverProvider />
<MudDialogProvider CloseButton="true" CloseOnEscapeKey="true" />
<MudSnackbarProvider />

<MudLayout Class="ov-gallery-layout">
    <MudAppBar Elevation="0" Dense="true" Class="ov-gallery-appbar">
        <MudText Typo="Typo.h6">OneVision.UI</MudText>
        <MudSpacer />
        <MudText Typo="Typo.body2">Component Library</MudText>
    </MudAppBar>

    <MudDrawer Open="true"
               Variant="DrawerVariant.Persistent"
               Elevation="0"
               Class="ov-gallery-drawer">
        <div class="ov-gallery-nav-title">Library</div>
        <MudNavMenu>
            <MudNavLink Href="" Match="NavLinkMatch.All">Overview</MudNavLink>

            <MudNavGroup Title="Components" Expanded="true">
                <MudNavLink Href="components/buttons">Buttons</MudNavLink>
                <MudNavLink Href="components/status-pills">Status pills</MudNavLink>
                <MudNavLink Href="components/form-controls">Form controls</MudNavLink>
            </MudNavGroup>

            <MudNavGroup Title="Patterns" Expanded="true">
                @foreach (var pattern in PatternCatalog.Patterns)
                {
                    <PatternNavNode Node="pattern" ParentPath="patterns" />
                }
            </MudNavGroup>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Class="ov-gallery-main">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="ov-gallery-content">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>
