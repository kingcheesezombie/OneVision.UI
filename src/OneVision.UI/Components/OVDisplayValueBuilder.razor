@using Microsoft.JSInterop
@using OneVision.UI.Iconography
@implements IAsyncDisposable
@inject IJSRuntime JS

<section class="ov-display-value-builder" aria-labelledby="@_titleId" @ref="_root">
    <header class="ov-display-value-builder__header">
        <div>
            <div class="ov-display-value-builder__title" id="@_titleId">@Title</div>
            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <p>@Description</p>
            }
        </div>
        @if (ReadOnly)
        {
            <span class="ov-display-value-builder__mode">Read only</span>
        }
    </header>

    @if (!ReadOnly && EnabledTargets.Count == 0)
    {
        <OVEmptyState Title="No completed mappings yet"
                      Description="Fields become available here after their mappings have been completed in the Mapping tab." />
    }
    else
    {
        @if (!ReadOnly)
        {
            <div class="ov-display-value-builder__available" aria-label="Available mapped fields">
                <div class="ov-display-value-builder__section-heading">
                    <strong>Available mapped fields</strong>
                    <span>Click a completed mapped field to add it to the display value.</span>
                </div>

                @if (CoreTargets.Count > 0)
                {
                    <div class="ov-display-value-builder__field-group">
                        <span class="ov-display-value-builder__group-label">Core fields</span>
                        <div class="ov-display-value-builder__palette">
                            @foreach (var target in CoreTargets)
                            {
                                @TargetChoice(target)
                            }
                        </div>
                    </div>
                }

                @if (StandardDetailTargets.Count > 0)
                {
                    <div class="ov-display-value-builder__field-group">
                        <span class="ov-display-value-builder__group-label">Standard Details</span>
                        <div class="ov-display-value-builder__palette">
                            @foreach (var target in StandardDetailTargets)
                            {
                                @TargetChoice(target)
                            }
                        </div>
                    </div>
                }
            </div>
        }

        <div class="ov-display-value-builder__composer">
            <div class="ov-display-value-builder__section-heading">
                <strong>Display value composition</strong>
                @if (ReadOnly)
                {
                    <span>The configured display value is shown below.</span>
                }
                else
                {
                    <span>Drag tokens to reorder them, or focus a token and use Alt + Left/Right Arrow.</span>
                }
            </div>

            @if (Segments.Count == 0)
            {
                <div class="ov-display-value-builder__empty">
                    <OVIcon Name="OneVisionIcon.Build" />
                    <strong>No display value configured</strong>
                    <span>Add a mapped field and any separators you need.</span>
                </div>
            }
            else
            {
                <ol class="ov-display-value-builder__segments" aria-label="Display value composition">
                    @for (var index = 0; index < Segments.Count; index++)
                    {
                        var itemIndex = index;
                        var segment = Segments[itemIndex];
                        var target = ResolveTarget(segment);
                        var unresolved = segment.Kind == OVDisplayValueSegmentKind.Target && target is null;
                        <li class="@TokenClass(segment, unresolved)"
                            data-segment-id="@segment.Id"
                            data-segment-index="@itemIndex"
                            draggable="@(!ReadOnly)"
                            tabindex="@(ReadOnly ? -1 : 0)"
                            aria-label="@TokenAriaLabel(segment, target, unresolved, itemIndex)"
                            @onkeydown="args => OnTokenKeyDown(args, itemIndex)">
                            @if (!ReadOnly)
                            {
                                <span class="ov-display-value-builder__drag" aria-hidden="true">⋮⋮</span>
                            }
                            <span class="ov-display-value-builder__token-text">@TokenText(segment, target, unresolved)</span>
                            @if (!ReadOnly)
                            {
                                <button type="button"
                                        class="ov-display-value-builder__remove"
                                        aria-label="@($"Remove {TokenText(segment, target, unresolved)}")"
                                        @onclick="() => RemoveSegment(segment.Id)">×</button>
                            }
                        </li>
                    }
                </ol>
            }

            @if (!ReadOnly)
            {
                <div class="ov-display-value-builder__separator-add">
                    <div class="ov-display-value-builder__section-heading">
                        <strong>Add separator</strong>
                        <span>Click a separator to add it to the end of the composition.</span>
                    </div>
                    <div class="ov-display-value-builder__separator-buttons" aria-label="Available separators">
                        @foreach (var separator in Separators)
                        {
                            <button type="button"
                                    class="ov-display-value-builder__separator-button"
                                    aria-label="@($"Add separator {separator.Name}")"
                                    data-separator="@separator.Symbol"
                                    @onclick="() => AddSeparator(separator.Literal)">@separator.Symbol</button>
                        }
                    </div>
                </div>
            }
        </div>
    }

    @if (HasUnresolvedTargets)
    {
        <OVAlert Tone="OVAlertTone.Warning">One or more fields used by this display value are no longer present in Mapping. Replace or remove them before saving.</OVAlert>
    }
    else if (Segments.Count > 0 && !IsValid)
    {
        <OVAlert Tone="OVAlertTone.Warning">Add at least one mapped field to create a valid display value.</OVAlert>
    }

    <div class="ov-display-value-builder__preview" aria-live="polite" aria-label="Display value preview">
        <span class="ov-display-value-builder__preview-label">Preview</span>
        @if (Segments.Count == 0)
        {
            <span class="ov-display-value-builder__preview-empty">Your composed display value will appear here.</span>
        }
        else
        {
            <strong>@PreviewText</strong>
            @if (!HasCompleteSample)
            {
                <span class="ov-display-value-builder__preview-hint">Example values are shown in brackets where sample data is unavailable.</span>
            }
        }
    </div>
</section>

@code {
    [Parameter] public string Title { get; set; } = "Display Value";
    [Parameter] public string? Description { get; set; } = "Build a human-readable value from completed Mapping targets. Raw source fields are never exposed here.";
    [Parameter] public IReadOnlyList<OVDisplayValueTargetOption> Targets { get; set; } = Array.Empty<OVDisplayValueTargetOption>();
    [Parameter] public OVDisplayValueDefinition? Value { get; set; }
    [Parameter] public EventCallback<OVDisplayValueDefinition?> ValueChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool AllowLiteralOnly { get; set; }

    private readonly string _titleId = $"ov-display-value-{Guid.NewGuid():N}";
    private ElementReference _root;
    private IJSObjectReference? _dragModule;
    private DotNetObjectReference<OVDisplayValueBuilder>? _selfReference;

    private sealed record SeparatorChoice(string Symbol, string Name, string Literal);
    private static readonly IReadOnlyList<SeparatorChoice> Separators =
    [
        new("|", "vertical bar", " | "), new("-", "hyphen", " - "), new("/", "slash", " / "),
        new(",", "comma", ", "), new("·", "middle dot", " · "), new("(", "open parenthesis", " ("), new(")", "close parenthesis", ")")
    ];

    private IReadOnlyList<OVDisplayValueSegment> Segments => Value?.Segments ?? Array.Empty<OVDisplayValueSegment>();
    private IReadOnlyList<OVDisplayValueTargetOption> EnabledTargets => Targets.Where(target => target.Enabled).ToArray();
    private IReadOnlyList<OVDisplayValueTargetOption> CoreTargets => EnabledTargets.Where(target => target.Kind == OVMappingTargetKind.Contract).ToArray();
    private IReadOnlyList<OVDisplayValueTargetOption> StandardDetailTargets => EnabledTargets.Where(target => target.Kind == OVMappingTargetKind.StandardDetail).ToArray();
    private bool IsValid => OVDisplayValueValidation.IsValid(Value, Targets, AllowLiteralOnly);
    private bool HasUnresolvedTargets => Segments.Any(segment => segment.Kind == OVDisplayValueSegmentKind.Target && ResolveTarget(segment) is null);
    private bool HasCompleteSample => Segments.Where(segment => segment.Kind == OVDisplayValueSegmentKind.Target).All(segment => !string.IsNullOrWhiteSpace(ResolveTarget(segment)?.SampleValue));
    private string PreviewText => string.Concat(Segments.Select(PreviewSegment));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            _dragModule = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/OneVision.UI/ov-display-value-dnd.js");
            _selfReference = DotNetObjectReference.Create(this);
            await _dragModule.InvokeVoidAsync("attach", _root, _selfReference);
        }
        catch (Exception)
        {
            // Keyboard reordering remains available if browser drag support cannot be initialized.
        }
    }

    private RenderFragment TargetChoice(OVDisplayValueTargetOption target) => @<button type="button" class="ov-display-value-builder__target-pill" title="@target.Description" aria-label="@($"Add mapped field {target.Label}")" @onclick="() => AddTarget(target)"><span>@target.Label</span><span aria-hidden="true">＋</span></button>;
    private OVDisplayValueTargetOption? ResolveTarget(OVDisplayValueSegment segment) => segment.TargetKey is null ? null : Targets.FirstOrDefault(target => target.Enabled && string.Equals(target.Key, segment.TargetKey, StringComparison.Ordinal));

    private async Task AddTarget(OVDisplayValueTargetOption target) { var segments = Segments.ToList(); segments.Add(new OVDisplayValueSegment(Guid.NewGuid().ToString("N"), OVDisplayValueSegmentKind.Target, TargetKey: target.Key)); await Publish(segments); }
    private async Task AddSeparator(string literal) { var segments = Segments.ToList(); segments.Add(new OVDisplayValueSegment(Guid.NewGuid().ToString("N"), OVDisplayValueSegmentKind.Literal, Literal: literal)); await Publish(segments); }
    private async Task RemoveSegment(string id) { var segments = Segments.Where(segment => !string.Equals(segment.Id, id, StringComparison.Ordinal)).ToList(); await Publish(segments); }

    [JSInvokable]
    public Task HandleDisplayValueDrop(string sourceId, string destinationId)
        => ReorderByIds(sourceId, destinationId);

    private async Task ReorderByIds(string sourceId, string destinationId)
    {
        if (ReadOnly || string.Equals(sourceId, destinationId, StringComparison.Ordinal)) return;
        var segments = Segments.ToList();
        var sourceIndex = segments.FindIndex(item => string.Equals(item.Id, sourceId, StringComparison.Ordinal));
        var destinationIndex = segments.FindIndex(item => string.Equals(item.Id, destinationId, StringComparison.Ordinal));
        if (sourceIndex < 0 || destinationIndex < 0) return;
        var item = segments[sourceIndex];
        segments.RemoveAt(sourceIndex);
        if (sourceIndex < destinationIndex) destinationIndex--;
        segments.Insert(destinationIndex, item);
        await Publish(segments);
    }

    private async Task OnTokenKeyDown(KeyboardEventArgs args, int index)
    {
        if (ReadOnly || !args.AltKey) return;
        if (string.Equals(args.Key, "ArrowLeft", StringComparison.Ordinal)) await MoveSegment(index, -1);
        else if (string.Equals(args.Key, "ArrowRight", StringComparison.Ordinal)) await MoveSegment(index, 1);
    }

    private async Task MoveSegment(int index, int delta)
    {
        var destination = index + delta;
        if (index < 0 || index >= Segments.Count || destination < 0 || destination >= Segments.Count) return;
        var segments = Segments.ToList();
        (segments[index], segments[destination]) = (segments[destination], segments[index]);
        await Publish(segments);
    }

    private Task Publish(IReadOnlyList<OVDisplayValueSegment> segments) => ValueChanged.InvokeAsync(new OVDisplayValueDefinition(segments));
    private string PreviewSegment(OVDisplayValueSegment segment)
    {
        if (segment.Kind == OVDisplayValueSegmentKind.Literal) return segment.Literal ?? string.Empty;
        var target = ResolveTarget(segment);
        if (target is null) return "[Missing field]";
        return !string.IsNullOrWhiteSpace(target.SampleValue) ? target.SampleValue! : $"[{target.Label}]";
    }

    private static string TokenText(OVDisplayValueSegment segment, OVDisplayValueTargetOption? target, bool unresolved)
    {
        if (segment.Kind == OVDisplayValueSegmentKind.Target) return unresolved ? "Mapped field removed" : target?.Label ?? "Mapped field";
        var literal = segment.Literal ?? string.Empty;
        return literal.Trim() switch { "" => "Space", var value => value };
    }

    private string TokenAriaLabel(OVDisplayValueSegment segment, OVDisplayValueTargetOption? target, bool unresolved, int index)
    {
        var label = $"{TokenText(segment, target, unresolved)}, position {index + 1}.";
        return ReadOnly ? label : $"{label} Drag to reorder or use Alt plus Left or Right Arrow.";
    }

    private static string TokenClass(OVDisplayValueSegment segment, bool unresolved)
    {
        var kind = segment.Kind == OVDisplayValueSegmentKind.Target ? "field" : "separator";
        return $"ov-display-value-builder__segment ov-display-value-builder__segment--{kind}{(unresolved ? " ov-display-value-builder__segment--unresolved" : string.Empty)}";
    }

    public async ValueTask DisposeAsync()
    {
        if (_dragModule is not null)
        {
            try { await _dragModule.InvokeVoidAsync("detach", _root); }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
            await _dragModule.DisposeAsync();
        }
        _selfReference?.Dispose();
    }
}
