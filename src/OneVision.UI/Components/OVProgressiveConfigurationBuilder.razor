<section class="@RootClass" aria-labelledby="@AriaLabelledBy" aria-label="@EffectiveAriaLabel" aria-busy="@(Busy ? "true" : null)" aria-readonly="@(ReadOnly ? "true" : null)">
    @if (!EmbeddedInOverlay && (!string.IsNullOrWhiteSpace(Title) || !string.IsNullOrWhiteSpace(Description)))
    {
        <header class="ov-progressive-builder__header">
            @if (!string.IsNullOrWhiteSpace(Title))
            {
                <div id="@_titleId" class="ov-progressive-builder__title" role="heading" aria-level="@EffectiveHeadingLevel">@Title</div>
            }
            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <p>@Description</p>
            }
        </header>
    }

    @if (Busy)
    {
        <div class="ov-progressive-builder__progress" role="status">
            <OVProgress Mode="OVProgressMode.Indeterminate" Label="@BusyMessage" />
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="ov-progressive-builder__feedback" role="alert">
            <OVAlert Tone="OVAlertTone.Error">@ErrorMessage</OVAlert>
        </div>
    }
    @if (Completed)
    {
        <div class="ov-progressive-builder__feedback" role="status">
            <OVAlert Tone="OVAlertTone.Success">@CompletedMessage</OVAlert>
        </div>
    }

    <div class="ov-progressive-builder__body" data-composition="@(Items is null ? "legacy" : "definitions")">
        @if (Items is not null)
        {
            @foreach (var item in Items)
            {
                @RenderItem(item)
            }
        }
        else
        {
            @ChildContent
        }
    </div>

    @if (Preview is not null)
    {
        <div class="ov-progressive-builder__preview">@Preview</div>
    }

    @if (Validation is not null)
    {
        <div class="ov-progressive-builder__validation" aria-live="polite">@Validation</div>
    }

    @if (!EmbeddedInOverlay && !ReadOnly && !Completed && Actions is not null)
    {
        <footer class="ov-progressive-builder__footer">@Actions</footer>
    }
</section>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public int HeadingLevel { get; set; } = 2;
    // New definition-driven API; legacy ChildContent composition remains available.
    [Parameter] public IReadOnlyList<OVConfigurationItemDefinition>? Items { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? ActiveStepKey { get; set; }
    [Parameter] public EventCallback<string?> ActiveStepKeyChanged { get; set; }
    [Parameter] public RenderFragment? Preview { get; set; }
    [Parameter] public RenderFragment? Validation { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool EmbeddedInOverlay { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string BusyMessage { get; set; } = "Saving configuration…";
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public bool Completed { get; set; }
    [Parameter] public string CompletedMessage { get; set; } = "Configuration saved.";
    [Parameter] public bool ReadOnly { get; set; }

    private readonly List<OVConfigurationStepDefinition> _orderedSteps = new();
    private readonly Dictionary<string, OVConfigurationStepDefinition> _stepsByKey = new(StringComparer.Ordinal);
    private string? _requestedActiveKey;
    private string? _valueWhenActivated;

    protected override void OnParametersSet()
    {
        _orderedSteps.Clear();
        _stepsByKey.Clear();
        if (Items is null) return;

        var keys = new HashSet<string>(StringComparer.Ordinal);
        Visit(Items, keys);
        if (_requestedActiveKey is not null)
        {
            if (!_stepsByKey.TryGetValue(_requestedActiveKey, out var step) ||
                !step.IsVisible || !step.Enabled || !string.Equals(step.Value, _valueWhenActivated, StringComparison.Ordinal))
            {
                _requestedActiveKey = null;
                _valueWhenActivated = null;
            }
        }
    }

    private void Visit(IReadOnlyList<OVConfigurationItemDefinition> items, HashSet<string> keys)
    {
        foreach (var item in items)
        {
            if (string.IsNullOrWhiteSpace(item.Key) || !keys.Add(item.Key))
                throw new InvalidOperationException("Progressive configuration item keys must be non-empty and unique.");
            if (item is OVConfigurationSectionDefinition section)
                Visit(section.Items, keys);
            else if (item is OVConfigurationStepDefinition step)
            {
                if (!_stepsByKey.TryAdd(step.Key, step))
                    throw new InvalidOperationException($"Duplicate progressive configuration step: {step.Key}.");
                if (step.IsVisible) _orderedSteps.Add(step);
            }
        }
    }

    private bool IsComplete(OVConfigurationStepDefinition step)
        => step.Complete ?? (!string.IsNullOrWhiteSpace(step.Value) ||
            (step.AllowAny && step.Value == step.AnyValue));

    private bool DependenciesSatisfied(OVConfigurationStepDefinition step)
        => step.DependsOn.All(key => _stepsByKey.TryGetValue(key, out var parent) &&
             parent.IsVisible && parent.Enabled && IsComplete(parent) &&
             parent.ValidationState != OVConfigurationValidationState.Error);

    private bool CanActivate(OVConfigurationStepDefinition step)
        => step.IsVisible && step.Enabled && DependenciesSatisfied(step);

    private string? CurrentKey
    {
        get
        {
            if (!ReadOnly && !Completed)
            {
                if (ActiveStepKey is not null && _stepsByKey.TryGetValue(ActiveStepKey, out var controlled) && CanActivate(controlled))
                    return ActiveStepKey;
                if (_requestedActiveKey is not null && _stepsByKey.TryGetValue(_requestedActiveKey, out var requested) && CanActivate(requested))
                    return _requestedActiveKey;
                return _orderedSteps.FirstOrDefault(step => CanActivate(step) &&
                    (!IsComplete(step) || step.ValidationState == OVConfigurationValidationState.Error))?.Key;
            }
            return null;
        }
    }

    private OVConfigurationStepState StateOf(OVConfigurationStepDefinition step)
    {
        if (!step.Enabled) return OVConfigurationStepState.Disabled;
        if (!DependenciesSatisfied(step)) return OVConfigurationStepState.Pending;
        if (CurrentKey == step.Key)
            return step.ValidationState == OVConfigurationValidationState.Error
                ? OVConfigurationStepState.Error : OVConfigurationStepState.Current;
        return IsComplete(step) ? OVConfigurationStepState.Completed : OVConfigurationStepState.Pending;
    }

    private async Task ActivateStep(OVConfigurationStepDefinition step)
    {
        if (Busy || ReadOnly || Completed || !step.CanChange || !CanActivate(step)) return;
        _requestedActiveKey = step.Key;
        _valueWhenActivated = step.Value;
        await ActiveStepKeyChanged.InvokeAsync(step.Key);
    }

    private async Task SelectValue(OVConfigurationStepDefinition step, string? value)
    {
        if (Busy || ReadOnly || Completed || !CanActivate(step)) return;
        await step.ValueChanged.InvokeAsync(value);
        _requestedActiveKey = null;
        _valueWhenActivated = null;
        await ActiveStepKeyChanged.InvokeAsync(null);
    }

    private int NumberOf(OVConfigurationStepDefinition step)
        => _orderedSteps.FindIndex(candidate => candidate.Key == step.Key) + 1;

    private RenderFragment EditorFor(OVConfigurationStepDefinition step)
        => step.Editor ?? @<OVSelect T="string"
                                   Label="@step.Label"
                                   Value="@step.Value"
                                   ValueChanged="@(value => SelectValue(step, value))"
                                   Options="@step.Options"
                                   Required="@step.Required"
                                   Disabled="@(Busy || ReadOnly || Completed)" />;

    private RenderFragment RenderItem(OVConfigurationItemDefinition item) => @<text>
        @if (item is OVConfigurationSectionDefinition section)
        {
            <OVConfigurationSection @key="section.Key" Title="@section.Title" Description="@section.Description">
                @foreach (var nested in section.Items)
                {
                    @RenderItem(nested)
                }
            </OVConfigurationSection>
        }
        else if (item is OVConfigurationSeparatorDefinition separator)
        {
            <OVConfigurationRelationship @key="separator.Key" Label="@separator.Label"
                                         Style="@separator.Style" />
        }
        else if (item is OVConfigurationStepDefinition step && step.IsVisible)
        {
            <OVConfigurationStep @key="step.Key"
                                 StepNumber="@NumberOf(step)"
                                 Label="@step.Label"
                                 Required="@step.Required"
                                 IsConditional="@step.IsConditional"
                                 AllowAny="@step.AllowAny"
                                 IsAny="@(step.AllowAny && step.Value == step.AnyValue)"
                                 AnyLabel="@step.AnyLabel"
                                 SelectedValue="@(step.DisplayValue ?? step.Value)"
                                 HelpText="@step.HelpText"
                                 PendingText="@(step.PendingText ?? "Complete the preceding selections to continue.")"
                                 DisabledText="@(step.DisabledText ?? "Not available for the current configuration.")"
                                 State="@StateOf(step)"
                                 CanChange="@(step.CanChange && !Busy && !ReadOnly && !Completed && (step.Editor is not null || step.Options.Count > 0))"
                                 ValidationState="@step.ValidationState"
                                 ValidationMessage="@step.ValidationMessage"
                                 Editor="@EditorFor(step)"
                                 ChangeRequested="@(() => ActivateStep(step))" />
        }
    </text>;

    private readonly string _titleId = $"ov-progressive-builder-{Guid.NewGuid():N}";
    private string? AriaLabelledBy => EmbeddedInOverlay || string.IsNullOrWhiteSpace(Title) ? null : _titleId;
    private string? EffectiveAriaLabel => (EmbeddedInOverlay || string.IsNullOrWhiteSpace(Title)) && !string.IsNullOrWhiteSpace(AriaLabel) ? AriaLabel : null;
    private int EffectiveHeadingLevel => Math.Clamp(HeadingLevel, 1, 6);
    private string RootClass => string.IsNullOrWhiteSpace(Class) ? "ov-progressive-builder" : $"ov-progressive-builder {Class}";
}
