<MudPaper Elevation="0" Class="@PanelClass">
    @if (ReadOnlyHeader is not null || Header is not null)
    {
        <header class="ov-panel__header">
            @if (ReadOnlyHeader is not null) { @ReadOnlyHeader(ReadOnly) }
            else { @Header }
        </header>
    }
    <div class="ov-panel__content">
        @if (ReadOnlyContent is not null) { @ReadOnlyContent(ReadOnly) }
        else { @ChildContent }
    </div>
    @if (ReadOnlyFooter is not null || Footer is not null)
    {
        <footer class="ov-panel__footer">
            @if (ReadOnlyFooter is not null) { @ReadOnlyFooter(ReadOnly) }
            else { @Footer }
        </footer>
    }
</MudPaper>

@code {
    [Parameter] public RenderFragment? Header { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    // Optional state-aware slots receive the actual read-only flag. Legacy
    // fragments remain unchanged and never have interactions disabled silently.
    [Parameter] public RenderFragment<bool>? ReadOnlyHeader { get; set; }
    [Parameter] public RenderFragment<bool>? ReadOnlyContent { get; set; }
    [Parameter] public RenderFragment<bool>? ReadOnlyFooter { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public string? Class { get; set; }

    private string PanelClass
    {
        get
        {
            var value = "ov-panel";
            if (ReadOnly) value += " ov-panel--readonly";
            return string.IsNullOrWhiteSpace(Class) ? value : $"{value} {Class}";
        }
    }
}
