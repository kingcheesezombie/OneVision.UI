@using System.Globalization

<div class="ov-api-call-builder">
    <header class="ov-api-call-builder__header">
        <div>
            <h2>@Title</h2>
            <span>Build and test a governed API request without manually constructing URLs or query strings.</span>
        </div>
        @if (Dirty)
        {
            <span class="ov-api-call-builder__dirty" role="status">Unsaved changes</span>
        }
    </header>

    @if (Presets.Count > 0)
    {
        <section class="ov-api-call-builder__section ov-api-call-builder__presets" aria-labelledby="@PresetHeadingId">
            <div class="ov-api-call-builder__section-heading">
                <div>
                    <h3 id="@PresetHeadingId">Start from</h3>
                    <span>Choose a starting point or continue with the current configuration.</span>
                </div>
            </div>
            <div class="ov-api-call-builder__preset-grid">
                @foreach (var preset in Presets)
                {
                    <button type="button" class="ov-api-call-builder__preset" disabled="@(ReadOnly || Busy)" @onclick="() => ApplyPreset(preset)">
                        <strong>@preset.Label</strong>
                        @if (!string.IsNullOrWhiteSpace(preset.Description))
                        {
                            <span>@preset.Description</span>
                        }
                    </button>
                }
            </div>
        </section>
    }

    <div class="ov-api-call-builder__workspace">
        <div class="ov-api-call-builder__configuration">
            <section class="ov-api-call-builder__section" aria-labelledby="@ConnectionHeadingId">
                <div class="ov-api-call-builder__section-heading">
                    <div>
                        <h3 id="@ConnectionHeadingId">Connection</h3>
                        <span>Where the request will be sent.</span>
                    </div>
                </div>
                <OVSelect T="string"
                          Label="Connection"
                          Value="@_connectionId"
                          ValueChanged="OnConnectionChanged"
                          Options="@ConnectionOptions"
                          Required="true"
                          Disabled="@(ReadOnly || Busy)"
                          Error="@ConnectionInvalid"
                          ErrorText="@(ConnectionInvalid ? "Choose a connection to continue." : null)" />
                @if (SelectedConnection is { } connection)
                {
                    <div class="ov-api-call-builder__connection-summary">
                        <div><span>Endpoint</span><strong>@connection.BaseAddress</strong></div>
                        <div><span>Authentication</span><strong>@connection.AuthenticationDisplay</strong></div>
                        <div><span>Credential</span><strong>@(connection.AuthenticationConfigured ? "Configured" : "Not configured")</strong></div>
                    </div>
                }
            </section>

            <section class="ov-api-call-builder__section" aria-labelledby="@RequestHeadingId">
                <div class="ov-api-call-builder__section-heading">
                    <div>
                        <h3 id="@RequestHeadingId">Request</h3>
                        <span>Choose the method and resource you want to call.</span>
                    </div>
                </div>
                <div class="ov-api-call-builder__request-grid">
                    <OVSelect T="string"
                              Label="Method"
                              Value="@_method"
                              ValueChanged="OnMethodChanged"
                              Options="@Methods"
                              Required="true"
                              Disabled="@(ReadOnly || Busy)" />
                    <OVTextField Label="Resource"
                                 Value="@_resource"
                                 ValueChanged="OnResourceChanged"
                                 Placeholder="/api/v1/entities/query"
                                 Required="true"
                                 Immediate="true"
                                 Disabled="@(ReadOnly || Busy)"
                                 Error="@ResourceInvalid"
                                 ErrorText="@(ResourceInvalid ? "Resource path is required." : null)" />
                </div>
            </section>

            <section class="ov-api-call-builder__section" aria-labelledby="@ParametersHeadingId">
                <div class="ov-api-call-builder__section-heading">
                    <div>
                        <h3 id="@ParametersHeadingId">Parameters</h3>
                        <span>Add filters and request options individually. The query string is generated for you.</span>
                    </div>
                    <OVButton Appearance="OVButtonVariant.Secondary"
                              OnClick="BeginAddParameter"
                              Disabled="@(ReadOnly || Busy || _addingParameter || AvailableParameterDefinitions.Count == 0)">
                        Add parameter
                    </OVButton>
                </div>

                @if (_parameters.Count == 0 && !_addingParameter)
                {
                    <div class="ov-api-call-builder__empty">No parameters added. Add only the filters or options this request needs.</div>
                }
                else
                {
                    <div class="ov-api-call-builder__parameter-list">
                        @foreach (var parameter in _parameters)
                        {
                            var definition = DefinitionFor(parameter.Name);
                            <div class="ov-api-call-builder__parameter-row">
                                <div class="ov-api-call-builder__parameter-copy">
                                    <strong>@(definition?.Label ?? parameter.Name)</strong>
                                    @if (!string.IsNullOrWhiteSpace(definition?.Description))
                                    {
                                        <span>@definition.Description</span>
                                    }
                                    <code>@parameter.Name</code>
                                </div>
                                <div class="ov-api-call-builder__parameter-control">
                                    @RenderParameterControl(parameter, definition)
                                    @if (Tokens.Count > 0)
                                    {
                                        <OVSelect T="string" Label="Insert value"
                                                  Value="@((string?)null)"
                                                  ValueChanged="value => InsertToken(parameter.Name, value)"
                                                  Options="@TokenOptions"
                                                  Disabled="@(ReadOnly || Busy || !parameter.Enabled)" />
                                    }
                                </div>
                                <div class="ov-api-call-builder__parameter-actions">
                                    <OVCheckbox Label="Enabled"
                                                Value="@parameter.Enabled"
                                                ValueChanged="value => SetParameterEnabled(parameter.Name, value == true)"
                                                Disabled="@(ReadOnly || Busy)" />
                                    <OVButton Appearance="OVButtonVariant.Subtle" OnClick="_ => RemoveParameter(parameter.Name)" Disabled="@(ReadOnly || Busy)">Remove</OVButton>
                                </div>
                            </div>
                        }
                    </div>
                }

                @if (_addingParameter)
                {
                    <div class="ov-api-call-builder__parameter-draft">
                        <OVSelect T="string" Label="Parameter"
                                  Value="@_pendingParameterName"
                                  ValueChanged="ChoosePendingParameter"
                                  Options="@AvailableParameterOptions"
                                  Disabled="@(ReadOnly || Busy)" />
                        <OVButton Appearance="OVButtonVariant.Secondary" OnClick="CancelAddParameter" Disabled="@(ReadOnly || Busy)">Cancel</OVButton>
                    </div>
                }
            </section>

            <section class="ov-api-call-builder__section ov-api-call-builder__advanced">
                <button type="button"
                        class="ov-api-call-builder__advanced-toggle"
                        aria-expanded="@(_advancedOpen ? "true" : "false")"
                        aria-controls="@AdvancedPanelId"
                        disabled="@(ReadOnly || Busy)"
                        @onclick="ToggleAdvanced">
                    <span>Advanced</span>
                    <span aria-hidden="true">@(_advancedOpen ? "▾" : "▸")</span>
                </button>
                @if (_advancedOpen)
                {
                    <div id="@AdvancedPanelId" class="ov-api-call-builder__advanced-panel">
                        <div class="ov-api-call-builder__advanced-grid">
                            <OVTextField Label="Content type" Value="@_contentType" ValueChanged="OnContentTypeChanged" Placeholder="application/json" Disabled="@(ReadOnly || Busy)" />
                            <OVTextField Label="Timeout (seconds)" Value="@TimeoutText" ValueChanged="OnTimeoutChanged" Placeholder="30" Disabled="@(ReadOnly || Busy)" />
                        </div>
                        <OVTextArea Label="Request body" Value="@_requestBody" ValueChanged="OnRequestBodyChanged" Lines="5" Placeholder="Optional request body" Disabled="@(ReadOnly || Busy)" />
                        <div class="ov-api-call-builder__headers-heading">
                            <strong>Headers</strong>
                            <OVButton Appearance="OVButtonVariant.Subtle" OnClick="AddHeader" Disabled="@(ReadOnly || Busy)">Add header</OVButton>
                        </div>
                        @if (_headers.Count == 0)
                        {
                            <div class="ov-api-call-builder__empty">No custom headers. Authentication remains managed by the selected connection.</div>
                        }
                        else
                        {
                            <div class="ov-api-call-builder__header-list">
                                @foreach (var header in _headers)
                                {
                                    <div class="ov-api-call-builder__header-row">
                                        <OVTextField Label="Header" Value="@header.Name" ValueChanged="value => RenameHeader(header, value)" Disabled="@(ReadOnly || Busy)" />
                                        <OVTextField Label="Value" Value="@header.Value" ValueChanged="value => SetHeaderValue(header, value)" Disabled="@(ReadOnly || Busy)" />
                                        <OVCheckbox Label="Enabled" Value="@header.Enabled" ValueChanged="value => SetHeaderEnabled(header, value == true)" Disabled="@(ReadOnly || Busy)" />
                                        <OVButton Appearance="OVButtonVariant.Subtle" OnClick="_ => RemoveHeader(header)" Disabled="@(ReadOnly || Busy)">Remove</OVButton>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </section>
        </div>

        <aside class="ov-api-call-builder__preview" aria-labelledby="@PreviewHeadingId">
            <section class="ov-api-call-builder__section ov-api-call-builder__preview-card">
                <div class="ov-api-call-builder__section-heading">
                    <div>
                        <h3 id="@PreviewHeadingId">Request preview</h3>
                        <span>Review the resolved request before execution.</span>
                    </div>
                </div>

                @if (SelectedConnection is null)
                {
                    <div class="ov-api-call-builder__empty">Choose a connection to begin building an API call.</div>
                }
                else
                {
                    <div class="ov-api-call-builder__resolved-request">
                        <span class="ov-api-call-builder__method">@_method</span>
                        <strong>@ResolvedAddressWithoutQuery</strong>
                    </div>
                    @if (EnabledParameters.Count > 0)
                    {
                        <dl class="ov-api-call-builder__preview-parameters">
                            @foreach (var parameter in EnabledParameters)
                            {
                                <div><dt>@parameter.Name</dt><dd>@DisplayParameterValue(parameter.Value)</dd></div>
                            }
                        </dl>
                    }
                    <button type="button" class="ov-api-call-builder__raw-toggle" @onclick="ToggleRawRequest" aria-expanded="@(_rawRequestOpen ? "true" : "false")">
                        @(_rawRequestOpen ? "Hide raw request" : "View raw request")
                    </button>
                    @if (_rawRequestOpen)
                    {
                        <code class="ov-api-call-builder__raw-request">@ResolvedAddress</code>
                    }
                }

                <div class="ov-api-call-builder__test-action">
                    <OVButton OnClick="TestCall" Loading="@(TestResult?.State == OVApiTestState.Testing)" Disabled="@(!CanTest || Busy)">Test Call</OVButton>
                </div>
            </section>

            @RenderTestResult()
        </aside>
    </div>

    <footer class="ov-api-call-builder__footer">
        <OVButton Appearance="OVButtonVariant.Secondary" OnClick="RequestCancel" Disabled="@Busy">Cancel</OVButton>
        <OVButton OnClick="Save" Disabled="@(!CanSave || Busy)" Loading="@Busy">Save</OVButton>
    </footer>
</div>

<OVConfirmDialog Open="@_confirmDiscard"
                 OpenChanged="value => _confirmDiscard = value"
                 Title="Discard changes?"
                 Message="Unsaved API call configuration will be lost."
                 ConfirmText="Discard changes"
                 CancelText="Cancel"
                 CloseOnBackdrop="false"
                 Confirmed="ConfirmCancel" />

@code {
    [Parameter] public string Title { get; set; } = "API Call";
    [Parameter] public IReadOnlyList<OVApiConnectionOption> Connections { get; set; } = Array.Empty<OVApiConnectionOption>();
    [Parameter] public IReadOnlyList<OVOption<string>> Methods { get; set; } = DefaultMethods;
    [Parameter] public IReadOnlyList<OVApiParameterDefinition> ParameterDefinitions { get; set; } = Array.Empty<OVApiParameterDefinition>();
    [Parameter] public IReadOnlyList<OVApiTokenOption> Tokens { get; set; } = Array.Empty<OVApiTokenOption>();
    [Parameter] public IReadOnlyList<OVApiCallPreset> Presets { get; set; } = Array.Empty<OVApiCallPreset>();
    [Parameter, EditorRequired] public OVApiCallConfiguration Configuration { get; set; } = EmptyConfiguration;
    [Parameter] public EventCallback<OVApiCallConfiguration> ConfigurationChanged { get; set; }
    [Parameter] public OVApiCallTestResult? TestResult { get; set; }
    [Parameter] public EventCallback<OVApiCallConfiguration> TestRequested { get; set; }
    [Parameter] public EventCallback<OVApiCallConfiguration> SaveRequested { get; set; }
    [Parameter] public EventCallback CancelRequested { get; set; }
    [Parameter] public EventCallback<bool> DirtyChanged { get; set; }
    [Parameter] public bool Dirty { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool ReadOnly { get; set; }

    private static readonly IReadOnlyList<OVOption<string>> DefaultMethods =
    [
        new("GET", "GET"),
        new("POST", "POST"),
        new("PUT", "PUT"),
        new("PATCH", "PATCH"),
        new("DELETE", "DELETE")
    ];

    private static readonly OVApiCallConfiguration EmptyConfiguration = new(null, "GET", string.Empty, [], []);
    private static readonly IReadOnlyList<OVOption<string>> BooleanOptions = [new("true", "Yes"), new("false", "No")];

    private OVApiCallConfiguration? _lastConfiguration;
    private string? _connectionId;
    private string _method = "GET";
    private string _resource = string.Empty;
    private List<OVApiParameterValue> _parameters = [];
    private List<OVApiHeaderValue> _headers = [];
    private string? _requestBody;
    private string? _contentType;
    private int? _timeoutSeconds;
    private bool _addingParameter;
    private string? _pendingParameterName;
    private bool _advancedOpen;
    private bool _rawRequestOpen;
    private bool _technicalDetailsOpen;
    private bool _confirmDiscard;
    private string _responseTab = "structure";

    private string ConnectionHeadingId { get; } = $"ov-api-connection-{Guid.NewGuid():N}";
    private string RequestHeadingId { get; } = $"ov-api-request-{Guid.NewGuid():N}";
    private string ParametersHeadingId { get; } = $"ov-api-parameters-{Guid.NewGuid():N}";
    private string PresetHeadingId { get; } = $"ov-api-presets-{Guid.NewGuid():N}";
    private string PreviewHeadingId { get; } = $"ov-api-preview-{Guid.NewGuid():N}";
    private string AdvancedPanelId { get; } = $"ov-api-advanced-{Guid.NewGuid():N}";

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_lastConfiguration, Configuration)) return;
        _lastConfiguration = Configuration;
        Load(Configuration);
    }

    private void Load(OVApiCallConfiguration configuration)
    {
        _connectionId = configuration.ConnectionId;
        _method = string.IsNullOrWhiteSpace(configuration.Method) ? "GET" : configuration.Method;
        _resource = configuration.Resource ?? string.Empty;
        _parameters = configuration.Parameters.ToList();
        _headers = configuration.Headers.ToList();
        _requestBody = configuration.RequestBody;
        _timeoutSeconds = configuration.TimeoutSeconds;
        _contentType = configuration.ContentType;
    }

    private IReadOnlyList<OVOption<string>> ConnectionOptions => Connections.Select(connection => new OVOption<string>(connection.Id, connection.Name)).ToArray();
    private OVApiConnectionOption? SelectedConnection => Connections.FirstOrDefault(connection => string.Equals(connection.Id, _connectionId, StringComparison.Ordinal));
    private bool ConnectionInvalid => string.IsNullOrWhiteSpace(_connectionId);
    private bool ResourceInvalid => string.IsNullOrWhiteSpace(_resource);
    private bool CanTest => !ReadOnly && !ConnectionInvalid && !ResourceInvalid && !HasDuplicateParameters;
    private bool CanSave => !ReadOnly && !ConnectionInvalid && !ResourceInvalid && !HasDuplicateParameters;
    private bool HasDuplicateParameters => _parameters.GroupBy(parameter => parameter.Name, StringComparer.OrdinalIgnoreCase).Any(group => group.Count() > 1);
    private string TimeoutText => _timeoutSeconds?.ToString(CultureInfo.InvariantCulture) ?? string.Empty;
    private IReadOnlyList<OVApiParameterValue> EnabledParameters => _parameters.Where(parameter => parameter.Enabled && !string.IsNullOrWhiteSpace(parameter.Name)).ToArray();
    private IReadOnlyList<OVApiParameterDefinition> AvailableParameterDefinitions => ParameterDefinitions.Where(definition => !_parameters.Any(parameter => string.Equals(parameter.Name, definition.Name, StringComparison.OrdinalIgnoreCase))).ToArray();
    private IReadOnlyList<OVOption<string>> AvailableParameterOptions => AvailableParameterDefinitions.Select(definition => new OVOption<string>(definition.Name, definition.Label)).ToArray();
    private IReadOnlyList<OVOption<string>> TokenOptions => Tokens.Select(token => new OVOption<string>(token.Value, $"{token.Group} · {token.Label}")).ToArray();
    private string ResolvedAddressWithoutQuery => SelectedConnection is null ? _resource : $"{SelectedConnection.BaseAddress.TrimEnd('/')}/{_resource.TrimStart('/')}";
    private string ResolvedAddress => BuildResolvedAddress();

    private RenderFragment RenderParameterControl(OVApiParameterValue parameter, OVApiParameterDefinition? definition) => builder =>
    {
        var sequence = 0;
        if (definition?.InputKind == OVApiParameterInputKind.Boolean)
        {
            builder.OpenComponent<OVSelect<string>>(sequence++);
            builder.AddAttribute(sequence++, "Label", definition.Label);
            builder.AddAttribute(sequence++, "Value", parameter.Value);
            builder.AddAttribute(sequence++, "ValueChanged", EventCallback.Factory.Create<string?>(this, value => SetParameterValue(parameter.Name, value)));
            builder.AddAttribute(sequence++, "Options", BooleanOptions);
            builder.AddAttribute(sequence++, "Disabled", ReadOnly || Busy || !parameter.Enabled);
            builder.CloseComponent();
            return;
        }
        if (definition?.InputKind == OVApiParameterInputKind.Select && definition.Options is { Count: > 0 })
        {
            builder.OpenComponent<OVSelect<string>>(sequence++);
            builder.AddAttribute(sequence++, "Label", definition.Label);
            builder.AddAttribute(sequence++, "Value", parameter.Value);
            builder.AddAttribute(sequence++, "ValueChanged", EventCallback.Factory.Create<string?>(this, value => SetParameterValue(parameter.Name, value)));
            builder.AddAttribute(sequence++, "Options", definition.Options);
            builder.AddAttribute(sequence++, "Disabled", ReadOnly || Busy || !parameter.Enabled);
            builder.CloseComponent();
            return;
        }
        if (definition?.InputKind == OVApiParameterInputKind.Date)
        {
            builder.OpenComponent<OVDatePicker>(sequence++);
            builder.AddAttribute(sequence++, "Label", definition.Label);
            builder.AddAttribute(sequence++, "Value", ParseDate(parameter.Value));
            builder.AddAttribute(sequence++, "ValueChanged", EventCallback.Factory.Create<DateTime?>(this, value => SetParameterValue(parameter.Name, value?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))));
            builder.AddAttribute(sequence++, "Disabled", ReadOnly || Busy || !parameter.Enabled);
            builder.CloseComponent();
            return;
        }

        builder.OpenComponent<OVTextField>(sequence++);
        builder.AddAttribute(sequence++, "Label", definition?.Label ?? parameter.Name);
        builder.AddAttribute(sequence++, "Value", parameter.Value);
        builder.AddAttribute(sequence++, "ValueChanged", EventCallback.Factory.Create<string?>(this, value => SetParameterValue(parameter.Name, value)));
        builder.AddAttribute(sequence++, "Placeholder", definition?.Placeholder);
        builder.AddAttribute(sequence++, "Immediate", true);
        builder.AddAttribute(sequence++, "Disabled", ReadOnly || Busy || !parameter.Enabled);
        builder.CloseComponent();
    };

    private RenderFragment RenderTestResult() => builder =>
    {
        var result = TestResult;
        if (result is null || result.State == OVApiTestState.NotTested)
        {
            builder.AddMarkupContent(0, "<section class=\"ov-api-call-builder__section ov-api-call-builder__response\"><div class=\"ov-api-call-builder__empty\">Test the request to preview the returned data.</div></section>");
            return;
        }

        builder.OpenElement(1, "section");
        builder.AddAttribute(2, "class", "ov-api-call-builder__section ov-api-call-builder__response");
        builder.AddAttribute(3, "aria-live", "polite");
        builder.OpenElement(4, "div");
        builder.AddAttribute(5, "class", $"ov-api-call-builder__result ov-api-call-builder__result--{result.State.ToString().ToLowerInvariant()}");
        builder.OpenElement(6, "strong");
        builder.AddContent(7, ResultHeading(result));
        builder.CloseElement();
        builder.OpenElement(8, "span");
        builder.AddContent(9, ResultSummary(result));
        builder.CloseElement();
        builder.CloseElement();

        if (result.State == OVApiTestState.Failure)
        {
            if (!string.IsNullOrWhiteSpace(result.FriendlyMessage))
            {
                builder.OpenElement(10, "p");
                builder.AddContent(11, result.FriendlyMessage);
                builder.CloseElement();
            }
            if (!string.IsNullOrWhiteSpace(result.TechnicalDetails))
            {
                builder.OpenElement(12, "button");
                builder.AddAttribute(13, "type", "button");
                builder.AddAttribute(14, "class", "ov-api-call-builder__raw-toggle");
                builder.AddAttribute(15, "onclick", EventCallback.Factory.Create(this, () => _technicalDetailsOpen = !_technicalDetailsOpen));
                builder.AddContent(16, _technicalDetailsOpen ? "Hide technical details" : "View technical details");
                builder.CloseElement();
                if (_technicalDetailsOpen)
                {
                    builder.OpenElement(17, "pre");
                    builder.AddAttribute(18, "class", "ov-api-call-builder__technical-details");
                    builder.AddContent(19, result.TechnicalDetails);
                    builder.CloseElement();
                }
            }
        }
        else if (result.State is OVApiTestState.Success or OVApiTestState.Empty)
        {
            builder.AddContent(20, RenderResponseTabs(result));
        }
        builder.CloseElement();
    };

    private RenderFragment RenderResponseTabs(OVApiCallTestResult result) => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "ov-api-call-builder__response-tabs");
        builder.AddAttribute(2, "role", "tablist");
        foreach (var tab in new[] { (Key: "structure", Label: "Structure"), (Key: "data", Label: "Data"), (Key: "raw", Label: "Raw") })
        {
            builder.OpenElement(3, "button");
            builder.AddAttribute(4, "type", "button");
            builder.AddAttribute(5, "role", "tab");
            builder.AddAttribute(6, "aria-selected", _responseTab == tab.Key ? "true" : "false");
            builder.AddAttribute(7, "class", _responseTab == tab.Key ? "ov-api-call-builder__response-tab is-active" : "ov-api-call-builder__response-tab");
            builder.AddAttribute(8, "onclick", EventCallback.Factory.Create(this, () => _responseTab = tab.Key));
            builder.AddContent(9, tab.Label);
            builder.CloseElement();
        }
        builder.CloseElement();

        builder.OpenElement(10, "div");
        builder.AddAttribute(11, "class", "ov-api-call-builder__response-panel");
        builder.AddAttribute(12, "role", "tabpanel");
        if (_responseTab == "structure")
        {
            if (result.Structure is { Count: > 0 })
            {
                builder.OpenComponent<OVStructuredFieldTree>(13);
                builder.AddAttribute(14, "Nodes", result.Structure);
                builder.AddAttribute(15, "ReadOnly", true);
                builder.AddAttribute(16, "Searchable", true);
                builder.AddAttribute(17, "ShowSelectionCount", false);
                builder.CloseComponent();
            }
            else
                builder.AddContent(18, result.State == OVApiTestState.Empty ? "The request succeeded, but no records were returned. Try changing the request parameters." : "No structure was supplied by the consuming application.");
        }
        else if (_responseTab == "data")
        {
            builder.AddContent(19, RenderSampleTable(result.SampleRows));
        }
        else
        {
            builder.OpenElement(20, "pre");
            builder.AddAttribute(21, "class", "ov-api-call-builder__raw-response");
            builder.AddContent(22, result.RawResponse ?? "No raw response supplied.");
            builder.CloseElement();
        }
        builder.CloseElement();
    };

    private RenderFragment RenderSampleTable(IReadOnlyList<OVApiResponseSampleRow>? rows) => builder =>
    {
        if (rows is not { Count: > 0 })
        {
            builder.AddContent(0, "No sample rows were supplied.");
            return;
        }
        var columns = rows.SelectMany(row => row.Values.Keys).Distinct(StringComparer.Ordinal).Take(8).ToArray();
        builder.OpenElement(1, "div");
        builder.AddAttribute(2, "class", "ov-api-call-builder__sample-wrap");
        builder.OpenElement(3, "table");
        builder.OpenElement(4, "thead"); builder.OpenElement(5, "tr");
        foreach (var column in columns) { builder.OpenElement(6, "th"); builder.AddContent(7, column); builder.CloseElement(); }
        builder.CloseElement(); builder.CloseElement();
        builder.OpenElement(8, "tbody");
        foreach (var row in rows.Take(5))
        {
            builder.OpenElement(9, "tr");
            foreach (var column in columns)
            {
                builder.OpenElement(10, "td");
                builder.AddContent(11, row.Values.TryGetValue(column, out var value) ? value : null);
                builder.CloseElement();
            }
            builder.CloseElement();
        }
        builder.CloseElement(); builder.CloseElement(); builder.CloseElement();
    };

    private OVApiParameterDefinition? DefinitionFor(string name) => ParameterDefinitions.FirstOrDefault(definition => string.Equals(definition.Name, name, StringComparison.OrdinalIgnoreCase));
    private static DateTime? ParseDate(string? value) => DateTime.TryParse(value, CultureInfo.InvariantCulture, DateTimeStyles.None, out var date) ? date : null;
    private static string DisplayParameterValue(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private string BuildResolvedAddress()
    {
        var baseAddress = ResolvedAddressWithoutQuery;
        var query = EnabledParameters
            .Where(parameter => !string.IsNullOrWhiteSpace(parameter.Value))
            .Select(parameter => $"{Uri.EscapeDataString(parameter.Name)}={Uri.EscapeDataString(parameter.Value!)}")
            .ToArray();
        return query.Length == 0 ? baseAddress : $"{baseAddress}?{string.Join("&", query)}";
    }

    private OVApiCallConfiguration Snapshot() => new(_connectionId, _method, _resource, _parameters.ToArray(), _headers.ToArray(), _requestBody, _timeoutSeconds, _contentType);

    private async Task Changed()
    {
        await ConfigurationChanged.InvokeAsync(Snapshot());
        await DirtyChanged.InvokeAsync(true);
    }

    private async Task OnConnectionChanged(string? value) { _connectionId = value; await Changed(); }
    private async Task OnMethodChanged(string? value) { _method = string.IsNullOrWhiteSpace(value) ? "GET" : value; await Changed(); }
    private async Task OnResourceChanged(string? value) { _resource = value ?? string.Empty; await Changed(); }
    private async Task OnRequestBodyChanged(string? value) { _requestBody = value; await Changed(); }
    private async Task OnContentTypeChanged(string? value) { _contentType = value; await Changed(); }
    private async Task OnTimeoutChanged(string? value) { _timeoutSeconds = int.TryParse(value, out var timeout) && timeout > 0 ? timeout : null; await Changed(); }

    private Task BeginAddParameter(MouseEventArgs _) { _addingParameter = true; _pendingParameterName = null; return Task.CompletedTask; }
    private Task CancelAddParameter(MouseEventArgs _) { _addingParameter = false; _pendingParameterName = null; return Task.CompletedTask; }
    private async Task ChoosePendingParameter(string? name)
    {
        _pendingParameterName = name;
        if (string.IsNullOrWhiteSpace(name)) return;
        var definition = DefinitionFor(name);
        var defaultValue = definition?.InputKind == OVApiParameterInputKind.Boolean ? "true" : null;
        _parameters.Add(new OVApiParameterValue(name, defaultValue));
        _addingParameter = false;
        _pendingParameterName = null;
        await Changed();
    }

    private async Task SetParameterValue(string name, string? value)
    {
        var index = _parameters.FindIndex(parameter => string.Equals(parameter.Name, name, StringComparison.OrdinalIgnoreCase));
        if (index < 0) return;
        _parameters[index] = _parameters[index] with { Value = value };
        await Changed();
    }

    private Task InsertToken(string name, string? token)
        => string.IsNullOrWhiteSpace(token) ? Task.CompletedTask : SetParameterValue(name, $"{{{{{token}}}}}");

    private async Task SetParameterEnabled(string name, bool enabled)
    {
        var index = _parameters.FindIndex(parameter => string.Equals(parameter.Name, name, StringComparison.OrdinalIgnoreCase));
        if (index < 0) return;
        _parameters[index] = _parameters[index] with { Enabled = enabled };
        await Changed();
    }

    private async Task RemoveParameter(string name)
    {
        _parameters.RemoveAll(parameter => string.Equals(parameter.Name, name, StringComparison.OrdinalIgnoreCase));
        await Changed();
    }

    private async Task ApplyPreset(OVApiCallPreset preset)
    {
        Load(preset.Configuration);
        _lastConfiguration = null;
        await Changed();
    }

    private Task ToggleAdvanced() { _advancedOpen = !_advancedOpen; return Task.CompletedTask; }
    private Task ToggleRawRequest() { _rawRequestOpen = !_rawRequestOpen; return Task.CompletedTask; }

    private async Task AddHeader(MouseEventArgs _)
    {
        var suffix = 1;
        string name;
        do name = $"Header {suffix++}"; while (_headers.Any(header => string.Equals(header.Name, name, StringComparison.OrdinalIgnoreCase)));
        _headers.Add(new OVApiHeaderValue(name));
        await Changed();
    }

    private async Task RenameHeader(OVApiHeaderValue header, string? value)
    {
        var index = _headers.IndexOf(header); if (index < 0) return;
        _headers[index] = header with { Name = value ?? string.Empty };
        await Changed();
    }
    private async Task SetHeaderValue(OVApiHeaderValue header, string? value) { var index = _headers.IndexOf(header); if (index < 0) return; _headers[index] = header with { Value = value }; await Changed(); }
    private async Task SetHeaderEnabled(OVApiHeaderValue header, bool enabled) { var index = _headers.IndexOf(header); if (index < 0) return; _headers[index] = header with { Enabled = enabled }; await Changed(); }
    private async Task RemoveHeader(OVApiHeaderValue header) { _headers.Remove(header); await Changed(); }

    private Task TestCall(MouseEventArgs _) => TestRequested.InvokeAsync(Snapshot());
    private Task Save(MouseEventArgs _) => SaveRequested.InvokeAsync(Snapshot());

    private Task RequestCancel(MouseEventArgs _)
    {
        if (Dirty) { _confirmDiscard = true; return Task.CompletedTask; }
        return CancelRequested.InvokeAsync();
    }

    private async Task ConfirmCancel()
    {
        _confirmDiscard = false;
        await CancelRequested.InvokeAsync();
    }

    private static string ResultHeading(OVApiCallTestResult result) => result.State switch
    {
        OVApiTestState.Testing => "Testing connection…",
        OVApiTestState.Success => "Request successful",
        OVApiTestState.Empty => "Request successful",
        OVApiTestState.Failure => "Request failed",
        _ => "Request"
    };

    private static string ResultSummary(OVApiCallTestResult result)
    {
        var parts = new List<string>();
        if (result.StatusCode.HasValue) parts.Add($"{result.StatusCode} {result.StatusText}".Trim());
        if (result.RecordCount.HasValue) parts.Add($"{result.RecordCount:N0} records returned");
        if (result.DurationMilliseconds.HasValue) parts.Add($"{result.DurationMilliseconds:N0} ms");
        return parts.Count == 0 ? result.FriendlyMessage ?? string.Empty : string.Join(" · ", parts);
    }
}
