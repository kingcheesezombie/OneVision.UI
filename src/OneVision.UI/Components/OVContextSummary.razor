<section class="@RootClass" aria-label="@AriaLabel">
    @if (Loading)
    {
        <div class="ov-context-summary__loading" role="status" aria-label="Loading summary">
            <OVSkeleton Width="120px" Height="36px" />
            <OVSkeleton Width="120px" Height="36px" />
            <OVSkeleton Width="120px" Height="36px" />
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <OVAlert Tone="OVAlertTone.Error">@ErrorMessage</OVAlert>
    }
    else if (Items.Count == 0 && Process is null)
    {
        <OVEmptyState Title="@EmptyTitle" Description="@EmptyDescription" />
    }
    else
    {
        <div class="ov-context-summary__items">
            @foreach (var item in Items)
            {
                <div class="ov-context-summary__item">
                    <span class="ov-context-summary__label">@item.Label</span>
                    @if (item.Tone is not null)
                    {
                        <OVPill Text="@item.Value" Role="OVPillRole.Status" Tone="@item.Tone.Value" />
                    }
                    else
                    {
                        <strong class="ov-context-summary__value">@item.Value</strong>
                    }
                    @if (!string.IsNullOrWhiteSpace(item.SupportingText))
                    {
                        <span class="ov-context-summary__supporting">@item.SupportingText</span>
                    }
                </div>
            }
        </div>
        @if (Process is not null)
        {
            <div class="ov-context-summary__process">@Process</div>
        }
    }
</section>

@code {
    [Parameter] public IReadOnlyList<OVContextSummaryItem> Items { get; set; } = [];
    [Parameter] public RenderFragment? Process { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public string EmptyTitle { get; set; } = "No summary available";
    [Parameter] public string EmptyDescription { get; set; } = "There is no contextual summary to show.";
    [Parameter] public string AriaLabel { get; set; } = "Context summary";
    [Parameter] public string? Class { get; set; }

    private string RootClass => string.IsNullOrWhiteSpace(Class) ? "ov-context-summary" : $"ov-context-summary {Class}";
}
