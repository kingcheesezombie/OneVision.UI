@using OneVision.UI.Demo

@if (Definition.Reference == "OVC-BUTTON")
{
    @RenderButton()
}
else if (Definition.Reference == "OVC-STATUS-PILL")
{
    @RenderStatusPill()
}
else if (Definition.Reference == "OVC-MULTI-SELECT")
{
    @RenderMultiSelect()
}
else if (Definition.Reference == "OVC-TREE")
{
    @RenderTree()
}
else if (Definition.Reference == "OVC-STRUCTURED-FIELD-TREE")
{
    @RenderStructuredTree()
}
else
{
    @RenderPending()
}

@code {
    [Parameter, EditorRequired] public ComponentDefinition Definition { get; set; } = default!;
    [Parameter] public string State { get; set; } = "Default";

    private readonly string[] _multiOptions = ["Birmingham", "Solihull", "Dudley", "Sandwell", "Walsall", "Wolverhampton"];
    private readonly HashSet<string> _multiSelected = ["Birmingham", "Solihull"];
    private string _multiSearch = string.Empty;

    private string _treeSearch = string.Empty;
    private bool _treeRootOpen = true;
    private bool _treeServicesOpen = true;
    private string _treeSelection = "Community Nursing";
    private readonly HashSet<string> _checkedTreeNodes = ["Team North"];

    private bool _personOpen = true;
    private bool _nameOpen = true;
    private bool _addressesOpen = true;
    private bool _arrayItemOpen = true;
    private string _structuredSelection = "$.person.name.first";

    private bool IsDisabled => State.Contains("Disabled", StringComparison.OrdinalIgnoreCase);

    private RenderFragment DemoShell(RenderFragment content, string status = "Contract demo") => @<MudPaper Class="ov-component-demo" Elevation="0">
        <div class="ov-component-demo__header">
            <div>
                <MudText Typo="Typo.h6">@Definition.Name</MudText>
                <MudText Typo="Typo.caption">@Definition.Reference · @State</MudText>
            </div>
            <OVStatusPill Text="@status" Tone="@(status == "Implemented" ? OVStatusPill.OVStatusTone.Success : OVStatusPill.OVStatusTone.Info)" />
        </div>
        <div class="ov-component-demo__body">@content</div>
    </MudPaper>;

    private RenderFragment RenderButton() => DemoShell(@<div class="ov-component-demo-row ov-demo-wrap">
        <OVButton Disabled="@IsDisabled">Primary action</OVButton>
        <OVButton Variant="Variant.Outlined" Disabled="@IsDisabled">Secondary</OVButton>
        <OVButton Variant="Variant.Text" Disabled="@IsDisabled">Text action</OVButton>
    </div>, "Implemented");

    private RenderFragment RenderStatusPill() => DemoShell(@<div class="ov-component-demo-row ov-demo-wrap">
        <OVStatusPill Text="Neutral" Tone="OVStatusPill.OVStatusTone.Neutral" />
        <OVStatusPill Text="Information" Tone="OVStatusPill.OVStatusTone.Info" />
        <OVStatusPill Text="Success" Tone="OVStatusPill.OVStatusTone.Success" />
        <OVStatusPill Text="Warning" Tone="OVStatusPill.OVStatusTone.Warning" />
        <OVStatusPill Text="Danger" Tone="OVStatusPill.OVStatusTone.Danger" />
    </div>, "Implemented");

    private IEnumerable<string> FilteredMultiOptions => _multiOptions.Where(option =>
        string.IsNullOrWhiteSpace(_multiSearch) || option.Contains(_multiSearch, StringComparison.OrdinalIgnoreCase));

    private RenderFragment RenderMultiSelect() => DemoShell(@<div class="ov-demo-multiselect">
        <label class="ov-demo-field-label">Areas</label>
        <div class="ov-demo-multiselect__control">
            <div class="ov-demo-multiselect__chips">
                @if (_multiSelected.Count == 0)
                {
                    <span class="ov-pattern-demo__muted">No areas selected</span>
                }
                else
                {
                    @foreach (var value in _multiSelected.OrderBy(value => value))
                    {
                        <span class="ov-demo-selection-chip">@value <button type="button" title="Remove @value" @onclick="() => RemoveMulti(value)">×</button></span>
                    }
                }
            </div>
            <MudTextField @bind-Value="_multiSearch" Immediate="true" Placeholder="Search areas" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@IsDisabled" />
            <div class="ov-demo-multiselect__options">
                @foreach (var option in FilteredMultiOptions)
                {
                    <label class="ov-demo-multiselect__option">
                        <input type="checkbox" checked="@_multiSelected.Contains(option)" disabled="@IsDisabled" @onchange="() => ToggleMulti(option)" />
                        <span>@option</span>
                    </label>
                }
            </div>
        </div>
        <div class="ov-demo-multiselect__summary">@_multiSelected.Count selected · selections can be removed without reopening the option list.</div>
    </div>);

    private void ToggleMulti(string value)
    {
        if (!_multiSelected.Add(value)) _multiSelected.Remove(value);
    }

    private void RemoveMulti(string value) => _multiSelected.Remove(value);

    private bool TreeSearching => !string.IsNullOrWhiteSpace(_treeSearch);
    private bool TreeMatch(string text) => string.IsNullOrWhiteSpace(_treeSearch) || text.Contains(_treeSearch, StringComparison.OrdinalIgnoreCase);
    private bool ServicesMatch => TreeMatch("Clinical Services") || TreeMatch("Community Nursing") || TreeMatch("Therapies") || TeamMatch;
    private bool TeamMatch => TreeMatch("Teams") || TreeMatch("Team North") || TreeMatch("Team South") || TreeMatch("Archived Service");

    private RenderFragment RenderTree() => DemoShell(@<div class="ov-demo-tree-layout">
        <div class="ov-structured-toolbar">
            <MudTextField @bind-Value="_treeSearch" Immediate="true" Placeholder="Search hierarchy" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <span class="ov-pattern-demo__muted">Selection and expansion are independent</span>
        </div>
        <div class="ov-demo-tree">
            <button type="button" class="@TreeNodeClass("Organisation")" @onclick="ToggleTreeRoot"><span>@(_treeRootOpen || TreeSearching ? "▾" : "▸")</span><strong>Organisation</strong></button>
            @if ((_treeRootOpen || TreeSearching) && ServicesMatch)
            {
                <button type="button" class="@TreeNodeClass("Clinical Services", 1)" @onclick="ToggleTreeServices"><span>@(_treeServicesOpen || TreeSearching ? "▾" : "▸")</span><strong>Clinical Services</strong></button>
                @if (_treeServicesOpen || TreeSearching)
                {
                    @if (TreeMatch("Community Nursing"))
                    {
                        <button type="button" class="@TreeNodeClass("Community Nursing", 2)" @onclick="() => SelectTree("Community Nursing")"><span></span><strong>Community Nursing</strong></button>
                    }
                    @if (TreeMatch("Therapies"))
                    {
                        <button type="button" class="@TreeNodeClass("Therapies", 2)" @onclick="() => SelectTree("Therapies")"><span></span><strong>Therapies</strong></button>
                    }
                    @if (TeamMatch)
                    {
                        <div class="ov-demo-tree-check-row ov-depth-2"><span>▾</span><strong>Teams</strong></div>
                        <label class="ov-demo-tree-check-row ov-depth-3"><input type="checkbox" checked="@_checkedTreeNodes.Contains("Team North")" @onchange="() => ToggleTreeCheck("Team North")" /><span>Team North</span></label>
                        <label class="ov-demo-tree-check-row ov-depth-3"><input type="checkbox" checked="@_checkedTreeNodes.Contains("Team South")" @onchange="() => ToggleTreeCheck("Team South")" /><span>Team South</span></label>
                        <button type="button" disabled class="ov-structured-node ov-structured-node--leaf ov-depth-3"><span></span><strong>Archived Service</strong><small>Disabled</small></button>
                    }
                }
            }
        </div>
        <div class="ov-demo-tree-summary"><strong>Selected:</strong> @_treeSelection · <strong>Checked:</strong> @(_checkedTreeNodes.Count == 0 ? "None" : string.Join(", ", _checkedTreeNodes.OrderBy(x => x)))</div>
    </div>);

    private string TreeNodeClass(string node, int depth = 0)
    {
        var type = node is "Organisation" or "Clinical Services" ? "ov-structured-node--container" : "ov-structured-node--leaf";
        var selected = node == _treeSelection ? " ov-structured-node--selected" : string.Empty;
        var depthClass = depth > 0 ? $" ov-depth-{depth}" : string.Empty;
        return $"ov-structured-node {type}{selected}{depthClass}";
    }

    private void ToggleTreeRoot() => _treeRootOpen = !_treeRootOpen;
    private void ToggleTreeServices() => _treeServicesOpen = !_treeServicesOpen;
    private void SelectTree(string value) => _treeSelection = value;
    private void ToggleTreeCheck(string value)
    {
        if (!_checkedTreeNodes.Add(value)) _checkedTreeNodes.Remove(value);
    }

    private bool IsSearchingTree => !string.IsNullOrWhiteSpace(_treeSearch);
    private bool PersonBranchMatches => IsSearchMatch("person", "$.person") || NameBranchMatches || AddressBranchMatches;
    private bool NameBranchMatches => IsSearchMatch("name", "$.person.name") || IsSearchMatch("first", "$.person.name.first") || IsSearchMatch("surname", "$.person.name.surname");
    private bool AddressBranchMatches => IsSearchMatch("addresses", "$.person.addresses") || IsSearchMatch("postcode", "$.person.addresses[].postcode") || IsSearchMatch("type", "$.person.addresses[].type");

    private RenderFragment RenderStructuredTree() => DemoShell(@<div>
        <div class="ov-structured-toolbar"><MudTextField @bind-Value="_treeSearch" Immediate="true" Placeholder="Search field name or path" Variant="Variant.Outlined" Margin="Margin.Dense" /><span class="ov-pattern-demo__muted">Selection mode: LeafOnly</span></div>
        <div class="ov-structured-layout">
            <div class="ov-structured-json"><div class="ov-structured-pane-title">Incoming JSON</div><pre class="ov-code">{
  "person": {
    "name": { "first": "Steve", "surname": "Example" },
    "addresses": [{ "postcode": "B1 1AA", "type": "Home" }]
  }
}</pre></div>
            <div class="ov-structured-tree"><div class="ov-structured-pane-title">Field structure</div>
                @if (PersonBranchMatches)
                {
                    <button type="button" class="ov-structured-node ov-structured-node--container" @onclick="TogglePerson"><span>@(_personOpen || IsSearchingTree ? "▾" : "▸")</span><strong>person</strong><small>Object</small></button>
                }
                @if ((_personOpen || IsSearchingTree) && PersonBranchMatches)
                {
                    @if (NameBranchMatches)
                    {
                        <button type="button" class="ov-structured-node ov-structured-node--container ov-depth-1" @onclick="ToggleName"><span>@(_nameOpen || IsSearchingTree ? "▾" : "▸")</span><strong>name</strong><small>Object</small></button>
                    }
                    @if ((_nameOpen || IsSearchingTree) && NameBranchMatches)
                    {
                        @if (IsSearchMatch("first", "$.person.name.first")) { <button type="button" class="@StructuredLeafClass("$.person.name.first")" @onclick="() => _structuredSelection = "$.person.name.first""><span></span><strong>first</strong><small>String</small></button> }
                        @if (IsSearchMatch("surname", "$.person.name.surname")) { <button type="button" class="@StructuredLeafClass("$.person.name.surname")" @onclick="() => _structuredSelection = "$.person.name.surname""><span></span><strong>surname</strong><small>String</small></button> }
                    }
                    @if (AddressBranchMatches)
                    {
                        <button type="button" class="ov-structured-node ov-structured-node--container ov-depth-1" @onclick="ToggleAddresses"><span>@(_addressesOpen || IsSearchingTree ? "▾" : "▸")</span><strong>addresses</strong><small>Array</small></button>
                    }
                    @if ((_addressesOpen || IsSearchingTree) && AddressBranchMatches)
                    {
                        <button type="button" class="ov-structured-node ov-structured-node--container ov-depth-2" @onclick="ToggleArrayItem"><span>@(_arrayItemOpen || IsSearchingTree ? "▾" : "▸")</span><strong>[]</strong><small>Object item</small></button>
                        @if (_arrayItemOpen || IsSearchingTree)
                        {
                            @if (IsSearchMatch("postcode", "$.person.addresses[].postcode")) { <button type="button" class="@StructuredLeafClass("$.person.addresses[].postcode")" @onclick="() => _structuredSelection = "$.person.addresses[].postcode""><span></span><strong>postcode</strong><small>String</small></button> }
                            @if (IsSearchMatch("type", "$.person.addresses[].type")) { <button type="button" class="@StructuredLeafClass("$.person.addresses[].type")" @onclick="() => _structuredSelection = "$.person.addresses[].type""><span></span><strong>type</strong><small>String</small></button> }
                        }
                    }
                }
            </div>
            <div class="ov-structured-selection"><div class="ov-structured-pane-title">Selection</div><div class="ov-demo-keyvalue"><span>Path</span><strong>@_structuredSelection</strong></div><div class="ov-demo-keyvalue"><span>Selectable</span><strong>LeafOnly</strong></div><MudText Typo="Typo.body2" Class="mt-4">Search reveals matching ancestor branches automatically; structural expansion does not select nodes.</MudText></div>
        </div>
    </div>);

    private bool IsSearchMatch(string name, string path)
        => string.IsNullOrWhiteSpace(_treeSearch) || name.Contains(_treeSearch, StringComparison.OrdinalIgnoreCase) || path.Contains(_treeSearch, StringComparison.OrdinalIgnoreCase);

    private string StructuredLeafClass(string path)
        => path == _structuredSelection ? "ov-structured-node ov-structured-node--leaf ov-structured-node--selected ov-depth-3" : "ov-structured-node ov-structured-node--leaf ov-depth-3";

    private void TogglePerson() => _personOpen = !_personOpen;
    private void ToggleName() => _nameOpen = !_nameOpen;
    private void ToggleAddresses() => _addressesOpen = !_addressesOpen;
    private void ToggleArrayItem() => _arrayItemOpen = !_arrayItemOpen;

    private RenderFragment RenderPending() => @<MudPaper Class="ov-component-demo" Elevation="0">
        <div class="ov-component-demo__header">
            <div><MudText Typo="Typo.h6">@Definition.Name</MudText><MudText Typo="Typo.caption">@Definition.Reference</MudText></div>
            <OVStatusPill Text="Contract defined · implementation pending" Tone="OVStatusPill.OVStatusTone.Neutral" />
        </div>
        <div class="ov-component-demo__body">
            <div class="ov-contract-pending">
                <OVIcon Icon="OneVisionIcon.Info" />
                <div><strong>No substitute preview is shown.</strong><p>This OVC has a defined contract, but OneVision.UI does not yet contain a first-class implementation or a dedicated behavioural contract demo. The previous generic preview was removed because it did not accurately represent this component.</p></div>
            </div>
        </div>
    </MudPaper>;
}
