@using OneVision.UI.Iconography

<nav class="@RootClass" aria-label="@AriaLabel">
    <span class="ov-pagination__summary">@Summary</span>
    <div class="ov-pagination__actions">
        <OVIconButton Icon="OneVisionIcon.ChevronLeft" Label="Previous page" Disabled="@(Page <= 1 || TotalPages <= 1)" OnClick="Previous" />
        <span class="ov-pagination__page">Page @DisplayPage of @DisplayTotalPages</span>
        <OVIconButton Icon="OneVisionIcon.ChevronRight" Label="Next page" Disabled="@(TotalPages <= 1 || Page >= TotalPages)" OnClick="Next" />
    </div>
</nav>

@code {
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public int TotalPages { get; set; }
    [Parameter] public long TotalCount { get; set; }
    [Parameter] public int PageSize { get; set; } = 25;
    [Parameter] public EventCallback<int> PageChanged { get; set; }
    [Parameter] public string AriaLabel { get; set; } = "Pagination";
    [Parameter] public string? Class { get; set; }

    private int DisplayTotalPages => Math.Max(1, TotalPages);
    private int DisplayPage => Math.Clamp(Page, 1, DisplayTotalPages);
    private string Summary => TotalCount == 1 ? "1 item" : $"{TotalCount:N0} items";
    private string RootClass => string.IsNullOrWhiteSpace(Class) ? "ov-pagination" : $"ov-pagination {Class}";

    private Task Previous(MouseEventArgs _) => PageChanged.InvokeAsync(Math.Max(1, DisplayPage - 1));
    private Task Next(MouseEventArgs _) => PageChanged.InvokeAsync(Math.Min(DisplayTotalPages, DisplayPage + 1));
}
