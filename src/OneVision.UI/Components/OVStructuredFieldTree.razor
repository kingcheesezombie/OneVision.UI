<OVTree Nodes="@TreeNodes"
        SelectionMode="@TreeSelectionMode"
        Searchable="@Searchable"
        ReadOnly="@ReadOnly"
        SearchPlaceholder="Search field name or path"
        SelectedKeys="@SelectedKeys"
        SelectedKeysChanged="@SelectedKeysChanged"
        FocusedKey="@FocusedKey"
        FocusedKeyChanged="@FocusedKeyChanged"
        ShowSelectionCount="@ShowSelectionCount"
        CanDrag="@CanDragTreeNode"
        DragContext="@DragContext"
        DragStarted="@OnTreeDragStarted"
        DragEnded="@DragEnded"
        DropMode="@DropMode"
        CanDrop="@CanDropTreeNode"
        DragEntered="@OnTreeDragEntered"
        DragLeft="@OnTreeDragLeft"
        Dropped="@OnTreeDropped"
        Class="@Class">
    <NodeActions Context="treeNode">
        @if (RecordCollectionSelectionMode == OVStructuredRecordCollectionSelectionMode.SingleArray && Find(treeNode.Key) is { } structuredNode && structuredNode.Kind == OVStructuredNodeKind.Array)
        {
            @if (IsSelectedRecordCollection(structuredNode))
            {
                <OVPill Text="Record collection" Role="OVPillRole.Status" Tone="OVPillTone.Info" Locked="true" />
            }
            else if (!ReadOnly && !structuredNode.Disabled)
            {
                <button type="button"
                        class="ov-structured-field-tree__record-action"
                        aria-label="@($"Set {structuredNode.Name} as record collection")"
                        @onclick="@(() => SelectRecordCollection(structuredNode))">
                    Set record collection
                </button>
            }
        }
    </NodeActions>
</OVTree>

@code {
    [Parameter] public IReadOnlyList<OVStructuredFieldNode> Nodes { get; set; } = [];
    [Parameter] public OVStructuredSelectionMode SelectionMode { get; set; } = OVStructuredSelectionMode.LeafOnly;
    [Parameter] public bool Searchable { get; set; } = true;
    [Parameter] public bool ShowSelectionCount { get; set; } = true;
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Draggable { get; set; }
    [Parameter] public string? DragContext { get; set; }
    [Parameter] public EventCallback<OVStructuredFieldNode> DragStarted { get; set; }
    [Parameter] public EventCallback DragEnded { get; set; }
    [Parameter] public bool DropMode { get; set; }
    [Parameter] public Func<OVStructuredFieldNode, bool>? CanDrop { get; set; }
    [Parameter] public EventCallback<OVStructuredFieldNode> DragEntered { get; set; }
    [Parameter] public EventCallback<OVStructuredFieldNode> DragLeft { get; set; }
    [Parameter] public EventCallback<OVStructuredFieldNode> Dropped { get; set; }
    [Parameter] public Func<OVStructuredFieldNode, string?>? EndText { get; set; }
    [Parameter] public IReadOnlyCollection<string> SelectedKeys { get; set; } = Array.Empty<string>();
    [Parameter] public EventCallback<IReadOnlyCollection<string>> SelectedKeysChanged { get; set; }
    [Parameter] public string? FocusedKey { get; set; }
    [Parameter] public EventCallback<string?> FocusedKeyChanged { get; set; }
    [Parameter] public OVStructuredRecordCollectionSelectionMode RecordCollectionSelectionMode { get; set; } = OVStructuredRecordCollectionSelectionMode.None;
    [Parameter] public string? SelectedRecordCollectionPath { get; set; }
    [Parameter] public EventCallback<string?> SelectedRecordCollectionPathChanged { get; set; }
    [Parameter] public string? Class { get; set; }

    private OVTreeSelectionMode TreeSelectionMode => SelectionMode switch
    {
        OVStructuredSelectionMode.SingleLeaf => OVTreeSelectionMode.SingleLeaf,
        OVStructuredSelectionMode.LeafOnly => OVTreeSelectionMode.LeafOnly,
        _ => OVTreeSelectionMode.Multiple
    };

    private IReadOnlyList<OVTreeNode> _treeNodes = Array.Empty<OVTreeNode>();
    private int? _treeSignature;
    private string? _lastInvalidRecordCollectionPath;
    private IReadOnlyList<OVTreeNode> TreeNodes => _treeNodes;

    protected override async Task OnParametersSetAsync()
    {
        var signature = BuildTreeSignature();
        if (_treeSignature != signature)
        {
            _treeSignature = signature;
            _treeNodes = Nodes.Select(ToTreeNode).ToArray();
        }

        if (RecordCollectionSelectionMode == OVStructuredRecordCollectionSelectionMode.None || string.IsNullOrWhiteSpace(SelectedRecordCollectionPath))
        {
            _lastInvalidRecordCollectionPath = null;
            return;
        }

        var resolved = OVStructuredRecordCollectionSemantics.ResolveSelectedPath(Nodes, RecordCollectionSelectionMode, SelectedRecordCollectionPath);
        if (resolved is not null)
        {
            _lastInvalidRecordCollectionPath = null;
            return;
        }

        if (!string.Equals(_lastInvalidRecordCollectionPath, SelectedRecordCollectionPath, StringComparison.Ordinal))
        {
            _lastInvalidRecordCollectionPath = SelectedRecordCollectionPath;
            await SelectedRecordCollectionPathChanged.InvokeAsync(null);
        }
    }

    private int BuildTreeSignature()
    {
        var hash = new HashCode();
        AddNodeSignatures(Nodes, ref hash);
        return hash.ToHashCode();
    }

    private void AddNodeSignatures(IEnumerable<OVStructuredFieldNode> nodes, ref HashCode hash)
    {
        foreach (var node in nodes)
        {
            hash.Add(node.Key, StringComparer.Ordinal);
            hash.Add(node.Name, StringComparer.Ordinal);
            hash.Add(node.Path, StringComparer.Ordinal);
            hash.Add(node.Kind);
            hash.Add(node.DataType);
            hash.Add(node.Disabled);
            hash.Add(EndText?.Invoke(node) ?? Describe(node), StringComparer.Ordinal);
            hash.Add(node.Children.Count);
            AddNodeSignatures(node.Children, ref hash);
        }
    }

    private OVTreeNode ToTreeNode(OVStructuredFieldNode node)
        => new(node.Key, node.Name, node.Children.Select(ToTreeNode).ToArray(), node.Disabled, EndText?.Invoke(node) ?? Describe(node), $"{node.Path} {Describe(node)}");

    private bool CanDragTreeNode(OVTreeNode node)
    {
        if (!Draggable || ReadOnly) return false;
        var source = Find(node.Key);
        return source is { Disabled: false, Kind: OVStructuredNodeKind.Primitive };
    }

    private bool CanDropTreeNode(OVTreeNode node)
    {
        if (!DropMode || ReadOnly) return false;
        var target = Find(node.Key);
        return target is { Disabled: false, Kind: OVStructuredNodeKind.Primitive } && (CanDrop?.Invoke(target) ?? true);
    }

    private bool IsSelectedRecordCollection(OVStructuredFieldNode node)
        => OVStructuredRecordCollectionSemantics.IsSelected(node, RecordCollectionSelectionMode, SelectedRecordCollectionPath);

    private Task SelectRecordCollection(OVStructuredFieldNode node)
    {
        var selectedPath = OVStructuredRecordCollectionSemantics.SelectPath(Nodes, RecordCollectionSelectionMode, SelectedRecordCollectionPath, node.Path, ReadOnly);
        return string.Equals(selectedPath, SelectedRecordCollectionPath, StringComparison.Ordinal)
            ? Task.CompletedTask
            : SelectedRecordCollectionPathChanged.InvokeAsync(selectedPath);
    }

    private Task OnTreeDragStarted(OVTreeNode node) => Find(node.Key) is { } source ? DragStarted.InvokeAsync(source) : Task.CompletedTask;
    private Task OnTreeDragEntered(OVTreeNode node) => Find(node.Key) is { } target ? DragEntered.InvokeAsync(target) : Task.CompletedTask;
    private Task OnTreeDragLeft(OVTreeNode node) => Find(node.Key) is { } target ? DragLeft.InvokeAsync(target) : Task.CompletedTask;
    private Task OnTreeDropped(OVTreeNode node) => Find(node.Key) is { } target ? Dropped.InvokeAsync(target) : Task.CompletedTask;
    private OVStructuredFieldNode? Find(string key) => Flatten(Nodes).FirstOrDefault(item => string.Equals(item.Key, key, StringComparison.Ordinal));

    private static IEnumerable<OVStructuredFieldNode> Flatten(IEnumerable<OVStructuredFieldNode> nodes)
    {
        foreach (var node in nodes)
        {
            yield return node;
            foreach (var child in Flatten(node.Children)) yield return child;
        }
    }

    private static string Describe(OVStructuredFieldNode node)
    {
        if (node.IsEmptyContainer) return node.Kind == OVStructuredNodeKind.Array ? "Empty array" : "Empty object";
        return node.Kind switch { OVStructuredNodeKind.Object => "Object", OVStructuredNodeKind.Array => "Array", _ => node.DataType.ToString() };
    }
}