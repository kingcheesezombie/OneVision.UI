<OVListPage Title="@Title" Description="@Description"
            Actions="@TopActions"
            Toolbar="@CatalogueToolbar"
            Pagination="@CataloguePagination"
            Refreshing="@(Refreshing && !Loading && string.IsNullOrWhiteSpace(ErrorMessage))"
            RefreshErrorMessage="@RefreshErrorMessage">
    <ChildContent>
        <div class="ov-catalogue-manager" aria-busy="@(Loading || Refreshing ? "true" : null)">
            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="ov-catalogue-manager__feedback" role="alert">
                    <OVAlert Tone="OVAlertTone.Error">@ErrorMessage</OVAlert>
                    @if (RetryRequested.HasDelegate)
                    {
                        <OVButton Appearance="OVButtonVariant.Secondary" OnClick="RetryClicked">Retry</OVButton>
                    }
                </div>
            }
            else if (Loading)
            {
                <OVProgress Mode="OVProgressMode.Indeterminate" Label="@LoadingLabel" />
            }
            else if (Empty)
            {
                <OVEmptyState Title="@EmptyTitle" Description="@EmptyDescription">
                    <Action>
                        @if (!ReadOnly && AddRequested.HasDelegate)
                        {
                            <OVButton OnClick="AddClicked">@AddLabel</OVButton>
                        }
                    </Action>
                </OVEmptyState>
            }
            else if (NoResults)
            {
                <OVEmptyState Title="@NoResultsTitle" Description="@NoResultsDescription" />
            }
            else
            {
                <OVDataGrid AriaLabel="@ResultsAriaLabel">@GridContent</OVDataGrid>
            }
        </div>
    </ChildContent>
</OVListPage>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public string ItemName { get; set; } = "Item";
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public EventCallback AddRequested { get; set; }
    [Parameter] public bool SearchEnabled { get; set; } = true;
    [Parameter] public string? SearchValue { get; set; }
    [Parameter] public EventCallback<string?> SearchValueChanged { get; set; }
    [Parameter] public string SearchPlaceholder { get; set; } = "Search...";
    [Parameter] public string SearchLabel { get; set; } = "Search catalogue";
    [Parameter] public RenderFragment? Filters { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool Refreshing { get; set; }
    [Parameter] public string? RefreshErrorMessage { get; set; }
    [Parameter] public EventCallback RetryRequested { get; set; }
    [Parameter] public string LoadingLabel { get; set; } = "Loading catalogue…";
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public bool Empty { get; set; }
    [Parameter] public string EmptyTitle { get; set; } = "No items have been configured";
    [Parameter] public string EmptyDescription { get; set; } = "Add an item to begin configuring this catalogue.";
    [Parameter] public bool NoResults { get; set; }
    [Parameter] public string NoResultsTitle { get; set; } = "No matching items";
    [Parameter] public string NoResultsDescription { get; set; } = "No items match the current search or filters.";
    [Parameter] public string ResultsAriaLabel { get; set; } = "Catalogue entries";
    [Parameter, EditorRequired] public RenderFragment GridContent { get; set; } = default!;
    [Parameter] public bool ShowPagination { get; set; } = true;
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public int TotalPages { get; set; } = 1;
    [Parameter] public long TotalCount { get; set; }
    [Parameter] public int PageSize { get; set; } = 25;
    [Parameter] public EventCallback<int> PageChanged { get; set; }
    [Parameter] public string PaginationAriaLabel { get; set; } = "Catalogue pagination";

    private bool CanAdd => !ReadOnly && AddRequested.HasDelegate;
    private RenderFragment? TopActions => CanAdd && !Empty
        ? @<OVButton OnClick="AddClicked">@AddLabel</OVButton> : null;
    private RenderFragment? CatalogueToolbar => !SearchEnabled && Filters is null ? null : @<div class="ov-catalogue-manager__toolbar" aria-label="Catalogue toolbar">
        @if (SearchEnabled)
        {
            <div class="ov-catalogue-manager__search" aria-label="@SearchLabel">
                <OVSearchBox Value="@SearchValue" ValueChanged="@SearchValueChanged" Placeholder="@SearchPlaceholder" />
            </div>
        }
        @if (Filters is not null)
        {
            <div class="ov-catalogue-manager__filters" aria-label="Catalogue filters">@Filters</div>
        }
    </div>;
    private RenderFragment? CataloguePagination => ShowPagination && !Loading &&
        string.IsNullOrWhiteSpace(ErrorMessage) && !Empty && !NoResults
        ? @<OVPagination Page="@Page" TotalPages="@TotalPages"
                        TotalCount="@TotalCount" PageSize="@PageSize"
                        PageChanged="@PageChanged" AriaLabel="@PaginationAriaLabel" />
        : null;
    private Task RetryClicked(MouseEventArgs _) => RetryRequested.InvokeAsync();
    private string AddLabel => $"Add {ItemName}";
    private Task AddClicked(MouseEventArgs _) => AddRequested.InvokeAsync();
}
