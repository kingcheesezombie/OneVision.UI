@using Microsoft.JSInterop
@using OneVision.UI.Iconography
@implements IAsyncDisposable
@inject IJSRuntime JS

@if (Open)
{
    <div class="@BackdropClass" role="presentation" @onclick="BackdropClicked">
        <section class="@SurfaceClass"
                 @ref="_surface"
                 tabindex="-1"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="@TitleId"
                 aria-describedby="@DescriptionIdOrNull"
                 aria-busy="@(Busy ? "true" : null)"
                 @onclick:stopPropagation="true">
            <header class="ov-overlay__header">
                <div class="ov-overlay__heading">
                    <h2 id="@TitleId">@Title</h2>
                    @if (!string.IsNullOrWhiteSpace(Description))
                    {
                        <div id="@DescriptionId" class="ov-overlay__description">@Description</div>
                    }
                </div>
                <OVIconButton Icon="OneVisionIcon.Cancel"
                              Label="Close overlay"
                              Class="ov-overlay__close"
                              OnClick="CloseClicked"
                              Disabled="@(Busy || CloseDisabled)" />
            </header>
            <div class="ov-overlay__body @(ContentMode == OVOverlayContentMode.External ? "ov-overlay__body--external" : "")">
                @if (ContentMode == OVOverlayContentMode.External)
                {
                    @if (_externalError is not null)
                    {
                        <div class="ov-overlay__external-message" role="alert">@_externalError</div>
                    }
                    else
                    {
                        @if (!_externalLoaded)
                        {
                            <div class="ov-overlay__external-message" role="status">Loading external content…</div>
                        }
                        <iframe @key="_externalUrl"
                                class="ov-overlay__iframe"
                                title="@ExternalContent!.FrameTitle"
                                src="@_externalUrl"
                                loading="eager"
                                @onload="ExternalLoaded"></iframe>
                        @if (_externalLoaded)
                        {
                            <div class="ov-overlay__external-status" role="status">Page load completed. The destination's readiness cannot be independently verified.</div>
                        }
                        @if (_standaloneUrl is not null)
                        {
                            <a class="ov-overlay__external-link" href="@_standaloneUrl" target="_blank" rel="noopener noreferrer">Open in new tab</a>
                        }
                    }
                }
                else
                {
                    @ChildContent
                }
            </div>
            <footer class="ov-overlay__footer">
                @if (Footer is not null)
                {
                    @Footer
                }
                else
                {
                    <OVButton Appearance="OVButtonVariant.Secondary" OnClick="CloseClicked" Disabled="@(Busy || CloseDisabled)">@CancelText</OVButton>
                    @if (SaveRequested.HasDelegate)
                    {
                        <OVButton OnClick="SaveClicked" Loading="@Busy" Disabled="@SaveDisabled">@SaveText</OVButton>
                    }
                }
            </footer>
        </section>
    </div>
}

<OVConfirmDialog Open="@_confirmLeave"
                 OpenChanged="ConfirmLeaveChanged"
                 Title="Discard changes?"
                 Message="Unsaved changes will be lost."
                 ConfirmText="Discard changes"
                 Confirmed="LeaveWithoutSaving" />

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool CloseDisabled { get; set; }
    [Parameter] public bool Dirty { get; set; }
    [Parameter] public bool SaveDisabled { get; set; }
    [Parameter] public string SaveText { get; set; } = "Save";
    [Parameter] public string CancelText { get; set; } = "Cancel";
    [Parameter] public EventCallback SaveRequested { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public OVOverlayContentMode ContentMode { get; set; } = OVOverlayContentMode.Native;
    [Parameter] public OVOverlayExternalContent? ExternalContent { get; set; }
    [Parameter] public bool CloseOnBackdrop { get; set; } = true;
    [Parameter] public bool Contained { get; set; }
    [Parameter] public OVOverlayPlacement Placement { get; set; } = OVOverlayPlacement.RightSide;
    [Parameter] public string? Class { get; set; }

    private readonly string _overlayId = $"ov-overlay-{Guid.NewGuid():N}";
    private readonly string _titleId = $"ov-overlay-title-{Guid.NewGuid():N}";
    private readonly string _descriptionId = $"ov-overlay-description-{Guid.NewGuid():N}";
    private ElementReference _surface;
    private IJSObjectReference? _module;
    private DotNetObjectReference<OVOverlay>? _dotNetReference;
    private bool _overlayActive;
    private bool _confirmLeave;
    private bool _externalLoaded;
    private string? _externalUrl;
    private string? _standaloneUrl;
    private string? _externalError;
    private string? _externalSessionKey;
    private bool ConfirmExternalClose => ContentMode == OVOverlayContentMode.External &&
        ExternalContent?.ClosePolicy == OVOverlayExternalClosePolicy.Confirm;

    private string TitleId => _titleId;
    private string DescriptionId => _descriptionId;
    private string? DescriptionIdOrNull => string.IsNullOrWhiteSpace(Description) ? null : DescriptionId;
    private string PlacementClass => Placement == OVOverlayPlacement.Workspace ? "ov-overlay__backdrop--workspace" : "ov-overlay__backdrop--right";
    private string BackdropClass => Contained
        ? $"ov-overlay__backdrop ov-overlay__backdrop--contained {PlacementClass}"
        : $"ov-overlay__backdrop {PlacementClass}";

    private string SurfaceClass
    {
        get
        {
            var placement = Placement == OVOverlayPlacement.Workspace ? "ov-overlay--workspace" : "ov-overlay--right";
            return string.IsNullOrWhiteSpace(Class) ? $"ov-overlay {placement}" : $"ov-overlay {placement} {Class}";
        }
    }

    protected override void OnParametersSet()
    {
        if (ContentMode == OVOverlayContentMode.External)
        {
            var key = $"{Open}|{ExternalContent?.Url}|{string.Join(",", ExternalContent?.PermittedOrigins ?? Array.Empty<string>())}|{ExternalContent?.StandaloneUrl}";
            if (_externalSessionKey != key)
            {
                _externalSessionKey = key;
                _externalLoaded = false;
                _externalUrl = null;
                _standaloneUrl = null;
                _externalError = ValidateExternalContent(ExternalContent, out _externalUrl, out _standaloneUrl);
            }
        }
        else
        {
            _externalSessionKey = null;
            _externalLoaded = false;
            _externalError = null;
            _externalUrl = null;
            _standaloneUrl = null;
        }
    }

    private static string? ValidateExternalContent(OVOverlayExternalContent? configuration, out string? url, out string? standalone)
    {
        url = null;
        standalone = null;
        if (configuration is null)
            return "External content has not been configured.";
        if (configuration.PermittedOrigins is null || configuration.PermittedOrigins.Count == 0)
            return "No permitted destination origins have been configured.";
        if (!IsApproved(configuration.Url, configuration.PermittedOrigins))
            return "The external destination is invalid or its origin is not permitted.";
        url = configuration.Url;
        if (!string.IsNullOrWhiteSpace(configuration.StandaloneUrl))
        {
            if (IsApproved(configuration.StandaloneUrl, configuration.PermittedOrigins))
                standalone = configuration.StandaloneUrl;
        }
        else
            standalone = url;
        return null;
    }

    private static bool IsApproved(string? candidate, IReadOnlyCollection<string> origins)
    {
        if (!Uri.TryCreate(candidate, UriKind.Absolute, out var address) ||
            (address.Scheme != Uri.UriSchemeHttps && address.Scheme != Uri.UriSchemeHttp) ||
            !string.IsNullOrWhiteSpace(address.UserInfo))
            return false;

        return origins.Any(origin =>
            Uri.TryCreate(origin, UriKind.Absolute, out var allowed) &&
            (allowed.Scheme == Uri.UriSchemeHttps || allowed.Scheme == Uri.UriSchemeHttp) &&
            string.IsNullOrEmpty(allowed.UserInfo) &&
            allowed.AbsolutePath == "/" &&
            string.IsNullOrEmpty(allowed.Query) &&
            string.IsNullOrEmpty(allowed.Fragment) &&
            string.Equals(allowed.GetLeftPart(UriPartial.Authority),
                          address.GetLeftPart(UriPartial.Authority), StringComparison.OrdinalIgnoreCase));
    }

    private void ExternalLoaded() => _externalLoaded = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Open && !_overlayActive)
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/OneVision.UI/ov-overlay.js");
            _dotNetReference ??= DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("activate", _overlayId, _surface, _dotNetReference, !Contained);
            _overlayActive = true;
        }
        else if (!Open && _overlayActive)
        {
            await DeactivateAsync(restoreFocus: true);
        }
    }

    private Task SaveClicked(MouseEventArgs _) => SaveRequested.InvokeAsync();
    private Task CloseClicked(MouseEventArgs _) => CloseAsync();
    private Task BackdropClicked() => CloseOnBackdrop ? CloseAsync() : Task.CompletedTask;

    [JSInvokable]
    public Task HandleEscapeFromJs() => CloseAsync();

    private async Task CloseAsync()
    {
        if (Busy || CloseDisabled) return;

        if (Dirty || ConfirmExternalClose)
        {
            _confirmLeave = true;
            StateHasChanged();
            return;
        }

        await CompleteCloseAsync();
    }

    private Task ConfirmLeaveChanged(bool value)
    {
        _confirmLeave = value;
        return Task.CompletedTask;
    }

    private async Task LeaveWithoutSaving()
    {
        _confirmLeave = false;
        await CompleteCloseAsync();
    }

    private async Task CompleteCloseAsync()
    {
        await DeactivateAsync(restoreFocus: true);
        await OpenChanged.InvokeAsync(false);
    }

    private async Task DeactivateAsync(bool restoreFocus)
    {
        if (!_overlayActive || _module is null) return;

        try
        {
            await _module.InvokeVoidAsync("deactivate", _overlayId, restoreFocus);
        }
        catch (JSDisconnectedException)
        {
            // The browser is already gone; there is no focus or scroll state left to restore.
        }
        finally
        {
            _overlayActive = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        await DeactivateAsync(restoreFocus: false);
        _dotNetReference?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
