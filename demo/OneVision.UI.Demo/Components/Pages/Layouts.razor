@page "/layouts"

<PageTitle>Shell & Layouts · OneVision.UI</PageTitle>

<div class="ov-index-heading">
    <div>
        <div class="ov-home-kicker">OVP-001 · OVP-010–013</div>
        <h1 class="ov-gallery-page-title">Application shell & page layouts</h1>
        <MudText Typo="Typo.body1" Class="ov-gallery-page-intro">
            Governed structural patterns used beneath OVP-000. Applications provide domain content while OneVision.UI owns the shared frame, spacing and regions.
        </MudText>
    </div>
</div>

<section class="ov-home-section">
    <MudText Typo="Typo.h5">OVP-001 · Application Shell</MudText>
    <div class="ov-demo-section" style="padding:0; overflow:hidden; min-height:320px;">
        <OVApplicationShell Title="Entity Allocation Manager" Subtitle="OneVision">
            <Logo><strong style="color:#005eb8;">OneVision</strong></Logo>
            <HeaderActions><OVButton Variant="Variant.Text">Help</OVButton></HeaderActions>
            <Navigation><span>Entities&nbsp;&nbsp; Allocations&nbsp;&nbsp; Settings</span></Navigation>
            <ChildContent>
                <div style="padding:20px;">Application content is hosted here.</div>
            </ChildContent>
            <Footer><span>Signed in user · Version 1.0</span></Footer>
        </OVApplicationShell>
    </div>
</section>

<section class="ov-home-section">
    <MudText Typo="Typo.h5">OVP-010 · Standard Page</MudText>
    <div class="ov-demo-section">
        <OVStandardPage Title="Overview" Description="Standard page heading, actions and content.">
            <Actions><OVButton Color="Color.Primary">Primary action</OVButton></Actions>
            <ChildContent><div>App-specific content</div></ChildContent>
        </OVStandardPage>
    </div>
</section>

<section class="ov-home-section">
    <MudText Typo="Typo.h5">OVP-011 · List Page</MudText>
    <div class="ov-demo-section">
        <OVListPage Title="Entities" Description="Searchable, filterable list composition.">
            <Actions><OVButton Color="Color.Primary">Add entity</OVButton></Actions>
            <Toolbar><span>Search and context filters</span></Toolbar>
            <ChildContent><div style="padding:16px 0; border-top:1px solid #d8dde2; border-bottom:1px solid #d8dde2;">Compact results table/list</div></ChildContent>
            <Pagination><span>1–25 of 100</span></Pagination>
        </OVListPage>
    </div>
</section>

<section class="ov-home-section">
    <MudText Typo="Typo.h5">OVP-012 · Detail / Edit Page</MudText>
    <div class="ov-demo-section">
        <OVDetailPage Title="Entity details" Description="Identity, status, actions and editable content.">
            <Status><OVStatusPill Text="Current" Tone="OVStatusPill.OVStatusTone.Success" /></Status>
            <Actions><OVButton Variant="Variant.Text">More</OVButton></Actions>
            <ChildContent><div>App-specific form or detail sections</div></ChildContent>
            <FooterActions><OVButton Variant="Variant.Text">Cancel</OVButton><OVButton Color="Color.Primary">Save</OVButton></FooterActions>
        </OVDetailPage>
    </div>
</section>

<section class="ov-home-section">
    <MudText Typo="Typo.h5">OVP-013 · Split / Builder Page</MudText>
    <div class="ov-demo-section">
        <OVBuilderPage Title="Hierarchy Builder" Description="Governed navigation, canvas and inspector workspace.">
            <Toolbar><OVButton Variant="Variant.Text">Add</OVButton><OVButton Variant="Variant.Text">Refresh</OVButton></Toolbar>
            <Navigation><strong>Navigation/tree</strong></Navigation>
            <ChildContent><strong>Main working area</strong></ChildContent>
            <Inspector><strong>Inspector/details</strong></Inspector>
        </OVBuilderPage>
    </div>
</section>
