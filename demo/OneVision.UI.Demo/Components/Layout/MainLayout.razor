@inherits LayoutComponentBase

<MudThemeProvider Theme="@ActiveTheme" />
<MudPopoverProvider />
<MudDialogProvider CloseButton="true" CloseOnEscapeKey="true" />
<MudSnackbarProvider />

<MudLayout Class="@GalleryLayoutClass">
    <MudAppBar Elevation="0" Dense="true" Class="ov-gallery-appbar">
        <div class="ov-gallery-brand">
            <div class="ov-gallery-brand__mark">OV</div>
            <MudText Typo="Typo.h6">OneVision.UI</MudText>
        </div>
        <MudSpacer />
        <div class="ov-profile-switch" role="group" aria-label="Presentation profile">
            <button type="button" class="@ProfileButtonClass(false)" aria-pressed="@(!_experienceProfile)" @onclick="() => SetExperienceProfile(false)">Manager</button>
            <button type="button" class="@ProfileButtonClass(true)" aria-pressed="@_experienceProfile" @onclick="() => SetExperienceProfile(true)">Experience</button>
        </div>
        <MudText Typo="Typo.body2" Class="ov-gallery-profile-description">@ProfileDescription</MudText>
    </MudAppBar>

    <MudDrawer Open="true" Variant="DrawerVariant.Persistent" Elevation="0" Width="300px" Class="ov-gallery-drawer">
        <div class="ov-gallery-nav-title">Library</div>
        <div class="ov-library-search-wrap ov-library-search-wrap--fluent">
            <OVIcon Name="OneVisionIcon.Search" Class="ov-library-search-icon" />
            <MudTextField @bind-Value="_librarySearch" Immediate="true" Placeholder="Search components and patterns…" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </div>

        @if (!string.IsNullOrWhiteSpace(_librarySearch))
        {
            <div class="ov-library-search-results">
                <div class="ov-library-search-summary">@SearchHits.Count result(s)</div>
                @foreach (var hit in SearchHits.Take(18))
                {
                    <a class="ov-library-search-hit" href="@hit.Route"><span class="ov-library-search-hit__kind">@hit.Kind</span><strong>@hit.Name</strong><code>@hit.Reference</code></a>
                }
                @if (SearchHits.Count > 18) { <div class="ov-library-search-more">Refine the search to narrow @SearchHits.Count matches.</div> }
            </div>
        }
        else
        {
            <nav class="ov-gallery-nav" aria-label="OneVision.UI library">
                <NavLink href="" Match="NavLinkMatch.All" class="ov-gallery-nav-link"><OVIcon Name="OneVisionIcon.Home" /><span>Overview</span></NavLink>
                <NavLink href="build" class="ov-gallery-nav-link"><OVIcon Name="OneVisionIcon.Build" /><span>Build a screen</span></NavLink>
                <NavLink href="components" class="ov-gallery-nav-link"><OVIcon Name="OneVisionIcon.Components" /><span>All components</span></NavLink>
                <NavLink href="patterns" class="ov-gallery-nav-link"><OVIcon Name="OneVisionIcon.Patterns" /><span>All patterns</span></NavLink>
                <NavLink href="icons" class="ov-gallery-nav-link"><OVIcon Name="OneVisionIcon.Information" /><span>Icons</span></NavLink>
                <div class="ov-gallery-nav-title ov-gallery-nav-title--sub">Common components</div>
                @foreach (var component in CommonComponents) { <NavLink href="@($"components/{component.Slug}")" class="ov-gallery-nav-link ov-gallery-nav-link--secondary">@component.Name</NavLink> }
                <div class="ov-gallery-nav-title ov-gallery-nav-title--sub">Common patterns</div>
                @foreach (var pattern in CommonPatterns) { <NavLink href="@($"patterns/{pattern.Slug}")" class="ov-gallery-nav-link ov-gallery-nav-link--secondary">@pattern.Name</NavLink> }
            </nav>
        }

        <div class="ov-library-drawer-tip"><strong>Tip</strong><span>Search by purpose too — try <em>JSON</em>, <em>mapping</em>, <em>pagination</em>, <em>allocation</em>, <em>tree</em> or a canonical <code>OVC-/OVP-</code> reference.</span></div>
    </MudDrawer>

    <MudMainContent Class="ov-gallery-main"><MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="ov-gallery-content">@Body</MudContainer></MudMainContent>
</MudLayout>

@code {
    private string _librarySearch = string.Empty;
    private bool _experienceProfile;
    private MudBlazor.MudTheme ActiveTheme => _experienceProfile ? OneVisionTheme.Experience : OneVisionTheme.Manager;
    private string GalleryLayoutClass => _experienceProfile ? "ov-gallery-layout ov-profile--experience" : "ov-gallery-layout ov-profile--manager";
    private string ProfileDescription => _experienceProfile ? "Guided, expressive and progression-oriented" : "Compact, precise and operational";
    private void SetExperienceProfile(bool enabled) => _experienceProfile = enabled;
    private string ProfileButtonClass(bool experience) => _experienceProfile == experience ? "ov-profile-switch__button ov-profile-switch__button--active" : "ov-profile-switch__button";

    private static readonly string[] CommonComponentSlugs = ["button", "search-box", "select", "multi-select", "data-grid", "tabs", "tree", "structured-field-tree", "mapping-pair", "mapping-rule", "copyable-link", "dialog"];
    private static readonly string[] CommonPatternSlugs = ["list-page", "edit-overlay", "picker-overlay", "connection-manager", "source-configuration", "schedule-editor", "tree-workspace", "run-overlay"];
    private IEnumerable<ComponentDefinition> CommonComponents => CommonComponentSlugs.Select(slug => GovernedComponentCatalog.Find(slug)).Where(component => component is not null).Cast<ComponentDefinition>();
    private IEnumerable<PatternNode> CommonPatterns => CommonPatternSlugs.Select(slug => GovernedPatternCatalog.FindPattern(slug)).Where(pattern => pattern is not null).Cast<PatternNode>();

    private List<LibraryHit> SearchHits
    {
        get
        {
            var q = _librarySearch.Trim();
            if (string.IsNullOrWhiteSpace(q)) return [];

            var hits = new List<LibraryHit>();
            hits.AddRange(GovernedComponentCatalog.Search(q).Select(component =>
                new LibraryHit("Component", component.Name, component.Reference, $"components/{component.Slug}", Rank(component.Name, component.Reference, q))));
            hits.AddRange(GovernedPatternCatalog.Patterns.Where(pattern => MatchesPattern(pattern, q)).Select(pattern =>
                new LibraryHit("Pattern", pattern.Name, pattern.Reference, $"patterns/{pattern.Slug}", Rank(pattern.Name, pattern.Reference, q))));
            return hits.OrderBy(hit => hit.Score).ThenBy(hit => hit.Kind).ThenBy(hit => hit.Name).ToList();
        }
    }

    private static bool MatchesPattern(PatternNode pattern, string query)
        => pattern.Name.Contains(query, StringComparison.OrdinalIgnoreCase)
           || pattern.Reference.Contains(query, StringComparison.OrdinalIgnoreCase)
           || pattern.Description.Contains(query, StringComparison.OrdinalIgnoreCase);

    private static int Rank(string name, string reference, string query) => reference.Equals(query, StringComparison.OrdinalIgnoreCase) ? 0 : name.Equals(query, StringComparison.OrdinalIgnoreCase) ? 1 : name.StartsWith(query, StringComparison.OrdinalIgnoreCase) ? 2 : reference.Contains(query, StringComparison.OrdinalIgnoreCase) ? 3 : 4;
    private sealed record LibraryHit(string Kind, string Name, string Reference, string Route, int Score);
}
