@using System.Globalization

@if (CurrentWorker is null)
{
    <OVListPage Title="Workers" Description="Open a worker to configure its administrator-facing identity, availability and assigned jobs.">
        <Summary>
            <OVContextSummary Items="@WorkerListSummary" AriaLabel="Worker collection context">
                <Process>
                    <OVProcessStatus State="OVProcessState.Completed"
                                     Display="OVProcessStatusDisplay.Compact"
                                     Label="Heartbeat scan"
                                     Phase="Current estate"
                                     ProgressCurrent="2"
                                     ProgressTotal="2"
                                     LastRunAt="@DemoHeartbeat"
                                     Message="Worker state is current" />
                </Process>
            </OVContextSummary>
        </Summary>
        <ChildContent>
            <OVCardCollection AriaLabel="Workers">
                @foreach (var worker in _workers)
                {
                    <OVCard Selected="@(_lastOpenedWorker == worker.Id)"
                            SelectedAction="@(() => OpenWorker(worker.Id))"
                            AriaLabel="@($"Open {worker.Alias} worker settings")">
                        <Header>
                            <div class="ov-capability-demo__worker-heading">
                                <strong>@worker.Alias</strong>
                                <span>@worker.Name</span>
                            </div>
                        </Header>
                        <Status>
                            <OVPill Text="@(worker.Available ? worker.Status : "Unavailable")"
                                    Role="OVPillRole.Status"
                                    Tone="@(worker.Available ? OVPillTone.Success : OVPillTone.Warning)" />
                        </Status>
                        <ChildContent>
                            <div class="ov-capability-demo__worker-summary">
                                <span>@worker.AssignedCapabilities.Count jobs assigned</span>
                                <span aria-hidden="true">·</span>
                                <span>heartbeat @worker.LastHeartbeat</span>
                            </div>
                        </ChildContent>
                    </OVCard>
                }
            </OVCardCollection>
        </ChildContent>
    </OVListPage>
}
else
{
    var worker = CurrentWorker;
    var effectiveReadOnly = _readOnly || !worker.Available;

    <OVDetailPage Title="@worker.Alias"
                  Description="Configure worker identity, availability and assigned jobs."
                  Busy="@_saving"
                  StickyFooter="true">
        <BackAction>
            <OVButton Appearance="OVButtonVariant.Subtle" Disabled="@_saving" OnClick="_ => CancelAndReturn()">← Back to workers</OVButton>
        </BackAction>
        <Status>
            <div class="ov-capability-demo__status-row">
                <OVPill Text="@(worker.Available ? worker.Status : "Unavailable")"
                        Role="OVPillRole.Status"
                        Tone="@(worker.Available ? OVPillTone.Success : OVPillTone.Warning)" />
                @if (effectiveReadOnly)
                {
                    <OVPill Text="Read-only" Role="OVPillRole.Status" Tone="OVPillTone.Neutral" />
                }
            </div>
        </Status>
        <Summary>
            <OVContextSummary Items="@WorkerOperationalSummary(worker)" AriaLabel="Worker operational status">
                <Process>
                    <OVProcessStatus State="@(worker.Available ? OVProcessState.Running : OVProcessState.Stale)"
                                     Display="OVProcessStatusDisplay.Compact"
                                     Label="@(worker.Available ? worker.CurrentActivity : "Worker activity")"
                                     Phase="@(worker.Available ? $"{worker.ProgressCurrent} / {worker.ProgressTotal}" : "Heartbeat unavailable")"
                                     ProgressCurrent="@(worker.Available ? worker.ProgressCurrent : 0)"
                                     ProgressTotal="@(worker.Available ? worker.ProgressTotal : 0)"
                                     StartedAt="@(worker.Available ? DemoActivityStarted : null)"
                                     LastRunAt="@DemoHeartbeat"
                                     Message="@(worker.Available ? $"Heartbeat {worker.LastHeartbeat} · {worker.CurrentMessage}" : "No live process information is available")" />
                </Process>
            </OVContextSummary>
        </Summary>
        <Actions>
            @if (worker.Available)
            {
                <OVButton Appearance="OVButtonVariant.Subtle" Disabled="@_saving" OnClick="_ => ToggleReadOnly()">
                    @(_readOnly ? "Return to edit" : "View read-only")
                </OVButton>
            }
        </Actions>
        <ChildContent>
            <div class="ov-capability-demo">
                @if (!worker.Available)
                {
                    <OVAlert Tone="OVAlertTone.Warning">This worker is unavailable. Its last known configuration remains readable, but configuration changes are disabled until the application reports the worker as available.</OVAlert>
                }
                else if (_readOnly)
                {
                    <OVAlert Tone="OVAlertTone.Information">Read-only mode uses the same composition. Alias, enabled state and assigned jobs remain visible while editing and selection are disabled.</OVAlert>
                }

                <section class="ov-capability-demo__section ov-capability-demo__identity" aria-labelledby="capability-identity-heading">
                    <div class="ov-capability-demo__section-heading">
                        <div>
                            <h2 id="capability-identity-heading">Worker identity</h2>
                            <p>Alias is the administrator-facing identity. Technical worker and host details remain read-only.</p>
                        </div>
                    </div>
                    <div class="ov-capability-demo__identity-grid">
                        <div class="ov-capability-demo__alias-field">
                            <OVTextField Label="Alias"
                                         Value="@_alias"
                                         ValueChanged="AliasChanged"
                                         ReadOnly="@effectiveReadOnly"
                                         Disabled="@_saving"
                                         Immediate="true"
                                         Class="ov-capability-demo__alias-input" />
                        </div>
                        <div class="ov-capability-demo__enabled">
                            <OVToggle Label="Enabled"
                                      Value="@_enabled"
                                      ValueChanged="EnabledChanged"
                                      ReadOnly="@effectiveReadOnly"
                                      Disabled="@_saving"
                                      Saving="@_saving" />
                            <span>Controls whether the consuming application makes this worker available for configured jobs.</span>
                        </div>
                        <div class="ov-capability-demo__technical-identity">
                            <OVTextField Label="Worker name" Value="@worker.Name" ReadOnly="true" />
                            <div class="ov-capability-demo__technical-meta">
                                <span>Host @worker.Host</span>
                                <span>Instance @worker.Instance</span>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="ov-capability-demo__section" aria-labelledby="capability-jobs-heading">
                    <div class="ov-capability-demo__section-heading">
                        <div>
                            <h2 id="capability-jobs-heading">Job capabilities</h2>
                            <p>Select a job to assign or remove it. Names and descriptions are primary; implementation codes remain secondary diagnostic metadata.</p>
                        </div>
                        <OVPill Text="@($"{_assigned.Count} assigned")" Role="OVPillRole.Count" Tone="OVPillTone.Info" />
                    </div>

                    @foreach (var category in CapabilityCategories)
                    {
                        var capabilities = CapabilityDefinitions.Where(capability => capability.Category == category).ToList();
                        if (capabilities.Count > 0)
                        {
                            <div class="ov-capability-demo__group">
                                <h3>@category</h3>
                                <OVCardCollection AriaLabel="@($"{category} capabilities")">
                                    @foreach (var capability in capabilities)
                                    {
                                        var selected = _assigned.Contains(capability.Code);
                                        var available = capability.State == CapabilityAvailability.Available;
                                        var unavailable = capability.State == CapabilityAvailability.Unavailable;
                                        var selectable = available && !effectiveReadOnly;
                                        <OVCard Selected="@selected"
                                                Disabled="@(unavailable || (available && effectiveReadOnly))"
                                                Busy="@(_saving && available)"
                                                Actionable="@available"
                                                Class="@CapabilityCardClass(capability)"
                                                SelectedAction="@(selectable ? EventCallback.Factory.Create(this, () => ToggleCapability(capability.Code)) : default)"
                                                AriaLabel="@CapabilityAriaLabel(capability, selected, effectiveReadOnly)">
                                            <Header>
                                                <div class="ov-capability-demo__capability-heading">
                                                    <strong>@capability.DisplayName</strong>
                                                </div>
                                            </Header>
                                            <Status>
                                                <OVPill Text="@CapabilityStatusText(capability, selected)"
                                                        Role="OVPillRole.Status"
                                                        Tone="@CapabilityStatusTone(capability, selected)" />
                                            </Status>
                                            <ChildContent>
                                                <p class="ov-capability-demo__description">@capability.Description</p>
                                                @if (!string.IsNullOrWhiteSpace(capability.OptionalNote))
                                                {
                                                    <div class="ov-capability-demo__note">@capability.OptionalNote</div>
                                                }
                                            </ChildContent>
                                            <Metadata>
                                                <code class="ov-capability-demo__code">@capability.Code</code>
                                            </Metadata>
                                        </OVCard>
                                    }
                                </OVCardCollection>
                            </div>
                        }
                    }
                </section>
            </div>
        </ChildContent>
        <FooterContent>
            <span class="ov-capability-demo__footer-state">@(effectiveReadOnly ? "Configuration is read-only" : HasChanges ? "Unsaved worker configuration changes" : "Worker configuration is up to date")</span>
        </FooterContent>
        <FooterActions>
            <OVButton Appearance="OVButtonVariant.Secondary" Disabled="@_saving" OnClick="_ => CancelAndReturn()">Cancel</OVButton>
            @if (!effectiveReadOnly)
            {
                <OVButton Appearance="OVButtonVariant.Primary" Loading="@_saving" Disabled="@(_saving || !HasChanges)" OnClick="SaveAsync">Save changes</OVButton>
            }
        </FooterActions>
    </OVDetailPage>
}

@code {
    private string? _workerId;
    private string? _lastOpenedWorker;
    private string? _alias;
    private bool _enabled;
    private bool _readOnly;
    private bool _saving;
    private HashSet<string> _assigned = new(StringComparer.OrdinalIgnoreCase);

    private static readonly DateTimeOffset DemoActivityStarted = new(2026, 10, 29, 17, 34, 0, TimeSpan.Zero);
    private static readonly DateTimeOffset DemoHeartbeat = new(2026, 10, 29, 18, 12, 0, TimeSpan.Zero);

    private readonly List<WorkerDemo> _workers =
    [
        new("worker-01", "D-INFISDEVGEN01:WORKER:02", "Allocation and Merge Worker", true, "Running", "D-INFISDEVGEN01", "18:12", "02", "Processing queue", "18 of 42 queued items processed", 18, 42, true,
            ["IMPORT_DATA", "SYNCHRONISE_RECORDS", "PROCESS_QUEUE"]),
        new("worker-02", "D-INFISDEVGEN02:WORKER:01", "Publishing Worker", false, "Stale", "D-INFISDEVGEN02", "17:48", "01", "Unavailable", "Last heartbeat is stale", 0, 0, false,
            ["VALIDATE_DATA", "PUBLISH_OUTPUT"])
    ];

    private static readonly string[] CapabilityCategories =
    ["Data & synchronisation", "Processing", "Operations"];

    private static readonly IReadOnlyList<CapabilityDemo> CapabilityDefinitions =
    [
        new("IMPORT_DATA", "Import data", "Retrieves configured source data and stages it for application processing.", "Data & synchronisation", CapabilityAvailability.Available, "Requires a configured source connection."),
        new("SYNCHRONISE_RECORDS", "Synchronise records", "Keeps application-owned records aligned with their configured upstream source.", "Data & synchronisation", CapabilityAvailability.Available, "Normally paired with Import data for continuous synchronisation."),
        new("VALIDATE_DATA", "Validate data", "Runs configured validation rules and records actionable validation outcomes.", "Processing", CapabilityAvailability.Available, null),
        new("PROCESS_QUEUE", "Process queue", "Processes queued application work using the business rules owned by the consuming application.", "Processing", CapabilityAvailability.Available, "May require connectivity to another OneVision service."),
        new("PUBLISH_OUTPUT", "Publish output", "Publishes approved application output to its configured serving destination.", "Operations", CapabilityAvailability.Available, null),
        new("MAINTENANCE_SWEEP", "Maintenance sweep", "Runs the environment maintenance capability when that worker runtime supports it.", "Operations", CapabilityAvailability.Unavailable, "Not supported by this worker environment."),
        new("LEGACY_RECONCILE", "Legacy reconciliation", "Compatibility capability retained for older deployments.", "Operations", CapabilityAvailability.Reserved, "Retained for compatibility; not used by normal processing.")
    ];

    private WorkerDemo? CurrentWorker => _workers.FirstOrDefault(worker => worker.Id == _workerId);

    private IReadOnlyList<OVContextSummaryItem> WorkerListSummary =>
    [
        new("Workers", _workers.Count.ToString(CultureInfo.InvariantCulture)),
        new("Available", _workers.Count(worker => worker.Available).ToString(CultureInfo.InvariantCulture), Tone: OVPillTone.Success),
        new("Unavailable", _workers.Count(worker => !worker.Available).ToString(CultureInfo.InvariantCulture), Tone: OVPillTone.Warning),
        new("Assigned jobs", _workers.Sum(worker => worker.AssignedCapabilities.Count).ToString(CultureInfo.InvariantCulture))
    ];

    private static IReadOnlyList<OVContextSummaryItem> WorkerOperationalSummary(WorkerDemo worker) =>
    [
        new("Availability", worker.Available ? "Available" : "Unavailable", Tone: worker.Available ? OVPillTone.Success : OVPillTone.Warning),
        new("Last heartbeat", worker.LastHeartbeat)
    ];

    private bool HasChanges
    {
        get
        {
            var worker = CurrentWorker;
            if (worker is null) return false;
            return !string.Equals(_alias, worker.Alias, StringComparison.Ordinal)
                || _enabled != worker.Enabled
                || !_assigned.SetEquals(worker.AssignedCapabilities);
        }
    }

    private void OpenWorker(string workerId)
    {
        var worker = _workers.First(worker => worker.Id == workerId);
        _workerId = workerId;
        _lastOpenedWorker = workerId;
        _alias = worker.Alias;
        _enabled = worker.Enabled;
        _assigned = new HashSet<string>(worker.AssignedCapabilities, StringComparer.OrdinalIgnoreCase);
        _readOnly = false;
    }

    private Task AliasChanged(string? value) { _alias = value; return Task.CompletedTask; }
    private Task EnabledChanged(bool value) { _enabled = value; return Task.CompletedTask; }
    private void ToggleReadOnly() => _readOnly = !_readOnly;

    private void ToggleCapability(string code)
    {
        if (_readOnly || _saving || CurrentWorker is not { Available: true }) return;
        if (!_assigned.Add(code)) _assigned.Remove(code);
    }

    private async Task SaveAsync(MouseEventArgs _)
    {
        var worker = CurrentWorker;
        if (worker is null || _readOnly || !worker.Available || _saving || !HasChanges) return;

        _saving = true;
        await Task.Delay(900);

        worker.Alias = string.IsNullOrWhiteSpace(_alias) ? worker.Alias : _alias.Trim();
        worker.Enabled = _enabled;
        worker.AssignedCapabilities = new HashSet<string>(_assigned, StringComparer.OrdinalIgnoreCase);
        _saving = false;
        _workerId = null;
    }

    private void CancelAndReturn()
    {
        if (_saving) return;
        _workerId = null;
        _readOnly = false;
    }

    private static string CapabilityStatusText(CapabilityDemo capability, bool selected) => capability.State switch
    {
        CapabilityAvailability.Unavailable => "Unavailable",
        CapabilityAvailability.Reserved => "Reserved",
        _ => selected ? "Assigned" : "Available"
    };

    private static OVPillTone CapabilityStatusTone(CapabilityDemo capability, bool selected) => capability.State switch
    {
        CapabilityAvailability.Unavailable => OVPillTone.Neutral,
        CapabilityAvailability.Reserved => OVPillTone.Info,
        _ => selected ? OVPillTone.Success : OVPillTone.Info
    };

    private static string CapabilityCardClass(CapabilityDemo capability) => capability.State switch
    {
        CapabilityAvailability.Unavailable => "ov-capability-demo__card ov-capability-demo__card--unavailable",
        CapabilityAvailability.Reserved => "ov-capability-demo__card ov-capability-demo__card--reserved",
        _ => "ov-capability-demo__card"
    };

    private static string CapabilityAriaLabel(CapabilityDemo capability, bool selected, bool readOnly) => capability.State switch
    {
        CapabilityAvailability.Unavailable => $"{capability.DisplayName}, unavailable, not supported by this worker environment",
        CapabilityAvailability.Reserved => $"{capability.DisplayName}, reserved for compatibility",
        _ when readOnly => $"{capability.DisplayName}, {(selected ? "assigned" : "not assigned")}, read-only",
        _ when selected => $"Remove {capability.DisplayName} capability",
        _ => $"Assign {capability.DisplayName} capability"
    };

    private sealed class WorkerDemo(
        string id,
        string name,
        string alias,
        bool enabled,
        string status,
        string host,
        string lastHeartbeat,
        string instance,
        string currentActivity,
        string currentMessage,
        long progressCurrent,
        long progressTotal,
        bool available,
        IEnumerable<string> assignedCapabilities)
    {
        public string Id { get; } = id;
        public string Name { get; } = name;
        public string Alias { get; set; } = alias;
        public bool Enabled { get; set; } = enabled;
        public string Status { get; } = status;
        public string Host { get; } = host;
        public string LastHeartbeat { get; } = lastHeartbeat;
        public string Instance { get; } = instance;
        public string CurrentActivity { get; } = currentActivity;
        public string CurrentMessage { get; } = currentMessage;
        public long ProgressCurrent { get; } = progressCurrent;
        public long ProgressTotal { get; } = progressTotal;
        public bool Available { get; } = available;
        public HashSet<string> AssignedCapabilities { get; set; } = new(assignedCapabilities, StringComparer.OrdinalIgnoreCase);
    }

    private sealed record CapabilityDemo(
        string Code,
        string DisplayName,
        string Description,
        string Category,
        CapabilityAvailability State,
        string? OptionalNote);

    private enum CapabilityAvailability
    {
        Available,
        Unavailable,
        Reserved
    }
}
