@using OneVision.UI.Demo

@{
    var definition = PatternPreviewDefinitions.For(PatternKey);
    var fields = ScopeFields(definition);
}

<MudPaper Class="ov-pattern-demo ov-pattern-demo--focused" Elevation="0">
    <div class="ov-pattern-demo__header">
        <div>
            <MudText Typo="Typo.h6">@Node.Name</MudText>
            <MudText Typo="Typo.caption">@Node.Kind scope · @Node.Reference</MudText>
        </div>
        <span class="ov-pattern-kind">@Node.Kind</span>
    </div>

    <div class="ov-pattern-demo__body">
        @if (Node.Children.Count > 0)
        {
            <div class="ov-demo-tabs">
                @foreach (var child in Node.Children)
                {
                    <button type="button"
                            class="@(child.Reference == _activeChildReference ? "ov-demo-tab ov-demo-tab--active" : "ov-demo-tab")"
                            @onclick="() => _activeChildReference = child.Reference">
                        @child.Name
                    </button>
                }
            </div>
        }
        else if (Node.Kind == PatternNodeKind.Tab)
        {
            <div class="ov-demo-tabs">
                <button type="button" class="ov-demo-tab ov-demo-tab--active">@Node.Name</button>
            </div>
        }

        <div class="ov-focused-scope">
            <div class="ov-focused-scope__title">@ActiveTitle</div>
            <MudText Typo="Typo.body2" Class="ov-pattern-demo__summary">
                Focused @Node.Kind.ToString().ToLowerInvariant() view from @definition.Title. The surrounding parent pattern is intentionally omitted.
            </MudText>

            @if (ActiveNode is not null)
            {
                <div class="ov-demo-state-label">
                    <span>Active state</span>
                    <strong>@ActiveNode.Name</strong>
                    <code>@ActiveNode.Reference</code>
                </div>
            }

            @if (IsActivityListScope)
            {
                <div class="ov-demo-table-wrap">
                    <table class="ov-demo-table">
                        <thead>
                            <tr><th>Activity</th><th>Status</th><th>Started</th><th>Duration</th><th></th></tr>
                        </thead>
                        <tbody>
                            <tr><td>EAM cache sync</td><td><OVPill Text="Completed" Role="OVPillRole.Status" Tone="OVPillTone.Success" /></td><td>24/10/2026 09:12</td><td>00:01:42</td><td><OVIconButton Icon="OneVisionIcon.More" Label="More actions" /></td></tr>
                            <tr><td>KPI recalculate</td><td><OVPill Text="Running" Role="OVPillRole.Status" Tone="OVPillTone.Info" /></td><td>24/10/2026 09:18</td><td>00:00:36</td><td><OVIconButton Icon="OneVisionIcon.More" Label="More actions" /></td></tr>
                            <tr><td>Hierarchy publish</td><td><OVPill Text="Failed" Role="OVPillRole.Status" Tone="OVPillTone.Danger" /></td><td>24/10/2026 08:54</td><td>00:00:18</td><td><OVIconButton Icon="OneVisionIcon.More" Label="More actions" /></td></tr>
                        </tbody>
                    </table>
                </div>
            }
            else if (IsMasterListScope)
            {
                <div class="ov-demo-workspace__list">
                    <MudTextField @bind-Value="_listSearch" Immediate="true" Placeholder="Search records" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    @foreach (var item in MasterItems.Where(MatchesMasterSearch))
                    {
                        <button type="button"
                                class="@(item == _selectedMasterItem ? "ov-demo-list-row ov-demo-list-row--selected" : "ov-demo-list-row")"
                                @onclick="() => _selectedMasterItem = item">
                            <span>@item</span>
                        </button>
                    }
                </div>
            }
            else if (fields.Length > 0)
            {
                <div class="ov-demo-form-grid">
                    @foreach (var field in fields)
                    {
                        <MudTextField Value="@SampleValue(field)" Label="@field" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    }
                </div>
            }
            else
            {
                <div class="ov-demo-preview-box">@ActiveTitle content</div>
            }

            @if (!IsActivityListScope && !IsMasterListScope && Node.Kind is PatternNodeKind.Section or PatternNodeKind.Pane)
            {
                <div class="ov-focused-scope__sample">
                    <span class="ov-pattern-demo__muted">Example state</span>
                    <strong>Current</strong>
                    <span>Representative content for this scoped region.</span>
                </div>
            }
        </div>
    </div>
</MudPaper>

@code {
    [Parameter, EditorRequired] public string PatternKey { get; set; } = string.Empty;
    [Parameter, EditorRequired] public PatternNode Node { get; set; } = default!;

    private string? _activeChildReference;
    private string? _lastNodeReference;
    private string _listSearch = string.Empty;
    private string _selectedMasterItem = "Record 001";
    private static readonly string[] MasterItems = ["Record 001", "Record 002", "Record 003", "Record 004"];

    private bool IsActivityListScope
        => string.Equals(Node.Reference, "OVP-ACTIVITY-LIST-LIST", StringComparison.OrdinalIgnoreCase);

    private bool IsMasterListScope
        => string.Equals(Node.Reference, "OVP-LIST-DETAIL-WORKSPACE-LIST", StringComparison.OrdinalIgnoreCase);

    protected override void OnParametersSet()
    {
        if (string.Equals(_lastNodeReference, Node.Reference, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _activeChildReference = Node.Children.FirstOrDefault()?.Reference;
        _lastNodeReference = Node.Reference;
        _listSearch = string.Empty;
        _selectedMasterItem = MasterItems[0];
    }

    private PatternNode? ActiveNode
        => Node.Children.FirstOrDefault(child => child.Reference == _activeChildReference);

    private string ActiveTitle => ActiveNode?.Name ?? Node.Name;

    private bool MatchesMasterSearch(string item)
        => string.IsNullOrWhiteSpace(_listSearch) || item.Contains(_listSearch, StringComparison.OrdinalIgnoreCase);

    private string[] ScopeFields(PatternPreviewDefinition definition)
    {
        if (PatternKey == "schedule-editor" && Node.Slug == "timing")
        {
            return ActiveNode?.Slug switch
            {
                "one-off" => ["Run date", "Run time", "Time zone"],
                "recurring" => ["Frequency", "Interval", "Run time", "Time zone"],
                _ => ["Timing mode", "Start date", "Time"]
            };
        }

        if (Node.Slug == "overview")
        {
            return definition.Fields.Take(2).ToArray();
        }

        if (Node.Slug.Contains("advanced", StringComparison.OrdinalIgnoreCase))
        {
            return ["Mode", "Enabled", "Notes"];
        }

        return definition.Fields.Take(3).ToArray();
    }

    private static string SampleValue(string field)
    {
        var f = field.ToLowerInvariant();
        if (f.Contains("date")) return "24/10/2026";
        if (f.Contains("time")) return "09:00";
        if (f.Contains("status")) return "Current";
        if (f.Contains("type")) return "Standard";
        if (f.Contains("endpoint")) return "https://service.example";
        if (f.Contains("name")) return "Example configuration";
        if (f.Contains("frequency")) return "Daily";
        if (f.Contains("interval")) return "1";
        if (f.Contains("zone")) return "Europe/London";
        if (f.Contains("enabled")) return "Yes";
        return "Example value";
    }
}
