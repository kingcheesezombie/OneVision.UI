@using OneVision.UI.Iconography

<MudTooltip Text="@Label">
    <button type="button"
            class="@ButtonClass"
            aria-label="@Label"
            aria-busy="@(Loading ? "true" : "false")"
            disabled="@(Disabled || Loading)"
            @onclick="OnClick">
        @if (Loading)
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Inherit" />
        }
        else
        {
            <OVIcon Name="@Icon" />
        }
    </button>
</MudTooltip>

@code {
    [Parameter, EditorRequired] public OneVisionIcon Icon { get; set; }
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public OVIconButtonTone Tone { get; set; } = OVIconButtonTone.Default;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public string? Class { get; set; }

    private string ButtonClass
    {
        get
        {
            var value = $"ov-icon-button ov-icon-button--{Tone.ToString().ToLowerInvariant()}";
            return string.IsNullOrWhiteSpace(Class) ? value : $"{value} {Class}";
        }
    }
}
