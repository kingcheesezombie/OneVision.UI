@page "/components"

<PageTitle>Components · OneVision.UI</PageTitle>

<div class="ov-index-heading">
    <div>
        <h1 class="ov-gallery-page-title">Components</h1>
        <MudText Typo="Typo.body1" Class="ov-gallery-page-intro">Find a reusable control by what you are trying to build. Open a component to review its live states, behaviour contract and copyable specification reference.</MudText>
    </div>
    <div class="ov-index-count">@Filtered.Count() components</div>
</div>

<div class="ov-catalog-toolbar">
    <MudTextField @bind-Value="_search" Immediate="true" Placeholder="Search by control, behaviour, state or OVC reference" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense" />
    <div class="ov-catalog-filter-row">
        <button type="button" class="@GroupClass(null)" @onclick="() => SetGroup(null)">All</button>
        @foreach (var group in ComponentCatalog.GroupOrder)
        {
            <button type="button" class="@GroupClass(group)" @onclick="() => SetGroup(group)">@group</button>
        }
    </div>
</div>

@if (!Filtered.Any())
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">No components match the current search/filter.</MudAlert>
}
else
{
    @foreach (var group in ComponentCatalog.GroupOrder)
    {
        var items = Filtered.Where(component => component.Group == group).ToArray();
        if (items.Length > 0)
        {
            <section class="ov-catalog-group">
                <div class="ov-catalog-group__heading"><MudText Typo="Typo.h6">@group</MudText><span>@items.Length</span></div>
                <div class="ov-catalog-grid">
                    @foreach (var component in items)
                    {
                        <a class="ov-catalog-card" href="components/@component.Slug">
                            <div class="ov-catalog-card__top"><strong>@component.Name</strong><code>@component.Reference</code></div>
                            <span>@component.Description</span>
                            <small>@component.UseWhen</small>
                            <div class="ov-catalog-card__states">@string.Join(" · ", component.States.Take(4))@(component.States.Length > 4 ? " · …" : string.Empty)</div>
                        </a>
                    }
                </div>
            </section>
        }
    }
}

@code {
    private string _search = string.Empty;
    private string? _group;

    private IEnumerable<ComponentDefinition> Filtered
        => ComponentCatalog.Search(_search).Where(component => _group is null || component.Group == _group);

    private void SetGroup(string? group) => _group = group;
    private string GroupClass(string? group) => group == _group ? "ov-filter-chip ov-filter-chip--active" : "ov-filter-chip";
}
