@using OneVision.UI.Iconography

<div class="ov-demo-allocation">
    <OVAllocation Title="Create allocation"
                  SearchLoading="@IsSearching"
                  NoSourceResults="@HasNoResults"
                  EligibilityUnavailable="@IsUnavailable"
                  ErrorMessage="@(IsInvalid ? "The selected source is no longer eligible. Change the selection." : null)"
                  ReadOnly="@IsReadOnly"
                  Submitting="@IsSubmitting"
                  SubmissionErrorMessage="@(IsSubmissionError ? "The allocation could not be created. Correct the issue and retry." : null)"
                  Completed="@IsCompleted"
                  Description="Assign an eligible source Attribute to this entity."
                  FindTarget="@IsFinder"
                  TargetPlatform="@_targetPlatform"
                  TargetPlatformChanged="OnTargetPlatformChanged"
                  AvailableTargetPlatforms="@TargetPlatforms"
                  TargetSelected="@(IsFinder && _targetSelected)"
                  ChangeTargetRequested="OnChangeTargetRequested"
                  FixedSourceSystem="@FixedSystem"
                  FixedSourceType="@FixedType"
                  SourceSelected="@_sourceSelected"
                  ChangeSourceRequested="OnChangeSourceRequested"
                  AlwaysBelonged="@_alwaysBelonged"
                  AlwaysBelongedChanged="OnAlwaysBelongedChanged"
                  FromDate="@_fromDate"
                  FromDateChanged="OnFromDateChanged"
                  ToDate="@_toDate"
                  ToDateChanged="OnToDateChanged">
        <Target>
            <div class="ov-demo-allocation-identity">
                <div class="ov-demo-allocation-identity__icon"><OVIcon Name="OneVisionIcon.Organisation" /></div>
                <div class="ov-demo-allocation-identity__text"><strong>Children &amp; Families</strong><span>Organisation Unit · 620496</span></div>
            </div>
        </Target>
        <TargetType><OVSelect T="string" Label="" Value="@_targetType" ValueChanged="OnTargetTypeChanged" Options="@TargetTypes" /></TargetType>
        <TargetSearch><OVSearchBox Value="@_targetSearch" ValueChanged="OnTargetSearchChanged" Placeholder="Search target entities" /></TargetSearch>
        <TargetResults>
            <OVSelectionList Items="@FilteredTargets" SelectedKeys="@_selectedTargetKeys" SelectedKeysChanged="OnTargetSelectionChanged" />
        </TargetResults>
        <SelectedTarget>
            <div class="ov-demo-allocation-identity">
                <div class="ov-demo-allocation-identity__icon"><OVIcon Name="OneVisionIcon.Organisation" /></div>
                <div class="ov-demo-allocation-identity__text"><strong>@SelectedTargetItem?.Label</strong><span>@SelectedTargetItem?.Description</span></div>
            </div>
        </SelectedTarget>
        <SourceSystem><OVSelect T="string" Label="" Value="@_sourceSystem" ValueChanged="OnSourceSystemChanged" Options="@(IsRuleConstrained ? RuleSourceSystems : SourceSystems)" Disabled="@ControlsLocked" /></SourceSystem>
        <SourceType><OVSelect T="string" Label="" Value="@_sourceType" ValueChanged="OnSourceTypeChanged" Options="@(IsRuleConstrained ? EligibleRuleTypes : SourceTypes)" Disabled="@ControlsLocked" /></SourceType>
        <SourceSearch><OVSearchBox Value="@_sourceSearch" ValueChanged="OnSourceSearchChanged" Placeholder="Search by name, value or identifier" Disabled="@ControlsLocked" /></SourceSearch>
        <SourceResults>
            <OVSelectionList Items="@DisplayedSources" SelectedKeys="@_selectedSourceKeys" SelectedKeysChanged="OnSourceSelectionChanged" Disabled="@ControlsLocked" />
            @if (IsRuleConstrained && RulePageCount > 1)
            {
                <div class="ov-demo-allocation-pagination">
                    <span>Page @_sourcePage of @RulePageCount · @FilteredRuleSources.Count eligible entities</span>
                    <OVButton Appearance="OVButtonVariant.Secondary" Disabled="@(_sourcePage <= 1 || ControlsLocked)" OnClick="PreviousSources">Previous</OVButton>
                    <OVButton Appearance="OVButtonVariant.Secondary" Disabled="@(_sourcePage >= RulePageCount || ControlsLocked)" OnClick="NextSources">Next</OVButton>
                </div>
            }
        </SourceResults>
        <SelectedSource>
            <div class="ov-demo-allocation-identity">
                <div class="ov-demo-allocation-identity__icon"><OVIcon Name="OneVisionIcon.Organisation" /></div>
                <div class="ov-demo-allocation-identity__text"><strong>@SelectedSourceItem?.Label</strong><span>@SelectedSourceItem?.Description</span></div>
            </div>
        </SelectedSource>
        <Actions>
            <div class="ov-demo-allocation-actions">
                <OVButton Appearance="OVButtonVariant.Secondary" Disabled="@IsSubmitting" OnClick="Cancel">Cancel</OVButton>
                <OVButton Disabled="@(!CanAllocate || ControlsLocked)" Loading="@IsSubmitting" OnClick="Allocate">@(IsRuleConstrained ? "Create Allocation" : "Allocate")</OVButton>
            </div>
        </Actions>
    </OVAllocation>
    @if (_allocated)
    {
        <OVAlert Tone="OVAlertTone.Success">Example allocation completed. No application data has been changed.</OVAlert>
    }
</div>

@code {
    [Parameter] public string Scenario { get; set; } = "known";
    [Parameter] public bool EditableSourceSystem { get; set; } = true;
    [Parameter] public bool EditableSourceType { get; set; }
    [Parameter] public bool ShowSelectedSource { get; set; }
    [Parameter] public bool ShowSelectedTarget { get; set; } = true;
    [Parameter] public bool ShowExplicitDates { get; set; }
    [Parameter] public bool ConstrainTargetPlatforms { get; set; }

    private bool IsFinder => Scenario == "finder";
    private bool IsRuleConstrained => Scenario is not ("known" or "finder");
    private bool IsSearching => Scenario == "searching";
    private bool IsUnavailable => Scenario == "unavailable";
    private bool IsReadOnly => Scenario == "read-only";
    private bool IsSubmitting => Scenario == "submitting";
    private bool IsSubmissionError => Scenario == "submission-error";
    private bool IsCompleted => Scenario == "completed";
    private bool IsInvalid => Scenario == "invalid";
    private bool ControlsLocked => IsReadOnly || IsSubmitting || IsCompleted;
    private string? FixedSystem => IsRuleConstrained || EditableSourceSystem ? null : "ESR";
    private string? FixedType => IsRuleConstrained || EditableSourceType ? null : "Attribute";
    private IReadOnlyList<OVAllocationTargetPlatform> TargetPlatforms
        => ConstrainTargetPlatforms ? [OVAllocationTargetPlatform.Eam] :
            [OVAllocationTargetPlatform.Eam, OVAllocationTargetPlatform.Odm, OVAllocationTargetPlatform.Idm];

    private OVAllocationTargetPlatform _targetPlatform = OVAllocationTargetPlatform.Eam;
    private string? _targetType = "organisation";
    private string? _targetSearch;
    private IReadOnlyCollection<string> _selectedTargetKeys = ["ORG-NWR-002"];
    private bool _targetSelected = true;
    private string? _sourceSystem = "esr";
    private string? _sourceType = "attribute";
    private string? _sourceSearch;
    private IReadOnlyCollection<string> _selectedSourceKeys = [];
    private bool _sourceSelected;
    private bool _alwaysBelonged = true;
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private bool _allocated;
    private int _sourcePage = 1;
    private const int RulePageSize = 2;

    protected override void OnParametersSet()
    {
        _targetSelected = ShowSelectedTarget;
        _sourceSelected = ShowSelectedSource || Scenario is "submitting" or "submission-error" or "completed" or "invalid";
        _alwaysBelonged = !ShowExplicitDates;
        if (IsRuleConstrained)
        {
            _sourceSystem = _sourceSystem is "esr" or "ods" ? _sourceSystem : "esr";
            if (!EligibleRuleTypes.Any(option => option.Value == _sourceType))
                _sourceType = EligibleRuleTypes[0].Value;
        }
        if (_sourceSelected && (_selectedSourceKeys.Count == 0 || IsRuleConstrained && !_selectedSourceKeys.Any(key => RuleSources.Any(item => item.Key == key))))
            _selectedSourceKeys = [IsRuleConstrained ? "SRC-JOB-02" : "SRC-1002"];
        if (!_sourceSelected) _selectedSourceKeys = [];
        if (ConstrainTargetPlatforms && _targetPlatform != OVAllocationTargetPlatform.Eam)
            _targetPlatform = OVAllocationTargetPlatform.Eam;
        _allocated = false;
    }

    private bool CanAllocate => _sourceSelected && !IsInvalid && !IsUnavailable && (!IsFinder || _targetSelected)
        && (_alwaysBelonged || _fromDate is not null);
    private OVListItem? SelectedSourceItem => (IsRuleConstrained ? RuleSources : SourceItems).FirstOrDefault(item => _selectedSourceKeys.Contains(item.Key));
    private bool HasNoResults => Scenario == "empty" || (IsRuleConstrained ? FilteredRuleSources.Count == 0 : FilteredSources.Count == 0);
    private IReadOnlyList<OVListItem> DisplayedSources => IsRuleConstrained
        ? FilteredRuleSources.Skip((_sourcePage - 1) * RulePageSize).Take(RulePageSize).ToArray() : FilteredSources;
    private IReadOnlyList<OVListItem> FilteredRuleSources => RuleSources.Where(item =>
        item.Key.StartsWith($"SRC-{(_sourceSystem == "ods" ? "ODS" : "JOB")}", StringComparison.Ordinal)
        && (_sourceType == "job-role" ? item.Key.Contains("JOB", StringComparison.Ordinal) :
            _sourceType == "practice-category" ? item.Key.Contains("ODS", StringComparison.Ordinal) : false)
        && Matches(item, _sourceSearch)).ToArray();
    private int RulePageCount => Math.Max(1, (FilteredRuleSources.Count + RulePageSize - 1) / RulePageSize);
    private IReadOnlyList<OVOption<string>> EligibleRuleTypes => _sourceSystem == "ods"
        ? [new("practice-category", "Practice Category")] : [new("job-role", "Job Role")];
    private OVListItem? SelectedTargetItem => TargetItems.FirstOrDefault(item => _selectedTargetKeys.Contains(item.Key));
    private IReadOnlyList<OVListItem> FilteredSources => SourceItems.Where(item => Matches(item, _sourceSearch)).ToArray();
    private IReadOnlyList<OVListItem> FilteredTargets => TargetItems.Where(item => Matches(item, _targetSearch)).ToArray();
    private static bool Matches(OVListItem item, string? search)
        => string.IsNullOrWhiteSpace(search) || item.Label.Contains(search, StringComparison.OrdinalIgnoreCase)
            || item.Key.Contains(search, StringComparison.OrdinalIgnoreCase);

    private static readonly IReadOnlyList<OVOption<string>> RuleSourceSystems =
    [
        new("esr", "ESR"), new("ods", "ODS")
    ];
    private static readonly IReadOnlyList<OVListItem> RuleSources =
    [
        new("SRC-JOB-01", "Community Nurse", "ESR · Job Role · JR-0042", "Eligible"),
        new("SRC-JOB-02", "Specialist Practitioner", "ESR · Job Role · JR-0188", "Eligible"),
        new("SRC-JOB-03", "Advanced Practitioner", "ESR · Job Role · JR-0192", "Eligible"),
        new("SRC-JOB-04", "Community Matron", "ESR · Job Role · JR-0020", "Eligible"),
        new("SRC-JOB-05", "Ward Manager", "ESR · Job Role · JR-0064", "Eligible"),
        new("SRC-ODS-01", "Primary Care", "ODS · Practice Category · PC-010", "Eligible"),
        new("SRC-ODS-02", "Specialist Services", "ODS · Practice Category · PC-018", "Eligible")
    ];
    private static readonly IReadOnlyList<OVOption<string>> SourceSystems =
    [
        new("esr", "ESR"), new("ods", "ODS"), new("manual", "Manual")
    ];
    private static readonly IReadOnlyList<OVOption<string>> SourceTypes =
    [
        new("attribute", "Attribute"), new("asset", "Asset"), new("location", "Location")
    ];
    private static readonly IReadOnlyList<OVOption<string>> TargetTypes =
    [
        new("organisation", "Organisation Unit"), new("service", "Service"), new("location", "Location")
    ];
    private static readonly IReadOnlyList<OVListItem> SourceItems =
    [
        new("SRC-1001", "Staff Group", "ESR · ATTR-001", "Eligible"),
        new("SRC-1002", "Workforce Status", "ESR · ATTR-002", "Eligible"),
        new("SRC-1003", "Position Number", "ESR · ATTR-003", "Eligible"),
        new("SRC-1004", "Employment Type", "ESR · ATTR-004", "Eligible")
    ];
    private static readonly IReadOnlyList<OVListItem> TargetItems =
    [
        new("ORG-MAN-001", "Manchester Hospital", "Organisation Unit · ORG-MAN-001", "Active"),
        new("ORG-NWR-002", "North West Region", "Organisation Unit · ORG-NWR-002", "Active"),
        new("ORG-CSH-003", "Community Services Hub", "Organisation Unit · ORG-CSH-003", "Active")
    ];

    private Task OnTargetPlatformChanged(OVAllocationTargetPlatform value) { _targetPlatform = value; _targetSelected = false; return Task.CompletedTask; }
    private Task OnTargetTypeChanged(string? value) { _targetType = value; _targetSelected = false; return Task.CompletedTask; }
    private Task OnTargetSearchChanged(string? value) { _targetSearch = value; return Task.CompletedTask; }
    private Task OnTargetSelectionChanged(IReadOnlyCollection<string> value) { _selectedTargetKeys = value; _targetSelected = value.Count > 0; return Task.CompletedTask; }
    private Task OnChangeTargetRequested() { _targetSelected = false; return Task.CompletedTask; }
    private Task OnSourceSystemChanged(string? value)
    {
        if (ControlsLocked) return Task.CompletedTask;
        _sourceSystem = value;
        if (IsRuleConstrained && !EligibleRuleTypes.Any(option => option.Value == _sourceType))
            _sourceType = EligibleRuleTypes[0].Value;
        ResetSourceSelection();
        return Task.CompletedTask;
    }
    private Task OnSourceTypeChanged(string? value)
    {
        if (ControlsLocked) return Task.CompletedTask;
        _sourceType = value;
        ResetSourceSelection();
        return Task.CompletedTask;
    }
    private Task OnSourceSearchChanged(string? value)
    {
        if (ControlsLocked) return Task.CompletedTask;
        _sourceSearch = value;
        _sourcePage = 1;
        return Task.CompletedTask;
    }
    private void ResetSourceSelection()
    {
        _sourceSelected = false;
        _selectedSourceKeys = [];
        _sourceSearch = null;
        _sourcePage = 1;
    }
    private Task PreviousSources(Microsoft.AspNetCore.Components.Web.MouseEventArgs _)
    {
        if (_sourcePage > 1 && !ControlsLocked) _sourcePage--;
        return Task.CompletedTask;
    }
    private Task NextSources(Microsoft.AspNetCore.Components.Web.MouseEventArgs _)
    {
        if (_sourcePage < RulePageCount && !ControlsLocked) _sourcePage++;
        return Task.CompletedTask;
    }
    private Task OnSourceSelectionChanged(IReadOnlyCollection<string> value) { _selectedSourceKeys = value; _sourceSelected = value.Count > 0; return Task.CompletedTask; }
    private Task OnChangeSourceRequested() { if (!ControlsLocked) ResetSourceSelection(); return Task.CompletedTask; }
    private Task OnAlwaysBelongedChanged(bool value) { _alwaysBelonged = value; return Task.CompletedTask; }
    private Task OnFromDateChanged(DateTime? value) { _fromDate = value; return Task.CompletedTask; }
    private Task OnToDateChanged(DateTime? value) { _toDate = value; return Task.CompletedTask; }
    private Task Cancel(Microsoft.AspNetCore.Components.Web.MouseEventArgs _) { _sourceSelected = false; _allocated = false; return Task.CompletedTask; }
    private Task Allocate(Microsoft.AspNetCore.Components.Web.MouseEventArgs _) { if (CanAllocate) _allocated = true; return Task.CompletedTask; }
}

<style>
    .ov-demo-allocation { display: grid; gap: 12px; width: 100%; min-width: 0; max-width: 640px; }
    .ov-demo-allocation-identity { display: flex; align-items: center; min-width: 0; gap: 10px; }
    .ov-demo-allocation-identity__icon { display: grid; place-items: center; flex: 0 0 34px; height: 34px; border-radius: 6px; background: var(--ov-colour-surface); }
    .ov-demo-allocation-identity__text { display: grid; gap: 2px; min-width: 0; }
    .ov-demo-allocation-identity__text strong { overflow-wrap: anywhere; font-size: .9rem; font-weight: 600; }
    .ov-demo-allocation-identity__text span { overflow-wrap: anywhere; color: var(--ov-colour-muted); font-size: .76rem; }
    .ov-demo-allocation-actions { display: flex; justify-content: flex-end; gap: 8px; width: 100%; }
    .ov-demo-allocation-pagination { display:flex; flex-wrap:wrap; justify-content:flex-end; align-items:center; gap:8px; padding:6px; border-top:1px solid var(--ov-colour-border); }
    .ov-demo-allocation-pagination span { margin-right:auto; color:var(--ov-colour-muted); font-size:.76rem; }
</style>
