<div class="ov-workspace-demo">
    <section class="ov-workspace-demo__example">
        <div class="ov-workspace-demo__heading">
            <strong>Tab summary with active process</strong>
            <span>Compact contextual state without a dashboard/card grid.</span>
        </div>
        <OVTabs Items="@Tabs" ActiveKey="overview" />
        <OVContextSummary Items="@TabSummary">
            <Process>
                <OVProcessStatus State="OVProcessState.Running"
                                 Label="Refreshing catalogue"
                                 Phase="Evaluating records"
                                 ProgressCurrent="1284"
                                 ProgressTotal="5930"
                                 StartedAt="@DemoStartedAt"
                                 Message="Applying the current validation rules" />
            </Process>
        </OVContextSummary>
    </section>

    <section class="ov-workspace-demo__example">
        <div class="ov-workspace-demo__heading">
            <strong>Review Workspace · List → open → focused workspace → back</strong>
            <span>The list is the previous navigation level. The focused workspace uses the full available content width and does not retain the collection as a permanent side rail.</span>
        </div>
        @if (!_workspaceOpen)
        {
            <OVListPage Title="Configuration reviews" Description="Browse review items, then open one into a focused workspace.">
                <Summary>
                    <OVContextSummary Items="@ListSummary">
                        <Process>
                            <OVProcessStatus State="OVProcessState.Completed"
                                             Label="Review generation"
                                             Phase="Last evaluation"
                                             ProgressCurrent="3"
                                             ProgressTotal="3"
                                             LastRunAt="@DemoCompletedAt"
                                             Message="Review collection is ready" />
                        </Process>
                    </OVContextSummary>
                </Summary>
                <Toolbar>
                    <OVTextField Label="Search" Placeholder="Search review items" />
                    <OVSelect T="string" Label="Status" Value="@_reviewStatus" Options="@ReviewStatusOptions" />
                </Toolbar>
                <ChildContent>
                    <OVCardCollection AriaLabel="Configuration reviews">
                        @foreach (var item in ReviewItems)
                        {
                            <OVCard SelectedAction="@(() => OpenWorkspace(item.Key))" AriaLabel="@($"Open {item.Label}")">
                                <Header><strong>@item.Label</strong></Header>
                                <Status><OVPill Text="@item.Status" Role="OVPillRole.Status" Tone="@item.Tone" /></Status>
                                <ChildContent><span>@item.Description</span></ChildContent>
                                <Metadata><span>@item.Metadata</span></Metadata>
                                <PrimaryAction><OVButton Appearance="OVButtonVariant.Subtle" OnClick="_ => OpenWorkspace(item.Key)">Open review</OVButton></PrimaryAction>
                            </OVCard>
                        }
                    </OVCardCollection>
                </ChildContent>
                <Pagination><span>1–3 of 3</span></Pagination>
            </OVListPage>
        }
        else
        {
            <OVDetailPage Title="North region configuration"
                          Description="Focused full-width review workspace with contextual state and governed actions."
                          Busy="@_saving">
                <BackAction>
                    <OVButton Appearance="OVButtonVariant.Subtle" Disabled="@_saving" OnClick="BackToList">← Back to reviews</OVButton>
                </BackAction>
                <Status><OVPill Text="Draft" Role="OVPillRole.Status" Tone="OVPillTone.Warning" /></Status>
                <Actions><OVButton Appearance="OVButtonVariant.Secondary" Disabled="@_saving">Refresh</OVButton></Actions>
                <Summary>
                    <OVContextSummary Items="@WorkspaceSummary">
                        <Process>
                            <OVProcessStatus State="OVProcessState.Completed"
                                             Label="Validation"
                                             Phase="Last run"
                                             LastRunAt="@DemoCompletedAt"
                                             Message="All 42 checks completed" />
                        </Process>
                    </OVContextSummary>
                </Summary>
                <ChildContent>
                    <div class="ov-workspace-demo__workspace-content">
                        <h3>Selectable information cards</h3>
                        <p>Selection is explicit, keyboard-operable and visible beyond colour alone. Actions remain separate from the selection target.</p>
                        <OVCardCollection AriaLabel="Configuration options">
                            <OVCard Selected="@(_selectedCard == "alpha")" SelectedAction="@(() => SelectCard("alpha"))" AriaLabel="Select source Alpha">
                                <Header><strong>Source Alpha</strong></Header>
                                <Status><OVPill Text="Ready" Role="OVPillRole.Status" Tone="OVPillTone.Success" /></Status>
                                <ChildContent><span>Validated source definition ready for review.</span></ChildContent>
                                <Metadata><div class="ov-workspace-demo__metadata"><span>12 fields</span><span>Updated 14:32</span><span>SQL</span></div></Metadata>
                                <SecondaryActions><OVButton Appearance="OVButtonVariant.Subtle">Inspect</OVButton></SecondaryActions>
                            </OVCard>
                            <OVCard Selected="@(_selectedCard == "beta")" SelectedAction="@(() => SelectCard("beta"))" AriaLabel="Select source Beta">
                                <Header><strong>Source Beta</strong></Header>
                                <Status><OVPill Text="Review" Role="OVPillRole.Status" Tone="OVPillTone.Warning" /></Status>
                                <ChildContent><span>One warning requires operator review.</span></ChildContent>
                                <Metadata><div class="ov-workspace-demo__metadata"><span>9 fields</span><span>Updated 14:28</span><span>API</span></div></Metadata>
                                <SecondaryActions><OVButton Appearance="OVButtonVariant.Subtle">Inspect</OVButton></SecondaryActions>
                            </OVCard>
                            <OVCard Disabled="true" Actionable="true" AriaLabel="Source Gamma disabled">
                                <Header><strong>Source Gamma</strong></Header>
                                <Status><OVPill Text="Disabled" Role="OVPillRole.Status" Tone="OVPillTone.Neutral" /></Status>
                                <ChildContent><span>This item is unavailable to the current user.</span></ChildContent>
                                <Metadata><div class="ov-workspace-demo__metadata"><span>Permission required</span></div></Metadata>
                            </OVCard>
                            <OVCard Busy="true" Actionable="true" AriaLabel="Source Delta busy">
                                <Header><strong>Source Delta</strong></Header>
                                <Status><OVPill Text="Refreshing" Role="OVPillRole.Status" Tone="OVPillTone.Info" /></Status>
                                <ChildContent><span>The item remains visible while its operation is in progress.</span></ChildContent>
                                <Metadata><div class="ov-workspace-demo__metadata"><span>18 fields</span><span>Refresh in progress</span></div></Metadata>
                            </OVCard>
                        </OVCardCollection>
                    </div>
                </ChildContent>
                <FooterContent>One primary action is visually dominant; secondary actions remain subordinate and duplicate submission is prevented while busy.</FooterContent>
                <FooterActions>
                    <OVButton Appearance="OVButtonVariant.Secondary" Disabled="@_saving">Reset</OVButton>
                    <OVButton Appearance="OVButtonVariant.Primary" Loading="@_saving" Disabled="@_saving" OnClick="SaveAsync">Save changes</OVButton>
                </FooterActions>
            </OVDetailPage>
        }
    </section>

    <section class="ov-workspace-demo__example">
        <div class="ov-workspace-demo__heading">
            <strong>Content-state precedence</strong>
            <span>Reusable collection/workspace surfaces consistently resolve loading → error → empty → content.</span>
        </div>
        <div class="ov-workspace-demo__state-grid">
            <div><strong>Loading</strong><OVCardCollection Loading="true" AriaLabel="Loading example" /></div>
            <div><strong>Error</strong><OVCardCollection ErrorMessage="Review items could not be loaded." AriaLabel="Error example" /></div>
            <div><strong>Empty</strong><OVCardCollection Empty="true" EmptyTitle="No review items" EmptyDescription="Nothing currently requires review." AriaLabel="Empty example" /></div>
        </div>
    </section>

    <section class="ov-workspace-demo__example">
        <div class="ov-workspace-demo__heading">
            <strong>Process status states</strong>
            <span>The application supplies semantic state; OneVision.UI owns presentation.</span>
        </div>
        <div class="ov-workspace-demo__process-grid">
            <OVProcessStatus State="OVProcessState.Queued" Label="Queued refresh" Message="Waiting for a worker" LastRunAt="@DemoCompletedAt" />
            <OVProcessStatus State="OVProcessState.Running" Label="Active refresh" Phase="Reading source" ProgressCurrent="1284" ProgressTotal="5930" StartedAt="@DemoStartedAt" Message="Evaluating evidence" />
            <OVProcessStatus State="OVProcessState.Completed" Label="Completed refresh" ProgressCurrent="5930" ProgressTotal="5930" CompletedAt="@DemoCompletedAt" Message="Refresh completed successfully" />
            <OVProcessStatus State="OVProcessState.Failed" Label="Failed refresh" Phase="Publishing" CompletedAt="@DemoCompletedAt" Message="The destination rejected the current payload" />
            <OVProcessStatus State="OVProcessState.Stale" Label="Stale refresh" LastRunAt="@DemoStaleAt" Message="The last successful refresh is outside the expected interval" />
        </div>
    </section>
</div>

@code {
    private bool _workspaceOpen;
    private bool _saving;
    private string _selectedCard = "alpha";
    private string _reviewStatus = "All";

    private static readonly DateTimeOffset DemoStartedAt = new(2026, 10, 29, 14, 18, 0, TimeSpan.Zero);
    private static readonly DateTimeOffset DemoCompletedAt = new(2026, 10, 29, 14, 32, 0, TimeSpan.Zero);
    private static readonly DateTimeOffset DemoStaleAt = new(2026, 10, 26, 9, 5, 0, TimeSpan.Zero);
    private static readonly RenderFragment EmptyTabContent = _ => { };

    private static readonly IReadOnlyList<OVTabItem> Tabs =
    [
        new("overview", "Overview", EmptyTabContent),
        new("sources", "Sources", EmptyTabContent),
        new("activity", "Activity", EmptyTabContent)
    ];

    private static readonly IReadOnlyList<OVContextSummaryItem> TabSummary =
    [
        new("Records", "5,930"),
        new("Valid", "5,812", "98.0%"),
        new("Warnings", "118", Tone: OVPillTone.Warning),
        new("Status", "Active", Tone: OVPillTone.Success)
    ];

    private static readonly IReadOnlyList<OVContextSummaryItem> ListSummary =
    [
        new("Awaiting review", "3"),
        new("Ready", "2", Tone: OVPillTone.Success),
        new("Needs attention", "1", Tone: OVPillTone.Warning),
        new("Visible", "3")
    ];

    private static readonly IReadOnlyList<OVContextSummaryItem> WorkspaceSummary =
    [
        new("Sources", "4"),
        new("Rules", "42"),
        new("Owner", "Operations"),
        new("State", "Draft", Tone: OVPillTone.Warning)
    ];

    private static readonly IReadOnlyList<OVOption<string>> ReviewStatusOptions =
    [
        new("All", "All statuses"),
        new("Ready", "Ready"),
        new("Review", "Needs review")
    ];

    private static readonly IReadOnlyList<ReviewItemDemo> ReviewItems =
    [
        new("north", "North region configuration", "4 sources · 42 rules", "Ready", OVPillTone.Success, "Updated 14:32"),
        new("central", "Central region configuration", "3 sources · 38 rules", "Review", OVPillTone.Warning, "Updated 14:28"),
        new("south", "South region configuration", "5 sources · 47 rules", "Ready", OVPillTone.Success, "Updated 14:21")
    ];

    private void OpenWorkspace(string key) => _workspaceOpen = true;
    private void BackToList(MouseEventArgs _) => _workspaceOpen = false;
    private void SelectCard(string key) => _selectedCard = key;

    private async Task SaveAsync(MouseEventArgs _)
    {
        if (_saving) return;
        _saving = true;
        await Task.Delay(500);
        _saving = false;
    }

    private sealed record ReviewItemDemo(string Key, string Label, string Description, string Status, OVPillTone Tone, string Metadata);
}
