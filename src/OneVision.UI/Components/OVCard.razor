<MudPaper Elevation="0" Class="@CardClass">
    @if (Header is not null)
    {
        <div class="ov-card__header">@Header</div>
    }
    <div class="ov-card__content">@ChildContent</div>
    @if (Actions is not null)
    {
        <div class="ov-card__actions">@Actions</div>
    }
</MudPaper>

@code {
    [Parameter] public RenderFragment? Header { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Actionable { get; set; }
    [Parameter] public string? Class { get; set; }

    private string CardClass
    {
        get
        {
            var value = "ov-card";
            if (Disabled) value += " ov-card--disabled";
            if (Actionable) value += " ov-card--actionable";
            return string.IsNullOrWhiteSpace(Class) ? value : $"{value} {Class}";
        }
    }
}
