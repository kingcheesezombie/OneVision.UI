<OVSourceConfiguration Title="Example source"
                       Description="Managed inbound source configuration"
                       ActiveSection="@_activeSection"
                       ActiveSectionChanged="OnSectionChanged">
    <Status><OVPill Text="Enabled" Role="OVPillRole.Status" Tone="OVPillTone.Success" /></Status>
    <Overview>
        <OVPanel>
            <Header><strong>Source overview</strong></Header>
            <ChildContent>
                <div class="ov-demo-detail-grid">
                    <OVKeyValue Label="Name" Value="Example source" />
                    <OVKeyValue Label="Type" Value="Structured inbound source" />
                    <OVKeyValue Label="Status" Value="Enabled" />
                    <OVKeyValue Label="Last profiled" Value="@_lastProfiled" />
                </div>
            </ChildContent>
        </OVPanel>
    </Overview>
    <Connection>
        <OVPanel>
            <Header><strong>Connection</strong></Header>
            <ChildContent>
                <div class="ov-demo-form-grid">
                    <OVSelect T="string" Label="Managed connection" Value="@_connectionKey" ValueChanged="OnConnectionChanged" Options="@Connections" />
                </div>
                <div class="ov-demo-detail-grid mt-3">
                    <OVKeyValue Label="Connection" Value="@ConnectionName" />
                    <OVKeyValue Label="Type" Value="@ConnectionType" />
                    <OVKeyValue Label="Endpoint" Value="@ConnectionEndpoint" />
                    <OVKeyValue Label="Status" Value="Available" />
                </div>
                <div class="mt-3">
                    <OVAlert Tone="OVAlertTone.Information">
                        The managed connection owns everything required to reach and authenticate to the endpoint, including file locations and LDAP connection/base details. Profile only defines source-specific retrieval or parsing behaviour that is not reusable connection state.
                    </OVAlert>
                </div>
            </ChildContent>
        </OVPanel>
    </Connection>
    <Profile>
        <OVSourceProfile ConnectionLabel="@ConnectionName"
                         RunHint="@ProfileRunHint"
                         ResultSummary="@ProfileResultSummary"
                         Profiling="@_profiling"
                         RunRequested="RunProfile">
            <Status>
                <OVPill Text="@ConnectionType" Role="OVPillRole.Source" />
            </Status>
            <Definition>
                @if (_connectionKey == "primary-sql")
                {
                    <div class="ov-demo-form-grid">
                        <OVSelect T="string" Label="Source type" Value="@_sqlSourceType" ValueChanged="OnSqlSourceTypeChanged" Options="@SqlSourceTypes" />
                        @if (_sqlSourceType == "procedure")
                        {
                            <OVTextField Label="Stored procedure" Value="@_sqlProcedure" ValueChanged="value => _sqlProcedure = value" />
                            <OVTextField Label="Start date parameter" Value="@_sqlStartDate" ValueChanged="value => _sqlStartDate = value" />
                            <OVTextField Label="End date parameter" Value="@_sqlEndDate" ValueChanged="value => _sqlEndDate = value" />
                        }
                        else
                        {
                            <div class="ov-source-config-demo__wide-field">
                                <OVTextArea Label="SQL query" Value="@_sqlQuery" ValueChanged="value => _sqlQuery = value" Lines="7" />
                            </div>
                        }
                    </div>
                }
                else if (_connectionKey == "remote-json")
                {
                    <div class="ov-demo-form-grid">
                        <OVTextField Label="Endpoint extension" Value="@_apiExtension" ValueChanged="value => _apiExtension = value" Placeholder="/patients/search" />
                        <OVSelect T="string" Label="HTTP method" Value="@_apiMethod" ValueChanged="value => _apiMethod = value" Options="@HttpMethods" />
                        <OVTextField Label="Response root" Value="@_apiRoot" ValueChanged="value => _apiRoot = value" Placeholder="$.items" />
                        <div class="ov-source-config-demo__wide-field">
                            <OVTextArea Label="Request body / parameters" Value="@_apiBody" ValueChanged="value => _apiBody = value" Lines="5" />
                        </div>
                    </div>
                }
                else if (_connectionKey == "inbound-file")
                {
                    <div class="ov-demo-form-grid">
                        <OVTextField Label="File pattern" Value="@_filePattern" ValueChanged="value => _filePattern = value" Placeholder="patients-*.csv" />
                        <OVSelect T="string" Label="Format" Value="@_fileFormat" ValueChanged="value => _fileFormat = value" Options="@FileFormats" />
                        <OVTextField Label="Header row" Value="@_fileHeaderRow" ValueChanged="value => _fileHeaderRow = value" />
                    </div>
                }
                else
                {
                    <OVAlert Tone="OVAlertTone.Information">The managed LDAP connection already owns host, port, authentication and directory/base context. Run Profile to discover the available returned attributes; the Mapping section decides which attributes are used and what they map to.</OVAlert>
                }
            </Definition>
            <Message>
                @if (_profiled)
                {
                    <OVAlert Tone="OVAlertTone.Success">Profile completed. The discovered structure below is the output of the current Profile definition executed through the selected managed connection.</OVAlert>
                }
                else
                {
                    <OVAlert Tone="OVAlertTone.Information">Change the source definition, then choose <strong>Run &amp; Profile</strong> to execute it through the selected connection and refresh the discovered structure.</OVAlert>
                }
            </Message>
            <Profile>
                <OVStructuredFieldTree Nodes="@SourceFields" SelectionMode="OVStructuredSelectionMode.LeafOnly" />
            </Profile>
        </OVSourceProfile>
    </Profile>
    <Mapping>
        <div class="ov-source-config-demo__mapping">
            <OVPanel>
                <Header><strong>Pair mapping</strong></Header>
                <ChildContent>
                    <div class="mb-3">
                        <OVAlert Tone="OVAlertTone.Information">Map fields from the profiled source structure onto the declared target contract. Mapping consumes the Profile output; it does not define connection details.</OVAlert>
                    </div>
                    <OVMappingPair SourceItems="@SourceFields"
                                   TargetItems="@Targets"
                                   Mappings="@_mappings"
                                   AddRequested="OnMappingAdd"
                                   ReplaceRequested="OnMappingAdd"
                                   RemoveRequested="OnMappingRemove" />
                </ChildContent>
            </OVPanel>
            <OVPanel>
                <Header><strong>Mapping rules <span class="ov-pattern-demo__muted">(optional)</span></strong></Header>
                <ChildContent>
                    <OVMappingRule RuleName="Apply mapping when source is active"
                                   RootGroup="@RuleGroup"
                                   Operands="@RuleOperands"
                                   Operators="@RuleOperators"
                                   OutcomeOptions="@RuleOutcomes"
                                   OutcomeKey="apply" />
                </ChildContent>
            </OVPanel>
        </div>
    </Mapping>
    <FooterActions>
        <OVButton Appearance="OVButtonVariant.Secondary">Cancel</OVButton>
        <OVButton Icon="OneVisionIcon.Save">Save source</OVButton>
    </FooterActions>
</OVSourceConfiguration>

@code {
    [Parameter] public string? Scope { get; set; }

    private string? _activeSection = "overview";
    private string? _connectionKey = "primary-sql";
    private List<OVMappingPairEntry> _mappings = [];
    private bool _profiling;
    private bool _profiled;
    private string _lastProfiled = "Not yet profiled";

    private string? _sqlSourceType = "procedure";
    private string? _sqlProcedure = "dbo.usp_GetPatients";
    private string? _sqlStartDate = "2026-10-01";
    private string? _sqlEndDate = "2026-10-27";
    private string? _sqlQuery = "select PatientId, NHSNumber, DateOfBirth\nfrom dbo.Patient\nwhere IsActive = 1;";

    private string? _apiExtension = "/patients/search";
    private string? _apiMethod = "POST";
    private string? _apiRoot = "$.items";
    private string? _apiBody = "{\n  \"active\": true\n}";

    private string? _filePattern = "patients-*.csv";
    private string? _fileFormat = "csv";
    private string? _fileHeaderRow = "1";

    protected override void OnParametersSet()
    {
        _activeSection = Scope is "overview" or "connection" or "profile" or "mapping" ? Scope : "overview";
    }

    private static readonly IReadOnlyList<OVOption<string>> Connections =
    [
        new("primary-sql", "Primary warehouse · SQL"),
        new("remote-json", "Remote patient API · JSON/API"),
        new("inbound-file", "Inbound file share · FILE"),
        new("directory", "Corporate directory · LDAP")
    ];

    private static readonly IReadOnlyList<OVOption<string>> SqlSourceTypes =
    [
        new("procedure", "Stored procedure"),
        new("query", "SQL query")
    ];

    private static readonly IReadOnlyList<OVOption<string>> HttpMethods =
    [
        new("GET", "GET"),
        new("POST", "POST"),
        new("PUT", "PUT")
    ];

    private static readonly IReadOnlyList<OVOption<string>> FileFormats =
    [
        new("csv", "CSV"),
        new("json", "JSON"),
        new("xlsx", "Excel workbook")
    ];

    private string ConnectionName => _connectionKey switch
    {
        "primary-sql" => "Primary warehouse",
        "remote-json" => "Remote patient API",
        "directory" => "Corporate directory",
        _ => "Inbound file share"
    };

    private string ConnectionType => _connectionKey switch
    {
        "primary-sql" => "SQL",
        "remote-json" => "JSON/API",
        "directory" => "LDAP",
        _ => "FILE"
    };

    private string ConnectionEndpoint => _connectionKey switch
    {
        "primary-sql" => "warehouse.example.internal / OneVision",
        "remote-json" => "https://api.example.internal",
        "directory" => "ldap.example.internal:389",
        _ => @"\\files.example.internal\inbound"
    };

    private string ProfileRunHint => _connectionKey switch
    {
        "primary-sql" => "Executes the selected procedure/query against the managed SQL connection and profiles the returned columns.",
        "remote-json" => "Calls the endpoint extension through the managed API connection and profiles the response structure.",
        "directory" => "Profiles the attributes exposed through the managed LDAP connection; attribute use is defined in Mapping.",
        _ => "Reads matching files from the managed file connection and profiles the selected format/header settings."
    };

    private string ProfileResultSummary => _profiled ? "7 discovered fields · refreshed just now" : "Example discovered structure";

    private static readonly IReadOnlyList<OVStructuredFieldNode> SourceFields =
    [
        new("identifier", "identifier", "$.identifier", OVStructuredNodeKind.Primitive, OVStructuredDataType.String),
        new("record", "record", "$.record", OVStructuredNodeKind.Object, OVStructuredDataType.Unknown,
        [
            new("name", "name", "$.record.name", OVStructuredNodeKind.Object, OVStructuredDataType.Unknown,
            [
                new("primary", "primary", "$.record.name.primary", OVStructuredNodeKind.Primitive, OVStructuredDataType.String),
                new("secondary", "secondary", "$.record.name.secondary", OVStructuredNodeKind.Primitive, OVStructuredDataType.String)
            ]),
            new("items", "items", "$.record.items", OVStructuredNodeKind.Array, OVStructuredDataType.Unknown,
            [
                new("item", "[]", "$.record.items[]", OVStructuredNodeKind.Object, OVStructuredDataType.Unknown,
                [
                    new("code", "code", "$.record.items[].code", OVStructuredNodeKind.Primitive, OVStructuredDataType.String),
                    new("active", "active", "$.record.items[].active", OVStructuredNodeKind.Primitive, OVStructuredDataType.Boolean)
                ])
            ])
        ])
    ];

    private static readonly IReadOnlyList<OVMappingPairTarget> Targets =
    [
        new("target-name", "Display name", "Required target value", Required: true),
        new("target-code", "Reference code", "Stable source reference", Required: true),
        new("target-description", "Description", "Optional descriptive value")
    ];

    private static readonly IReadOnlyList<OVOption<string>> RuleOperands = [new("active", "Active flag"), new("code", "Reference code")];
    private static readonly IReadOnlyList<OVOption<string>> RuleOperators = [new("equals", "Equals"), new("starts", "Starts with")];
    private static readonly IReadOnlyList<OVOption<string>> RuleOutcomes = [new("apply", "Apply mapping"), new("skip", "Skip mapping")];
    private static readonly OVMappingRuleGroup RuleGroup = new("root", OVMappingRuleJoin.And, [new("c1", "active", "equals", "true")]);

    private Task OnSectionChanged(string? section) { _activeSection = section; return Task.CompletedTask; }

    private Task OnConnectionChanged(string? key)
    {
        _connectionKey = key;
        _profiled = false;
        _lastProfiled = "Not yet profiled";
        return Task.CompletedTask;
    }

    private Task OnSqlSourceTypeChanged(string? value)
    {
        _sqlSourceType = value;
        _profiled = false;
        return Task.CompletedTask;
    }

    private async Task RunProfile(MouseEventArgs _)
    {
        _profiling = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(350);
        _profiling = false;
        _profiled = true;
        _lastProfiled = DateTime.Now.ToString("dd/MM/yyyy HH:mm");
    }

    private Task OnMappingAdd(OVMappingPairRequest request)
    {
        _mappings.RemoveAll(item => item.TargetKey == request.Target.Key);
        _mappings.Add(new(request.Target.Key, request.Source.Key, request.Source.Path));
        return InvokeAsync(StateHasChanged);
    }

    private Task OnMappingRemove(string targetKey)
    {
        _mappings.RemoveAll(item => item.TargetKey == targetKey);
        return InvokeAsync(StateHasChanged);
    }
}
