@if (Open)
{
    <div class="@BackdropClass" role="presentation" @onclick="CancelFromBackdrop">
        <section class="@SurfaceClass" role="alertdialog" aria-modal="true" aria-labelledby="@TitleId" aria-describedby="@DescriptionId" @onclick:stopPropagation="true">
            <header class="ov-confirm-dialog__header">
                <h2 id="@TitleId">@Title</h2>
            </header>
            <div class="ov-confirm-dialog__body" id="@DescriptionId">
                @if (ChildContent is not null)
                {
                    @ChildContent
                }
                else
                {
                    <p>@Message</p>
                }
            </div>
            <footer class="ov-confirm-dialog__footer">
                <OVButton Appearance="OVButtonVariant.Secondary" OnClick="Cancel" Disabled="@Busy">@CancelText</OVButton>
                <OVButton Class="ov-button--destructive" OnClick="Confirm" Loading="@Busy">@ConfirmText</OVButton>
            </footer>
        </section>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string Message { get; set; } = string.Empty;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string ConfirmText { get; set; } = "Confirm";
    [Parameter] public string CancelText { get; set; } = "Cancel";
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool CloseOnBackdrop { get; set; }
    [Parameter] public bool Contained { get; set; }
    [Parameter] public EventCallback Confirmed { get; set; }
    [Parameter] public EventCallback Cancelled { get; set; }
    [Parameter] public string? Class { get; set; }

    private string TitleId { get; } = $"ov-confirm-title-{Guid.NewGuid():N}";
    private string DescriptionId { get; } = $"ov-confirm-description-{Guid.NewGuid():N}";
    private string BackdropClass => Contained ? "ov-confirm-dialog__backdrop ov-confirm-dialog__backdrop--contained" : "ov-confirm-dialog__backdrop";
    private string SurfaceClass => string.IsNullOrWhiteSpace(Class) ? "ov-confirm-dialog" : $"ov-confirm-dialog {Class}";

    private async Task Confirm(MouseEventArgs _)
    {
        if (Busy) return;
        await Confirmed.InvokeAsync();
    }

    private Task Cancel(MouseEventArgs _) => CancelAsync();

    private Task CancelFromBackdrop()
        => CloseOnBackdrop ? CancelAsync() : Task.CompletedTask;

    private async Task CancelAsync()
    {
        if (Busy) return;
        await Cancelled.InvokeAsync();
        await OpenChanged.InvokeAsync(false);
    }
}
