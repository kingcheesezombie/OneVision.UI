<div class="@CardClass" aria-busy="@Busy">
    @if (Busy)
    {
        <div class="ov-card__busy-indicator" role="status">Working…</div>
    }

    <div class="ov-card__selection-target"
         role="@(Selectable ? "button" : null)"
         tabindex="@(Selectable && !Disabled && !Busy ? "0" : null)"
         aria-pressed="@(Selectable ? Selected.ToString().ToLowerInvariant() : null)"
         aria-disabled="@(Selectable ? (Disabled || Busy).ToString().ToLowerInvariant() : null)"
         @onclick="HandleSelect"
         @onkeydown="HandleKeyDown">
        @if (Selectable && !string.IsNullOrWhiteSpace(AriaLabel))
        {
            <span class="sr-only">@AriaLabel. </span>
        }
        @if (Header is not null || Status is not null)
        {
            <div class="ov-card__header">
                <div class="ov-card__heading">@Header</div>
                @if (Status is not null)
                {
                    <div class="ov-card__status">@Status</div>
                }
            </div>
        }
        @if (Selected)
        {
            <div class="ov-card__selected-indicator" aria-hidden="true">✓ Selected</div>
        }
        <div class="ov-card__content">
            @ChildContent
            @if (Metadata is not null)
            {
                <div class="ov-card__metadata">@Metadata</div>
            }
        </div>
    </div>

    @if (Actions is not null || PrimaryAction is not null || SecondaryActions is not null || OverflowActions is not null)
    {
        <div class="ov-card__actions"
             aria-disabled="@(Disabled || Busy)"
             inert="@(Disabled || Busy ? "" : null)">
            @if (SecondaryActions is not null)
            {
                <div class="ov-card__secondary-actions">@SecondaryActions</div>
            }
            @if (Actions is not null)
            {
                <div class="ov-card__legacy-actions">@Actions</div>
            }
            @if (OverflowActions is not null)
            {
                <div class="ov-card__overflow-actions">@OverflowActions</div>
            }
            @if (PrimaryAction is not null)
            {
                <div class="ov-card__primary-action">@PrimaryAction</div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public RenderFragment? Header { get; set; }
    [Parameter] public RenderFragment? Status { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Metadata { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? PrimaryAction { get; set; }
    [Parameter] public RenderFragment? SecondaryActions { get; set; }
    [Parameter] public RenderFragment? OverflowActions { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool Selected { get; set; }
    [Parameter] public bool Actionable { get; set; }
    [Parameter] public EventCallback SelectedAction { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string? Class { get; set; }

    private bool Selectable => Actionable || SelectedAction.HasDelegate;

    private async Task HandleSelect()
    {
        if (!Selectable || Disabled || Busy || !SelectedAction.HasDelegate)
            return;

        await SelectedAction.InvokeAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key is "Enter" or " ")
            await HandleSelect();
    }

    private string CardClass
    {
        get
        {
            var value = "ov-card";
            if (Disabled) value += " ov-card--disabled";
            if (Busy) value += " ov-card--busy";
            if (Selectable) value += " ov-card--actionable ov-card--selectable";
            if (Selected) value += " ov-card--selected";
            return string.IsNullOrWhiteSpace(Class) ? value : $"{value} {Class}";
        }
    }
}
