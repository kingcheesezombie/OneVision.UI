<MudTabs ActivePanelIndex="@ActiveIndex" ActivePanelIndexChanged="OnActiveIndexChanged" Class="@Class">
    @foreach (var item in Items)
    {
        <MudTabPanel Text="@item.Label" Disabled="@item.Disabled">
            @item.Content
        </MudTabPanel>
    }
</MudTabs>

@code {
    [Parameter] public IReadOnlyList<OVTabItem> Items { get; set; } = Array.Empty<OVTabItem>();
    [Parameter] public string? ActiveKey { get; set; }
    [Parameter] public EventCallback<string?> ActiveKeyChanged { get; set; }
    [Parameter] public string? Class { get; set; }

    private int ActiveIndex
    {
        get
        {
            if (Items.Count == 0) return 0;
            for (var index = 0; index < Items.Count; index++)
                if (Items[index].Key == ActiveKey && !Items[index].Disabled) return index;

            for (var index = 0; index < Items.Count; index++)
                if (!Items[index].Disabled) return index;

            return 0;
        }
    }

    private Task OnActiveIndexChanged(int index)
    {
        if (index < 0 || index >= Items.Count || Items[index].Disabled)
            return Task.CompletedTask;

        return ActiveKeyChanged.InvokeAsync(Items[index].Key);
    }
}
