@using Microsoft.JSInterop
@using OneVision.UI.Iconography
@implements IAsyncDisposable
@inject IJSRuntime JS

@if (Open)
{
    <div class="@BackdropClass" role="presentation" @onclick="BackdropClicked">
        <section class="@SurfaceClass"
                 @ref="_surface"
                 tabindex="-1"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="@TitleId"
                 aria-describedby="@DescriptionIdOrNull"
                 aria-busy="@(Busy ? "true" : null)"
                 @onclick:stopPropagation="true">
            <header class="ov-overlay__header">
                <div class="ov-overlay__heading">
                    <h2 id="@TitleId">@Title</h2>
                    @if (!string.IsNullOrWhiteSpace(Description))
                    {
                        <div id="@DescriptionId" class="ov-overlay__description">@Description</div>
                    }
                </div>
                <OVIconButton Icon="OneVisionIcon.Cancel"
                              Label="Close overlay"
                              Class="ov-overlay__close"
                              OnClick="CloseClicked"
                              Disabled="@(Busy || CloseDisabled)" />
            </header>
            <div class="ov-overlay__body">@ChildContent</div>
            <footer class="ov-overlay__footer">
                @if (Footer is not null)
                {
                    @Footer
                }
                else
                {
                    <OVButton Appearance="OVButtonVariant.Secondary" OnClick="CloseClicked" Disabled="@(Busy || CloseDisabled)">@CancelText</OVButton>
                    @if (SaveRequested.HasDelegate)
                    {
                        <OVButton OnClick="SaveClicked" Loading="@Busy" Disabled="@SaveDisabled">@SaveText</OVButton>
                    }
                }
            </footer>
        </section>
    </div>
}

<OVConfirmDialog Open="@_confirmLeave"
                 OpenChanged="ConfirmLeaveChanged"
                 Title="Discard changes?"
                 Message="Unsaved changes will be lost."
                 ConfirmText="Discard changes"
                 Confirmed="LeaveWithoutSaving" />

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool CloseDisabled { get; set; }
    [Parameter] public bool Dirty { get; set; }
    [Parameter] public bool SaveDisabled { get; set; }
    [Parameter] public string SaveText { get; set; } = "Save";
    [Parameter] public string CancelText { get; set; } = "Cancel";
    [Parameter] public EventCallback SaveRequested { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;
    [Parameter] public bool CloseOnBackdrop { get; set; } = true;
    [Parameter] public bool Contained { get; set; }
    [Parameter] public OVOverlayPlacement Placement { get; set; } = OVOverlayPlacement.RightSide;
    [Parameter] public string? Class { get; set; }

    private readonly string _overlayId = $"ov-overlay-{Guid.NewGuid():N}";
    private readonly string _titleId = $"ov-overlay-title-{Guid.NewGuid():N}";
    private readonly string _descriptionId = $"ov-overlay-description-{Guid.NewGuid():N}";
    private ElementReference _surface;
    private IJSObjectReference? _module;
    private DotNetObjectReference<OVOverlay>? _dotNetReference;
    private bool _overlayActive;
    private bool _confirmLeave;

    private string TitleId => _titleId;
    private string DescriptionId => _descriptionId;
    private string? DescriptionIdOrNull => string.IsNullOrWhiteSpace(Description) ? null : DescriptionId;
    private string PlacementClass => Placement == OVOverlayPlacement.Workspace ? "ov-overlay__backdrop--workspace" : "ov-overlay__backdrop--right";
    private string BackdropClass => Contained
        ? $"ov-overlay__backdrop ov-overlay__backdrop--contained {PlacementClass}"
        : $"ov-overlay__backdrop {PlacementClass}";

    private string SurfaceClass
    {
        get
        {
            var placement = Placement == OVOverlayPlacement.Workspace ? "ov-overlay--workspace" : "ov-overlay--right";
            return string.IsNullOrWhiteSpace(Class) ? $"ov-overlay {placement}" : $"ov-overlay {placement} {Class}";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Open && !_overlayActive)
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/OneVision.UI/ov-overlay.js");
            _dotNetReference ??= DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("activate", _overlayId, _surface, _dotNetReference, !Contained);
            _overlayActive = true;
        }
        else if (!Open && _overlayActive)
        {
            await DeactivateAsync(restoreFocus: true);
        }
    }

    private Task SaveClicked(MouseEventArgs _) => SaveRequested.InvokeAsync();
    private Task CloseClicked(MouseEventArgs _) => CloseAsync();
    private Task BackdropClicked() => CloseOnBackdrop ? CloseAsync() : Task.CompletedTask;

    [JSInvokable]
    public Task HandleEscapeFromJs() => CloseAsync();

    private async Task CloseAsync()
    {
        if (Busy || CloseDisabled) return;

        if (Dirty)
        {
            _confirmLeave = true;
            StateHasChanged();
            return;
        }

        await CompleteCloseAsync();
    }

    private Task ConfirmLeaveChanged(bool value)
    {
        _confirmLeave = value;
        return Task.CompletedTask;
    }

    private async Task LeaveWithoutSaving()
    {
        _confirmLeave = false;
        await CompleteCloseAsync();
    }

    private async Task CompleteCloseAsync()
    {
        await DeactivateAsync(restoreFocus: true);
        await OpenChanged.InvokeAsync(false);
    }

    private async Task DeactivateAsync(bool restoreFocus)
    {
        if (!_overlayActive || _module is null) return;

        try
        {
            await _module.InvokeVoidAsync("deactivate", _overlayId, restoreFocus);
        }
        catch (JSDisconnectedException)
        {
            // The browser is already gone; there is no focus or scroll state left to restore.
        }
        finally
        {
            _overlayActive = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        await DeactivateAsync(restoreFocus: false);
        _dotNetReference?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
