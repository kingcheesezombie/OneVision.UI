@using OneVision.UI.Demo

@switch (Definition.Reference)
{
    case "OVC-BUTTON":
        <div class="ov-component-demo-row ov-demo-wrap">
            <OVButton Appearance="OVButtonVariant.Primary" Disabled="@IsDisabled" Loading="@IsLoading" Icon="OneVisionIcon.Save">Primary action</OVButton>
            <OVButton Appearance="OVButtonVariant.Secondary" Disabled="@IsDisabled" Loading="@IsLoading">Secondary</OVButton>
            <OVButton Appearance="OVButtonVariant.Subtle" Disabled="@IsDisabled" Loading="@IsLoading">Subtle</OVButton>
        </div>
        break;

    case "OVC-ICON-BUTTON":
        <div class="ov-component-demo-row">
            <OVIconButton Icon="OneVisionIcon.Edit" Label="Edit" Disabled="@IsDisabled" Loading="@IsLoading" />
            <OVIconButton Icon="OneVisionIcon.Refresh" Label="Refresh" Disabled="@IsDisabled" />
            <OVIconButton Icon="OneVisionIcon.Delete" Label="Delete" Tone="OVIconButtonTone.Destructive" Disabled="@IsDisabled" />
        </div>
        break;

    case "OVC-OVERFLOW-MENU":
        <div class="ov-demo-menu-stage">
            <OVOverflowMenu Items="@OverflowItems" AriaLabel="Example actions" />
        </div>
        break;

    case "OVC-TEXT-FIELD":
        <OVTextField @bind-Value="_text" Label="Name" Disabled="@IsDisabled" ReadOnly="@IsReadOnly" Error="@IsError" ErrorText="Enter a valid name." />
        break;

    case "OVC-TEXT-AREA":
        <OVTextArea @bind-Value="_notes" Label="Description" Lines="4" Disabled="@IsDisabled" ReadOnly="@IsReadOnly" Error="@IsError" ErrorText="Enter a valid description." />
        break;

    case "OVC-NUMBER-FIELD":
        <OVNumberField T="int?" @bind-Value="_number" Label="Threshold" Disabled="@IsDisabled" ReadOnly="@IsReadOnly" Error="@IsError" ErrorText="Enter a valid number." />
        break;

    case "OVC-SEARCH-BOX":
        <div class="ov-component-demo-stack">
            <OVSearchBox @bind-Value="_search" Disabled="@IsDisabled" Placeholder="Search records" />
            <span class="ov-pattern-demo__muted">@SearchResultText</span>
        </div>
        break;

    case "OVC-SELECT":
        <OVSelect T="string" @bind-Value="_select" Label="Mode" Options="@ModeOptions" Disabled="@IsDisabled" ReadOnly="@IsReadOnly" Error="@IsError" ErrorText="Choose a mode." />
        break;

    case "OVC-MULTI-SELECT":
        <OVMultiSelect Options="@MultiOptions" SelectedKeys="@_multiSelected" SelectedKeysChanged="OnMultiSelectedChanged" Disabled="@IsDisabled" ReadOnly="@IsReadOnly" />
        break;

    case "OVC-AUTOCOMPLETE":
        <OVAutocomplete T="string" @bind-Value="_person" Label="Person" SearchFunc="SearchPeople" Loading="@IsLoading" Disabled="@IsDisabled" NoResultsText="No matching people" />
        break;

    case "OVC-CHECKBOX":
        <OVCheckbox Value="@CheckboxValue" ValueChanged="@(value => _checked = value)" TriState="true" Disabled="@IsDisabled" Label="Include inactive records" />
        break;

    case "OVC-RADIO-GROUP":
        <OVRadioGroup T="string" @bind-Value="_radioMode" Options="@RadioOptions" Disabled="@IsDisabled" Error="@IsError" ErrorText="Choose an assignment mode." />
        break;

    case "OVC-TOGGLE":
        <OVToggle @bind-Value="_toggle" Label="Enabled" Disabled="@IsDisabled" Saving="@(State == "Saving")" />
        break;

    case "OVC-DATE-PICKER":
        <OVDatePicker @bind-Value="_date" Label="Effective date" Disabled="@IsDisabled" ReadOnly="@IsReadOnly" Error="@IsError" ErrorText="Choose a valid date." />
        break;

    case "OVC-DATE-RANGE":
        <div class="ov-component-demo-stack">
            <OVDateRangePicker Value="@DemoDateRange"
                               ValueChanged="OnDateRangeChanged"
                               Label="Effective period"
                               Disabled="@IsDisabled"
                               ReadOnly="@IsReadOnly"
                               Error="@IsError"
                               ErrorText="Review the selected effective period."
                               Required="@(State == "Required empty")"
                               RequireComplete="@(HasCapability("complete") || State == "Incomplete")"
                               MinDate="@(HasCapability("limits") || State == "Out of bounds" ? new DateTime(2026, 10, 1) : null)"
                               MaxDate="@(HasCapability("limits") || State == "Out of bounds" ? new DateTime(2026, 10, 31) : null)" />
            <span class="ov-pattern-demo__muted" role="status">
                @DateRangeStatus
            </span>
        </div>
        break;

    case "OVC-TIME-PICKER":
        <OVTimePicker @bind-Value="_time" Label="Run at" Disabled="@IsDisabled" ReadOnly="@IsReadOnly" Error="@IsError" ErrorText="Choose a valid time." />
        break;

    default:
        <MudAlert Severity="Severity.Warning">No input/action demo is registered for @Definition.Reference.</MudAlert>
        break;
}

@code {
    [Parameter, EditorRequired] public ComponentDefinition Definition { get; set; } = default!;
    [Parameter] public string State { get; set; } = "Default";
    [Parameter] public IReadOnlyCollection<string> EnabledCapabilities { get; set; } = Array.Empty<string>();
    private bool HasCapability(string key) => EnabledCapabilities.Contains(key);

    private string? _text = "Example value";
    private string? _notes = "Example description for this governed object.";
    private int? _number = 25;
    private string? _search = string.Empty;
    private string? _select = "Standard";
    private string? _person;
    private bool? _checked = true;
    private string? _radioMode = "Automatic";
    private bool _toggle = true;
    private IReadOnlyCollection<string> _multiSelected = new[] { "birmingham", "solihull" };
    private DateTime? _date = new(2026, 10, 24);
    private DateRange? _dateRange = new(new DateTime(2026, 10, 1), new DateTime(2026, 10, 31));
    private TimeSpan? _time = new(9, 0, 0);

    private IReadOnlyList<OVOverflowMenuItem> OverflowItems =>
    [
        new("edit", "Edit", OneVisionIcon.Edit),
        new("duplicate", "Duplicate", Disabled: State == "Disabled item"),
        new("delete", "Delete", OneVisionIcon.Delete, Destructive: true)
    ];

    private static readonly IReadOnlyList<OVOption<string>> ModeOptions =
    [
        new("Standard", "Standard"),
        new("Advanced", "Advanced"),
        new("Custom", "Custom")
    ];

    private static readonly IReadOnlyList<OVOption<string>> RadioOptions =
    [
        new("Automatic", "Automatic"),
        new("Manual", "Manual"),
        new("Legacy", "Legacy", true)
    ];

    private static readonly IReadOnlyList<OVSelectionOption> MultiOptions =
    [
        new("birmingham", "Birmingham", "Birmingham and Solihull"),
        new("solihull", "Solihull", "Birmingham and Solihull"),
        new("dudley", "Dudley", "Black Country"),
        new("sandwell", "Sandwell", "Black Country"),
        new("walsall", "Walsall", "Black Country"),
        new("wolverhampton", "Wolverhampton", "Black Country")
    ];

    private DateRange? DemoDateRange => State switch
    {
        "Open-ended" or "Incomplete" => new DateRange(new DateTime(2026, 10, 1), null),
        "Invalid range" => new DateRange(new DateTime(2026, 10, 20), new DateTime(2026, 10, 10)),
        "Required empty" => null,
        "Out of bounds" => new DateRange(new DateTime(2026, 9, 15), new DateTime(2026, 10, 5)),
        _ => _dateRange
    };

    private string DateRangeStatus
    {
        get
        {
            var result = OVDateRangeValidation.Evaluate(
                DemoDateRange,
                HasCapability("limits") || State == "Out of bounds" ? new DateTime(2026, 10, 1) : null,
                HasCapability("limits") || State == "Out of bounds" ? new DateTime(2026, 10, 31) : null,
                required: State == "Required empty",
                requireComplete: HasCapability("complete") || State == "Incomplete");
            return result.IsValid ? "Valid effective date range" : result.ErrorMessage ?? "Invalid effective date range";
        }
    }

    private Task OnDateRangeChanged(DateRange? value)
    {
        _dateRange = value;
        return Task.CompletedTask;
    }

    private bool IsDisabled => State == "Disabled" || HasCapability("disabled");
    private bool IsReadOnly => State == "Read-only" || HasCapability("read-only");
    private bool IsLoading => State == "Loading" || HasCapability("loading");
    private bool IsError => HasCapability("validation") || State.Contains("Validation", StringComparison.OrdinalIgnoreCase) || State.Contains("Invalid", StringComparison.OrdinalIgnoreCase);
    private bool? CheckboxValue => State == "Indeterminate" ? null : State == "Unchecked" ? false : _checked;
    private string SearchResultText => string.IsNullOrWhiteSpace(_search) ? "Search is local to the owning control." : _search.Contains("xyz", StringComparison.OrdinalIgnoreCase) ? "No results" : "3 matching records";

    private Task OnMultiSelectedChanged(IReadOnlyCollection<string> values) { _multiSelected = values; return Task.CompletedTask; }

    private Task<IEnumerable<string>> SearchPeople(string? value, CancellationToken cancellationToken)
    {
        IEnumerable<string> people = new[] { "Steve Example", "Steven Sample", "Stephanie Example", "Sam Example" };
        if (!string.IsNullOrWhiteSpace(value)) people = people.Where(person => person.Contains(value, StringComparison.OrdinalIgnoreCase));
        if (State == "No results") people = Array.Empty<string>();
        return Task.FromResult(people);
    }
}
