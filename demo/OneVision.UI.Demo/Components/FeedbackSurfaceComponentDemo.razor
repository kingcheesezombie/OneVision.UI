@using OneVision.UI.Demo

@switch (Definition.Reference)
{
    case "OVC-ALERT":
        <OVAlert Tone="@AlertTone" Dismissible="@(State == "Dismissible" || HasCapability("dismissible"))">@AlertMessage</OVAlert>
        break;

    case "OVC-VALIDATION-SUMMARY":
        <OVValidationSummary Title="@(State == "Warning" ? "Review these items" : "There is a problem")" Severity="@(State == "Warning" ? Severity.Warning : Severity.Error)" Issues="@ValidationIssues" />
        break;

    case "OVC-TOOLTIP":
        <OVTooltip Text="Refresh data" Disabled="@(State == "Disabled target")">
            <OVIconButton Icon="OneVisionIcon.Refresh" Label="Refresh data" Disabled="@(State == "Disabled target")" />
        </OVTooltip>
        break;

    case "OVC-PROGRESS":
        <OVProgress Mode="@ProgressMode" Value="@ProgressValue" Label="@ProgressLabel" Complete="@(State == "Complete")" Failed="@(State == "Failed")" />
        break;

    case "OVC-CARD":
        <OVCard Actionable="@(State == "Actionable")" Disabled="@(State == "Disabled")">
            <Header><strong>Identity matching</strong></Header>
            <ChildContent><p>Candidate generation and ambiguity review.</p></ChildContent>
            <Actions><OVPill Text="Healthy" Role="OVPillRole.Status" Tone="OVPillTone.Success" />@if (State == "Actionable") { <OVButton Appearance="OVButtonVariant.Subtle">Open</OVButton> }</Actions>
        </OVCard>
        break;

    case "OVC-PANEL":
        <OVPanel ReadOnly="@(State == "Read-only" || HasCapability("read-only"))">
            <Header><div><strong>Connection details</strong><small>SQL Warehouse</small></div><OVButton Appearance="OVButtonVariant.Subtle" Disabled="@(State == "Read-only")">Edit</OVButton></Header>
            <ChildContent><div class="ov-demo-detail-grid"><OVKeyValue Label="Type" Value="SQL Server" /><OVKeyValue Label="Status" Value="Available" /></div></ChildContent>
        </OVPanel>
        break;

    case "OVC-ACCORDION":
        <OVAccordion Items="@AccordionItems" Disabled="@(State == "Disabled")" />
        break;

    case "OVC-DIALOG":
        <div class="ov-component-overlay-stage" aria-label="Dialog demonstration">
            <OVDialog Open="true"
                      Title="Edit connection"
                      Contained="true"
                      CloseOnBackdrop="false"
                      Busy="@(State == "Saving")"
                      SaveRequested="Noop">
                <OVTextField Value="@ExampleConnectionName" Label="Name" ReadOnly="@(State == "Read-only")" />
            </OVDialog>
        </div>
        break;

    case "OVC-OVERLAY":
        <div class="ov-component-overlay-stage" aria-label="Overlay demonstration">
            @if (_overlayOpen)
            {
                <OVOverlay Open="@_overlayOpen"
                           OpenChanged="SetOverlayOpen"
                           Title="Add allocation"
                           Description="@OverlayDescription"
                           Placement="@OverlayPlacement"
                           Contained="@OverlayContained"
                           CloseOnBackdrop="true"
                           Dirty="@(State == "Dirty")"
                           Busy="@(State == "Saving")"
                           SaveText="Save allocation"
                           SaveRequested="Noop">
                    <OVSelect T="string" Label="Target" Value="@("Business Area A")" Options="@TargetOptions" />
                    @if (State == "Error")
                    {
                        <OVAlert Tone="OVAlertTone.Error" Class="mt-3">The allocation could not be saved.</OVAlert>
                    }
                </OVOverlay>
            }
            else
            {
                <div class="ov-demo-overlay-closed">
                    <OVAlert Tone="OVAlertTone.Information">Overlay closed successfully.</OVAlert>
                    <OVButton Appearance="OVButtonVariant.Secondary" OnClick="ReopenOverlay">Reopen overlay</OVButton>
                </div>
            }
        </div>
        break;

    case "OVC-CONFIRM-DIALOG":
        <div class="ov-component-overlay-stage" aria-label="Confirmation dialog demonstration">
            <OVConfirmDialog Open="true"
                             Title="Delete connection?"
                             Message="This permanently removes SQL Warehouse. Existing dependent configuration may stop working."
                             ConfirmText="Delete connection"
                             Busy="@(State == "Busy")"
                             Contained="true"
                             Confirmed="Noop" />
        </div>
        break;

    default:
        <MudAlert Severity="Severity.Warning">No feedback/surface demo is registered for @Definition.Reference.</MudAlert>
        break;
}

@code {
    [Parameter, EditorRequired] public ComponentDefinition Definition { get; set; } = default!;
    [Parameter] public string State { get; set; } = "Right-side";

    private const string ExampleConnectionName = "SQL Warehouse";
    private bool _overlayOpen = true;
    private string? _lastOverlayState;

    protected override void OnParametersSet()
    {
        if (Definition.Reference == "OVC-OVERLAY" && !string.Equals(_lastOverlayState, State, StringComparison.Ordinal))
        {
            _overlayOpen = true;
            _lastOverlayState = State;
        }
    }

    private static readonly IReadOnlyList<OVValidationSummary.OVValidationIssue> ValidationIssues =
    [
        new("Name is required."),
        new("Effective To cannot be before Effective From.")
    ];

    private static readonly IReadOnlyList<OVOption<string>> TargetOptions =
    [
        new("Business Area A", "Business Area A"),
        new("Business Area B", "Business Area B")
    ];

    private IReadOnlyList<OVAccordionItem> AccordionItems =>
    [
        new("Advanced settings", Content("Optional configuration is visible while expanded."), State == "Expanded")
    ];

    private OVOverlayPlacement OverlayPlacement => State == "Workspace" ? OVOverlayPlacement.Workspace : OVOverlayPlacement.RightSide;
    private bool OverlayContained => OverlayPlacement == OVOverlayPlacement.RightSide;
    private string OverlayDescription => OverlayPlacement == OVOverlayPlacement.Workspace
        ? "Large viewport-centred 80vw × 80vh workspace for substantial focused workflows."
        : "Right-side contextual workspace preserving visible parent context.";

    private static RenderFragment Content(string text) => builder => builder.AddContent(0, text);
    private static Task Noop() => Task.CompletedTask;
    private Task SetOverlayOpen(bool value)
    {
        _overlayOpen = value;
        return Task.CompletedTask;
    }
    private Task ReopenOverlay(MouseEventArgs _)
    {
        _overlayOpen = true;
        return Task.CompletedTask;
    }

    private OVAlertTone AlertTone => State switch
    {
        "Error" => OVAlertTone.Error,
        "Warning" => OVAlertTone.Warning,
        "Success" => OVAlertTone.Success,
        _ => OVAlertTone.Information
    };

    private string AlertMessage => AlertTone switch
    {
        OVAlertTone.Error => "The operation could not be completed. Review the highlighted fields and try again.",
        OVAlertTone.Warning => "This change may affect existing allocations.",
        OVAlertTone.Success => "Changes saved successfully.",
        _ => "Additional information is available for this section."
    };

    private OVProgressMode ProgressMode => State == "Indeterminate" ? OVProgressMode.Indeterminate : OVProgressMode.Determinate;
    private double ProgressValue => State == "Complete" ? 100 : State == "Failed" ? 42 : 68;
    private string ProgressLabel => State == "Failed" ? "Failed after 42%" : State == "Complete" ? "Complete" : State == "Indeterminate" ? "Working…" : "68% complete";
}
