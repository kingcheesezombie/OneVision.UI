@page "/patterns/{PatternKey}"
@page "/patterns/{PatternKey}/{Node1}"
@page "/patterns/{PatternKey}/{Node1}/{Node2}"
@page "/patterns/{PatternKey}/{Node1}/{Node2}/{Node3}"
@inject IJSRuntime JS

@if (_pattern is null || _selected is null)
{
    <PageTitle>Pattern not found · OneVision.UI</PageTitle>
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">The requested pattern node was not found.</MudAlert>
}
else
{
    <PageTitle>@_selected.Name · OneVision.UI</PageTitle>

    <div class="ov-pattern-page-heading">
        <div>
            <div class="ov-pattern-breadcrumb">@Breadcrumb</div>
            <h1 class="ov-gallery-page-title">@_selected.Name</h1>
            <MudText Typo="Typo.body1" Class="ov-gallery-page-intro">@_selected.Description</MudText>
        </div>
        <div class="ov-pattern-meta">
            <span class="ov-pattern-kind">@(_selected.Kind == PatternNodeKind.Container ? "Pattern" : "Internal region")</span>
            <OVPill Text="@_selected.Status.ToString()" Role="OVPillRole.Status" Tone="@StatusTone" />
        </div>
    </div>

    @if (ReferenceEquals(_selected, _pattern))
    {
        <div class="ov-pattern-reference">
            <div>
                <div class="ov-pattern-reference__label">Pattern reference</div>
                <code>@_pattern.Reference</code>
            </div>
            <div class="ov-reference-actions">
                <OVButton Appearance="OVButtonVariant.Secondary" Icon="OneVisionIcon.Copy" OnClick="CopyReference">@(_copied ? "Copied" : "Copy reference")</OVButton>
                <OVButton Icon="OneVisionIcon.Copy" OnClick="CopyContract">@(_contractCopied ? "Contract copied" : "Copy design contract")</OVButton>
            </div>
        </div>
    }
    else
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
            This is an internal region of <strong>@_pattern.Name</strong>. It is not a separate OVP contract.
        </MudAlert>
    }

    @if (_selected.Children.Count > 0)
    {
        <section class="ov-scope-map">
            <div class="ov-workbench-label">Internal regions</div>
            <div class="ov-scope-map__row">
                @foreach (var child in _selected.Children)
                {
                    <a class="ov-scope-link" href="@ChildRoute(child)">
                        <span>@child.Kind</span>
                        <strong>@child.Name</strong>
                    </a>
                }
            </div>
        </section>
    }

    <section class="ov-demo-section">
        <div class="ov-section-heading-row">
            <div><MudText Typo="Typo.h6">Live behaviour</MudText><MudText Typo="Typo.body2">@ScopeDescription</MudText></div>
        </div>

        @if (_pattern.Slug == "connection-manager")
        {
            <ConnectionManagerDemo Scope="@ConnectionScope" />
        }
        else if (ReferenceEquals(_selected, _pattern))
        {
            <PatternDemo PatternKey="@_pattern.Slug" ScopeName="@_selected.Name" Reference="@_selected.Reference" />
        }
        else
        {
            <PatternScopeDemo PatternKey="@_pattern.Slug" Node="@_selected" />
        }
    </section>

    <section class="ov-demo-section mt-6">
        <MudPaper Class="ov-contract-card" Elevation="0">
            <div class="ov-contract-card__title"><MudIcon Icon="@Icons.Material.Filled.Rule" /><span>@(ReferenceEquals(_selected, _pattern) ? "Pattern contract" : "Region behaviour")</span></div>
            <MudText Typo="Typo.body2">The application supplies domain data, permissions and rules. The pattern owns the reusable layout, state transitions and interaction structure represented here.</MudText>
            @if (_selected.Children.Count > 0)
            {
                <ul class="ov-contract-list">
                    @foreach (var child in _selected.Children)
                    {
                        <li><strong>@child.Name:</strong> @child.Description</li>
                    }
                </ul>
            }
        </MudPaper>
    </section>
}

@code {
    [Parameter] public string PatternKey { get; set; } = string.Empty;
    [Parameter] public string? Node1 { get; set; }
    [Parameter] public string? Node2 { get; set; }
    [Parameter] public string? Node3 { get; set; }

    private PatternNode? _pattern;
    private PatternNode? _selected;
    private bool _copied;
    private bool _contractCopied;

    protected override void OnParametersSet()
    {
        _pattern = PatternCatalog.FindPattern(PatternKey);
        _selected = _pattern is null ? null : PatternCatalog.Resolve(_pattern, Node1, Node2, Node3);
        _copied = false;
        _contractCopied = false;
    }

    private string Breadcrumb
    {
        get
        {
            if (_pattern is null || _selected is null) return "Patterns";
            var names = new List<string> { "Patterns", _pattern.Name };
            var current = _pattern;
            foreach (var segment in new[] { Node1, Node2, Node3 }.Where(segment => !string.IsNullOrWhiteSpace(segment)))
            {
                var next = current.Children.FirstOrDefault(child => string.Equals(child.Slug, segment, StringComparison.OrdinalIgnoreCase));
                if (next is null) break;
                names.Add(next.Name);
                current = next;
            }
            return string.Join("  /  ", names.Distinct());
        }
    }

    private string ScopeDescription => _selected?.Kind switch
    {
        PatternNodeKind.Container => "Review the complete governed pattern in context.",
        PatternNodeKind.Tab => "Review this internal tab without treating it as an independent contract.",
        PatternNodeKind.Section => "Review this internal region independently from the surrounding workspace.",
        PatternNodeKind.Pane => "Review this internal pane and its local behaviour.",
        _ => string.Empty
    };

    private string DesignContract
    {
        get
        {
            if (_pattern is null) return string.Empty;
            var children = _pattern.Children.Count == 0
                ? "None"
                : string.Join("\n", _pattern.Children.Select(child => $"- {child.Name}: {child.Description}"));
            return $"{_pattern.Reference} — {_pattern.Name}\n\nPurpose\n{_pattern.Description}\n\nInternal regions\n{children}\n\nApplication contract\nThe app supplies domain data, permissions and domain-specific rules. OneVision.UI owns the reusable layout, interaction structure and state presentation for this pattern.";
        }
    }

    private OVPillTone StatusTone => _selected?.Status switch
    {
        PatternNodeStatus.Approved => OVPillTone.Success,
        PatternNodeStatus.Draft => OVPillTone.Info,
        _ => OVPillTone.Neutral
    };

    private string ConnectionScope => _selected?.Slug switch
    {
        "overview" => "overview",
        "connection" => "connection",
        "sql" => "sql",
        "ldap" => "ldap",
        "json" => "json",
        _ => "manager"
    };

    private string CurrentRoute
    {
        get
        {
            var route = $"patterns/{PatternKey}";
            foreach (var segment in new[] { Node1, Node2, Node3 }.Where(segment => !string.IsNullOrWhiteSpace(segment))) route += $"/{segment}";
            return route;
        }
    }

    private string ChildRoute(PatternNode child) => $"{CurrentRoute}/{child.Slug}";

    private async Task CopyReference(MouseEventArgs _)
    {
        if (_pattern is null) return;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", _pattern.Reference);
        _copied = true;
    }

    private async Task CopyContract(MouseEventArgs _)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", DesignContract);
        _contractCopied = true;
    }
}
