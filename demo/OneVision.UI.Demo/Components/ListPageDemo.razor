<OVListPage Title="List Page" Description="Standard searchable, filterable and paginated OneVision list.">
    <Toolbar>
        <OVSearchBox Value="@_search" ValueChanged="OnSearchChanged" Placeholder="Search" />
        <OVButton Appearance="OVButtonVariant.Secondary" Icon="OneVisionIcon.Filter">Filter</OVButton>
    </Toolbar>
    <ToolbarActions>
        <OVButton Icon="OneVisionIcon.Add">Add new</OVButton>
    </ToolbarActions>
    <ChildContent>
        <div class="ov-list-demo-table-wrap">
            <table class="ov-list-demo-table">
                <thead>
                    <tr><th>Name</th><th>Status</th><th>Updated</th><th class="ov-list-demo-table__actions"><span class="visually-hidden">Actions</span></th></tr>
                </thead>
                <tbody>
                    @foreach (var item in FilteredItems)
                    {
                        <tr>
                            <td>@item</td>
                            <td><OVPill Text="Current" Role="OVPillRole.Status" Tone="OVPillTone.Success" /></td>
                            <td>24/10/2026</td>
                            <td class="ov-list-demo-table__actions"><OVIconButton Icon="OneVisionIcon.More" Label="More actions" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </ChildContent>
    <Pagination>
        <div class="ov-list-demo-pagination"><span>@FilteredItems.Length result(s)</span><span>‹ 1 ›</span></div>
    </Pagination>
</OVListPage>

@code {
    private static readonly string[] Items = ["Community Nursing", "Vaccination Service", "Virtual Ward"];
    private string? _search;

    private string[] FilteredItems => string.IsNullOrWhiteSpace(_search)
        ? Items
        : Items.Where(item => item.Contains(_search, StringComparison.OrdinalIgnoreCase)).ToArray();

    private Task OnSearchChanged(string? value) { _search = value; return Task.CompletedTask; }
}
