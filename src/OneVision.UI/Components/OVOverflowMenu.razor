@using Microsoft.JSInterop
@using OneVision.UI.Iconography
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="@RootClass" @onclick:stopPropagation="true" @onkeydown="OnKeyDown">
    <button type="button"
            @ref="_trigger"
            class="ov-icon-button ov-icon-button--default ov-icon-button--overflow"
            aria-label="@AriaLabel"
            aria-haspopup="menu"
            aria-expanded="@(_open ? "true" : "false")"
            disabled="@Disabled"
            @onclick="Toggle">
        <OVIcon Name="OneVisionIcon.More" />
    </button>

    @if (_open)
    {
        <div @ref="_surface"
             class="ov-overflow-menu__surface"
             role="menu"
             aria-label="@AriaLabel">
            @foreach (var item in Items)
            {
                <button type="button"
                        role="menuitem"
                        class="@ItemClass(item)"
                        disabled="@item.Disabled"
                        @onclick="@(_ => Select(item))">
                    @if (item.Icon is { } icon)
                    {
                        <OVIcon Name="@icon" />
                    }
                    <span>@item.Label</span>
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<OVOverflowMenuItem> Items { get; set; } = [];
    [Parameter] public EventCallback<string> ItemSelected { get; set; }
    [Parameter] public string AriaLabel { get; set; } = "More actions";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool AlignRight { get; set; } = true;
    [Parameter] public string? Class { get; set; }

    private readonly string _popoverId = $"ov-overflow-menu-{Guid.NewGuid():N}";
    private ElementReference _trigger;
    private ElementReference _surface;
    private IJSObjectReference? _module;
    private DotNetObjectReference<OVOverflowMenu>? _dotNetReference;
    private bool _open;
    private bool _overlayActive;

    private string RootClass
    {
        get
        {
            var value = $"ov-overflow-menu{(AlignRight ? " ov-overflow-menu--right" : string.Empty)}";
            return string.IsNullOrWhiteSpace(Class) ? value : $"{value} {Class}";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_open && !_overlayActive)
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/OneVision.UI/ov-overlay.js");
            _dotNetReference ??= DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("activateAnchoredPopover", _popoverId, _trigger, _surface, _dotNetReference, AlignRight);
            _overlayActive = true;
        }
        else if (!_open && _overlayActive)
        {
            await DeactivateAsync(restoreFocus: true);
        }
    }

    private async Task Toggle(MouseEventArgs _)
    {
        if (Disabled) return;

        if (_open)
        {
            await CloseAsync(restoreFocus: true);
            return;
        }

        _open = true;
    }

    private async Task Select(OVOverflowMenuItem item)
    {
        if (item.Disabled) return;

        await CloseAsync(restoreFocus: true);
        await ItemSelected.InvokeAsync(item.Key);
    }

    private async Task OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape" && _open)
        {
            await CloseAsync(restoreFocus: true);
        }
    }

    [JSInvokable]
    public async Task HandlePopoverCloseFromJs()
    {
        _overlayActive = false;
        _open = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task CloseAsync(bool restoreFocus)
    {
        await DeactivateAsync(restoreFocus);
        _open = false;
    }

    private async Task DeactivateAsync(bool restoreFocus)
    {
        if (!_overlayActive || _module is null) return;

        try
        {
            await _module.InvokeVoidAsync("deactivateAnchoredPopover", _popoverId, restoreFocus);
        }
        catch (JSDisconnectedException)
        {
        }
        finally
        {
            _overlayActive = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        await DeactivateAsync(restoreFocus: false);
        _dotNetReference?.Dispose();

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private static string ItemClass(OVOverflowMenuItem item)
        => item.Destructive ? "ov-overflow-menu__item ov-overflow-menu__item--destructive" : "ov-overflow-menu__item";
}
