<div class="ov-api-decision-trail" role="list" aria-label="Completed API request choices">
    @if (Selections.Count > 0)
    {
        @for (var index = 0; index < Selections.Count; index++)
        {
            var itemIndex = index;
            var item = Selections[itemIndex];
            <div class="ov-api-decision-trail__item" role="listitem">
                <span class="ov-api-decision-trail__sr">@($"Completed: {item.Question}, {item.Answer}")</span>
                <span class="ov-api-decision-trail__marker" aria-hidden="true">✓</span>
                <div class="ov-api-decision-trail__content" aria-hidden="true">
                    <span class="ov-api-decision-trail__question">@item.Question</span>
                    <strong class="ov-api-decision-trail__answer">@item.Answer</strong>
                </div>
                <button type="button"
                        class="ov-api-decision-trail__change"
                        disabled="@Disabled"
                        aria-label="@($"Change {item.Question}: {item.Answer}")"
                        @onclick="() => ChangeRequested.InvokeAsync(itemIndex)">
                    Change
                </button>
            </div>
        }
    }
</div>

@code {
    [Parameter] public IReadOnlyList<OVApiDecisionTrailItem> Selections { get; set; } = [];
    [Parameter] public EventCallback<int> ChangeRequested { get; set; }
    [Parameter] public bool Disabled { get; set; }
}
