@using OneVision.UI.Iconography

<OVAllocation AssignmentMode="OVAllocationAssignmentMode.Inherited"
              UnderlyingAllocationExpanded="true">
    <EffectiveOdm>
        <div class="ov-demo-allocation-card-content">
            <div>
                <div class="ov-demo-allocation-title">Community Nursing</div>
                <div class="ov-demo-allocation-meta">ODM ID 7</div>
            </div>
            <OVPill Text="Current" Role="OVPillRole.Status" Tone="OVPillTone.Success" />
            <OVButton Appearance="OVButtonVariant.Subtle"
                      Icon="OneVisionIcon.Open"
                      Href="viewer/?hierarchyId=42&nodeKey=ODM-0007">
                Open
            </OVButton>
        </div>
    </EffectiveOdm>

    <SourceAncestor>
        <div class="ov-demo-allocation-card-content">
            <div>
                <div class="ov-demo-allocation-title">Neighbourhood Services</div>
                <div class="ov-demo-allocation-meta">Nearest allocated ancestor · depth 2</div>
            </div>
            <OVButton Appearance="OVButtonVariant.Subtle"
                      Icon="OneVisionIcon.Open"
                      Href="viewer/?hierarchyId=42&nodeKey=ORG-0042">
                Open
            </OVButton>
        </div>
    </SourceAncestor>

    <Actions>
        <OVButton Icon="OneVisionIcon.Add">Add direct allocation</OVButton>
    </Actions>

    <UnderlyingEamAllocation>
        <div class="ov-demo-detail-grid">
            <OVKeyValue Label="Allocation ID" Value="ALLOC-00123" />
            <OVKeyValue Label="Status" Value="Current" />
            <OVKeyValue Label="Effective" Value="Always belonged" />
            <OVKeyValue Label="Source node" Value="ORG-0042" />
            <OVKeyValue Label="Target ODM" Value="ODM 7 · Community Nursing" />
            <OVKeyValue Label="Owner" Value="EAM" />
        </div>
    </UnderlyingEamAllocation>

    <OdmHierarchyMemberships>
        <div class="ov-demo-allocation-memberships">
            <div class="ov-demo-allocation-membership">
                <div>
                    <div class="ov-demo-allocation-title">BCHC Organisational Hierarchy</div>
                    <div class="ov-demo-allocation-meta">Community Nursing · ODM-0007</div>
                </div>
                <OVButton Appearance="OVButtonVariant.Subtle"
                          Icon="OneVisionIcon.Open"
                          Href="viewer/?hierarchyId=42&nodeKey=ODM-0007">
                    Open
                </OVButton>
            </div>
        </div>
    </OdmHierarchyMemberships>
</OVAllocation>

<style>
    .ov-demo-allocation-card-content {
        display: grid;
        gap: 10px;
        align-content: start;
    }

    .ov-demo-allocation-title {
        font-size: .95rem;
        font-weight: 600;
        color: var(--ov-colour-text);
    }

    .ov-demo-allocation-meta {
        margin-top: 2px;
        font-size: .8rem;
        color: var(--ov-colour-muted);
    }

    .ov-demo-allocation-memberships {
        display: grid;
        gap: 8px;
    }

    .ov-demo-allocation-membership {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        min-width: 0;
    }
</style>
