@using System.Globalization

@if (SelectedGroup is null)
{
    <OVListPage Title="Merge Candidates"
                Description="Review proposed duplicate-person groups. Open a group to enter its focused review workspace.">
        <Actions>
            <div class="ov-merge-workspace__header-actions">
                @if (!string.IsNullOrWhiteSpace(_feedback))
                {
                    <span class="ov-merge-workspace__feedback" role="status">@_feedback</span>
                }
                <OVButton Appearance="OVButtonVariant.Secondary" Loading="@_refreshing" Disabled="@_busy" OnClick="RefreshAsync">Refresh</OVButton>
            </div>
        </Actions>
        <Summary>
            <OVContextSummary Items="@QueueSummary" AriaLabel="Merge review queue context">
                <Process>
                    <OVProcessStatus State="@(_refreshing ? OVProcessState.Running : OVProcessState.Completed)"
                                     Display="OVProcessStatusDisplay.Compact"
                                     Label="Candidate generation"
                                     Phase="@(_refreshing ? "Re-evaluating review groups" : "Last evaluation")"
                                     ProgressCurrent="@(_refreshing ? 2 : _groups.Count)"
                                     ProgressTotal="@_groups.Count"
                                     LastRunAt="@DemoLastRunAt"
                                     Message="@(_refreshing ? "Refreshing synthetic matching evidence" : "Review queue is ready")" />
                </Process>
            </OVContextSummary>
        </Summary>
        <Toolbar>
            <OVTextField Label="Search" Placeholder="Name, Person Code or group" Value="@_search" ValueChanged="SearchChanged" Immediate="true" />
            <OVSelect T="string" Label="Review state" Value="@_statusFilter" ValueChanged="StatusFilterChanged" Options="@StatusOptions" />
        </Toolbar>
        <ChildContent>
            <OVCardCollection AriaLabel="Merge review groups"
                              Loading="@_refreshing"
                              Empty="@(FilteredGroups.Count == 0)"
                              EmptyTitle="No review groups"
                              EmptyDescription="No merge groups match the current search and review-state filters.">
                @foreach (var group in FilteredGroups)
                {
                    <OVCard SelectedAction="@(() => OpenGroup(group.Id))" AriaLabel="@($"Open {group.Label} review workspace")">
                        <Header>
                            <div class="ov-merge-group-card__identity">
                                <strong>@group.Label</strong>
                                <span>@string.Join(" · ", group.Candidates.Take(3).Select(MergeReviewDemoData.PersonName))</span>
                            </div>
                        </Header>
                        <Status>
                            <OVPill Text="@group.Status" Role="OVPillRole.Status" Tone="@StatusTone(group)" />
                        </Status>
                        <ChildContent>
                            <div class="ov-merge-group-card__summary">@group.Candidates.Count person candidates · @group.AmbiguityText</div>
                        </ChildContent>
                        <Metadata>
                            <div class="ov-merge-group-card__metadata">
                                <span>@group.Rule</span>
                                <OVPill Text="@($"{group.Confidence:0}% confidence")" Role="OVPillRole.Status" Tone="@(group.Confidence >= 90 ? OVPillTone.Success : OVPillTone.Info)" />
                            </div>
                        </Metadata>
                    </OVCard>
                }
            </OVCardCollection>
        </ChildContent>
        <Pagination><span>Showing @FilteredGroups.Count of @_groups.Count synthetic review groups</span></Pagination>
    </OVListPage>
}
else
{
    var group = SelectedGroup;
    var included = MergeReviewDemoData.IncludedCandidates(group);
    var primary = MergeReviewDemoData.PrimaryCandidate(group);

    <OVDetailPage Title="@group.Label"
                  Description="Focused merge-review workspace. The review queue is the previous navigation level."
                  Busy="@_busy"
                  StickyFooter="true">
        <BackAction>
            <OVButton Appearance="OVButtonVariant.Subtle" Disabled="@_busy" OnClick="BackToList">← Back to review groups</OVButton>
        </BackAction>
        <Status>
            <div class="ov-merge-review__heading-pills">
                <OVPill Text="@group.Rule" Role="OVPillRole.Type" Tone="OVPillTone.Info" />
                <OVPill Text="@group.Status" Role="OVPillRole.Status" Tone="@StatusTone(group)" />
            </div>
        </Status>
        <Summary>
            <OVContextSummary Items="@GroupSummary(group)" AriaLabel="Selected merge group context">
                <Process>
                    <OVProcessStatus State="@(_refreshing ? OVProcessState.Running : OVProcessState.Completed)"
                                     Display="OVProcessStatusDisplay.Compact"
                                     Label="Review-group evaluation"
                                     Phase="@(_refreshing ? "Re-evaluating evidence" : "Current proposal")"
                                     ProgressCurrent="@(_refreshing ? 1 : group.Candidates.Count)"
                                     ProgressTotal="@group.Candidates.Count"
                                     LastRunAt="@DemoLastRunAt"
                                     Message="@(_refreshing ? "Refreshing candidate evidence and conflicts" : "Candidate evidence is current")" />
                </Process>
            </OVContextSummary>
        </Summary>
        <Actions>
            <div class="ov-merge-workspace__header-actions">
                @if (!string.IsNullOrWhiteSpace(_feedback))
                {
                    <span class="ov-merge-workspace__feedback" role="status">@_feedback</span>
                }
                <OVButton Appearance="OVButtonVariant.Secondary" Loading="@_refreshing" Disabled="@_busy" OnClick="RefreshAsync">Refresh group</OVButton>
            </div>
        </Actions>
        <ChildContent>
            <div class="ov-merge-review">
                <section class="ov-merge-review__section" aria-labelledby="merge-candidates-heading">
                    <div class="ov-merge-review__section-heading">
                        <div>
                            <h2 id="merge-candidates-heading">Candidate people</h2>
                            <p>Select any included Person as the survivor. Other included people will be absorbed into that survivor.</p>
                        </div>
                        <OVPill Text="@($"{included.Count} included")" Role="OVPillRole.Status" Tone="OVPillTone.Neutral" />
                    </div>

                    <OVCardCollection AriaLabel="Candidate people">
                        @foreach (var candidate in group.Candidates)
                        {
                            var isIncluded = !candidate.Removed;
                            var isPrimary = isIncluded && candidate.PersonCode == group.PrimaryPersonCode;
                            <OVCard Selected="@isPrimary"
                                    Disabled="@(!isIncluded)"
                                    Busy="@_busy"
                                    SelectedAction="@(() => SelectPrimary(candidate))"
                                    AriaLabel="@CandidateAriaLabel(candidate, isPrimary)">
                                <Header>
                                    <div class="ov-merge-candidate__identity">
                                        <strong>@MergeReviewDemoData.PersonName(candidate)</strong>
                                        <span>@candidate.PersonCode</span>
                                    </div>
                                </Header>
                                <Status>
                                    <OVPill Text="@(isPrimary ? "PRIMARY" : isIncluded ? "Included" : "Removed from current set")"
                                            Role="OVPillRole.Status"
                                            Tone="@(isPrimary ? OVPillTone.Info : isIncluded ? OVPillTone.Success : OVPillTone.Neutral)" />
                                </Status>
                                <ChildContent>
                                    <div class="ov-merge-candidate__evidence">
                                        <div class="ov-merge-candidate__pill-row">
                                            <OVPill Text="@candidate.Source" Role="OVPillRole.Source" Tone="OVPillTone.Neutral" />
                                            <OVPill Text="@candidate.AllocationSummary" Role="OVPillRole.Status" Tone="OVPillTone.Info" />
                                        </div>
                                        <span>@candidate.EvidenceSummary</span>
                                    </div>
                                </ChildContent>
                                <Metadata>
                                    <dl class="ov-merge-candidate__metadata">
                                        <div><dt>DOB</dt><dd>@candidate.DateOfBirth</dd></div>
                                        <div><dt>NHS number</dt><dd>@candidate.NhsNumber</dd></div>
                                        <div><dt>Sex</dt><dd>@candidate.Sex</dd></div>
                                        <div><dt>Postcode</dt><dd class="@(group.HasPostcodeConflict ? "ov-merge-value--conflict" : null)">@candidate.Postcode</dd></div>
                                    </dl>
                                </Metadata>
                                <SecondaryActions>
                                    @if (isIncluded && !isPrimary)
                                    {
                                        <OVButton Appearance="OVButtonVariant.Subtle" Disabled="@_busy" OnClick="_ => RemoveCandidate(candidate)">Remove from merge set</OVButton>
                                    }
                                </SecondaryActions>
                            </OVCard>
                        }
                    </OVCardCollection>

                    @if (included.Count < 2)
                    {
                        <OVAlert Tone="OVAlertTone.Warning">This review set now contains fewer than two people and cannot be merged. Refresh the group to restore the generated proposal before continuing.</OVAlert>
                    }
                </section>

                <section class="ov-merge-review__section" aria-labelledby="merge-evidence-heading">
                    <div class="ov-merge-review__section-heading">
                        <div>
                            <h2 id="merge-evidence-heading">Evidence and conflicts</h2>
                            <p>Readable evidence from the application-owned match result. Legitimate multiple allocations are not treated as conflicts.</p>
                        </div>
                    </div>
                    <div class="ov-merge-evidence-grid">
                        @foreach (var evidence in MergeReviewDemoData.EvidenceRows(included))
                        {
                            <div class="ov-merge-evidence-row">
                                <div><strong>@evidence.Label</strong><span>@evidence.Detail</span></div>
                                <OVPill Text="@evidence.Result" Role="OVPillRole.Status" Tone="@evidence.Tone" />
                            </div>
                        }
                    </div>
                    <OVMetadataList Items="@MergeReviewDemoData.EvidenceMetadata(group, included)" />
                </section>

                <section class="ov-merge-review__section" aria-labelledby="merge-preview-heading">
                    <div class="ov-merge-review__section-heading">
                        <div>
                            <h2 id="merge-preview-heading">Resulting Person</h2>
                            <p>The application supplies this preview from its merge rules. Changing the survivor updates the preview immediately; unresolved values remain explicit.</p>
                        </div>
                        @if (primary is not null)
                        {
                            <OVPill Text="@($"Survivor · {MergeReviewDemoData.PersonName(primary)}")" Role="OVPillRole.Status" Tone="OVPillTone.Info" />
                        }
                    </div>
                    @if (primary is null)
                    {
                        <OVAlert Tone="OVAlertTone.Warning">Select exactly one included Person as the survivor before merging.</OVAlert>
                    }
                    else
                    {
                        <div class="ov-merge-preview">
                            <OVMetadataList Items="@MergeReviewDemoData.ResultMetadata(primary, included)" />
                            @if (group.HasPostcodeConflict && included.Select(candidate => candidate.Postcode).Distinct(StringComparer.OrdinalIgnoreCase).Count() > 1)
                            {
                                <OVAlert Tone="OVAlertTone.Information">Postcode differs between included candidates. No UI-level conflict resolution is invented here; the application must supply the governed resulting value or mark it unresolved.</OVAlert>
                            }
                        </div>
                    }
                </section>
            </div>
        </ChildContent>
        <FooterContent>
            <div class="ov-merge-review__footer-note">
                <strong>Not same person</strong>
                <span>Durably excludes these people from being proposed together again. It is different from temporarily removing a Person from this current merge set.</span>
            </div>
        </FooterContent>
        <FooterActions>
            <OVButton Appearance="OVButtonVariant.Secondary" Disabled="@_busy" OnClick="MarkNotSameAsync">Not same person</OVButton>
            <OVButton Appearance="OVButtonVariant.Primary" Loading="@_busy" Disabled="@(!CanMerge(group))" OnClick="MergeAsync">Merge</OVButton>
        </FooterActions>
    </OVDetailPage>
}

@code {
    private readonly List<MergeReviewGroup> _groups = MergeReviewDemoData.BuildGroups();
    private string? _selectedGroupId;
    private string? _search;
    private string _statusFilter = "All";
    private string? _feedback;
    private bool _refreshing;
    private bool _busy;
    private static readonly DateTimeOffset DemoLastRunAt = new(2026, 10, 29, 15, 45, 0, TimeSpan.Zero);

    private static readonly IReadOnlyList<OVOption<string>> StatusOptions =
    [
        new("All", "All review states"),
        new("Ready", "Ready"),
        new("Ambiguous", "Ambiguous")
    ];

    private MergeReviewGroup? SelectedGroup => _groups.FirstOrDefault(group => group.Id == _selectedGroupId);
    private IReadOnlyList<MergeReviewGroup> FilteredGroups => _groups
        .Where(group => _statusFilter == "All" || group.Status.Equals(_statusFilter, StringComparison.OrdinalIgnoreCase))
        .Where(group => string.IsNullOrWhiteSpace(_search)
            || group.Label.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || group.Candidates.Any(candidate => MergeReviewDemoData.PersonName(candidate).Contains(_search, StringComparison.OrdinalIgnoreCase)
                || candidate.PersonCode.Contains(_search, StringComparison.OrdinalIgnoreCase)))
        .ToList();

    private IReadOnlyList<OVContextSummaryItem> QueueSummary =>
    [
        new("Awaiting review", _groups.Count.ToString(CultureInfo.InvariantCulture)),
        new("Ready", _groups.Count(group => group.Status == "Ready").ToString(CultureInfo.InvariantCulture), Tone: OVPillTone.Success),
        new("Ambiguous", _groups.Count(group => group.Status == "Ambiguous").ToString(CultureInfo.InvariantCulture), Tone: OVPillTone.Warning),
        new("Visible", FilteredGroups.Count.ToString(CultureInfo.InvariantCulture))
    ];

    private static IReadOnlyList<OVContextSummaryItem> GroupSummary(MergeReviewGroup group) =>
    [
        new("Candidates", group.Candidates.Count.ToString(CultureInfo.InvariantCulture)),
        new("Confidence", $"{group.Confidence:0}%", Tone: group.Confidence >= 90 ? OVPillTone.Success : OVPillTone.Info),
        new("Ambiguity", group.AmbiguityText),
        new("Status", group.Status, Tone: StatusTone(group))
    ];

    private static OVPillTone StatusTone(MergeReviewGroup group) => group.Status == "Ready" ? OVPillTone.Success : OVPillTone.Warning;
    private Task SearchChanged(string? value) { _search = value; return Task.CompletedTask; }
    private Task StatusFilterChanged(string? value) { _statusFilter = string.IsNullOrWhiteSpace(value) ? "All" : value; return Task.CompletedTask; }
    private void OpenGroup(string groupId) { _selectedGroupId = groupId; _feedback = null; }
    private void BackToList(MouseEventArgs _) { _selectedGroupId = null; _feedback = null; }

    private void SelectPrimary(MergeReviewCandidate candidate)
    {
        var group = SelectedGroup;
        if (group is null || candidate.Removed || _busy) return;
        group.PrimaryPersonCode = candidate.PersonCode;
        _feedback = $"{MergeReviewDemoData.PersonName(candidate)} selected as survivor.";
    }

    private void RemoveCandidate(MergeReviewCandidate candidate)
    {
        var group = SelectedGroup;
        if (group is null || candidate.Removed || candidate.PersonCode == group.PrimaryPersonCode || _busy) return;
        candidate.Removed = true;
        _feedback = $"{MergeReviewDemoData.PersonName(candidate)} removed from this proposed merge set only.";
    }

    private async Task RefreshAsync(MouseEventArgs _)
    {
        if (_refreshing || _busy) return;
        var current = _selectedGroupId;
        _refreshing = true;
        _feedback = "Re-evaluating synthetic merge groups…";
        await Task.Delay(450);
        foreach (var reviewGroup in _groups)
            foreach (var candidate in reviewGroup.Candidates)
                candidate.Removed = false;
        _refreshing = false;
        _selectedGroupId = current is not null && _groups.Any(group => group.Id == current) ? current : null;
        _feedback = current is null ? "Merge groups refreshed." : "Review group refreshed; generated candidates restored.";
    }

    private async Task MergeAsync(MouseEventArgs _)
    {
        var group = SelectedGroup;
        if (group is null || !CanMerge(group)) return;
        _busy = true;
        await Task.Delay(600);
        var label = group.Label;
        _groups.Remove(group);
        _busy = false;
        _selectedGroupId = null;
        _feedback = $"{label} merged successfully and was removed from the review queue.";
    }

    private async Task MarkNotSameAsync(MouseEventArgs _)
    {
        var group = SelectedGroup;
        if (group is null || _busy) return;
        _busy = true;
        await Task.Delay(350);
        var label = group.Label;
        _groups.Remove(group);
        _busy = false;
        _selectedGroupId = null;
        _feedback = $"{label} marked Not same person. The durable exclusion is application-owned and the group was removed from this queue.";
    }

    private bool CanMerge(MergeReviewGroup group)
        => !_busy && group.Status == "Ready" && MergeReviewDemoData.IncludedCandidates(group).Count >= 2 && MergeReviewDemoData.PrimaryCandidate(group) is not null;

    private static string CandidateAriaLabel(MergeReviewCandidate candidate, bool primary)
        => candidate.Removed ? $"{MergeReviewDemoData.PersonName(candidate)}, removed from current merge set"
            : primary ? $"{MergeReviewDemoData.PersonName(candidate)}, selected survivor"
            : $"Select {MergeReviewDemoData.PersonName(candidate)} as survivor";
}
