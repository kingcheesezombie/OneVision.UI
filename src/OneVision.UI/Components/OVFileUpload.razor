@using OneVision.UI.Iconography

<div class="@RootClass">
    <div class="ov-file-upload__dropzone" @ondragover:preventDefault="true">
        <InputFile class="ov-file-upload__input" OnChange="OnFilesChanged" multiple="@AllowMultiple" accept="@Accept" disabled="@Disabled" aria-label="@Prompt" />
        <div class="ov-file-upload__prompt" aria-hidden="true">
            <OVIcon Name="OneVisionIcon.Add" />
            <strong>@Prompt</strong>
            <span>Drag files here or browse</span>
            @if (!string.IsNullOrWhiteSpace(Hint)) { <small>@Hint</small> }
        </div>
    </div>

    @if (SelectedFiles.Count > 0)
    {
        <div class="ov-file-upload__files" role="list" aria-label="Selected files">
            @foreach (var file in SelectedFiles)
            {
                <div class="ov-file-upload__file" role="listitem">
                    <div><strong>@file.Name</strong><span>@FormatSize(file.Size)</span></div>
                    @if (!Disabled && RemoveRequested.HasDelegate)
                    {
                        <OVIconButton Icon="OneVisionIcon.Cancel" Label="@($"Remove {file.Name}")" OnClick="@(_ => RemoveRequested.InvokeAsync(file.Name))" />
                    }
                </div>
            }
        </div>
    }

    @if (ValidationIssues.Count > 0)
    {
        <OVValidationSummary Issues="@ValidationIssues" />
    }

    @if (UploadProgress is not null)
    {
        <OVProgress Mode="OVProgressMode.Determinate" Value="@UploadProgress.Value" Label="@ProgressLabel" />
    }
</div>

@code {
    [Parameter] public IReadOnlyList<IBrowserFile> SelectedFiles { get; set; } = [];
    [Parameter] public EventCallback<IReadOnlyList<IBrowserFile>> SelectedFilesChanged { get; set; }
    [Parameter] public EventCallback<string> RemoveRequested { get; set; }
    [Parameter] public bool AllowMultiple { get; set; }
    [Parameter] public int MaximumFileCount { get; set; } = 10;
    [Parameter] public string? Accept { get; set; }
    [Parameter] public string Prompt { get; set; } = "Choose file";
    [Parameter] public string? Hint { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public Func<IBrowserFile, string?>? ValidateFile { get; set; }
    [Parameter] public IReadOnlyList<string> ValidationMessages { get; set; } = [];
    [Parameter] public double? UploadProgress { get; set; }
    [Parameter] public string ProgressLabel { get; set; } = "Uploading…";
    [Parameter] public string? Class { get; set; }

    private string RootClass => string.IsNullOrWhiteSpace(Class) ? "ov-file-upload" : $"ov-file-upload {Class}";
    private readonly List<string> _selectionErrors = [];
    private IReadOnlyList<OVValidationSummary.OVValidationIssue> ValidationIssues
        => ValidationMessages.Concat(_selectionErrors)
            .Select(message => new OVValidationSummary.OVValidationIssue(message)).ToArray();

    private async Task OnFilesChanged(InputFileChangeEventArgs args)
    {
        if (Disabled) return;
        _selectionErrors.Clear();
        IReadOnlyList<IBrowserFile> files;
        try
        {
            files = AllowMultiple ? args.GetMultipleFiles(Math.Max(1, MaximumFileCount)) : [args.File];
        }
        catch (InvalidOperationException)
        {
            _selectionErrors.Add($"Choose no more than {Math.Max(1, MaximumFileCount)} files.");
            return;
        }

        var accepted = new List<IBrowserFile>();
        foreach (var file in files)
        {
            var error = ValidateFile?.Invoke(file);
            if (string.IsNullOrWhiteSpace(error)) accepted.Add(file);
            else _selectionErrors.Add($"{file.Name}: {error}");
        }

        if (accepted.Count > 0 || _selectionErrors.Count == 0)
            await SelectedFilesChanged.InvokeAsync(accepted);
    }

    private static string FormatSize(long bytes)
        => bytes >= 1024 * 1024 ? $"{bytes / 1024d / 1024d:0.##} MB" : bytes >= 1024 ? $"{bytes / 1024d:0.#} KB" : $"{bytes} B";
}
