@page "/"

<PageTitle>OneVision.UI Gallery</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">OneVision UI Gallery</MudText>
<MudText Typo="Typo.body1" Class="mb-6">
    Working gallery for the shared OneVision design system. MudBlazor provides the underlying component mechanics; the OV components and tokens define the OneVision contract.
</MudText>

<section class="ov-demo-section">
    <MudText Typo="Typo.h6" GutterBottom="true">Actions</MudText>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        <OVButton>Primary action</OVButton>
        <OVButton Variant="Variant.Outlined" Color="Color.Primary">Secondary action</OVButton>
        <OVButton Variant="Variant.Text" Color="Color.Error">Delete</OVButton>
        <OVButton Disabled="true">Disabled</OVButton>
    </MudStack>
</section>

<section class="ov-demo-section">
    <MudText Typo="Typo.h6" GutterBottom="true">Status</MudText>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        <OVStatusPill Text="Current" Tone="OVStatusPill.OVStatusTone.Success" />
        <OVStatusPill Text="Scheduled" Tone="OVStatusPill.OVStatusTone.Info" />
        <OVStatusPill Text="Pending" Tone="OVStatusPill.OVStatusTone.Warning" />
        <OVStatusPill Text="Ended" />
        <OVStatusPill Text="Failed" Tone="OVStatusPill.OVStatusTone.Danger" />
    </MudStack>
</section>

<section class="ov-demo-section">
    <MudText Typo="Typo.h6" GutterBottom="true">Form controls</MudText>
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudTextField @bind-Value="ConnectionName" Label="Connection name" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudSelect T="string" @bind-Value="ConnectionType" Label="Connection type" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value='@("SQL Server")'>SQL Server</MudSelectItem>
                <MudSelectItem Value='@("API")'>API</MudSelectItem>
                <MudSelectItem Value='@("LDAP")'>LDAP</MudSelectItem>
            </MudSelect>
        </MudItem>
    </MudGrid>
</section>

<section class="ov-demo-section">
    <MudText Typo="Typo.h6" GutterBottom="true">Next pattern</MudText>
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        The first higher-level pattern will be the standard OneVision Connection Manager dialog.
    </MudAlert>
</section>

@code {
    private string ConnectionName { get; set; } = "Primary SQL";
    private string ConnectionType { get; set; } = "SQL Server";
}
