@using OneVision.UI.Demo

<MudPaper Class="ov-component-demo" Elevation="0">
    <div class="ov-component-demo__header">
        <div>
            <MudText Typo="Typo.h6">@Definition.Name</MudText>
            <MudText Typo="Typo.caption">@Definition.Reference · @State</MudText>
            <MudText Typo="Typo.caption" Class="ov-component-demo__basis">@ComponentCatalog.KindLabel(Definition.Kind) · @Definition.ImplementationBasis</MudText>
        </div>
        <OVPill Text="@MaturityLabel" Role="OVPillRole.Status" Tone="@MaturityTone" />
    </div>
    <div class="ov-component-demo__body">
        @if (Definition.Reference == "OVC-MAPPING-PAIR")
        {
            <MappingPairDemo State="@State" EnabledCapabilities="@EnabledCapabilities" />
        }
        else if (Definition.Reference == "OVC-MAPPING-JOIN")
        {
            <MappingJoinDemo State="@State" EnabledCapabilities="@EnabledCapabilities" />
        }
        else if (Definition.Reference == "OVC-OVERFLOW-MENU")
        {
            <OverflowMenuDemo State="@State" />
        }
        else if (Definition.Reference == "OVC-CONNECTION-EDITOR")
        {
            <ConnectionEditorDemo State="@State" EnabledCapabilities="@EnabledCapabilities" />
        }
        else if (Definition.Reference == "OVC-SCHEDULE-BUILDER")
        {
            <ScheduleBuilderDemo State="@State" EnabledCapabilities="@EnabledCapabilities" />
        }
        else if (Definition.Reference == "OVC-TREE" && State == "StructureEdit")
        {
            <TreeStructureEditDemo ReadOnly="@HasCapability("read-only")" Searchable="@HasCapability("search")" />
        }
        else if (OperationalReferences.Contains(Definition.Reference))
        {
            <OperationalComponentDemo Definition="@Definition" State="@State" EnabledCapabilities="@EnabledCapabilities" />
        }
        else
        {
            @switch (Definition.Group)
            {
                case "Actions":
                case "Text & input":
                case "Selection":
                case "Dates & times":
                    <InputComponentDemo Definition="@Definition" State="@State" EnabledCapabilities="@EnabledCapabilities" />
                    break;
                case "Status & labels":
                case "Data & lists":
                case "Navigation":
                    <DataNavigationComponentDemo Definition="@Definition" State="@State" EnabledCapabilities="@EnabledCapabilities" />
                    break;
                case "Feedback":
                case "Containers":
                case "Overlays":
                    <FeedbackSurfaceComponentDemo Definition="@Definition" State="@State" EnabledCapabilities="@EnabledCapabilities" />
                    break;
                case "Display":
                case "App shell":
                case "Structured data":
                case "Mapping":
                    <DisplayShellComponentDemo Definition="@Definition" State="@State" />
                    break;
                default:
                    <MudAlert Severity="Severity.Warning">No behavioural demo is registered for @Definition.Reference.</MudAlert>
                    break;
            }
        }
    </div>
</MudPaper>

@code {
    [Parameter, EditorRequired] public ComponentDefinition Definition { get; set; } = default!;
    [Parameter] public string State { get; set; } = "Default";
    [Parameter] public IReadOnlyCollection<string> EnabledCapabilities { get; set; } = Array.Empty<string>();

    private static readonly HashSet<string> OperationalReferences = new(StringComparer.Ordinal)
    {
        "OVC-METADATA-LIST",
        "OVC-PROCESS-STAGES",
        "OVC-NOTIFICATION",
        "OVC-FILE-UPLOAD",
        "OVC-TIMELINE",
        "OVC-SKELETON",
        "OVC-LIST",
        "OVC-SELECTION-LIST",
        "OVC-DIVIDER",
        "OVC-BADGE",
        "OVC-STEPPER",
        "OVC-DATE-TIME"
    };

    private bool HasCapability(string key) => EnabledCapabilities.Contains(key);

    private ComponentMaturity Maturity => ComponentMaturityCatalog.Get(Definition.Reference);
    private string MaturityLabel => ComponentMaturityCatalog.Label(Maturity);
    private OVPillTone MaturityTone => ComponentMaturityCatalog.Tone(Maturity);
}
