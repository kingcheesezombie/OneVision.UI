@inherits LayoutComponentBase

<MudThemeProvider Theme="OneVisionTheme.Default" />
<MudPopoverProvider />
<MudDialogProvider CloseButton="true" CloseOnEscapeKey="true" />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true">
        <MudText Typo="Typo.h6">OneVision.UI</MudText>
        <MudSpacer />
        <MudText Typo="Typo.body2">Component Gallery</MudText>
    </MudAppBar>

    <MudDrawer Open="true" Variant="DrawerVariant.Mini" Elevation="0">
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Overview</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>
