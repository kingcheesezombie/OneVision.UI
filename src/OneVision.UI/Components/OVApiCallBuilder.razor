@using System.Globalization
@using System.Text
@using System.Text.Json
@using System.Text.Json.Nodes

<div class="@BuilderClass">
    <header class="ov-api-call-builder__header">
        <div>
            <h2>@Title</h2>
            <p>@(Catalogue?.Description ?? "Choose what you want to do and OneVision will build the request for you.")</p>
        </div>
        @if (Dirty && !ReadOnly)
        {
            <span class="ov-api-call-builder__unsaved">Unsaved changes</span>
        }
    </header>

    @if (Catalogue is null)
    {
        <OVAlert Tone="OVAlertTone.Information">No API catalogue has been supplied by this application.</OVAlert>
    }
    else if (InitialNode is null)
    {
        <OVAlert Tone="OVAlertTone.Warning">The API catalogue does not contain its configured starting decision.</OVAlert>
    }
    else
    {
        <section class="ov-api-call-builder__decision-flow" aria-labelledby="ov-api-decision-flow-heading">
            <div class="ov-api-call-builder__section-heading">
                <h3 id="ov-api-decision-flow-heading">Build request</h3>
                <p>Choose the outcome you need. Technical request details are generated as you go.</p>
            </div>

            @if (ShowDeepContext)
            {
                <div class="ov-api-call-builder__flow-context" role="status" aria-label="Current request context">@DecisionContext</div>
            }

            <OVApiDecisionTrail Selections="@TrailItems" ChangeRequested="ChangeDecision" Disabled="@(Busy || ReadOnly)" />

            <div class="ov-api-call-builder__active-host" tabindex="-1" @ref="_activeStepHost">
                @if (CurrentNode is not null)
                {
                    <OVApiDecisionStep Node="@CurrentNode" ChoiceSelected="SelectChoice" Disabled="@(Busy || ReadOnly)" />
                }
                else if (ResolvedOperation is not null)
                {
                    <section class="ov-api-call-builder__resolved" aria-labelledby="ov-api-configure-heading">
                        <div class="ov-api-call-builder__section-heading ov-api-call-builder__section-heading--active">
                            <h3 id="ov-api-configure-heading">Request options</h3>
                            @if (!string.IsNullOrWhiteSpace(ResolvedOperation.Description))
                            {
                                <p>@ResolvedOperation.Description</p>
                            }
                        </div>

                        @if (ReadOnly)
                        {
                            <div class="ov-api-call-builder__readonly-values" aria-label="Configured request values">
                                @if (ConfiguredParameters.Count == 0)
                                {
                                    <span>No additional request values are configured.</span>
                                }
                                else
                                {
                                    @foreach (var parameter in ConfiguredParameters)
                                    {
                                        <div>
                                            <span>@parameter.Label</span>
                                            <strong>@FriendlyValue(parameter, ValueFor(parameter.Name))</strong>
                                        </div>
                                    }
                                }
                            </div>
                        }
                        else if (VisibleRequiredParameters.Count == 0 && VisibleOptionalParameters.Count == 0)
                        {
                            <div class="ov-api-call-builder__complete">No further information is needed.</div>
                        }
                        else
                        {
                            @foreach (var group in RequiredParameterGroups)
                            {
                                <section class="ov-api-call-builder__parameter-group">
                                    @if (!string.IsNullOrWhiteSpace(group.Name))
                                    {
                                        <div class="ov-api-call-builder__parameter-group-heading">
                                            <strong>@group.Name</strong>
                                            @if (!string.IsNullOrWhiteSpace(group.Description))
                                            {
                                                <span>@group.Description</span>
                                            }
                                        </div>
                                    }
                                    <div class="@ParameterGridClass(group)">
                                        @foreach (var parameter in group.Parameters)
                                        {
                                            @ParameterEditor(parameter)
                                        }
                                    </div>
                                </section>
                            }

                            @if (VisibleOptionalParameters.Count > 0)
                            {
                                <details class="ov-api-call-builder__additional">
                                    <summary>
                                        <span>Additional options</span>
                                        <small>@OptionalStateText</small>
                                    </summary>
                                    <div class="ov-api-call-builder__optional-groups">
                                        @foreach (var group in OptionalParameterGroups)
                                        {
                                            <section class="ov-api-call-builder__parameter-group">
                                                @if (!string.IsNullOrWhiteSpace(group.Name))
                                                {
                                                    <div class="ov-api-call-builder__parameter-group-heading">
                                                        <strong>@group.Name</strong>
                                                        @if (!string.IsNullOrWhiteSpace(group.Description))
                                                        {
                                                            <span>@group.Description</span>
                                                        }
                                                    </div>
                                                }
                                                <div class="@ParameterGridClass(group, optional: true)">
                                                    @foreach (var parameter in group.Parameters)
                                                    {
                                                        @ParameterEditor(parameter)
                                                    }
                                                </div>
                                            </section>
                                        }
                                    </div>
                                </details>
                            }
                        }
                    </section>
                }
                else
                {
                    <div class="ov-api-call-builder__empty">Choose an action to begin.</div>
                }
            </div>
        </section>

        @if (ResolvedOperation is not null)
        {
            <section class="ov-api-call-builder__request" aria-labelledby="ov-api-request-heading">
                <div class="ov-api-call-builder__request-heading">
                    <div>
                        <h3 id="ov-api-request-heading">Request</h3>
                        <strong class="ov-api-call-builder__operation">@CompiledConfiguration.Method · @ResolvedOperation.Label</strong>
                    </div>
                    <div class="@ReadinessClass" role="status">
                        <span aria-hidden="true">@(IsValid ? "✓" : "○")</span>
                        <span>@ReadinessMessage</span>
                    </div>
                </div>

                <div class="ov-api-call-builder__request-values">
                    <div class="ov-api-call-builder__copy-row ov-api-call-builder__copy-row--primary">
                        <span>Resolved path</span>
                        <OVCopyableLink Text="@ResolvedPath" CopyValue="@ResolvedPath" Label="Copy resolved API path" />
                    </div>
                    <div class="ov-api-call-builder__copy-row">
                        <span>Full URL</span>
                        <OVCopyableLink Text="@FullUrl" CopyValue="@FullUrl" Label="Copy full URL" />
                    </div>
                    <div class="ov-api-call-builder__copy-row ov-api-call-builder__copy-row--secondary">
                        <span>API path</span>
                        <OVCopyableLink Text="@ApiPath" CopyValue="@ApiPath" Label="Copy API path" />
                    </div>
                </div>

                <div class="ov-api-call-builder__request-utility">
                    <OVCopyableLink Text="Copy request" CopyValue="@CopyRequestText" Label="Copy request" />
                </div>

                @if (SelectedConnection is not null)
                {
                    <div class="@(SelectedConnection.AuthenticationConfigured ? "ov-api-call-builder__auth" : "ov-api-call-builder__auth ov-api-call-builder__auth--problem")">
                        <span>Authentication</span>
                        <strong>@SelectedConnection.AuthenticationDisplay</strong>
                        @if (!SelectedConnection.AuthenticationConfigured)
                        {
                            <small>Service credential not configured.</small>
                        }
                    </div>
                }

                <details class="ov-api-call-builder__request-details">
                    <summary>Details</summary>
                    <div class="ov-api-call-builder__technical-grid">
                        <span>Method</span><code>@CompiledConfiguration.Method</code>
                        <span>Content type</span><code>@(CompiledConfiguration.ContentType ?? "—")</code>
                        <span>Headers</span><code>@CompiledConfiguration.Headers.Count(item => item.Enabled)</code>
                        <span>Body</span><code>@(string.IsNullOrWhiteSpace(CompiledConfiguration.RequestBody) ? "None" : "Generated")</code>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(CompiledConfiguration.RequestBody))
                    {
                        <div class="ov-api-call-builder__body-preview">
                            <div class="ov-api-call-builder__body-heading">
                                <span>Generated body</span>
                                <OVCopyableLink Text="Copy body" CopyValue="@CompiledConfiguration.RequestBody" Label="Copy request body" />
                            </div>
                            <pre>@CompiledConfiguration.RequestBody</pre>
                        </div>
                    }
                </details>

                <details class="ov-api-call-builder__advanced">
                    <summary><span>Advanced</span>@if (!string.IsNullOrWhiteSpace(AdvancedStateText)) { <small>@AdvancedStateText</small> }</summary>
                    <div class="ov-api-call-builder__advanced-content">
                        <div><span>Connection</span><strong>@(SelectedConnection?.Name ?? "Application managed")</strong></div>
                        @if (CompiledConfiguration.TimeoutSeconds is not null)
                        {
                            <div><span>Timeout</span><strong>@CompiledConfiguration.TimeoutSeconds s</strong></div>
                        }
                    </div>
                    <div class="ov-api-call-builder__raw-request">
                        <div class="ov-api-call-builder__body-heading">
                            <span>Generated request</span>
                            <OVCopyableLink Text="Copy generated request" CopyValue="@RawRequest" Label="Copy generated request" />
                        </div>
                        <pre>@RawRequest</pre>
                    </div>
                </details>

                @if (!ReadOnly)
                {
                    <div class="ov-api-call-builder__request-action">
                        <OVButton Appearance="OVButtonVariant.Primary"
                                  Disabled="@(!CanAttemptTest)"
                                  OnClick="Test">Test Request</OVButton>
                    </div>
                }
            </section>

            <section class="ov-api-call-builder__response" aria-labelledby="ov-api-response-heading">
                <div class="ov-api-call-builder__section-heading">
                    <h3 id="ov-api-response-heading">Response</h3>
                </div>
                <OVApiResponsePreview Result="@TestResult" />
            </section>
        }

        <footer class="ov-api-call-builder__footer">
            @if (ReadOnly)
            {
                <OVButton Appearance="OVButtonVariant.Secondary" Disabled="@Busy" OnClick="Cancel">Close</OVButton>
            }
            else
            {
                <OVButton Appearance="OVButtonVariant.Secondary" Disabled="@Busy" OnClick="Cancel">Cancel</OVButton>
                <OVButton Appearance="OVButtonVariant.Primary" Disabled="@(!Dirty || !IsValid || Busy)" OnClick="Save">Save</OVButton>
            }
        </footer>
    }
</div>

<OVConfirmDialog Open="@_confirmCancel"
                 Title="Discard changes?"
                 Message="Your API request choices have unsaved changes. Discard them?"
                 ConfirmText="Discard changes"
                 CancelText="Keep editing"
                 Confirmed="ConfirmCancel"
                 Cancelled="KeepEditing" />

@code {
    [Parameter] public string Title { get; set; } = "Build API Request";
    [Parameter] public OVApiCatalogue? Catalogue { get; set; }
    [Parameter] public OVApiGuidedState GuidedState { get; set; } = OVApiGuidedState.Empty;
    [Parameter] public EventCallback<OVApiGuidedState> GuidedStateChanged { get; set; }
    [Parameter] public Func<OVApiParameterSourceRequest, Task<OVApiParameterSourceResult>>? ParameterSourceResolver { get; set; }

    [Parameter] public IReadOnlyList<OVApiConnectionOption> Connections { get; set; } = [];
    [Parameter] public IReadOnlyList<OVOption<string>> Methods { get; set; } = [];
    [Parameter] public IReadOnlyList<OVApiParameterDefinition> ParameterDefinitions { get; set; } = [];
    [Parameter] public IReadOnlyList<OVApiTokenOption> Tokens { get; set; } = [];
    [Parameter] public IReadOnlyList<OVApiCallPreset> Presets { get; set; } = [];
    [Parameter, EditorRequired] public OVApiCallConfiguration Configuration { get; set; } = new(null, "GET", string.Empty, [], []);
    [Parameter] public EventCallback<OVApiCallConfiguration> ConfigurationChanged { get; set; }
    [Parameter] public OVApiCallTestResult? TestResult { get; set; }
    [Parameter] public EventCallback<OVApiCallConfiguration> TestRequested { get; set; }
    [Parameter] public EventCallback<OVApiCallConfiguration> SaveRequested { get; set; }
    [Parameter] public EventCallback CancelRequested { get; set; }
    [Parameter] public EventCallback<bool> DirtyChanged { get; set; }
    [Parameter] public bool Dirty { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool ReadOnly { get; set; }

    private readonly List<OVApiDecisionSelection> _decisions = [];
    private readonly Dictionary<string, string?> _values = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, OVApiParameterSourceResult> _sources = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _touchedParameters = new(StringComparer.OrdinalIgnoreCase);
    private string? _loadedOperationId;
    private string? _stateSignature;
    private bool _confirmCancel;
    private bool _validationRequested;
    private bool _focusActiveStep;
    private ElementReference _activeStepHost;

    protected override async Task OnParametersSetAsync()
    {
        var signature = BuildStateSignature();
        if (_stateSignature != signature)
        {
            _stateSignature = signature;
            _decisions.Clear();
            _decisions.AddRange(GuidedState.Decisions);
            _values.Clear();
            foreach (var parameter in GuidedState.Parameters) _values[parameter.Name] = parameter.Value;
            _loadedOperationId = null;
            _validationRequested = false;
            _touchedParameters.Clear();
        }

        await EnsureOperationStateAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusActiveStep) return;
        _focusActiveStep = false;
        try { await _activeStepHost.FocusAsync(); } catch (InvalidOperationException) { }
    }

    private string BuilderClass => $"ov-api-call-builder{(ReadOnly ? " ov-api-call-builder--readonly" : string.Empty)}";
    private OVApiDecisionNode? InitialNode => Catalogue?.Nodes.FirstOrDefault(node => node.Id == Catalogue.InitialNodeId);

    private OVApiDecisionNode? CurrentNode
    {
        get
        {
            if (Catalogue is null) return null;
            var node = InitialNode;
            foreach (var selection in _decisions)
            {
                if (node is null || !string.Equals(node.Id, selection.NodeId, StringComparison.Ordinal)) return node;
                var choice = node.Choices.FirstOrDefault(item => item.Value == selection.ChoiceValue);
                if (choice is null || !string.IsNullOrWhiteSpace(choice.OperationId)) return null;
                node = string.IsNullOrWhiteSpace(choice.NextNodeId) ? null : Catalogue.Nodes.FirstOrDefault(item => item.Id == choice.NextNodeId);
            }
            return node;
        }
    }

    private OVApiOperationDefinition? ResolvedOperation
    {
        get
        {
            if (Catalogue is null || _decisions.Count == 0) return null;
            var last = _decisions[^1];
            var node = Catalogue.Nodes.FirstOrDefault(item => item.Id == last.NodeId);
            var choice = node?.Choices.FirstOrDefault(item => item.Value == last.ChoiceValue);
            return string.IsNullOrWhiteSpace(choice?.OperationId) ? null : Catalogue.Operations.FirstOrDefault(operation => operation.Id == choice.OperationId);
        }
    }

    private IReadOnlyList<OVApiDecisionTrailItem> TrailItems
        => _decisions.Select(selection =>
        {
            var node = Catalogue?.Nodes.FirstOrDefault(item => item.Id == selection.NodeId);
            var choice = node?.Choices.FirstOrDefault(item => item.Value == selection.ChoiceValue);
            return new OVApiDecisionTrailItem(node?.Prompt ?? selection.NodeId, choice?.Label ?? selection.ChoiceValue);
        }).ToArray();

    private IReadOnlyList<OVApiParameterDefinition> VisibleRequiredParameters
        => ResolvedOperation?.Parameters.Where(parameter => !parameter.Hidden && parameter.Required && !parameter.OptionalByDefault).ToArray() ?? [];

    private IReadOnlyList<OVApiParameterDefinition> VisibleOptionalParameters
        => ResolvedOperation?.Parameters.Where(parameter => !parameter.Hidden && (!parameter.Required || parameter.OptionalByDefault)).ToArray() ?? [];

    private IReadOnlyList<OVApiParameterDefinition> ConfiguredParameters
        => ResolvedOperation?.Parameters.Where(parameter => !parameter.Hidden && !string.IsNullOrWhiteSpace(ValueFor(parameter.Name))).ToArray() ?? [];

    private IReadOnlyList<ParameterGroup> RequiredParameterGroups => GroupParameters(VisibleRequiredParameters);
    private IReadOnlyList<ParameterGroup> OptionalParameterGroups => GroupParameters(VisibleOptionalParameters);

    private IReadOnlyList<string> ValidationMessages
        => ResolvedOperation?.Parameters
            .Where(parameter => parameter.Required && !parameter.Hidden && string.IsNullOrWhiteSpace(ValueFor(parameter.Name)))
            .Select(parameter => parameter.ValidationMessage ?? $"Choose {parameter.Label.ToLowerInvariant()}.")
            .ToArray() ?? [];

    private bool IsValid => ResolvedOperation is not null && ValidationMessages.Count == 0 && ResolvedOperation.Parameters.All(DependencyValid);
    private bool CanAttemptTest => IsValid && !Busy && TestResult?.State != OVApiTestState.Testing && (SelectedConnection?.AuthenticationConfigured ?? true);
    private OVApiConnectionOption? SelectedConnection => Connections.FirstOrDefault(connection => connection.Id == ResolvedOperation?.ConnectionId);
    private OVApiCallConfiguration CompiledConfiguration => CompileConfiguration();
    private string ApiPath => ResolvedOperation?.Resource ?? CompiledConfiguration.Resource;
    private string ResolvedPath => BuildResolvedPath();
    private string FullUrl => BuildFullUrl();
    private string ReadinessClass => $"ov-api-call-builder__ready {(IsValid ? "ov-api-call-builder__ready--valid" : "ov-api-call-builder__ready--incomplete")}";
    private bool ShowDeepContext => _decisions.Count >= 5;

    private string DecisionContext
    {
        get
        {
            var answers = TrailItems.Select(item => item.Answer).TakeLast(3).ToArray();
            var prefix = ResolvedOperation?.Method;
            return string.Join(" · ", (string.IsNullOrWhiteSpace(prefix) ? answers : [prefix, .. answers]).Where(value => !string.IsNullOrWhiteSpace(value)));
        }
    }

    private string ReadinessMessage
    {
        get
        {
            if (SelectedConnection is { AuthenticationConfigured: false }) return "Connection authentication required";
            var missing = ResolvedOperation?.Parameters
                .Where(parameter => parameter.Required && !parameter.Hidden && string.IsNullOrWhiteSpace(ValueFor(parameter.Name)))
                .ToArray() ?? [];
            if (missing.Length == 1) return missing[0].ValidationMessage ?? $"Choose {missing[0].Label.ToLowerInvariant()}";
            if (missing.Length > 1) return $"{missing.Length} required values remaining";
            var invalidDependency = ResolvedOperation?.Parameters.FirstOrDefault(parameter => !DependencyValid(parameter));
            if (invalidDependency is not null) return $"Review {invalidDependency.Label.ToLowerInvariant()}";
            return "Ready";
        }
    }

    private int ConfiguredOptionalCount => VisibleOptionalParameters.Count(parameter =>
    {
        var value = ValueFor(parameter.Name);
        if (string.IsNullOrWhiteSpace(value)) return false;
        return _touchedParameters.Contains(parameter.Name) || !string.Equals(value, parameter.DefaultValue, StringComparison.Ordinal);
    });

    private string OptionalStateText => ConfiguredOptionalCount > 0
        ? $"{ConfiguredOptionalCount} configured"
        : $"{VisibleOptionalParameters.Count} available";

    private string AdvancedStateText
    {
        get
        {
            var count = CompiledConfiguration.Headers.Count(item => item.Enabled) + (CompiledConfiguration.TimeoutSeconds is null ? 0 : 1);
            return count == 0 ? string.Empty : count == 1 ? "1 setting" : $"{count} settings";
        }
    }

    private string CopyRequestText
    {
        get
        {
            var builder = new StringBuilder($"{CompiledConfiguration.Method} {FullUrl}");
            if (!string.IsNullOrWhiteSpace(CompiledConfiguration.RequestBody)) builder.AppendLine().Append(CompiledConfiguration.RequestBody);
            return builder.ToString();
        }
    }

    private RenderFragment ParameterEditor(OVApiParameterDefinition parameter) => builder =>
    {
        builder.OpenComponent<OVApiParameterControl>(0);
        builder.AddAttribute(1, nameof(OVApiParameterControl.Definition), parameter);
        builder.AddAttribute(2, nameof(OVApiParameterControl.Value), ValueFor(parameter.Name));
        builder.AddAttribute(3, nameof(OVApiParameterControl.ValueChanged), EventCallback.Factory.Create<string?>(this, value => SetParameter(parameter, value)));
        builder.AddAttribute(4, nameof(OVApiParameterControl.Options), OptionsFor(parameter));
        builder.AddAttribute(5, nameof(OVApiParameterControl.SourceState), SourceFor(parameter).State);
        builder.AddAttribute(6, nameof(OVApiParameterControl.SourceMessage), SourceFor(parameter).Message);
        builder.AddAttribute(7, nameof(OVApiParameterControl.RetryRequested), EventCallback.Factory.Create(this, () => ResolveSource(parameter)));
        builder.AddAttribute(8, nameof(OVApiParameterControl.Disabled), Busy || DependencyBlocked(parameter));
        builder.AddAttribute(9, nameof(OVApiParameterControl.ReadOnly), false);
        builder.AddAttribute(10, nameof(OVApiParameterControl.HasError), ShouldShowError(parameter));
        builder.AddAttribute(11, nameof(OVApiParameterControl.ErrorText), parameter.ValidationMessage ?? $"{parameter.Label} is required.");
        builder.AddAttribute(12, nameof(OVApiParameterControl.UnavailableMessage), DependencyMessage(parameter));
        builder.CloseComponent();
    };

    private bool ShouldShowError(OVApiParameterDefinition parameter)
        => parameter.Required
           && !parameter.Hidden
           && string.IsNullOrWhiteSpace(ValueFor(parameter.Name))
           && (_validationRequested || _touchedParameters.Contains(parameter.Name));

    private string? DependencyMessage(OVApiParameterDefinition parameter)
    {
        if (!DependencyBlocked(parameter)) return null;
        var controller = ResolvedOperation?.Parameters.FirstOrDefault(item => string.Equals(item.Name, parameter.DependsOn, StringComparison.OrdinalIgnoreCase));
        return controller is null ? "Complete the preceding selection first." : $"Choose {controller.Label.ToLowerInvariant()} first.";
    }

    private async Task SelectChoice(OVApiDecisionChoice choice)
    {
        var node = CurrentNode;
        if (node is null) return;
        _decisions.Add(new OVApiDecisionSelection(node.Id, choice.Value));
        _loadedOperationId = null;
        _validationRequested = false;
        _focusActiveStep = true;
        await MarkDirtyAsync();
        await EnsureOperationStateAsync();
        await PublishStateAsync();
    }

    private async Task ChangeDecision(int index)
    {
        if (index < 0 || index >= _decisions.Count) return;
        _decisions.RemoveRange(index, _decisions.Count - index);
        _values.Clear();
        _sources.Clear();
        _touchedParameters.Clear();
        _validationRequested = false;
        _loadedOperationId = null;
        _focusActiveStep = true;
        await MarkDirtyAsync();
        await PublishStateAsync();
    }

    private async Task EnsureOperationStateAsync()
    {
        var operation = ResolvedOperation;
        if (operation is null || operation.Id == _loadedOperationId) return;
        _loadedOperationId = operation.Id;
        _sources.Clear();

        foreach (var parameter in operation.Parameters)
        {
            if (!_values.ContainsKey(parameter.Name))
            {
                var persisted = GuidedState.Parameters.FirstOrDefault(item => item.Name == parameter.Name)?.Value;
                var legacy = Configuration.Parameters.FirstOrDefault(item => item.Name == parameter.Name)?.Value;
                _values[parameter.Name] = persisted ?? legacy ?? parameter.DefaultValue;
            }
            if (parameter.Hidden && string.IsNullOrWhiteSpace(_values[parameter.Name])) _values[parameter.Name] = parameter.DefaultValue;
        }

        foreach (var parameter in operation.Parameters.Where(parameter => !string.IsNullOrWhiteSpace(parameter.SourceKey)))
        {
            if (!DependencyBlocked(parameter)) await ResolveSource(parameter);
        }
        await PublishConfigurationAsync();
    }

    private async Task SetParameter(OVApiParameterDefinition parameter, string? value)
    {
        _values[parameter.Name] = value;
        _touchedParameters.Add(parameter.Name);
        if (ResolvedOperation is { } operation)
        {
            foreach (var dependent in operation.Parameters.Where(item => string.Equals(item.DependsOn, parameter.Name, StringComparison.OrdinalIgnoreCase)))
            {
                _values[dependent.Name] = dependent.DefaultValue;
                _sources.Remove(dependent.Name);
                if (!DependencyBlocked(dependent)) await ResolveSource(dependent);
                var validOptions = OptionsFor(dependent);
                if (!string.IsNullOrWhiteSpace(_values[dependent.Name]) && validOptions.Count > 0 && validOptions.All(option => option.Value != _values[dependent.Name]))
                {
                    _values[dependent.Name] = null;
                }
            }
        }
        await MarkDirtyAsync();
        await PublishStateAsync();
        await PublishConfigurationAsync();
    }

    private async Task ResolveSource(OVApiParameterDefinition parameter)
    {
        if (ResolvedOperation is null || string.IsNullOrWhiteSpace(parameter.SourceKey) || ParameterSourceResolver is null || DependencyBlocked(parameter)) return;
        _sources[parameter.Name] = new OVApiParameterSourceResult([], OVApiParameterSourceState.Loading);
        await InvokeAsync(StateHasChanged);
        try
        {
            var values = _values.ToDictionary(item => item.Key, item => item.Value, StringComparer.OrdinalIgnoreCase);
            _sources[parameter.Name] = await ParameterSourceResolver(new OVApiParameterSourceRequest(ResolvedOperation.Id, parameter.Name, null, values));
        }
        catch
        {
            _sources[parameter.Name] = new OVApiParameterSourceResult([], OVApiParameterSourceState.Error, $"{parameter.Label} could not be loaded.");
        }
    }

    private OVApiParameterSourceResult SourceFor(OVApiParameterDefinition parameter)
        => _sources.GetValueOrDefault(parameter.Name) ?? new OVApiParameterSourceResult(parameter.Options ?? []);

    private IReadOnlyList<OVOption<string>> OptionsFor(OVApiParameterDefinition parameter)
        => _sources.TryGetValue(parameter.Name, out var source) ? source.Options : parameter.Options ?? [];

    private bool DependencyBlocked(OVApiParameterDefinition parameter)
        => !string.IsNullOrWhiteSpace(parameter.DependsOn) && string.IsNullOrWhiteSpace(ValueFor(parameter.DependsOn));

    private bool DependencyValid(OVApiParameterDefinition parameter)
    {
        if (DependencyBlocked(parameter)) return !parameter.Required;
        var options = OptionsFor(parameter);
        var value = ValueFor(parameter.Name);
        return string.IsNullOrWhiteSpace(value) || options.Count == 0 || parameter.InputKind is OVApiParameterInputKind.Text or OVApiParameterInputKind.TextArea or OVApiParameterInputKind.Date or OVApiParameterInputKind.DateTime or OVApiParameterInputKind.Integer or OVApiParameterInputKind.Number or OVApiParameterInputKind.StructuredObject or OVApiParameterInputKind.Collection || options.Any(option => option.Value == value);
    }

    private string? ValueFor(string? name) => string.IsNullOrWhiteSpace(name) ? null : _values.GetValueOrDefault(name);

    private OVApiCallConfiguration CompileConfiguration()
    {
        var operation = ResolvedOperation;
        if (operation is null) return Configuration;
        var resource = operation.Resource;
        var query = new List<OVApiParameterValue>();
        var headers = (operation.Headers ?? []).ToList();
        var body = new JsonObject();
        string? directBody = null;

        foreach (var parameter in operation.Parameters)
        {
            var value = ValueFor(parameter.Name);
            if (string.IsNullOrWhiteSpace(value)) continue;
            switch (parameter.Location)
            {
                case OVApiParameterLocation.Path:
                    resource = resource.Replace($"{{{parameter.Name}}}", Uri.EscapeDataString(value), StringComparison.OrdinalIgnoreCase);
                    break;
                case OVApiParameterLocation.Header:
                    headers.Add(new OVApiHeaderValue(parameter.Name, value));
                    break;
                case OVApiParameterLocation.Body:
                    if (operation.Parameters.Count(item => item.Location == OVApiParameterLocation.Body) == 1 && parameter.InputKind is OVApiParameterInputKind.StructuredObject or OVApiParameterInputKind.Collection)
                    {
                        directBody = value;
                    }
                    else
                    {
                        body[parameter.Name] = JsonValueFor(parameter, value);
                    }
                    break;
                default:
                    query.Add(new OVApiParameterValue(parameter.Name, value));
                    break;
            }
        }

        var requestBody = directBody ?? (body.Count > 0 ? body.ToJsonString() : null);
        return new OVApiCallConfiguration(operation.ConnectionId, operation.Method, resource, query, headers, requestBody, operation.TimeoutSeconds, operation.ContentType);
    }

    private static JsonNode? JsonValueFor(OVApiParameterDefinition parameter, string value)
    {
        if (parameter.InputKind == OVApiParameterInputKind.Boolean && bool.TryParse(value, out var boolean)) return JsonValue.Create(boolean);
        if (parameter.InputKind == OVApiParameterInputKind.Integer && long.TryParse(value, NumberStyles.Integer, CultureInfo.InvariantCulture, out var integer)) return JsonValue.Create(integer);
        if (parameter.InputKind == OVApiParameterInputKind.Number && decimal.TryParse(value, NumberStyles.Number, CultureInfo.InvariantCulture, out var number)) return JsonValue.Create(number);
        if (parameter.InputKind is OVApiParameterInputKind.StructuredObject or OVApiParameterInputKind.Collection)
        {
            try { return JsonNode.Parse(value); } catch (JsonException) { return JsonValue.Create(value); }
        }
        return JsonValue.Create(value);
    }

    private string BuildResolvedPath()
    {
        var configuration = CompiledConfiguration;
        var address = configuration.Resource;
        var enabled = configuration.Parameters.Where(item => item.Enabled && !string.IsNullOrWhiteSpace(item.Name)).ToArray();
        if (enabled.Length > 0)
        {
            address += (address.Contains('?') ? "&" : "?") + string.Join("&", enabled.Select(item => $"{Uri.EscapeDataString(item.Name)}={Uri.EscapeDataString(item.Value ?? string.Empty)}"));
        }
        return address;
    }

    private string BuildFullUrl()
    {
        var baseAddress = SelectedConnection?.BaseAddress?.TrimEnd('/');
        if (string.IsNullOrWhiteSpace(baseAddress)) return ResolvedPath;
        return $"{baseAddress}/{ResolvedPath.TrimStart('/')}";
    }

    private string RawRequest
    {
        get
        {
            var configuration = CompiledConfiguration;
            var builder = new StringBuilder($"{configuration.Method} {ResolvedPath}");
            if (!string.IsNullOrWhiteSpace(configuration.RequestBody)) builder.AppendLine().Append(configuration.RequestBody);
            return builder.ToString();
        }
    }

    private string FriendlyValue(OVApiParameterDefinition parameter, string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "—";
        if (parameter.InputKind == OVApiParameterInputKind.Boolean) return string.Equals(value, "true", StringComparison.OrdinalIgnoreCase) ? "Yes" : "No";
        return OptionsFor(parameter).FirstOrDefault(option => option.Value == value)?.Label ?? value;
    }

    private IReadOnlyList<ParameterGroup> GroupParameters(IEnumerable<OVApiParameterDefinition> parameters)
        => parameters
            .GroupBy(parameter => new { Name = parameter.Group ?? string.Empty, parameter.GroupOrder })
            .OrderBy(group => group.Key.GroupOrder)
            .ThenBy(group => group.Key.Name, StringComparer.Ordinal)
            .Select(group =>
            {
                var items = group.ToArray();
                var requestedLayout = items.Select(parameter => parameter.GroupLayout).FirstOrDefault(layout => layout != OVApiParameterGroupLayout.Auto);
                return new ParameterGroup(
                    string.IsNullOrWhiteSpace(group.Key.Name) ? null : group.Key.Name,
                    items.Select(parameter => parameter.GroupDescription).FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)),
                    ResolveGroupLayout(items, requestedLayout),
                    items);
            })
            .ToArray();

    private static OVApiParameterGroupLayout ResolveGroupLayout(IReadOnlyList<OVApiParameterDefinition> parameters, OVApiParameterGroupLayout requested)
    {
        if (requested != OVApiParameterGroupLayout.Auto) return requested;
        if (parameters.Count <= 1) return OVApiParameterGroupLayout.SingleColumn;
        if (parameters.Any(parameter => !string.IsNullOrWhiteSpace(parameter.DependsOn))) return OVApiParameterGroupLayout.SingleColumn;
        if (parameters.Any(parameter => parameter.InputKind is OVApiParameterInputKind.Lookup
            or OVApiParameterInputKind.MultiSelect
            or OVApiParameterInputKind.TextArea
            or OVApiParameterInputKind.StructuredObject
            or OVApiParameterInputKind.Collection)) return OVApiParameterGroupLayout.SingleColumn;
        return OVApiParameterGroupLayout.TwoColumn;
    }

    private static string ParameterGridClass(ParameterGroup group, bool optional = false)
    {
        var layout = group.Layout == OVApiParameterGroupLayout.TwoColumn ? "two" : "single";
        return $"ov-api-call-builder__parameters ov-api-call-builder__parameters--{layout}{(optional ? " ov-api-call-builder__parameters--optional" : string.Empty)}";
    }

    private async Task PublishStateAsync()
    {
        var state = new OVApiGuidedState(_decisions.ToArray(), _values.Select(item => new OVApiParameterValue(item.Key, item.Value)).ToArray(), ResolvedOperation?.Id);
        await GuidedStateChanged.InvokeAsync(state);
    }

    private Task PublishConfigurationAsync() => ConfigurationChanged.InvokeAsync(CompiledConfiguration);

    private async Task MarkDirtyAsync()
    {
        if (!Dirty) await DirtyChanged.InvokeAsync(true);
    }

    private async Task Test(MouseEventArgs _)
    {
        if (!IsValid)
        {
            _validationRequested = true;
            await InvokeAsync(StateHasChanged);
            return;
        }
        await TestRequested.InvokeAsync(CompiledConfiguration);
    }

    private async Task Save(MouseEventArgs _)
    {
        if (!IsValid)
        {
            _validationRequested = true;
            await InvokeAsync(StateHasChanged);
            return;
        }
        await SaveRequested.InvokeAsync(CompiledConfiguration);
    }

    private async Task Cancel(MouseEventArgs _)
    {
        if (Dirty && !ReadOnly)
        {
            _confirmCancel = true;
            return;
        }
        await CancelRequested.InvokeAsync();
    }

    private async Task ConfirmCancel()
    {
        _confirmCancel = false;
        await CancelRequested.InvokeAsync();
    }

    private Task KeepEditing()
    {
        _confirmCancel = false;
        return Task.CompletedTask;
    }

    private string BuildStateSignature()
        => $"{Catalogue?.InitialNodeId}|{string.Join(';', GuidedState.Decisions.Select(item => $"{item.NodeId}:{item.ChoiceValue}"))}|{string.Join(';', GuidedState.Parameters.Select(item => $"{item.Name}:{item.Value}"))}|{GuidedState.OperationId}";

    private sealed record ParameterGroup(string? Name, string? Description, OVApiParameterGroupLayout Layout, IReadOnlyList<OVApiParameterDefinition> Parameters);
}