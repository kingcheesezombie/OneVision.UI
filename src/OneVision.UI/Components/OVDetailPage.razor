<section class="ov-page ov-page--detail">
    <header class="ov-page__header">
        <div class="ov-page__heading">
            <h1>@Title</h1>
            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <p>@Description</p>
            }
            @if (Status is not null)
            {
                <div class="ov-detail-page__status">@Status</div>
            }
        </div>
        @if (Actions is not null)
        {
            <div class="ov-page__actions">@Actions</div>
        }
    </header>

    <div class="ov-detail-page__content">@ChildContent</div>

    @if (FooterActions is not null)
    {
        <div class="ov-detail-page__footer-actions">@FooterActions</div>
    }
</section>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public RenderFragment? Status { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? FooterActions { get; set; }
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;
}
