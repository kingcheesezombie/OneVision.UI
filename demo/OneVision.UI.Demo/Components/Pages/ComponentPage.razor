@page "/components/{ComponentKey}"
@inject IJSRuntime JS

@if (_component is null)
{
    <PageTitle>Component not found · OneVision.UI</PageTitle>
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">This component is not implemented and is not part of the active gallery manifest.</MudAlert>
}
else
{
    <PageTitle>@_component.Name · OneVision.UI</PageTitle>

    <div class="ov-pattern-page-heading">
        <div>
            <div class="ov-pattern-breadcrumb">Components / @_component.Group</div>
            <h1 class="ov-gallery-page-title">@_component.Name</h1>
            <MudText Typo="Typo.body1" Class="ov-gallery-page-intro">@_component.Description</MudText>
        </div>
        <div class="ov-pattern-meta">
            <span class="ov-pattern-kind">@ImplementedComponentCatalog.KindLabel(_component.Kind)</span>
            <OVPill Text="@MaturityLabel" Role="OVPillRole.Status" Tone="@MaturityTone" />
        </div>
    </div>

    <div class="ov-pattern-reference">
        <div>
            <div class="ov-pattern-reference__label">UI reference</div>
            <OVCopyableLink Text="@_component.Reference" Label="@($"Copy {_component.Reference}")" />
            <div class="ov-pattern-reference__basis">@_component.ImplementationBasis</div>
        </div>
        <div class="ov-reference-actions">
            <OVButton Appearance="OVButtonVariant.Secondary" Icon="OneVisionIcon.Copy" OnClick="CopyReference">@(_copiedReference ? "Copied" : "Copy reference")</OVButton>
            <OVButton OnClick="CopySpec">@(_copiedSpec ? "Spec copied" : "Copy design contract")</OVButton>
        </div>
    </div>

    <div class="ov-component-workbench">
        <aside class="ov-component-workbench__rail">
            <div class="ov-workbench-label">Component states</div>
            @foreach (var state in _component.States)
            {
                <button type="button" class="@(state == _activeState ? "ov-state-choice ov-state-choice--active" : "ov-state-choice")" aria-pressed="@(state == _activeState)" @onclick="() => SelectState(state)">@state</button>
            }
            @if (ComponentCapabilities.Count > 0)
            {
                <div class="ov-workbench-label mt-4">Independent capabilities</div>
                @foreach (var capability in ComponentCapabilities)
                {
                    <label class="ov-pattern-explorer__toggle">
                        <input type="checkbox" checked="@_enabledCapabilities.Contains(capability.Key)" @onchange="e => ToggleCapability(capability.Key, e)" />
                        <span>@capability.Label</span>
                    </label>
                }
                <button type="button" class="ov-pattern-explorer__reset" @onclick="ResetCapabilities">Reset capabilities</button>
            }
        </aside>
        <main class="ov-component-workbench__preview">
            <div class="ov-workbench-label">Actual component preview</div>
            <ComponentDemo Definition="@_component" State="@_activeState" EnabledCapabilities="@_enabledCapabilities" />
        </main>
    </div>

    <section class="ov-contract-grid">
        <MudPaper Class="ov-contract-card" Elevation="0">
            <div class="ov-contract-card__title"><OVIcon Name="OneVisionIcon.Success" /><span>Use when</span></div>
            <MudText Typo="Typo.body2">@_component.UseWhen</MudText>
        </MudPaper>
        <MudPaper Class="ov-contract-card" Elevation="0">
            <div class="ov-contract-card__title"><OVIcon Name="OneVisionIcon.Settings" /><span>Behaviour contract</span></div>
            <ul class="ov-contract-list">
                @foreach (var behaviour in _component.Behaviours)
                {
                    <li>@behaviour</li>
                }
            </ul>
        </MudPaper>
    </section>

    <section class="ov-demo-section mt-6">
        <div class="ov-section-heading-row">
            <div><MudText Typo="Typo.h6">How to specify it in an app</MudText><MudText Typo="Typo.body2">Use the stable reference plus only the app-specific capability or behaviour you need to override.</MudText></div>
            <OVButton Appearance="OVButtonVariant.Secondary" Icon="OneVisionIcon.Copy" OnClick="CopyExample">Copy example</OVButton>
        </div>
        <pre class="ov-code">@SpecificationExample</pre>
    </section>
}

@code {
    [Parameter] public string ComponentKey { get; set; } = string.Empty;

    private ComponentDefinition? _component;
    private string _activeState = string.Empty;
    private bool _copiedReference;
    private bool _copiedSpec;
    private readonly HashSet<string> _enabledCapabilities = new(StringComparer.Ordinal);
    private IReadOnlyList<ComponentCapabilityCatalog.Option> ComponentCapabilities => _component is null ? [] : ComponentCapabilityCatalog.For(_component.Reference);

    private ComponentMaturity Maturity => _component is null ? ComponentMaturity.ContractDemo : ComponentMaturityCatalog.Get(_component.Reference);
    private string MaturityLabel => ComponentMaturityCatalog.Label(Maturity);
    private OVPillTone MaturityTone => ComponentMaturityCatalog.Tone(Maturity);

    protected override void OnParametersSet()
    {
        _component = ImplementedComponentCatalog.Find(ComponentKey);
        _activeState = _component?.States.FirstOrDefault() ?? "Default";
        _copiedReference = false;
        _copiedSpec = false;
        ResetCapabilities();
    }

    private string SpecificationExample => _component is null
        ? string.Empty
        : $"Use {_component.Reference}.\nGovernance: {ImplementedComponentCatalog.KindLabel(_component.Kind)}.\nFunctional state: {_activeState}.\nIndependent capabilities: {EnabledCapabilitiesText}.\nApp-specific rule: <describe only the domain behaviour that differs from the OneVision contract>.";

    private string DesignContract => _component is null
        ? string.Empty
        : $"{_component.Reference} — {_component.Name}\n\nGovernance\n{ImplementedComponentCatalog.KindLabel(_component.Kind)}\n\nImplementation basis\n{_component.ImplementationBasis}\n\nPurpose\n{_component.Description}\n\nUse when\n{_component.UseWhen}\n\nFunctional states / roles\n- {string.Join("\n- ", _component.States)}\n\nBehaviour\n- {string.Join("\n- ", _component.Behaviours)}";

    private string EnabledCapabilitiesText => _enabledCapabilities.Count == 0 ? "Default" : string.Join(", ", ComponentCapabilities.Where(c => _enabledCapabilities.Contains(c.Key)).Select(c => c.Label));
    private void SelectState(string state) => _activeState = state;
    private void ResetCapabilities()
    {
        _enabledCapabilities.Clear();
        if (_component is null) return;
        foreach (var capability in ComponentCapabilityCatalog.Defaults(_component.Reference)) _enabledCapabilities.Add(capability);
    }
    private void ToggleCapability(string key, ChangeEventArgs args)
    {
        if (!ComponentCapabilities.Any(c => c.Key == key)) return;
        if (args.Value is true) _enabledCapabilities.Add(key);
        else _enabledCapabilities.Remove(key);
    }

    private async Task CopyReference(MouseEventArgs _)
    {
        if (_component is null) return;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", _component.Reference);
        _copiedReference = true;
    }

    private async Task CopySpec(MouseEventArgs _)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", DesignContract);
        _copiedSpec = true;
    }

    private async Task CopyExample(MouseEventArgs _)
        => await JS.InvokeVoidAsync("navigator.clipboard.writeText", SpecificationExample);
}
