@using OneVision.UI.Demo

@switch (Definition.Reference)
{
    case "OVC-BUTTON":
        <div class="ov-component-demo-row ov-demo-wrap">
            <OVButton Appearance="OVButtonVariant.Primary" Disabled="@IsDisabled" Loading="@IsLoading" Icon="OneVisionIcon.Save">Primary action</OVButton>
            <OVButton Appearance="OVButtonVariant.Secondary" Disabled="@IsDisabled" Loading="@IsLoading">Secondary</OVButton>
            <OVButton Appearance="OVButtonVariant.Subtle" Disabled="@IsDisabled" Loading="@IsLoading">Subtle</OVButton>
        </div>
        break;

    case "OVC-ICON-BUTTON":
        <div class="ov-component-demo-row">
            <OVIconButton Icon="OneVisionIcon.Edit" Label="Edit" Disabled="@IsDisabled" Loading="@IsLoading" />
            <OVIconButton Icon="OneVisionIcon.Refresh" Label="Refresh" Disabled="@IsDisabled" />
            <OVIconButton Icon="OneVisionIcon.Delete" Label="Delete" Tone="OVIconButtonTone.Destructive" Disabled="@IsDisabled" />
        </div>
        break;

    case "OVC-OVERFLOW-MENU":
        <div class="ov-demo-menu-stage">
            <OVIconButton Icon="OneVisionIcon.More" Label="More actions" OnClick="@(_ => ToggleOverflow())" />
            @if (_overflowOpen || State == "Open")
            {
                <div class="ov-demo-menu" role="menu">
                    <button type="button" role="menuitem"><OVIcon Name="OneVisionIcon.Edit" /> Edit</button>
                    <button type="button" role="menuitem" disabled="@(State == "Disabled item")">Duplicate</button>
                    <button type="button" role="menuitem" class="ov-demo-danger"><OVIcon Name="OneVisionIcon.Delete" /> Delete</button>
                </div>
            }
        </div>
        break;

    case "OVC-TEXT-FIELD":
        <MudTextField @bind-Value="_text" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@IsDisabled" ReadOnly="@IsReadOnly" Error="@IsError" ErrorText="Enter a valid name." />
        break;

    case "OVC-TEXT-AREA":
        <MudTextField @bind-Value="_notes" Label="Description" Lines="4" Sizing="InputSizing.Auto" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@IsDisabled" ReadOnly="@IsReadOnly" Error="@IsError" ErrorText="Enter a valid description." />
        break;

    case "OVC-NUMBER-FIELD":
        <MudNumericField T="int?" @bind-Value="_number" Label="Threshold" Min="0" Max="100" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@IsDisabled" ReadOnly="@IsReadOnly" Error="@IsError" ErrorText="Enter a number from 0 to 100." />
        break;

    case "OVC-SEARCH-BOX":
        <div class="ov-component-demo-stack">
            <MudTextField T="string" @bind-Value="_search" Immediate="true" Clearable="true" Disabled="@IsDisabled" Placeholder="Search records" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <span class="ov-pattern-demo__muted">@SearchResultText</span>
        </div>
        break;

    case "OVC-SELECT":
        <MudSelect T="string" @bind-Value="_select" Label="Mode" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@IsDisabled" ReadOnly="@IsReadOnly" Error="@IsError" ErrorText="Choose a mode.">
            <MudSelectItem T="string" Value="@("Standard")">Standard</MudSelectItem>
            <MudSelectItem T="string" Value="@("Advanced")">Advanced</MudSelectItem>
            <MudSelectItem T="string" Value="@("Custom")">Custom</MudSelectItem>
        </MudSelect>
        break;

    case "OVC-MULTI-SELECT":
        <OVMultiSelect Options="@MultiOptions" SelectedKeys="@_multiSelected" SelectedKeysChanged="OnMultiSelectedChanged" Disabled="@IsDisabled" ReadOnly="@IsReadOnly" />
        break;

    case "OVC-AUTOCOMPLETE":
        <MudAutocomplete T="string" @bind-Value="_person" Label="Person" SearchFunc="SearchPeople" CoerceValue="false" ResetValueOnEmptyText="true" ShowProgressIndicator="@(State == "Loading")" Disabled="@IsDisabled" Variant="Variant.Outlined" Margin="Margin.Dense">
            <NoItemsTemplate><div class="pa-3">No matching people</div></NoItemsTemplate>
        </MudAutocomplete>
        break;

    case "OVC-CHECKBOX":
        <MudCheckBox T="bool?" Value="@CheckboxValue" ValueChanged="@(value => _checked = value)" TriState="true" Disabled="@IsDisabled" Label="Include inactive records" Color="Color.Primary" />
        break;

    case "OVC-RADIO-GROUP":
        <MudRadioGroup T="string" @bind-Value="_radioMode" Disabled="@IsDisabled">
            <MudRadio T="string" Value="@("Automatic")" Color="Color.Primary">Automatic</MudRadio>
            <MudRadio T="string" Value="@("Manual")" Color="Color.Primary">Manual</MudRadio>
            <MudRadio T="string" Value="@("Legacy")" Disabled="true" Color="Color.Primary">Legacy</MudRadio>
        </MudRadioGroup>
        @if (IsError) { <div class="mud-input-error">Choose an assignment mode.</div> }
        break;

    case "OVC-TOGGLE":
        <div class="ov-component-demo-stack">
            <MudSwitch T="bool" @bind-Value="_toggle" Disabled="@(IsDisabled || State == "Saving")" Color="Color.Primary">Enabled</MudSwitch>
            @if (State == "Saving") { <OVProgress Mode="OVProgressMode.Indeterminate" Label="Saving…" /> }
        </div>
        break;

    case "OVC-DATE-PICKER":
        <MudDatePicker @bind-Date="_date" Label="Effective date" DateFormat="dd/MM/yyyy" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@IsDisabled" ReadOnly="@IsReadOnly" Error="@IsError" ErrorText="Choose a valid date." />
        break;

    case "OVC-DATE-RANGE":
        <MudDateRangePicker @bind-DateRange="_dateRange" Label="Effective period" DateFormat="dd/MM/yyyy" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@IsDisabled" Error="@(State == "Invalid range")" ErrorText="To cannot be before From." />
        break;

    case "OVC-TIME-PICKER":
        <MudTimePicker @bind-Time="_time" Label="Run at" TimeFormat="HH:mm" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@IsDisabled" Error="@IsError" ErrorText="Choose a valid time." />
        break;

    default:
        <MudAlert Severity="Severity.Warning">No input/action demo is registered for @Definition.Reference.</MudAlert>
        break;
}

@code {
    [Parameter, EditorRequired] public ComponentDefinition Definition { get; set; } = default!;
    [Parameter] public string State { get; set; } = "Default";

    private string _text = "Example value";
    private string _notes = "Example description for this governed object.";
    private int? _number = 25;
    private string _search = string.Empty;
    private string _select = "Standard";
    private string? _person;
    private bool? _checked = true;
    private string _radioMode = "Automatic";
    private bool _toggle = true;
    private bool _overflowOpen;
    private IReadOnlyCollection<string> _multiSelected = new[] { "birmingham", "solihull" };
    private DateTime? _date = new(2026, 10, 24);
    private DateRange _dateRange = new(new DateTime(2026, 10, 1), new DateTime(2026, 10, 31));
    private TimeSpan? _time = new(9, 0, 0);

    private static readonly IReadOnlyList<OVSelectionOption> MultiOptions =
    [
        new("birmingham", "Birmingham", "Birmingham and Solihull"),
        new("solihull", "Solihull", "Birmingham and Solihull"),
        new("dudley", "Dudley", "Black Country"),
        new("sandwell", "Sandwell", "Black Country"),
        new("walsall", "Walsall", "Black Country"),
        new("wolverhampton", "Wolverhampton", "Black Country")
    ];

    private bool IsDisabled => State == "Disabled";
    private bool IsReadOnly => State == "Read-only";
    private bool IsLoading => State == "Loading";
    private bool IsError => State.Contains("Validation", StringComparison.OrdinalIgnoreCase) || State.Contains("Invalid", StringComparison.OrdinalIgnoreCase);
    private bool? CheckboxValue => State == "Indeterminate" ? null : State == "Unchecked" ? false : _checked;
    private string SearchResultText => string.IsNullOrWhiteSpace(_search) ? "Search is local to the owning control." : _search.Contains("xyz", StringComparison.OrdinalIgnoreCase) ? "No results" : "3 matching records";

    private void ToggleOverflow() => _overflowOpen = !_overflowOpen;
    private Task OnMultiSelectedChanged(IReadOnlyCollection<string> values) { _multiSelected = values; return Task.CompletedTask; }

    private Task<IEnumerable<string>> SearchPeople(string? value, CancellationToken cancellationToken)
    {
        IEnumerable<string> people = new[] { "Steve Example", "Steven Sample", "Stephanie Example", "Sam Example" };
        if (!string.IsNullOrWhiteSpace(value)) people = people.Where(person => person.Contains(value, StringComparison.OrdinalIgnoreCase));
        if (State == "No results") people = Array.Empty<string>();
        return Task.FromResult(people);
    }
}
