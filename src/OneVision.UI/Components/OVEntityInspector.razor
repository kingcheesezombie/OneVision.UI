<OVOverlay Open="@Open"
           OpenChanged="@OpenChanged"
           Title="@Title"
           Description="@Subtitle"
           Placement="@Placement"
           Busy="@Busy"
           CloseDisabled="@(Refreshing && CloseDisabledWhileRefreshing)"
           CloseOnBackdrop="@CloseOnBackdrop"
           Class="ov-entity-inspector">
    <ChildContent>
        <div class="ov-entity-inspector__content">
            @if (StatusContent is not null)
            {
                <div class="ov-entity-inspector__status" aria-label="Entity status">@StatusContent</div>
            }

            @if (!string.IsNullOrWhiteSpace(ActionErrorMessage))
            {
                <div class="ov-entity-inspector__action-error" role="alert">
                    <OVAlert Tone="OVAlertTone.Error">@ActionErrorMessage</OVAlert>
                </div>
            }
            @if (Busy)
            {
                <div class="ov-entity-inspector__action-progress" role="status">
                    <OVProgress Mode="OVProgressMode.Indeterminate" Label="@BusyMessage" />
                </div>
            }

            @if (Loading)
            {
                <div class="ov-entity-inspector__skeleton" role="status" aria-label="Loading entity details" aria-busy="true">
                    @for (var row = 0; row < 5; row++)
                    {
                        <div class="ov-entity-inspector__skeleton-row">
                            <OVSkeleton Width="32%" />
                            <OVSkeleton Width="@(row % 2 == 0 ? "78%" : "58%")" />
                        </div>
                    }
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="ov-entity-inspector__error" role="alert">
                    <OVAlert Tone="OVAlertTone.Error">@ErrorMessage</OVAlert>
                    @if (ErrorDetail is not null)
                    {
                        <div class="ov-entity-inspector__error-detail">@ErrorDetail</div>
                    }
                </div>
            }
            else if (Empty)
            {
                <div class="ov-entity-inspector__empty">
                    <OVEmptyState Title="@EmptyTitle" Description="@ResolvedEmptyDescription" />
                </div>
            }
            else
            {
                @if (!string.IsNullOrWhiteSpace(RefreshErrorMessage))
                {
                    <OVAlert Tone="OVAlertTone.Error">@RefreshErrorMessage</OVAlert>
                }
                @if (Refreshing)
                {
                    <div class="ov-entity-inspector__refresh-progress" aria-live="polite">
                        <OVProgress Mode="OVProgressMode.Indeterminate" Label="Refreshing entity details…" />
                    </div>
                }
                @if (SummaryContent is not null)
                {
                    <section class="ov-entity-inspector__summary" aria-label="Entity summary">@SummaryContent</section>
                }
                @if (Sections is not null)
                {
                    <div class="ov-entity-inspector__sections">@Sections</div>
                }
            }
        </div>
    </ChildContent>
    <Footer>
        <div class="ov-entity-inspector__footer-actions" aria-label="Entity inspector actions">
            <div class="ov-entity-inspector__utility-actions">
                @if (RefreshRequested.HasDelegate)
                {
                    <OVButton Appearance="OVButtonVariant.Subtle" OnClick="RefreshClicked" Loading="@Refreshing" Disabled="@(Loading || Refreshing || Busy)">Refresh</OVButton>
                }
            </div>
            <div class="ov-entity-inspector__application-actions">
                @if (SecondaryActions is not null)
                {
                    @SecondaryActions
                }
                else if (Actions is not null)
                {
                    @Actions
                }
                @if (OverflowActions.Count > 0)
                {
                    <OVOverflowMenu Items="@OverflowActions" ItemSelected="@OverflowActionSelected" AriaLabel="More entity actions" Disabled="@(Refreshing || Busy)" />
                }
                @if (PrimaryAction is not null)
                {
                    <div class="ov-entity-inspector__primary-action">@PrimaryAction</div>
                }
            </div>
        </div>
    </Footer>
</OVOverlay>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public OVOverlayPlacement Placement { get; set; } = OVOverlayPlacement.RightSide;
    [Parameter] public RenderFragment? StatusContent { get; set; }
    [Parameter] public RenderFragment? SummaryContent { get; set; }
    [Parameter] public RenderFragment? Sections { get; set; }

    // Compatibility slot. New consumers should use SecondaryActions, PrimaryAction and OverflowActions.
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? SecondaryActions { get; set; }
    [Parameter] public RenderFragment? PrimaryAction { get; set; }
    [Parameter] public IReadOnlyList<OVOverflowMenuItem> OverflowActions { get; set; } = [];
    [Parameter] public EventCallback<string> OverflowActionSelected { get; set; }

    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string BusyMessage { get; set; } = "Processing entity action…";
    [Parameter] public string? ActionErrorMessage { get; set; }
    [Parameter] public bool Refreshing { get; set; }
    [Parameter] public bool CloseDisabledWhileRefreshing { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public RenderFragment? ErrorDetail { get; set; }
    [Parameter] public string? RefreshErrorMessage { get; set; }
    [Parameter] public bool Empty { get; set; }
    [Parameter] public string EmptyTitle { get; set; } = "No details available";
    [Parameter] public string? EmptyDescription { get; set; }
    [Parameter] public EventCallback RefreshRequested { get; set; }
    [Parameter] public bool CloseOnBackdrop { get; set; } = true;

    [Parameter, Obsolete("OVEntityInspector close is governed by the overlay header and this parameter is no longer used.")]
    public string CloseText { get; set; } = "Close";

    private string ResolvedEmptyDescription => string.IsNullOrWhiteSpace(EmptyDescription)
        ? "This entity exists, but no detail content is currently available."
        : EmptyDescription!;

    private Task RefreshClicked(MouseEventArgs _) => (Loading || Refreshing || Busy) ? Task.CompletedTask : RefreshRequested.InvokeAsync();
    private Task CloseClicked(MouseEventArgs _) => Refreshing && CloseDisabledWhileRefreshing ? Task.CompletedTask : OpenChanged.InvokeAsync(false);
}
