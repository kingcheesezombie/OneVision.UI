<div class="@RootClass" role="separator" aria-orientation="@OrientationText">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <span>@Label</span>
    }
</div>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public OVDividerOrientation Orientation { get; set; } = OVDividerOrientation.Horizontal;
    [Parameter] public string? Class { get; set; }

    private string OrientationText => Orientation == OVDividerOrientation.Vertical ? "vertical" : "horizontal";
    private string RootClass
    {
        get
        {
            var value = $"ov-divider ov-divider--{Orientation.ToString().ToLowerInvariant()}";
            if (!string.IsNullOrWhiteSpace(Label)) value += " ov-divider--labelled";
            return string.IsNullOrWhiteSpace(Class) ? value : $"{value} {Class}";
        }
    }
}
