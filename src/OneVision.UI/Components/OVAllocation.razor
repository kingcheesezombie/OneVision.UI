<section class="@RootClass" aria-label="Allocation">
    @if (Loading)
    {
        <OVProgress Mode="OVProgressMode.Indeterminate" Label="Loading allocation…" />
    }
    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <OVAlert Tone="OVAlertTone.Error">@ErrorMessage</OVAlert>
    }
    else
    {
        <div class="ov-allocation__summary" role="group" aria-label="Effective allocation summary">
            <section class="ov-allocation__summary-card" aria-labelledby="ov-allocation-effective-heading">
                <div class="ov-allocation__summary-label" id="ov-allocation-effective-heading">Effective ODM</div>
                <div class="ov-allocation__summary-value">
                    @if (EffectiveOdm is not null)
                    {
                        @EffectiveOdm
                    }
                    else
                    {
                        <span class="ov-allocation__empty-value">No effective ODM</span>
                    }
                </div>
            </section>

            <section class="ov-allocation__summary-card" aria-labelledby="ov-allocation-mode-heading">
                <div class="ov-allocation__summary-label" id="ov-allocation-mode-heading">Assignment mode</div>
                <div class="ov-allocation__mode">
                    <OVPill Text="@ModeLabel" Role="OVPillRole.Status" Tone="@ModeTone" />
                    <span class="ov-allocation__mode-description">@ModeDescription</span>
                </div>
            </section>

            <section class="ov-allocation__summary-card" aria-labelledby="ov-allocation-source-heading">
                <div class="ov-allocation__summary-label" id="ov-allocation-source-heading">Source / ancestor</div>
                @if (AssignmentMode == OVAllocationAssignmentMode.Inherited && SourceAncestor is not null)
                {
                    <div class="ov-allocation__summary-value">@SourceAncestor</div>
                }
                else
                {
                    <div class="ov-allocation__no-ancestor">No ancestor</div>
                }
            </section>
        </div>

        @if (Actions is not null)
        {
            <div class="ov-allocation__actions">@Actions</div>
        }

        @if (UnderlyingEamAllocation is not null)
        {
            <details class="ov-allocation__details" open="@UnderlyingAllocationExpanded">
                <summary>Underlying EAM allocation</summary>
                <div class="ov-allocation__details-body">@UnderlyingEamAllocation</div>
            </details>
        }

        @if (OdmHierarchyMemberships is not null)
        {
            <section class="ov-allocation__memberships" aria-labelledby="ov-allocation-memberships-heading">
                <header class="ov-allocation__section-header">
                    <h2 id="ov-allocation-memberships-heading">ODM hierarchy memberships</h2>
                </header>
                <div class="ov-allocation__memberships-body">@OdmHierarchyMemberships</div>
            </section>
        }
    }
</section>

@code {
    [Parameter] public RenderFragment? EffectiveOdm { get; set; }
    [Parameter] public OVAllocationAssignmentMode AssignmentMode { get; set; } = OVAllocationAssignmentMode.None;
    [Parameter] public RenderFragment? SourceAncestor { get; set; }
    [Parameter] public RenderFragment? UnderlyingEamAllocation { get; set; }
    [Parameter] public RenderFragment? OdmHierarchyMemberships { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public bool UnderlyingAllocationExpanded { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public string? Class { get; set; }

    private string RootClass => string.IsNullOrWhiteSpace(Class) ? "ov-allocation" : $"ov-allocation {Class}";

    private string ModeLabel => AssignmentMode switch
    {
        OVAllocationAssignmentMode.Direct => "DIRECT",
        OVAllocationAssignmentMode.Inherited => "INHERITED",
        _ => "NONE"
    };

    private string ModeDescription => AssignmentMode switch
    {
        OVAllocationAssignmentMode.Direct => "Allocated directly to this object.",
        OVAllocationAssignmentMode.Inherited => "Inherited from the nearest allocated ancestor.",
        _ => "No effective ODM allocation."
    };

    private OVPillTone ModeTone => AssignmentMode switch
    {
        OVAllocationAssignmentMode.Direct => OVPillTone.Success,
        OVAllocationAssignmentMode.Inherited => OVPillTone.Info,
        _ => OVPillTone.Neutral
    };
}
