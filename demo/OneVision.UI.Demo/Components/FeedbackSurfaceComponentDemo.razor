@using OneVision.UI.Demo

@switch (Definition.Reference)
{
    case "OVC-ALERT":
        <MudAlert Severity="@AlertSeverity" Variant="Variant.Outlined" Dense="true" CloseIcon="@(State == "Dismissible" ? Icons.Material.Filled.Close : null)">@AlertMessage</MudAlert>
        break;

    case "OVC-VALIDATION-SUMMARY":
        <OVValidationSummary Title="@(State == "Warning" ? "Review these items" : "There is a problem")" Severity="@(State == "Warning" ? Severity.Warning : Severity.Error)" Issues="@ValidationIssues" />
        break;

    case "OVC-TOOLTIP":
        <MudTooltip Text="Refresh data" Disabled="@(State == "Disabled target")">
            <OVIconButton Icon="OneVisionIcon.Refresh" Label="Refresh data" Disabled="@(State == "Disabled target")" />
        </MudTooltip>
        break;

    case "OVC-PROGRESS":
        <OVProgress Mode="@ProgressMode" Value="@ProgressValue" Label="@ProgressLabel" Complete="@(State == "Complete")" Failed="@(State == "Failed")" />
        break;

    case "OVC-CARD":
        <article class="ov-demo-card">
            <div><strong>Identity matching</strong><p>Candidate generation and ambiguity review.</p></div>
            <div class="ov-component-demo-row"><OVPill Text="Healthy" Role="OVPillRole.Status" Tone="OVPillTone.Success" />@if (State == "Actionable") { <OVButton Appearance="OVButtonVariant.Subtle">Open</OVButton> }</div>
        </article>
        break;

    case "OVC-PANEL":
        <section class="ov-demo-panel"><header><div><strong>Connection details</strong><small>SQL Warehouse</small></div><OVButton Appearance="OVButtonVariant.Subtle">Edit</OVButton></header><div class="ov-demo-detail-grid"><div class="ov-demo-keyvalue"><span>Type</span><strong>SQL Server</strong></div><div class="ov-demo-keyvalue"><span>Status</span><strong>Available</strong></div></div></section>
        break;

    case "OVC-ACCORDION":
        <MudExpansionPanels Elevation="0" Class="ov-demo-accordion-mud">
            <MudExpansionPanel Text="Advanced settings" Expanded="@(State == "Expanded")" Disabled="@(State == "Disabled")">
                Optional configuration is visible while expanded.
            </MudExpansionPanel>
        </MudExpansionPanels>
        break;

    case "OVC-DIALOG":
        <div class="ov-component-overlay-stage" aria-label="Dialog contract demonstration">
            <div class="ov-demo-modal" role="dialog" aria-modal="true" aria-labelledby="demo-dialog-title">
                <div class="ov-demo-modal__header"><strong id="demo-dialog-title">Edit connection</strong>@if (State != "Read-only") { <OVIconButton Icon="OneVisionIcon.Cancel" Label="Close" /> }</div>
                <div class="ov-demo-modal__content"><MudTextField Value="@ExampleConnectionName" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="@(State == "Read-only")" /></div>
                <div class="ov-demo-modal__footer"><OVButton Appearance="OVButtonVariant.Subtle">Cancel</OVButton><OVButton Loading="@(State == "Saving")">Save</OVButton></div>
            </div>
        </div>
        break;

    case "OVC-OVERLAY":
        <div class="ov-demo-overlay-stage"><div class="ov-demo-overlay-surface"><header><div><strong>Add allocation</strong><small>Parent list remains visible behind this right-side workspace.</small></div><OVIconButton Icon="OneVisionIcon.Cancel" Label="Close overlay" /></header><div class="ov-demo-overlay-body"><MudSelect T="string" Label="Target" Value="@("Business Area A")" Variant="Variant.Outlined" Margin="Margin.Dense"><MudSelectItem T="string" Value="@("Business Area A")">Business Area A</MudSelectItem><MudSelectItem T="string" Value="@("Business Area B")">Business Area B</MudSelectItem></MudSelect>@if (State == "Error") { <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">The allocation could not be saved.</MudAlert> }</div><footer><OVButton Appearance="OVButtonVariant.Subtle">Cancel</OVButton><OVButton Loading="@(State == "Saving")">Save allocation</OVButton></footer></div></div>
        break;

    case "OVC-CONFIRM-DIALOG":
        <div class="ov-component-overlay-stage"><div class="ov-demo-modal ov-demo-confirm" role="alertdialog" aria-modal="true"><div class="ov-demo-modal__header"><strong>Delete connection?</strong></div><div class="ov-demo-modal__content"><p>This permanently removes <strong>SQL Warehouse</strong>. Existing dependent configuration may stop working.</p></div><div class="ov-demo-modal__footer"><OVButton Appearance="OVButtonVariant.Subtle">Cancel</OVButton><OVButton Loading="@(State == "Busy")" Class="ov-button--destructive">Delete connection</OVButton></div></div></div>
        break;

    default:
        <MudAlert Severity="Severity.Warning">No feedback/surface demo is registered for @Definition.Reference.</MudAlert>
        break;
}

@code {
    [Parameter, EditorRequired] public ComponentDefinition Definition { get; set; } = default!;
    [Parameter] public string State { get; set; } = "Default";

    private const string ExampleConnectionName = "SQL Warehouse";

    private static readonly IReadOnlyList<OVValidationSummary.OVValidationIssue> ValidationIssues =
    [
        new("Name is required."),
        new("Effective To cannot be before Effective From.")
    ];

    private Severity AlertSeverity => State switch
    {
        "Error" => Severity.Error,
        "Warning" => Severity.Warning,
        "Success" => Severity.Success,
        _ => Severity.Info
    };

    private string AlertMessage => AlertSeverity switch
    {
        Severity.Error => "The operation could not be completed. Review the highlighted fields and try again.",
        Severity.Warning => "This change may affect existing allocations.",
        Severity.Success => "Changes saved successfully.",
        _ => "Additional information is available for this section."
    };

    private OVProgressMode ProgressMode => State == "Indeterminate" ? OVProgressMode.Indeterminate : OVProgressMode.Determinate;
    private double ProgressValue => State == "Complete" ? 100 : State == "Failed" ? 42 : 68;
    private string ProgressLabel => State == "Failed" ? "Failed after 42%" : State == "Complete" ? "Complete" : State == "Indeterminate" ? "Working…" : "68% complete";
}
