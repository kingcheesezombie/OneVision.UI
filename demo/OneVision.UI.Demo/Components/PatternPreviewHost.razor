@using OneVision.UI.Demo

@switch (PatternKey)
{
    case "list-page":
        <ListPageDemo Scenario="@Scenario" ShowSearch="@HasCapability("search")" ShowFilter="@HasCapability("filter")" ShowAdd="@HasCapability("add")" ShowRowActions="@HasCapability("row-actions")" ShowPagination="@HasCapability("pagination")" />
        break;
    case "catalogue-management":
        <CatalogueManagementDemo Scenario="@Scenario" />
        break;
    case "api-call-builder":
        <ApiCallBuilderDemo Scenario="@Scenario" />
        break;
    case "source-configuration":
        <SourceConfigurationDemo WorkbenchScenario="@Scenario" WorkbenchSourceMode="@SourceMode" DisplayValueEnabled="@HasCapability("display-value")" StandardDetailsWorkbenchEnabled="@HasCapability("standard-details")" />
        break;
    case "progressive-configuration-builder":
        <ProgressiveConfigurationBuilderDemo Scenario="@Scenario" />
        break;
    case "operational-detail":
        <OperationalDetailDemo Scenario="@Scenario" ShowHealth="@HasCapability("health")" ShowEvent="@HasCapability("event")" ShowStages="@HasCapability("stages")" ShowActivity="@HasCapability("activity")" ShowActions="@HasCapability("actions")" />
        break;
    case "entity-inspector":
        <EntityInspectorDemo Scenario="@Scenario" />
        break;
    case "allocation":
        <AllocationPatternDemo Scenario="@Scenario" />
        break;
    default:
        <OVAlert Tone="OVAlertTone.Warning">
            No representative preview is implemented for this pattern. It must not be added to the governed pattern manifest until a real implementation and explicit demo exist.
        </OVAlert>
        break;
}

@code {
    [Parameter, EditorRequired] public string PatternKey { get; set; } = string.Empty;
    [Parameter] public string Scenario { get; set; } = string.Empty;
    [Parameter] public string SourceMode { get; set; } = "managed";
    [Parameter] public IReadOnlyCollection<string> EnabledCapabilities { get; set; } = Array.Empty<string>();

    private bool HasCapability(string key) => EnabledCapabilities.Contains(key);
}
