@using OneVision.UI.Demo

@switch (Definition.Reference)
{
    case "OVC-PILL":
        <div class="ov-component-demo-row ov-demo-wrap">
            @if (State == "Type")
            {
                <OVPill Text="ASSET" Role="OVPillRole.Type" />
                <OVPill Text="ATTRIBUTE" Role="OVPillRole.Type" />
            }
            else if (State == "Source")
            {
                <OVPill Text="EAM" Role="OVPillRole.Source" Tone="OVPillTone.Info" />
                <OVPill Text="IDM" Role="OVPillRole.Source" Tone="OVPillTone.Info" />
                <OVPill Text="HDM" Role="OVPillRole.Source" Tone="OVPillTone.Info" />
            }
            else if (State == "Filter")
            {
                <OVPill Text="Status: Current" Role="OVPillRole.Filter" Removable="true" />
                <OVPill Text="Business Area: North" Role="OVPillRole.Filter" Locked="true" />
            }
            else if (State == "Count")
            {
                <OVPill Text="12" Role="OVPillRole.Count" Tone="OVPillTone.Info" />
                <OVPill Text="999+" Role="OVPillRole.Count" Tone="OVPillTone.Info" />
            }
            else
            {
                <OVPill Text="Current" Role="OVPillRole.Status" Tone="OVPillTone.Success" />
                <OVPill Text="Scheduled" Role="OVPillRole.Status" Tone="OVPillTone.Info" />
                <OVPill Text="Warning" Role="OVPillRole.Status" Tone="OVPillTone.Warning" />
                <OVPill Text="Failed" Role="OVPillRole.Status" Tone="OVPillTone.Danger" />
            }
        </div>
        break;

    case "OVC-DATA-GRID":
        <OVDataGrid AriaLabel="Example governed records"
                    Loading="@(State == "Loading")"
                    Empty="@(State == "Empty")"
                    Refreshing="@HasCapability("refresh")"
                    RefreshErrorMessage="@(HasCapability("refresh-error") ? "Unable to refresh records; existing rows are retained." : null)"
                    EmptyTitle="No records"
                    EmptyDescription="There are no records in this result set.">
            <ChildContent>
                <thead><tr><th><input type="checkbox" disabled="@(State == "Read-only" || HasCapability("read-only"))" /></th><th>Name</th><th>Status</th><th>Updated</th><th></th></tr></thead>
                <tbody>
                    <tr><td><input type="checkbox" disabled="@(State == "Read-only")" /></td><td>Example A</td><td><OVPill Text="Current" Role="OVPillRole.Status" Tone="OVPillTone.Success" /></td><td>24/10/2026</td><td><OVIconButton Icon="OneVisionIcon.More" Label="More actions" Disabled="@(State == "Read-only" || HasCapability("read-only"))" /></td></tr>
                    <tr><td><input type="checkbox" disabled="@(State == "Read-only")" /></td><td>Example B</td><td><OVPill Text="Scheduled" Role="OVPillRole.Status" Tone="OVPillTone.Info" /></td><td>23/10/2026</td><td><OVIconButton Icon="OneVisionIcon.More" Label="More actions" Disabled="@(State == "Read-only")" /></td></tr>
                </tbody>
            </ChildContent>
        </OVDataGrid>
        break;

    case "OVC-PAGINATION":
        @if (State == "Single page")
        {
            <OVPagination Page="1" TotalPages="1" TotalCount="8" PageSize="25" PageChanged="OnPageChanged" Busy="@HasCapability("busy")" />
        }
        else
        {
            <div>
                <strong>Default accessibility label</strong>
                <OVPagination Page="@_page" TotalPages="4" TotalCount="92" PageSize="25" PageChanged="OnPageChanged" />
            </div>
            <div class="mt-3">
                <strong>Explicit accessibility label</strong>
                <OVPagination Page="@_page" TotalPages="4" TotalCount="92" PageSize="25" PageChanged="OnPageChanged" AriaLabel="Example governed pagination" Busy="@HasCapability("busy")" />
            </div>
        }
        break;

    case "OVC-EMPTY-STATE":
        <OVEmptyState Title="@EmptyTitle" Description="@EmptyDescription" Icon="@EmptyIcon">
            <Action>
                @if (State == "No results")
                {
                    <OVButton Appearance="OVButtonVariant.Secondary">Clear filters</OVButton>
                }
                else if (State == "First use")
                {
                    <OVButton>Create item</OVButton>
                }
            </Action>
        </OVEmptyState>
        break;

    case "OVC-TABS":
        <OVTabs Items="@TabItems" ActiveKey="@_activeTab" ActiveKeyChanged="OnActiveTabChanged" />
        @if (State == "Overflow")
        {
            <div class="ov-pattern-demo__muted mt-2">Additional peer views move into the governed overflow treatment rather than shrinking labels.</div>
        }
        break;

    case "OVC-BREADCRUMB":
        <OVBreadcrumb Items="@BreadcrumbItems" MaxItems="@(State == "Long path" ? (byte?)3 : null)" />
        break;

    case "OVC-SIDE-NAV":
        <OVSideNav Items="@SideNavItems" ActiveKey="@_sideNav" ActiveKeyChanged="OnSideNavChanged" AriaLabel="Example workspace navigation" />
        break;

    case "OVC-TREE":
        <OVTree Nodes="@TreeNodes" SelectionMode="@TreeMode" Searchable="@HasCapability("search")" ShowSelectionCount="@HasCapability("selection-count")" Refreshing="@HasCapability("refresh")" RefreshErrorMessage="@(HasCapability("refresh-error") ? "Could not refresh hierarchy. Existing nodes and selection remain available." : null)" ReadOnly="@(State == "Read-only" || HasCapability("read-only"))" SelectedKeys="@_treeSelectedKeys" SelectedKeysChanged="OnTreeSelectionChanged" FocusedKey="@_treeFocusedKey" FocusedKeyChanged="OnTreeFocusChanged" />
        <OVSelectionSummary Items="@TreeSelectionLabels" MaxVisibleItems="3" />
        break;

    default:
        <OVAlert Tone="OVAlertTone.Warning">No actual component preview is registered for @Definition.Reference.</OVAlert>
        break;
}

@code {
    [Parameter, EditorRequired] public ComponentDefinition Definition { get; set; } = default!;
    [Parameter] public string State { get; set; } = "Default";
    [Parameter] public IReadOnlyCollection<string> EnabledCapabilities { get; set; } = Array.Empty<string>();
    private bool HasCapability(string key) => EnabledCapabilities.Contains(key);

    private int _page = 2;
    private string? _activeTab = "overview";
    private string? _sideNav = "general";
    private IReadOnlyCollection<string> _treeSelectedKeys = new[] { "team-north" };
    private string? _treeFocusedKey = "community-nursing";

    private IReadOnlyList<OVTabItem> TabItems =>
    [
        new("overview", "Overview", TabContent("Overview content")),
        new("configuration", "Configuration", TabContent("Configuration content")),
        new("history", "History", TabContent("History content"), State == "Disabled")
    ];

    private IReadOnlyList<OVBreadcrumbItem> BreadcrumbItems => State == "Long path"
        ? [new("Home", "/"), new("Settings", "/settings"), new("Integrations", "/settings/integrations"), new("Connections", "/settings/integrations/connections"), new("SQL Warehouse")]
        : [new("Settings", "/settings"), new("Connections", "/settings/connections"), new("SQL Warehouse")];

    private IReadOnlyList<OVSideNavItem> SideNavItems =>
    [
        new("general", "General", Icon: OneVisionIcon.Information),
        new("integrations", "Integrations", Icon: OneVisionIcon.Settings),
        new("advanced", "Advanced",
        [
            new("api", "API"),
            new("security", "Security", Disabled: State == "Disabled item")
        ], Icon: OneVisionIcon.Settings)
    ];

    private static readonly IReadOnlyList<OVTreeNode> TreeNodes =
    [
        new("organisation", "Organisation",
        [
            new("clinical-services", "Clinical Services",
            [
                new("community-nursing", "Community Nursing"),
                new("therapies", "Therapies"),
                new("teams", "Teams",
                [
                    new("team-north", "Team North"),
                    new("team-south", "Team South"),
                    new("archived-service", "Archived Service", disabled: true)
                ])
            ])
        ])
    ];

    private Task OnPageChanged(int page) { _page = page; return Task.CompletedTask; }
    private Task OnActiveTabChanged(string? key) { _activeTab = key; return Task.CompletedTask; }
    private Task OnSideNavChanged(string? key) { _sideNav = key; return Task.CompletedTask; }
    private static RenderFragment TabContent(string text) => builder => builder.AddContent(0, text);

    private OVTreeSelectionMode TreeMode => State switch
    {
        "Single" => OVTreeSelectionMode.Single,
        "Multiple" => OVTreeSelectionMode.Multiple,
        "LeafOnly" => OVTreeSelectionMode.LeafOnly,
        _ => OVTreeSelectionMode.MultipleHierarchical
    };

    private IReadOnlyList<string> TreeSelectionLabels => Flatten(TreeNodes).Where(node => _treeSelectedKeys.Contains(node.Key)).Select(node => node.Label).ToArray();
    private Task OnTreeSelectionChanged(IReadOnlyCollection<string> keys) { _treeSelectedKeys = keys; return Task.CompletedTask; }
    private Task OnTreeFocusChanged(string? key) { _treeFocusedKey = key; return Task.CompletedTask; }

    private static IEnumerable<OVTreeNode> Flatten(IEnumerable<OVTreeNode> nodes)
    {
        foreach (var node in nodes)
        {
            yield return node;
            foreach (var child in Flatten(node.Children)) yield return child;
        }
    }

    private string EmptyTitle => State switch
    {
        "No results" => "No matching results",
        "No data" => "No data available",
        "Permission limited" => "Nothing available in your scope",
        _ => "Nothing here yet"
    };

    private string EmptyDescription => State switch
    {
        "No results" => "Try changing or clearing the current search and filters.",
        "No data" => "The current context contains no records.",
        "Permission limited" => "Your current permissions do not expose any items here.",
        _ => "Create the first item to get started."
    };

    private OneVisionIcon EmptyIcon => State == "No results" ? OneVisionIcon.Search : OneVisionIcon.Information;
}
