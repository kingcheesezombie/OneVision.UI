@page "/layouts"

<PageTitle>Shell & Layouts · OneVision.UI</PageTitle>

<div class="ov-index-heading">
    <div>
        <div class="ov-home-kicker">OVP-001 · OVP-010–013</div>
        <h1 class="ov-gallery-page-title">Application shell & page layouts</h1>
        <MudText Typo="Typo.body1" Class="ov-gallery-page-intro">
            Governed structural patterns used beneath OVP-000. Applications provide domain content while OneVision.UI owns the shared frame, spacing and regions.
        </MudText>
    </div>
</div>

<section class="ov-home-section">
    <MudText Typo="Typo.h5">OVP-001 · Application Shell</MudText>
    <div class="ov-demo-section" style="padding:0; overflow:hidden; min-height:420px;">
        <OVApplicationShell Title="Entity Allocation Manager" Subtitle="OneVision">
            <Logo><span class="ov-shell-brand-mark">OV</span></Logo>
            <HeaderActions>
                <OVButton Variant="Variant.Text">Help</OVButton>
                <OVButton Variant="Variant.Text">Steve Pollard</OVButton>
            </HeaderActions>
            <Navigation>
                <span class="ov-shell-nav-item ov-shell-nav-item--active">Entities</span>
                <span class="ov-shell-nav-item">Allocations</span>
                <span class="ov-shell-nav-item">Schedules</span>
                <span class="ov-shell-nav-item">Activity</span>
                <span class="ov-shell-nav-item">Settings</span>
            </Navigation>
            <ChildContent>
                <OVStandardPage Title="Entities" Description="Browse and manage the governed entity catalogue.">
                    <Actions><OVButton Color="Color.Primary">Add entity</OVButton></Actions>
                    <ChildContent>
                        <div class="ov-layout-placeholder">Application-specific page content sits inside the governed shell.</div>
                    </ChildContent>
                </OVStandardPage>
            </ChildContent>
            <Footer>
                <div class="ov-shell-footer-content">
                    <span>Signed in as Steve Pollard</span>
                    <span>OneVision EAM · v1.0</span>
                </div>
            </Footer>
        </OVApplicationShell>
    </div>
</section>

<section class="ov-home-section">
    <MudText Typo="Typo.h5">OVP-010 · Standard Page</MudText>
    <div class="ov-demo-section">
        <OVStandardPage Title="Overview" Description="Compact page heading, app-specific content and right-aligned primary actions.">
            <Actions><OVButton Color="Color.Primary">Primary action</OVButton></Actions>
            <ChildContent><div class="ov-layout-placeholder">Application-specific content</div></ChildContent>
        </OVStandardPage>
    </div>
</section>

<section class="ov-home-section">
    <MudText Typo="Typo.h5">OVP-011 · List Page</MudText>
    <div class="ov-demo-section">
        <OVListPage Title="Entities" Description="Searchable, filterable and paginated administrative list.">
            <Actions><OVButton Color="Color.Primary">Add entity</OVButton></Actions>
            <Toolbar>
                <MudTextField T="string" Placeholder="Search entities" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:280px;" />
                <OVButton Variant="Variant.Text">Filters</OVButton>
            </Toolbar>
            <ChildContent>
                <div class="ov-list-preview-row"><strong>Clinical Team 1</strong><span>ASSET · EAM</span><OVStatusPill Text="Current" Tone="OVStatusPill.OVStatusTone.Success" /></div>
                <div class="ov-list-preview-row"><strong>Clinical Team 2</strong><span>ASSET · EAM</span><OVStatusPill Text="Current" Tone="OVStatusPill.OVStatusTone.Success" /></div>
                <div class="ov-list-preview-row"><strong>Legacy Attribute</strong><span>ATTRIBUTE · LDAP</span><OVStatusPill Text="Disabled" Tone="OVStatusPill.OVStatusTone.Neutral" /></div>
            </ChildContent>
            <Pagination><span>1–25 of 86</span></Pagination>
        </OVListPage>
    </div>
</section>

<section class="ov-home-section">
    <MudText Typo="Typo.h5">OVP-012 · Detail / Edit / Workspace Page</MudText>
    <div class="ov-demo-section">
        <OVDetailPage Title="Entity details" Description="Identity, status, actions and editable app-owned content.">
            <Status><OVStatusPill Text="Current" Tone="OVStatusPill.OVStatusTone.Success" /></Status>
            <Actions><OVButton Variant="Variant.Text">More</OVButton></Actions>
            <ChildContent>
                <div class="ov-layout-placeholder">Form sections, validation and domain-specific controls</div>
            </ChildContent>
            <FooterActions><OVButton Variant="Variant.Text">Cancel</OVButton><OVButton Color="Color.Primary">Save</OVButton></FooterActions>
        </OVDetailPage>
    </div>
</section>

<section class="ov-home-section">
    <MudText Typo="Typo.h5">OVP-013 · Split / Builder Page</MudText>
    <div class="ov-demo-section">
        <OVBuilderPage Title="Hierarchy Builder" Description="Compact navigation, working canvas and inspector workspace.">
            <Toolbar><OVButton Variant="Variant.Text">Add</OVButton><OVButton Variant="Variant.Text">Refresh</OVButton></Toolbar>
            <Navigation>
                <div><strong>Hierarchy</strong></div>
                <div style="margin-top:10px; color:var(--ov-colour-muted);">Root<br />&nbsp;&nbsp;Business Area A<br />&nbsp;&nbsp;Business Area B</div>
            </Navigation>
            <ChildContent><div class="ov-layout-placeholder" style="min-height:420px;">Main working canvas</div></ChildContent>
            <Inspector><div><strong>Details</strong></div><div style="margin-top:10px; color:var(--ov-colour-muted);">Selected item properties and actions</div></Inspector>
        </OVBuilderPage>
    </div>
</section>

<section class="ov-home-section" id="workspace-capabilities">
    <div class="ov-pattern-page-heading">
        <div>
            <div class="ov-home-kicker">GOVERNED WORKSPACE COMPOSITION · Manager / administrative</div>
            <MudText Typo="Typo.h5">Workspace, contextual summary, process state and selectable cards</MudText>
            <MudText Typo="Typo.body2" Class="ov-gallery-page-intro">
                Neutral Fluent-inspired demonstrations of list → workspace flows, tab summaries, process status, responsive selectable information cards, action hierarchy and completion states. Applications supply routing and domain meaning; OneVision.UI owns the reusable presentation and interaction grammar.
            </MudText>
        </div>
        <div class="ov-pattern-meta">
            <OVPill Text="OVP-012" Role="OVPillRole.Type" Tone="OVPillTone.Info" />
            <OVPill Text="Manager" Role="OVPillRole.Type" Tone="OVPillTone.Neutral" />
        </div>
    </div>
    <div class="ov-demo-section" style="padding:0; overflow:hidden;">
        <WorkspacePatternsDemo />
    </div>
</section>

<section class="ov-home-section" id="merge-review-workspace">
    <div class="ov-pattern-page-heading">
        <div>
            <div class="ov-home-kicker">APP COMPOSITION · IDM-driven reference</div>
            <MudText Typo="Typo.h5">Merge review workspace</MudText>
            <MudText Typo="Typo.body2" Class="ov-gallery-page-intro">
                A domain review workspace composed from governed OneVision.UI assets. It remains an application-composition example, not a merge-specific shared component.
            </MudText>
        </div>
        <div class="ov-pattern-meta">
            <OVPill Text="APP COMPOSITION" Role="OVPillRole.Type" Tone="OVPillTone.Info" />
        </div>
    </div>
    <div class="ov-demo-section" style="padding:0; overflow:hidden;">
        <MergeReviewWorkspaceDemo />
    </div>
</section>
